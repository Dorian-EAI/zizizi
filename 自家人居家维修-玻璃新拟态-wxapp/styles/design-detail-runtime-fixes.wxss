/* Runtime repairs for selectors that cannot be represented by the HTML-to-WXSS token rewrite. */
.design-detail-page { overflow: visible; }

.page-body { padding: 8rpx 36rpx 224rpx; }

.icon-button {
  width: 80rpx;
  height: 80rpx;
  border: 0;
  border-radius: 28rpx;
  color: var(--ink);
  background: rgba(255, 255, 255, .4);
  box-shadow: var(--shadow-soft);
  display: inline-grid;
  place-items: center;
  font-size: 38rpx;
}

.input, .textarea, .select-like {
  width: 100%;
  border: 2rpx solid rgba(255, 255, 255, .55);
  border-radius: var(--radius-md);
  outline: 0;
  color: var(--ink);
  background: rgba(238, 233, 228, .72);
  box-shadow: var(--shadow-in);
}

.input, .select-like { min-height: 96rpx; padding: 0 28rpx; }
.textarea { min-height: 212rpx; padding: 26rpx 28rpx; line-height: 1.6; }
.select-like { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.select-like > .input { flex: 1; min-width: 0; border: 0; background: transparent; box-shadow: none; }

.media-map { width: 100%; height: 300rpx; overflow: hidden; border-radius: 36rpx; }
.media-map.large { height: 560rpx; }
