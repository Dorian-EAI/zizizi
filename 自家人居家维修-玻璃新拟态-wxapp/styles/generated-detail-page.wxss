/* AUTO-GENERATED from zjrnew/assets/detail-page.css; do not hand edit. */
page {
  /* Role palette: client green + gold. */
  --brand: #0D9488;
  --brand-dark: #0A7A70;
  --brand-mid: #14B8A6;
  --brand-light: #CCFBF1;
  --brand-glow: rgba(13, 148, 136, 0.28);
  --brand-soft: rgba(13, 148, 136, 0.08);
  --brand-gradient: linear-gradient(135deg, #14B8A6 0%, #0D9488 40%, #D4944C 100%);
  --brand-gradient-text: linear-gradient(135deg, #14B8A6 0%, #D4944C 100%);
  --topbar-background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212,148,76,.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13,148,136,.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13,148,136,.14) 0%, rgba(212,148,76,.08) 50%, rgba(13,148,136,.06) 100%);
  --summary-background:
    radial-gradient(ellipse 360rpx 240rpx at 88% 15%, rgba(212,148,76,.08) 0%, transparent 72%),
    radial-gradient(ellipse 300rpx 220rpx at 8% 90%, rgba(13,148,136,.08) 0%, transparent 72%),
    rgba(255,255,255,.48);

  --accent: #D4944C;
  --accent-dark: #A0723C;
  --accent-soft: rgba(212, 148, 76, 0.10);
  --gold: #D4944C;

  --success: #5B8C5A;
  --warning: #D4944C;
  --danger: #C4533A;
  --info: #5A8FAD;

  --bg: #F2EDE8;
  --body-bg: #E8E4DF;
  --bg-elevated: #F7F3EF;
  --surface: rgba(255, 255, 255, 0.52);
  --surface-strong: rgba(255, 255, 255, 0.68);
  --ink: #2C2824;
  --muted: #8B8178;
  --faint: #B5ADA5;
  --line: rgba(44, 40, 36, 0.06);
  --fill: rgba(44, 40, 36, 0.04);

  /* 2026-08-01 style.md / settle 原画布：双偏移新拟态 + 环境投影 */
  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;
  --neu-out-sm: 12rpx 12rpx 28rpx var(--neu-dark), -12rpx -12rpx 28rpx var(--neu-light), 0 8rpx 32rpx rgba(0,0,0,.04);
  --neu-out-md: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light), 0 12rpx 48rpx rgba(0,0,0,.05);
  --neu-out-lg: 20rpx 20rpx 48rpx var(--neu-dark), -20rpx -20rpx 48rpx var(--neu-light), 0 16rpx 64rpx rgba(0,0,0,.06);
  --neu-in: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
  --shadow-out: var(--neu-out-md);
  --shadow-soft: var(--neu-out-sm);
  --shadow-in: var(--neu-in);
  --shadow-glass: 0 8rpx 48rpx rgba(0,0,0,.04), 0 1rpx 4rpx rgba(0,0,0,.03);

  --radius-xl: 64rpx;
  --radius-lg: 51.2rpx;
  --radius-md: 38.4rpx;
  --radius-sm: 24rpx;
  --radius-full: 19998rpx;

  --font-display: "Cormorant Garamond", "Noto Serif SC", STSong, Georgia, serif;
  --font-body: "Noto Serif SC", "Cormorant Garamond", STSong, Georgia, serif;
  --font-nums: "Cormorant Garamond", "Noto Serif SC", Georgia, serif;
  --spring: cubic-bezier(.175,.885,.32,1.275);
  --ease: cubic-bezier(.25,.46,.45,.94);
  --dur: .2s;
}

/* Role palette: worker blue + gold. */
.worker-theme {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-soft: rgba(45, 108, 223, 0.08);
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
  --brand-gradient-text: linear-gradient(135deg, #5A8EE8 0%, #D4944C 100%);
  --accent: #D4944C;
  --accent-dark: #A0723C;
  --accent-soft: rgba(212, 148, 76, 0.10);
  --topbar-background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212,148,76,.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45,108,223,.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45,108,223,.14) 0%, rgba(212,148,76,.08) 50%, rgba(45,108,223,.06) 100%);
  --summary-background:
    radial-gradient(ellipse 360rpx 240rpx at 88% 15%, rgba(212,148,76,.08) 0%, transparent 72%),
    radial-gradient(ellipse 300rpx 220rpx at 8% 90%, rgba(45,108,223,.08) 0%, transparent 72%),
    rgba(255,255,255,.48);
}
view, text, image, input, textarea, .design-button, .design-select, .design-option { box-sizing: border-box; }

page {
  margin: 0;
  min-height: 100%;
  color: var(--ink);
  background: var(--body-bg);
  font-family: var(--font-body);
  letter-spacing: -.01em;
  -webkit-font-smoothing: antialiased;
}

page {
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.design-button, input, textarea, .design-select { font: inherit; }
.design-button, [data-target-page], [data-action] { cursor: pointer; }

.design-detail-page {
  position: relative;
  width: 828rpx;
  min-height: 1792rpx;
  overflow: hidden;
  background: var(--bg);
  border-radius: 96rpx;
  box-shadow: 0 40rpx 120rpx rgba(0,0,0,.12), 0 8rpx 32rpx rgba(0,0,0,.06);
}

.design-detail-page::after {
  content: "";
  position: absolute;
  z-index: 0;
  left: 0;
  right: 0;
  bottom: 0;
  height: 520rpx;
  pointer-events: none;
  background:
    radial-gradient(ellipse 400rpx 280rpx at 20% 90%, var(--brand-soft) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 240rpx at 80% 85%, var(--accent-soft) 0%, transparent 70%);
  opacity: .72;
}

.design-detail-page > view, .design-detail-page > text, .design-detail-page > image { position: relative; z-index: 1; }

/* 原画布普通详情页不额外绘制伪系统状态栏。 */
.status-bar { display: none; }

.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: 160rpx;
  padding: 36rpx 40rpx;
  padding-top: max(36rpx, env(safe-area-inset-top));
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
  border-radius: 0 0 56rpx 56rpx;
  background: var(--topbar-background);
}

.topbar .tag-h1 {
  margin: 0;
  text-align: center;
  color: var(--ink);
  font: 700 34rpx/1.3 var(--font-body);
  letter-spacing: -.02em;
}

.topbar .eyebrow { display: none; }

.icon-button {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: var(--ink);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255,255,255,.5);
  display: inline-grid;
  place-items: center;
  font-size: 38rpx;
  transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--ease);
}
.icon-button:active { box-shadow: var(--neu-in); transform: scale(.94); }
.icon-button .design-svg-icon {
  width: 42rpx;
  height: 42rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.top-action {
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}
.icon-action {
  width: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  border-radius: 50%;
  display: inline-grid;
  place-items: center;
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm);
}
.icon-action .design-svg-icon { width: 38rpx; height: 38rpx; }

.page-body { padding: 36rpx 40rpx 224rpx; }

/* 详情页中的 .hero 是摘要卡，不冒充顶级页 Hero；保留原画布的克制暖光。 */
.hero {
  position: relative;
  overflow: hidden;
  margin: 0 0 40rpx;
  padding: 40rpx;
  color: var(--ink);
  background: var(--summary-background);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255,255,255,.70);
  border-radius: var(--radius-lg);
  box-shadow: var(--neu-out-md), var(--shadow-glass);
}
.hero::after { display: none; }
.hero > view, .hero > text, .hero > image { position: relative; z-index: 1; }

.eyebrow,
.hero-kicker {
  margin: 0 0 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: .04em;
}

.display-number,
.hero-number {
  color: var(--brand-dark);
  font: 700 64rpx/1.1 var(--font-nums);
  font-variant-numeric: tabular-nums;
  letter-spacing: -.02em;
}
.display-number .tag-small { margin-left: 8rpx; font-size: 30rpx; }

.hero .tag-h2 {
  margin: 0;
  color: var(--ink);
  font: 700 52rpx/1.25 var(--font-display);
  letter-spacing: -.02em;
}
.hero .tag-p {
  margin: 16rpx 0 0;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.stepper {
  display: inline-flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 14rpx;
  border-radius: var(--radius-md);
  background: var(--bg);
  box-shadow: var(--neu-in);
}
.stepper .design-button {
  width: 72rpx;
  height: 72rpx;
  border: 0;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm);
  font-size: 40rpx;
}
.stepper .tag-strong { min-width: 60rpx; color: var(--ink); text-align: center; }

.certificate-card { display: flex; align-items: center; gap: 24rpx; margin-bottom: 26rpx; }
.field-help, .range-labels, .inline-status, .map-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: var(--muted);
  font-size: 22rpx;
}
.range { width: 100%; accent-color: var(--brand); }

.map-grid {
  position: absolute;
  inset: 0;
  opacity: .18;
  background-image:
    linear-gradient(rgba(90,143,173,.24) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(90,143,173,.24) 2rpx, transparent 2rpx);
  background-size: 56rpx 56rpx;
}
.service-radius {
  position: absolute;
  left: 50%;
  top: 48%;
  width: 236rpx;
  height: 236rpx;
  transform: translate(-50%, -50%);
  display: grid;
  place-items: center;
  border: 3rpx solid var(--brand);
  border-radius: 50%;
  color: var(--brand-dark);
  background: var(--brand-soft);
  font-size: 24rpx;
}
.map-pin { position: relative; z-index: 1; color: var(--brand); font-size: 64rpx; }
.map-caption {
  position: absolute;
  z-index: 2;
  left: 26rpx;
  right: 26rpx;
  bottom: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-sm);
  color: var(--ink);
  background: rgba(255,255,255,.62);
  backdrop-filter: blur(24rpx) saturate(150%);
}
.inline-status { margin-top: 24rpx; }

.status,
.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  border-radius: var(--radius-full);
  padding: 10rpx 18rpx;
  color: var(--brand-dark);
  background: var(--brand-soft);
  font-size: 22rpx;
  font-weight: 600;
}
.status.success, .badge.success { color: #3D6E3E; background: rgba(91,140,90,.12); }
.badge.warning { color: #986326; background: rgba(212,148,76,.10); }
.badge.danger { color: #A53E2D; background: rgba(196,83,58,.11); }
.badge.info { color: #46748D; background: rgba(90,143,173,.12); }

.progress-ring {
  width: 156rpx;
  height: 156rpx;
  margin-top: 30rpx;
  display: grid;
  place-items: center;
  align-content: center;
  border: 14rpx solid var(--brand-soft);
  border-top-color: var(--brand);
  border-radius: 50%;
}
.progress-ring .tag-strong { color: var(--brand-dark); font: 700 38rpx/1 var(--font-nums); }
.progress-ring .tag-small { margin-top: 6rpx; color: var(--muted); font-size: 18rpx; }

.section { margin: 0 0 36rpx; }
.section-title {
  margin: 0 12rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 500;
}
.section-title .tag-strong { color: var(--ink); font-size: 32rpx; font-weight: 700; }

.card {
  position: relative;
  padding: 32rpx;
  border: 2rpx solid rgba(255,255,255,.70);
  border-radius: var(--radius-md);
  background: var(--surface);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  box-shadow: var(--neu-out-md), 0 12rpx 56rpx rgba(0,0,0,.06), 0 0 0 2rpx rgba(44,40,36,.05), 0 4rpx 16rpx var(--brand-soft);
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.card[role=".design-button"]:active { transform: scale(.98); box-shadow: var(--neu-in-deep); }
.card + .card { margin-top: 24rpx; }
.card-title { margin: 0 0 16rpx; color: var(--ink); font-size: 32rpx; font-weight: 700; }
.card-copy { margin: 0; color: var(--muted); font-size: 26rpx; line-height: 1.55; }

.list-card { padding: 8rpx 28rpx; overflow: hidden; }
.list-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.list-row:last-child { border-bottom: 0; }
.design-button.list-row { width: 100%; padding: 0; border: 0; background: transparent; text-align: left; color: inherit; }
.list-row[role=".design-button"]:active, .design-button.list-row:active { transform: scale(.985); background: var(--fill); }
.row-icon {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255,255,255,.45);
  font-size: 30rpx;
}
.row-icon .design-svg-icon {
  width: 36rpx;
  height: 36rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.design-button.row-icon { padding: 0; border: 0; }
.certificate-icon { color: var(--brand-dark); }
.experience-icon { color: var(--accent-dark); }
.row-main { flex: 1; min-width: 0; }
.row-title { color: var(--ink); font-size: 30rpx; font-weight: 500; }
.row-copy { margin-top: 6rpx; color: var(--muted); font-size: 24rpx; line-height: 1.45; }
.row-value { color: var(--muted); font-size: 26rpx; text-align: right; }
.chevron {
  position: relative;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  color: var(--faint);
  font-size: 0;
}
.chevron::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}
.row-action {
  flex: 0 0 auto;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}
.expand-toggle {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  display: inline-grid;
  place-items: center;
  color: var(--brand);
}
.expand-toggle .design-svg-icon {
  width: 34rpx;
  height: 34rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.grid-2, .grid-3 { display: grid; gap: 24rpx; }
.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.metric { padding: 28rpx 20rpx; text-align: center; }
.metric .tag-strong {
  display: block;
  color: var(--brand-dark);
  font: 700 44rpx/1.1 var(--font-nums);
  font-variant-numeric: tabular-nums;
}
.metric .tag-span { display: block; margin-top: 14rpx; color: var(--muted); font-size: 24rpx; }

.field { margin-bottom: 32rpx; }
.field .tag-label { display: block; margin: 0 8rpx 16rpx; color: var(--muted); font-size: 26rpx; font-weight: 500; }
.input, .textarea, .select-like {
  width: 100%;
  border: 0;
  border-radius: var(--radius-md);
  outline: 0;
  color: var(--ink);
  background: var(--bg);
  box-shadow: var(--neu-in);
}
.input, .select-like { min-height: 96rpx; padding: 0 32rpx; }
.textarea { min-height: 212rpx; padding: 28rpx 32rpx; resize: none; line-height: 1.55; }
.select-like { display: flex; align-items: center; justify-content: space-between; }
.input:focus, .textarea:focus { box-shadow: var(--neu-in), 0 0 0 4rpx var(--brand-soft), 0 0 0 8rpx var(--brand-glow); }
.input::placeholder, .textarea::placeholder { color: var(--faint); }

.chips { display: flex; flex-wrap: wrap; gap: 18rpx; }
.chip {
  border: 0;
  border-radius: var(--radius-full);
  padding: 16rpx 28rpx;
  color: var(--muted);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255,255,255,.45);
  font-size: 24rpx;
  font-weight: 500;
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.chip.active { color: var(--brand); background: var(--brand-soft); box-shadow: var(--neu-in); font-weight: 600; }
.chip:active { transform: scale(.96); }

.segmented {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255,255,255,.45);
  border-radius: var(--radius-md);
  background: rgba(255,255,255,.18);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,.40), 0 4rpx 16rpx rgba(0,0,0,.04);
}
.segment {
  flex: 1;
  border: 0;
  border-radius: var(--radius-sm);
  padding: 20rpx 10rpx;
  color: var(--muted);
  background: rgba(255,255,255,.35);
  box-shadow: var(--neu-out-sm);
  font-size: 24rpx;
  font-weight: 500;
}
.segment.active { color: var(--brand); background: var(--brand-soft); box-shadow: var(--neu-in); font-weight: 600; }

.timeline { position: relative; padding-left: 54rpx; }
.timeline::before { content: ""; position: absolute; left: 16rpx; top: 14rpx; bottom: 24rpx; width: 4rpx; background: var(--line); }
.timeline-item { position: relative; padding-bottom: 34rpx; }
.timeline-item::before {
  content: "";
  position: absolute;
  left: -48rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border: 6rpx solid var(--bg);
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 0 4rpx var(--brand);
}
.timeline-item.pending::before { background: var(--bg); box-shadow: 0 0 0 4rpx var(--faint); }
.timeline-item .tag-strong { display: block; font-size: 28rpx; }
.timeline-item .tag-span { display: block; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; }

.empty-state { padding: 72rpx 44rpx; text-align: center; }
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-md);
  font-size: 40rpx;
}
.empty-icon .design-svg-icon {
  width: 44rpx;
  height: 44rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.empty-state .tag-h3 { margin: 0; font-size: 32rpx; }
.empty-state .tag-p { margin: 16rpx 0 0; color: var(--muted); font-size: 26rpx; line-height: 1.55; }

.notice {
  margin-bottom: 26rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(212,148,76,.14);
  border-radius: var(--radius-sm);
  color: #77501F;
  background: rgba(245,230,208,.58);
  font-size: 24rpx;
  line-height: 1.55;
}
.notice.error { color: #8C392D; background: rgba(196,83,58,.08); border-color: rgba(196,83,58,.18); }
.notice.info { color: #315F74; background: rgba(90,143,173,.09); border-color: rgba(90,143,173,.18); }

.upload-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; }
.upload-tile {
  aspect-ratio: 1;
  border: 2rpx dashed var(--brand-soft);
  border-radius: var(--radius-md);
  display: grid;
  place-items: center;
  color: var(--brand);
  background: rgba(255,255,255,.28);
  box-shadow: var(--neu-out-sm);
  font-size: 44rpx;
}
.upload-tile .design-svg-icon,
.upload-icon .design-svg-icon {
  width: 48rpx;
  height: 48rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.upload-icon {
  display: inline-grid;
  place-items: center;
  color: var(--brand);
}
.upload-placeholder { background: rgba(255,255,255,.22); }
.upload-tile .tag-small,
.upload-tile > span:not(.upload-icon):last-child { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; }
.inline-icon,
.media-icon {
  display: inline-grid;
  place-items: center;
}
.inline-icon { margin-right: 12rpx; vertical-align: -6rpx; }
.inline-icon .design-svg-icon { width: 36rpx; height: 36rpx; }

.fixed-actions {
  position: absolute;
  z-index: 20;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  padding: 20rpx;
  display: flex;
  gap: 22rpx;
  border: 1rpx solid rgba(255,255,255,.45);
  border-radius: var(--radius-md);
  background: rgba(255,255,255,.24);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,.40), 0 4rpx 16rpx rgba(0,0,0,.04);
}

.btn {
  min-height: 96rpx;
  border: 0;
  border-radius: var(--radius-full);
  padding: 0 36rpx;
  font-weight: 600;
  font-size: 28rpx;
  transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--ease);
}
.btn.primary {
  flex: 1;
  color: #fff;
  background: var(--brand-gradient);
  box-shadow: inset 0 2rpx 2rpx rgba(255,255,255,.40), inset 0 -2rpx 2rpx rgba(0,0,0,.16), 0 4rpx 8rpx var(--brand-glow), 0 12rpx 28rpx var(--brand-glow);
}
.btn.secondary { color: var(--brand); background: var(--surface-strong); box-shadow: var(--neu-out-sm); }
.btn.danger { color: var(--danger); background: var(--surface-strong); box-shadow: var(--neu-out-sm); }
.btn.block { width: 100%; }
.btn:active { transform: scale(.96); box-shadow: var(--neu-in); }
.btn:disabled { cursor: default; opacity: .52; box-shadow: none; }

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--brand);
  background: var(--bg);
  box-shadow: var(--neu-in-deep);
  font: 700 32rpx/1 var(--font-display);
}

.media-placeholder {
  position: relative;
  min-height: 300rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255,255,255,.62);
  border-radius: var(--radius-md);
  display: grid;
  place-items: center;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: var(--neu-in);
  font-size: 48rpx;
}
.design-button.media-placeholder { width: 100%; }
.media-placeholder .design-svg-icon,
.media-visual .design-svg-icon {
  width: 56rpx;
  height: 56rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.media-visual { display: grid; place-items: center; color: var(--brand); }

.result-state { text-align: center; }
.result-state.success .result-icon { color: var(--success); }
.result-state.pending .result-icon { color: var(--warning); }
.result-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: var(--neu-in-deep);
}
.result-icon.success { color: var(--success); }
.result-icon.warning { color: var(--warning); }
.result-icon.danger { color: var(--danger); }
.result-icon .design-svg-icon {
  width: 44rpx;
  height: 44rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.chat-thread { display: flex; flex-direction: column; gap: 24rpx; }
.chat-thread > .card { margin-top: 0; }
.chat-message { display: flex; align-items: flex-end; gap: 18rpx; }
.chat-message.outgoing { justify-content: flex-end; }
.chat-message .avatar { flex: 0 0 68rpx; width: 68rpx; height: 68rpx; font-size: 26rpx; }
.chat-bubble {
  max-width: 82%;
  padding: 26rpx 30rpx;
  border: 2rpx solid rgba(255,255,255,.68);
  border-radius: var(--radius-md);
  background: var(--surface);
  box-shadow: var(--neu-out-sm);
}
.chat-bubble.incoming { align-self: flex-start; border-bottom-left-radius: 14rpx; }
.chat-bubble.outgoing { align-self: flex-end; border-bottom-right-radius: 14rpx; background: var(--brand-soft); }
.chat-bubble .card-copy { color: var(--ink); }
.chat-sender { margin-bottom: 8rpx; color: var(--muted); font-size: 22rpx; }
.chat-copy { color: var(--ink); font-size: 26rpx; line-height: 1.55; }
.chat-meta { margin-top: 10rpx; color: var(--muted); font-size: 22rpx; text-align: right; }
.chat-meta .design-svg-icon { width: 26rpx; height: 26rpx; vertical-align: -4rpx; }
.chat-composer { align-items: center; }
.chat-composer .input { min-width: 0; }
.chat-media-button { flex: 0 0 88rpx; width: 88rpx; min-height: 88rpx; padding: 0; }
.chat-send { flex: 0 0 auto !important; min-height: 88rpx; padding-inline: 32rpx; }

.service-glyph {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 16rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm);
}
.service-glyph .design-svg-icon {
  width: 40rpx;
  height: 40rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.map-visual { min-height: 380rpx; }
.video-visual { min-height: 440rpx; }
.product-visual { min-height: 420rpx; }
.play-icon .design-svg-icon { width: 64rpx; height: 64rpx; }
.media-label {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  color: var(--brand-dark);
  font: 700 28rpx/1 var(--font-nums);
}

.hero .grid-2 { position: relative; z-index: 1; margin-top: 28rpx; }
.amount { color: var(--brand-dark); font: 700 60rpx/1.1 var(--font-nums); font-variant-numeric: tabular-nums; }
.amount .tag-small { font-size: 30rpx; }
.divider { height: 1rpx; margin: 28rpx 0; background: var(--line); }
.spacer { height: 24rpx; }
.text-center { text-align: center; }
.avatar-centered { margin: 0 auto 24rpx; }
.grow { flex: 1; }
.send-wide { flex: 0 0 172rpx !important; }
.text-danger { color: var(--danger) !important; }
.text-success { color: var(--success) !important; }
.rating { color: var(--accent); white-space: nowrap; }




page { display: block; min-height: 100%; padding: 0; background: var(--canvas); }
.design-detail-page { width: 750rpx; min-height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
.design-detail-page .fixed-actions { position: fixed; padding-bottom: calc(44rpx + env(safe-area-inset-bottom)); }
.design-button { margin: 0; padding: 0; line-height: inherit; }
.design-select, .design-option { box-sizing: border-box; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
.icon-button .design-svg-icon { width: 40rpx; height: 40rpx; }
.icon-action .design-svg-icon { width: 38rpx; height: 38rpx; }
.row-icon .design-svg-icon { width: 36rpx; height: 36rpx; }
.empty-icon .design-svg-icon, .result-icon .design-svg-icon { width: 72rpx; height: 72rpx; }
.card { -webkit-backdrop-filter: blur(28rpx) saturate(135%); }
.map-caption { -webkit-backdrop-filter: blur(16rpx); }
.upload-tile { min-height: 190rpx; }
