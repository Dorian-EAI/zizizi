/* pages/worker-home/index.wxss — 师傅端接单大厅 像素级复刻 worker-home.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 师傅端覆盖 --brand 为 #2D6CDF（蓝），使 var(--brand) 全页解析为蓝色
 * Hero 使用 app.wxss .hero + .hero-worker（0.14 轻量渐变）
 * filter-tabs / filter-pill 使用 app.wxss 全局类 + .worker 蓝色变体
 */

/* ===== 师傅端品牌色覆盖（对齐 HTML :root --brand: #2D6CDF） ===== */
.page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
  --ring: #2D6CDF;
  --primary: #2D6CDF;

  position: relative;
  min-height: 100vh;
  /* 不设 overflow: hidden，避免 scroll-view 内容裁切 */
}

/* ===== 滚动容器 ===== */
.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* ===== HERO 内部布局（背景/圆角/光斑来自 app.wxss .hero.hero-worker） ===== */
/* HTML: padding max(38px, env) 24px 24px → 76rpx 48rpx 48rpx */
.hero {
  padding: 0 48rpx 48rpx;
}

.greeting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.greeting-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* HTML: h1 font-size:26px font-weight:800 letter-spacing:-0.02em line-height:1.2 */
.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-1);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

/* HTML: .subtitle font-size:14px margin-top:4px font-weight:500 */
.hero-sub {
  font-size: 28rpx;
  color: var(--text-2);
  margin-top: 8rpx;
  font-weight: 500;
}

/* ===== Hero 筛选按钮（圆形玻璃，HTML: 42px 圆） ===== */
.filter-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), background 0.2s var(--ease);
}
.filter-btn:active {
  transform: scale(0.85);
  background: rgba(255, 255, 255, 0.32);
}

/* HTML: svg 22px → 44rpx */
.filter-btn-icon {
  width: 44rpx;
  height: 44rpx;
}

/* ===== 区块标题（HTML: .section padding:0 20px margin-top:20px） ===== */
.section {
  position: relative;
  z-index: 2;
  padding: 0 40rpx;
  margin-top: 40rpx;
}

/* HTML: .section-title flex space-between margin-bottom:12px font-size:18px */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

/* HTML: .more font-size:13px font-weight:500 color:text-2 */
.section-more {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-2);
  transition: transform var(--dur-base) var(--spring);
}
.section-more:active {
  transform: scale(0.92);
}

/* ===== 订单列表（HTML: gap:12px → 24rpx） ===== */
.order-list {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 40rpx;
}

/* ===== 订单卡片（HTML: glass card padding:16px border-radius:var(--r)） ===== */
.order-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  padding: 32rpx;
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  transition: transform var(--dur-base) var(--ease), box-shadow 0.2s var(--ease);
  position: relative;
  overflow: hidden;
}
/* Rim Light 边缘高光（HTML ::after） */
.order-card::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}
.order-card:active {
  box-shadow: var(--neu-inset-lg);
  transform: scale(0.98);
}
/* 卡片内容在 Rim Light 之上 */
.order-card > view,
.order-card > text {
  position: relative;
  z-index: 1;
}

/* ===== 订单顶部（HTML: .order-top flex gap:12px margin-bottom:14px） ===== */
.order-top {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

/* 圆形新拟态图标容器（HTML: 44px 圆） */
.order-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--background);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  flex-shrink: 0;
}

/* HTML: svg 22px → 44rpx */
.order-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.order-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* HTML: .order-title-row flex gap:8px margin-bottom:6px */
.order-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

/* HTML: .order-title font-size:16px font-weight:700 */
.order-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

/* HTML: .order-tag font-size:10.5px padding:2px 7px border-radius:6px bg:red color:#fff */
.order-tag {
  font-size: 21rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: var(--red);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  line-height: 1.3;
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

/* HTML: .order-meta flex gap:5px font-size:12px color:text-3 */
.order-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* HTML: .order-meta svg 12px → 24rpx */
.meta-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.meta-text {
  font-size: 24rpx;
  color: var(--text-3);
}

/* HTML: .meta-dot 3px 圆 */
.meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--text-3);
  flex-shrink: 0;
}

/* ===== 订单底部（HTML: .order-bottom flex space-between） ===== */
.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

/* HTML: .order-price font-size:18px font-weight:700 color:accent letter-spacing:-0.02em */
.order-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: -0.02em;
}

/* ===== 立即报价按钮（HTML: .btn-neu-secondary 白底蓝字胶囊） ===== */
.quote-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-family: var(--font-body);
  box-shadow:
    var(--neu-raised),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65),
    inset 0 -2rpx 2rpx rgba(0, 0, 0, 0.03);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
  flex-shrink: 0;
}
.quote-btn:active {
  box-shadow: var(--neu-inset-lg);
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.78);
}

/* HTML: btn svg 14px → 28rpx */
.quote-btn-icon {
  width: 28rpx;
  height: 28rpx;
}

.quote-btn-text {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 600;
}

/* ===== 空态 ===== */
.empty {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 8rpx;
}

.empty-img {
  width: 72rpx;
  height: 72rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-2);
  font-weight: 500;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== 师傅端底部环境光晕（蓝+鼠尾草绿，覆盖全局客户端 teal） ===== */
.page::after {
  background:
    radial-gradient(ellipse 400rpx 280rpx at 20% 90%, rgba(45, 108, 223, 0.07) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 240rpx at 80% 85%, rgba(143, 169, 152, 0.06) 0%, transparent 70%),
    radial-gradient(ellipse 320rpx 200rpx at 50% 95%, rgba(90, 142, 232, 0.04) 0%, transparent 70%);
}
