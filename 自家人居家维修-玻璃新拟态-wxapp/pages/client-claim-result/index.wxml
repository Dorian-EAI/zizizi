<view class="phone-page design-detail-page" data-page-id="page-client-claim-result">
  <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" data-route="/pages/client-orders/index" bindtap="onNavigate"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">理赔结果</view><text class="tag-span"></text></view>
  <view class="page-body">
    <view class="hero" style="text-align:center"><view class="hero-kicker tag-p">CLAIM STATUS</view><view class="avatar state-{{tone}}" style="margin:0 auto 24rpx">{{tone === 'success' ? '✓' : (tone === 'danger' ? '×' : '审')}}</view><view class="tag-h2">{{titleText}}</view><view class="tag-p">{{description}}</view></view>
    <view class="section"><view class="card list-card">
      <view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%23D4944C%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22M8%209h8M8%2015h8M12%206v12%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">申请金额</view><view class="row-copy">金额来自服务端理赔记录</view></view><text class="amount tag-span"><text class="tag-small">¥</text>{{amountText}}</text></view>
      <view class="list-row" wx:if="{{found}}" bindtap="onViewOrder"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%225%22%20y%3D%223%22%20width%3D%2214%22%20height%3D%2218%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M9%207h6M9%2011h6M9%2015h4%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">关联订单</view><view class="row-copy">订单 {{orderId}}</view></view><text class="chevron tag-span">›</text></view>
      <view class="list-row"><text class="row-icon tag-span">态</text><view class="row-main"><view class="row-title">理赔状态</view><view class="row-copy">申请时间 {{createdAtText}}</view></view><text class="badge {{tone}} tag-span">{{statusText}}</text></view>
      <view class="list-row" wx:if="{{statusText === '已结算'}}"><text class="row-icon tag-span">赔</text><view class="row-main"><view class="row-title">结算金额</view></view><text class="row-value tag-span">¥{{settledAmountText}}</text></view>
    </view></view>
    <view class="notice info" wx:if="{{auditRemark}}">审核说明：{{auditRemark}}</view>
    <view class="notice">本页只按服务端真实理赔状态展示结果；缺少记录时不会显示“申请已提交”。</view>
    <view class="btn secondary block design-button" bindtap="loadClaim">刷新理赔状态</view>
  </view>
  <view class="fixed-actions"><view class="btn secondary design-button" data-route="/pages/client-customer-service/index" bindtap="onNavigate">咨询客服</view><view class="btn primary design-button" data-route="/pages/client-home/index" bindtap="onNavigate">返回首页</view></view>
</view>
