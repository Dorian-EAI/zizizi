/* pages/worker-location-report/index.wxss — 师傅端位置上报页 玻璃新拟态
 * 完整复用 app.wxss 全局组件类，不重复定义：
 *   .nav-bar.worker / .nav-icon-btn / .nav-icon / .nav-title / .nav-spacer
 *   .location-report-bar / .pulse
 *   .location-info-card / .loc-coord / .loc-update
 *   .location-actions (grid 2 列) / .btn-arrive (span 2)
 *   .blob / .press-neu / .page / .page-scroll
 * 本文件仅定义页面特有样式（订单信息卡、次级按钮、位置卡内部布局等）
 */

/* ===== 师傅端 brand token 覆盖（蓝色 #2D6CDF） ===== */
page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
}

/* ===== Pulse 暂停态（页面特有，app.wxss 仅定义活跃态） ===== */
.location-report-bar .pulse.paused {
  background: var(--text-3);
  box-shadow: 0 0 0 8rpx var(--fill);
  animation: none;
}

/* ===== Location Info Card 内部布局（app.wxss 仅提供容器 + .loc-coord/.loc-update 基础样式） ===== */
.location-info-card .loc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx; /* 14px */
}

.loc-title {
  font-size: 32rpx; /* 16px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

/* 坐标徽章：在 app.wxss .loc-coord 基础上补充 pill 外观 */
.location-info-card .loc-coord {
  font-weight: 600;
  color: var(--brand-worker);
  background: var(--brand-worker-subtle);
  padding: 8rpx 20rpx; /* 4px 10px */
  border-radius: var(--r-pill);
  border: 1rpx solid rgba(45, 108, 223, 0.15);
}

.loc-address-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx; /* 8px */
  margin-bottom: 24rpx; /* 12px */
}

.loc-address-icon {
  width: 36rpx; /* 18px */
  height: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx; /* 2px */
}

.loc-address {
  font-size: 30rpx; /* 15px */
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.45;
  flex: 1;
}

/* 在 app.wxss .loc-update 基础上补充 flex 布局（CSS 合并，不覆盖 margin-top/font-size/color） */
.location-info-card .loc-update {
  display: flex;
  align-items: center;
  gap: 12rpx; /* 6px */
}

.loc-update-icon {
  width: 30rpx; /* 15px */
  height: 30rpx;
  flex-shrink: 0;
}

/* ===== Order Info Card（页面特有，不在 app.wxss 中） ===== */
.order-info-card {
  margin: 32rpx 40rpx 0; /* 与 app.wxss 位置组件一致的左右边距 */
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-lg);
  box-shadow: var(--neu-raised), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(45, 108, 223, 0.04), var(--shadow-card-ring);
  position: relative;
  overflow: hidden;
  padding: 36rpx; /* 18px */
}

.card-title {
  font-size: 32rpx; /* 16px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 28rpx; /* 14px */
  display: block;
}

.order-info-list {
  display: flex;
  flex-direction: column;
}

.order-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0; /* 11px */
  border-bottom: 1rpx solid var(--sep); /* 0.5px */
}

.order-info-row:last-of-type {
  border-bottom: none;
}

.order-info-label {
  display: inline-flex;
  align-items: center;
  gap: 12rpx; /* 6px */
  font-size: 27rpx; /* 13.5px */
  color: var(--text-2);
  font-weight: 500;
  flex-shrink: 0;
}

.order-info-ic {
  width: 30rpx; /* 15px */
  height: 30rpx;
  flex-shrink: 0;
}

.order-info-value {
  font-size: 27rpx; /* 13.5px */
  color: var(--text-1);
  font-weight: 600;
  text-align: right;
  max-width: 60%;
  line-height: 1.4;
}

/* ===== 次级按钮（页面特有，app.wxss 仅定义 .btn-arrive 主按钮） ===== */
.location-actions .btn-loc-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx; /* 6px */
  height: 96rpx; /* 48px */
  background: var(--bg-elevated);
  color: var(--brand-worker);
  border: 1rpx solid rgba(255, 255, 255, 0.60); /* 0.5px */
  border-radius: var(--r-pill);
  font-size: 28rpx; /* 14px */
  font-weight: 600;
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.location-actions .btn-loc-secondary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

.btn-loc-secondary-icon {
  width: 36rpx; /* 18px */
  height: 36rpx;
}

/* ===== btn-arrive 内部布局（在 app.wxss 基础上补充 flex 居中，CSS 合并） ===== */
.location-actions .btn-arrive {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx; /* 6px */
}

.btn-arrive-icon {
  width: 38rpx; /* 19px */
  height: 38rpx;
}

/* ===== 提示文字（页面特有，跨 grid 2 列） ===== */
.location-note {
  grid-column: span 2;
  text-align: center;
  font-size: 24rpx; /* 12px */
  color: var(--text-2);
  font-weight: 500;
  line-height: 1.5;
  margin-top: 8rpx; /* 4px */
  display: block;
}
