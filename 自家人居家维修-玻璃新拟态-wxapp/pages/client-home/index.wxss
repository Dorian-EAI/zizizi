/* pages/client-home/index.wxss — 像素级复刻 client-home-glass-neu-contrast-1.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

/* ===== 页面局部令牌（HTML 参考 :root 中的 surface/preset 值） ===== */
.page {
  --surface-1: rgba(255, 255, 255, 0.50);
  --surface-2: rgba(255, 255, 255, 0.45);
  --border-glass: 1rpx solid rgba(255, 255, 255, 0.60);
  --border-glass-soft: 1rpx solid rgba(255, 255, 255, 0.45);
  /* HTML icon-raise: 5px 5px 10px → 10rpx 10rpx 20rpx */
  --icon-raise: 10rpx 10rpx 20rpx var(--neu-dark), -10rpx -10rpx 20rpx var(--neu-light);
  /* HTML neu-out-sm: 6px 6px 14px → 12rpx 12rpx 28rpx（与 app.wxss --neu-raised-sm 一致）*/
  /* HTML neu-out-md: 8px 8px 18px → 16rpx 16rpx 36rpx（与 app.wxss --neu-raised 一致）*/
  /* HTML neu-in: inset 4px 4px 8px → inset 8rpx 8rpx 16rpx（与 app.wxss --neu-inset 一致）*/

  position: relative;
  min-height: 100vh;
  background: var(--phone-bg, #F2EDE8);
}

/* ===== 滚动容器 ===== */
.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* ===== 固定标题栏（滚动变形） ===== */
/* HTML: position:fixed; top:0; height:88px; padding-top:44px; */
.title-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(env(safe-area-inset-top) + 88rpx);
  padding-top: env(safe-area-inset-top);
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(242, 237, 232, 0);
  backdrop-filter: blur(0);
  -webkit-backdrop-filter: blur(0);
  opacity: 0;
  z-index: 100;
  pointer-events: none;
  transition: background 0.3s ease, backdrop-filter 0.3s ease, -webkit-backdrop-filter 0.3s ease, opacity 0.25s ease;
}

.title-bar.visible {
  background: rgba(242, 237, 232, 0.92);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  opacity: 1;
  pointer-events: auto;
}

.title-bar.search-mode {
  background: rgba(242, 237, 232, 0.95);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
}

/* 标题名 */
.title-bar__name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  opacity: 1;
  transform: translateX(0);
  transition: opacity 0.2s ease, transform 0.25s ease;
}

.title-bar.search-mode .title-bar__name {
  opacity: 0;
  transform: translateX(-20rpx);
}

/* 标题栏搜索框 */
.title-bar__search {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: calc(env(safe-area-inset-top) + 44rpx);
  transform: translateY(-50%) scaleX(0.88);
  opacity: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 36rpx;
  box-shadow: var(--neu-raised-sm);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  color: var(--text-3);
  font-size: 26rpx;
  transition: opacity 0.25s ease, transform 0.3s var(--ease);
}

.title-bar.search-mode .title-bar__search {
  opacity: 1;
  transform: translateY(-50%) scaleX(1);
}

.title-bar__search-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.title-bar__search-text {
  font-size: 26rpx;
  color: var(--text-3);
}

/* ===== HERO 区域（轻量渐变 0.14） ===== */
/* HTML: padding:14px 24px 24px; border-radius:0 0 32px 32px; */
.hero {
  padding: 28rpx 48rpx 48rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 440rpx 360rpx at 75% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 20% 80%, rgba(13, 148, 136, 0.14) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.16) 0%, rgba(212, 148, 76, 0.10) 50%, rgba(13, 148, 136, 0.06) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

/* Hero 子元素确保在光斑之上 */
.hero > view,
.hero > text {
  position: relative;
  z-index: 1;
}

/* ===== 状态栏 ===== */
/* HTML: margin-bottom:16px; font-size:13px; */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.status-time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.status-icons {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-icon-img {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 问候语 ===== */
/* HTML: font-size:14px; margin-bottom:4px; */
.greeting {
  font-size: 28rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
  transition: opacity 0.25s ease, transform 0.3s ease;
}

/* ===== 应用名 ===== */
/* HTML: font-size:26px; margin-bottom:18px; letter-spacing:-.3px; */
.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 36rpx;
  letter-spacing: -0.02em;
  transition: opacity 0.25s ease, transform 0.3s ease;
}

/* ===== 玻璃搜索栏 ===== */
/* HTML: gap:10px; border-radius:28px; padding:12px 18px; margin-bottom:16px; */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface-2);
  backdrop-filter: blur(20px) saturate(150%);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  border: var(--border-glass);
  border-radius: 56rpx;
  padding: 24rpx 36rpx;
  margin-bottom: 32rpx;
  color: var(--text-3);
  font-size: 28rpx;
  transition: transform 0.2s var(--spring), opacity 0.25s ease;
}

.search-bar:active {
  transform: scale(0.97);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.search-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* ===== 统计卡片（3 列网格） ===== */
/* HTML: gap:12px; */
.stats {
  display: flex;
  gap: 24rpx;
}

/* HTML: padding:14px 8px; border-radius:20px; box-shadow:var(--neu-out-sm); */
.stat-card {
  flex: 1;
  background: var(--surface-2);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  border: var(--border-glass-soft);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  padding: 28rpx 16rpx;
  text-align: center;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.stat-card:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
}

/* HTML: font-size:18px; margin-bottom:3px; */
.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  font-family: var(--font-number);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* HTML: font-size:11px; */
.stat-label {
  font-size: 22rpx;
  color: var(--text-2);
}

/* 3 卡片分别着色 */
.stat-card:nth-child(1) .stat-value { color: var(--brand); }
.stat-card:nth-child(2) .stat-value { color: var(--accent); }
.stat-card:nth-child(3) .stat-value { color: var(--text-1); }

/* ===== 区块标题 ===== */
/* HTML: font-size:18px; padding:10px 24px 7px; */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  padding: 20rpx 48rpx 14rpx;
  letter-spacing: -0.01em;
}

/* ===== 服务网格 ===== */
/* HTML: grid-template-columns:repeat(3,101px); gap:11px; padding:11px 24px; */
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 202rpx);
  gap: 22rpx;
  justify-content: center;
  padding: 22rpx 48rpx;
}

/* HTML: width:101px; height:90px; border-radius:22px; padding:8px 6px; gap:8px; */
.service-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 202rpx;
  height: 180rpx;
  background: var(--surface-1);
  backdrop-filter: blur(20px) saturate(150%);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 44rpx;
  box-shadow: var(--neu-raised), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65);
  padding: 16rpx 12rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.service-card:active {
  transform: scale(0.95);
  box-shadow: var(--neu-inset);
}

/* HTML: width:48px; height:48px; box-shadow:var(--icon-raise); */
.icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg);
  box-shadow: var(--icon-raise), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow 0.2s var(--ease), transform 0.2s var(--spring);
}

.service-card:active .icon-circle {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* HTML: width:22px; height:22px; */
.service-icon {
  width: 44rpx;
  height: 44rpx;
}

/* HTML: font-size:12px; */
.service-name {
  font-size: 24rpx;
  color: var(--text-1);
  font-weight: 600;
  white-space: nowrap;
}

/* ===== AI 智能助手卡片（加重渐变 0.32） ===== */
/* HTML: margin:14px 24px 0; padding:16px; gap:14px; border-radius:24px; */
.ai-card {
  margin: 28rpx 48rpx 0;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  border-radius: 48rpx;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 75% 40%, rgba(212, 148, 76, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 20% 80%, rgba(13, 148, 136, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.28) 0%, rgba(212, 148, 76, 0.20) 50%, rgba(20, 184, 166, 0.12) 100%);
  box-shadow: var(--neu-raised), 0 16rpx 56rpx rgba(13, 148, 136, 0.12);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.ai-card:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset);
}

/* HTML: width:50px; height:50px; border-radius:14px; */
.ai-icon {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 50%, var(--accent) 100%);
  box-shadow: var(--neu-raised-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* HTML: width:24px; height:24px; */
.ai-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.ai-text {
  flex: 1;
  min-width: 0;
}

/* HTML: font-size:16px; margin-bottom:3px; */
.ai-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 6rpx;
  letter-spacing: -0.01em;
}

/* HTML: font-size:12px; */
.ai-desc {
  font-size: 24rpx;
  color: var(--text-2);
}

/* HTML btn-neu-primary: padding:8px 18px; font-size:13px; border-radius:9999px; */
.ai-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 9999rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.55);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease), background 0.2s var(--ease);
  flex-shrink: 0;
}

.ai-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
  background: var(--brand-subtle);
}

/* ===== 分类筛选 Chips ===== */
/* HTML: gap:8px; padding:10px 24px 11px; */
.chips-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 20rpx 48rpx 22rpx;
  white-space: nowrap;
}

/* HTML: padding:8px 18px; font-size:13px; border-radius:9999px; */
.chip {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  font-family: var(--font-body);
  background: var(--bg-elevated);
  color: var(--text-2);
  box-shadow: var(--neu-raised-sm);
}

.chip:active {
  transform: scale(0.94);
  box-shadow: var(--neu-inset);
}

/* HTML .chip-active */
.chip-active {
  background: var(--brand-subtle);
  color: var(--brand);
  box-shadow: var(--neu-inset), 0 0 0 1rpx var(--brand-subtle);
}

/* ===== 推荐师傅卡片 ===== */
/* HTML: gap:14px; margin:0 24px 14px; border-radius:20px; padding:14px; */
.recommend-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 0 48rpx 28rpx;
  background: var(--surface-1);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  border: var(--border-glass-soft);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  padding: 28rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.recommend-card:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset);
}

/* HTML: width:52px; height:52px; */
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.28) 40%, var(--brand-subtle) 78%, rgba(255, 255, 255, 0.18) 100%);
  backdrop-filter: blur(10px) saturate(160%);
  -webkit-backdrop-filter: blur(10px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88), inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04), var(--icon-raise);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0.12) 35%, transparent 60%);
  pointer-events: none;
}

.avatar-img {
  width: 52rpx;
  height: 52rpx;
  position: relative;
  z-index: 1;
}

.recommend-info {
  flex: 1;
  min-width: 0;
}

/* HTML: font-size:15px; margin-bottom:2px; */
.recommend-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 4rpx;
}

/* HTML: font-size:12px; */
.recommend-sub {
  font-size: 24rpx;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* HTML: font-size:18px; color:var(--accent); */
.recommend-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
  white-space: nowrap;
  font-family: var(--font-number);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* ===== 推荐服务横滑区 ===== */
/* HTML: gap:12px; padding:0 24px 8px; */
.rec-scroll {
  display: flex;
  gap: 24rpx;
  overflow-x: auto;
  padding: 0 48rpx 16rpx;
  white-space: nowrap;
}

/* HTML: width:180px; border-radius:20px; padding:10px; */
.rec-card {
  flex-shrink: 0;
  width: 360rpx;
  background: var(--surface-1);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  border: var(--border-glass-soft);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  overflow: hidden;
  padding: 20rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.rec-card:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
}

/* HTML: height:100px; border-radius:14px; margin-bottom:10px; */
.rec-img {
  width: 100%;
  height: 200rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: inset 4rpx 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

/* HTML: font-size:14px; */
.rec-img-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-inverse);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
  position: relative;
  z-index: 2;
  letter-spacing: 0.02em;
}

/* HTML: font-size:14px; margin-bottom:4px; */
.rec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}

/* HTML: gap:6px; font-size:11px; margin-bottom:10px; */
.rec-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
}

/* HTML: gap:3px; color:var(--orange); */
.rec-star {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: var(--orange);
  font-weight: 600;
}

.rec-star-icon {
  width: 24rpx;
  height: 24rpx;
}

.rec-star-num {
  font-size: 22rpx;
  color: var(--orange);
  font-weight: 600;
}

.rec-count {
  color: var(--text-3);
}

.rec-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* HTML: gap:1px; */
.rec-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

/* HTML: font-size:12px; color:var(--red); */
.rec-currency {
  font-size: 24rpx;
  color: var(--red);
  font-weight: 600;
}

/* HTML: font-size:19px; color:var(--red); */
.rec-amount {
  font-size: 38rpx;
  color: var(--red);
  font-weight: 700;
  letter-spacing: -0.02em;
}

/* 预约按钮 — 复用 btn-neu-primary 样式 */
.rec-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 9999rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.55);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease), background 0.2s var(--ease);
}

.rec-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
  background: var(--brand-subtle);
}

/* ===== Hero 滚动渐隐动效（忠于 HTML .phone.scrolled / .scrolled-2） ===== */
.hero .greeting,
.hero .app-name,
.hero .search-bar {
  transition: opacity 0.25s ease, transform 0.3s ease;
}

/* y > 20: greeting 渐隐 */
.page.scrolled .hero .greeting {
  opacity: 0;
  transform: translateY(-24rpx);
}

/* y > 60: app-name, search-bar, stats 渐隐 */
.page.scrolled-2 .hero .app-name {
  opacity: 0;
  transform: translateY(-16rpx);
}

.page.scrolled-2 .hero .search-bar {
  opacity: 0;
  transform: translateY(-32rpx) scale(0.96);
  pointer-events: none;
}
