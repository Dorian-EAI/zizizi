<view class="phone-page design-detail-page" data-page-id="page-client-payment-result">
  <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● WiFi 100%</text></view>
  <view class="topbar"><text class="tag-span"></text><view class="tag-h1">支付结果</view><text class="tag-span"></text></view>
  <view class="page-body">
    <view class="hero" style="text-align:center">
      <view class="hero-kicker tag-p">{{kicker}}</view>
      <view class="avatar state-{{statusTone}}" style="margin:0 auto 24rpx">{{iconText}}</view>
      <view class="tag-h2">{{titleText}}</view>
      <view class="hero-number">¥ {{amountText}}</view>
      <view class="tag-p">{{description}}</view>
    </view>
    <view class="section-title"><text class="tag-strong">交易状态</text><text class="badge {{statusTone}} tag-span">{{statusText}}</text></view>
    <view class="section"><view class="card list-card">
      <view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%235B8C5A%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%225%22%20y%3D%223%22%20width%3D%2214%22%20height%3D%2218%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M9%207h6M9%2011h6M9%2015h4%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">支付单号</view></view><text class="row-value tag-span">{{paymentNo || '未提供'}}</text></view>
      <view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%225%22%20width%3D%2218%22%20height%3D%2214%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M3%209h18M7%2015h3%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">支付方式</view></view><text class="row-value tag-span">微信支付</text></view>
      <view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22M12%207v5l3%202%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">支付时间</view></view><text class="row-value tag-span">{{paidAtText}}</text></view>
    </view></view>
    <view class="notice info">只有服务端支付单状态为 paid 时，本页才会展示“支付成功”；微信客户端返回不作为到账凭证。</view>
    <view class="btn secondary block design-button {{checking || !paymentNo ? 'is-disabled' : ''}}" bindtap="onRefresh">{{checking ? '查询中…' : '刷新服务端结果'}}</view>
  </view>
  <view class="fixed-actions"><view class="btn secondary design-button" bindtap="onViewContext">{{scene === 'recharge' ? '返回钱包' : '查看订单'}}</view><view class="btn primary design-button" data-route="/pages/client-home/index" bindtap="onNavigate">返回首页</view></view>
</view>
