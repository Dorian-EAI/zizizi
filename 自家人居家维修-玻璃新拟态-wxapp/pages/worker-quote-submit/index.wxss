/* pages/worker-quote-submit/index.wxss — 师傅报价提交页 玻璃新拟态
 * 像素级复刻 worker-quote-submit.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

/* ===== 师傅端 brand token 覆盖（蓝色 #2D6CDF） ===== */
page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== Top Nav Bar (sticky) ===== */
/* HTML: 渐变背景（蓝-鼠尾草） + border-radius:0 0 28px 28px */
.nav-bar {
  background:
    radial-gradient(ellipse 220px 160px at 78% 45%, rgba(212,148,76,.10) 0%, transparent 70%),
    radial-gradient(ellipse 180px 140px at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(212,148,76,.04) 50%, rgba(45, 108, 223, 0.06) 100%);
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx;       /* 18px 20px；top 由内联 style 动态提供 */
  border-radius: 0 0 56rpx 56rpx; /* 28px */
  overflow: hidden;
}

/* HTML: 44px×44px; border-radius:50%; background:var(--bg-elevated) */
.nav-icon-btn {
  width: 88rpx;        /* 44px */
  height: 88rpx;       /* 44px */
  border-radius: 50%;
  background: var(--bg-elevated);
  border: none;
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.nav-icon-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* HTML: svg 22px×22px */
.nav-icon {
  width: 44rpx;        /* 22px */
  height: 44rpx;       /* 22px */
}

/* HTML: font-size:17px; font-weight:700; letter-spacing:-0.02em */
.nav-title {
  font-size: 34rpx;    /* 17px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

/* HTML: 44px×44px */
.nav-placeholder {
  width: 88rpx;        /* 44px */
  height: 88rpx;       /* 44px */
  flex-shrink: 0;
}

/* ===== Sections ===== */
/* HTML: padding:0 20px; margin-top:16px */
.section {
  padding: 0 40rpx;     /* 20px */
  margin-top: 32rpx;    /* 16px */
  position: relative;
  z-index: 2;
}

/* HTML: .section:first-of-type margin-top:18px */
.section:first-of-type {
  margin-top: 36rpx;    /* 18px */
}

/* ===== Glass + Neumorphic Card（覆盖全局为蓝色辉光） ===== */
/* HTML: rgba(255,255,255,0.52); backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,0.70) */
.glass-neu-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-lg);
  box-shadow: var(--neu-raised), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(45, 108, 223, 0.04), var(--shadow-card-ring);
  position: relative;
  overflow: hidden;
}

/* HTML: .glass-neu-card::before 渐变高光（Rim Light） */
.glass-neu-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

/* 卡片内容确保在 Rim Light 之上 */
.glass-neu-card > view,
.glass-neu-card > text {
  position: relative;
  z-index: 1;
}

/* ===== Mono / Tabular nums ===== */
.mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* ===== Card Title ===== */
/* HTML: font-size:16px; font-weight:700; margin-bottom:14px */
.card-title {
  font-size: 32rpx;     /* 16px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 28rpx; /* 14px */
  display: block;
}

/* ===== Order Summary Card (compact, read-only) ===== */
/* HTML: padding:16px 18px */
.summary-card {
  padding: 32rpx 36rpx; /* 16px 18px */
}

/* HTML: flex-direction:column; gap:0 */
.summary-list {
  display: flex;
  flex-direction: column;
}

/* HTML: justify-content:space-between; padding:9px 0; border-bottom:0.5px */
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;     /* 9px */
  border-bottom: 1rpx solid var(--sep); /* 0.5px */
}

.summary-row:last-of-type {
  border-bottom: none;
}

/* HTML: inline-flex; gap:6px; font-size:13px; color:var(--text-2) */
.summary-label {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;           /* 6px */
  font-size: 26rpx;     /* 13px */
  color: var(--text-2);
  font-weight: 500;
  flex-shrink: 0;
}

/* HTML: svg 14px×14px; color:var(--text-3) */
.summary-ic {
  width: 28rpx;         /* 14px */
  height: 28rpx;        /* 14px */
  flex-shrink: 0;
}

/* HTML: font-size:13px; color:var(--text-1); font-weight:600; max-width:62% */
.summary-value {
  font-size: 26rpx;     /* 13px */
  color: var(--text-1);
  font-weight: 600;
  text-align: right;
  max-width: 62%;
  line-height: 1.4;
}

/* HTML: margin-top:10px; padding:11px 13px; background:var(--fill); border-radius:var(--r-sm) */
.summary-desc {
  margin-top: 20rpx;    /* 10px */
  padding: 22rpx 26rpx; /* 11px 13px */
  background: var(--fill);
  border-radius: var(--r-sm);
  border: 1rpx solid var(--sep); /* 0.5px */
}

/* HTML: font-size:11px; margin-bottom:4px; letter-spacing:0.02em */
.summary-desc-label {
  font-size: 22rpx;     /* 11px */
  color: var(--text-2);
  font-weight: 600;
  margin-bottom: 8rpx;  /* 4px */
  letter-spacing: 0.02em;
  display: block;
}

/* HTML: font-size:12.5px; line-height:1.5; font-weight:500 */
.summary-desc-text {
  font-size: 25rpx;     /* 12.5px */
  color: var(--text-1);
  line-height: 1.5;
  font-weight: 500;
  display: block;
}

/* ===== Quote Amount Input Card ===== */
/* HTML: padding:18px */
.amount-card {
  padding: 36rpx;       /* 18px */
}

/* HTML: font-size:13.5px; color:var(--text-2); margin-bottom:4px; letter-spacing:-0.01em */
.amount-label {
  font-size: 27rpx;     /* 13.5px */
  color: var(--text-2);
  font-weight: 600;
  margin-bottom: 8rpx;  /* 4px */
  letter-spacing: -0.01em;
  display: block;
}

/* HTML: display:flex; align-items:baseline; gap:6px; padding:6px 2px 2px */
.amount-field {
  display: flex;
  align-items: baseline;
  gap: 12rpx;           /* 6px */
  padding: 12rpx 4rpx 4rpx; /* 6px 2px 2px */
}

/* HTML: font-size:38px; font-weight:800; color:var(--brand); line-height:1 */
.amount-symbol {
  font-size: 76rpx;     /* 38px */
  font-weight: 800;
  color: var(--brand);
  line-height: 1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  font-family: var(--font-number);
}

/* HTML: flex:1; font-size:48px; font-weight:800; color:var(--brand); line-height:1.1 */
.amount-input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--font-number);
  font-size: 96rpx;     /* 48px */
  font-weight: 800;
  color: var(--brand);
  text-align: left;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
  padding: 0;
}

/* HTML: ::placeholder color:var(--text-3); font-weight:700; opacity:0.7 */
.amount-placeholder {
  color: var(--text-3);
  font-weight: 700;
  opacity: 0.7;
}

/* HTML: height:0.5px; margin:6px 0 14px */
.amount-divider {
  height: 1rpx;         /* 0.5px */
  background: var(--sep);
  margin: 12rpx 0 28rpx; /* 6px 0 14px */
}

/* HTML: display:flex; gap:8px */
.amount-quick {
  display: flex;
  gap: 16rpx;           /* 8px */
}

/* HTML: flex:1; height:36px; background:var(--bg-elevated); color:var(--text-2); font-size:13px; border:0.5px; border-radius:var(--r-pill) */
.quick-chip {
  flex: 1;
  min-width: 0;
  height: 72rpx;        /* 36px */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  color: var(--text-2);
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
  font-family: var(--font-body);
  border: 1rpx solid rgba(255, 255, 255, 0.60); /* 0.5px */
  border-radius: var(--r-pill);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), color var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
}

.quick-chip:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.95);
}

/* HTML: background:var(--brand); color:var(--text-inverse); box-shadow:var(--neu-in) */
.quick-chip.is-active {
  background: var(--brand);
  color: var(--text-inverse);
  box-shadow: var(--neu-inset), inset 0 0 0 2rpx rgba(45, 108, 223, 0.30); /* 1px */
}

/* ===== Form Card ===== */
/* HTML: padding:18px */
.form-card {
  padding: 36rpx;       /* 18px */
}

/* HTML: flex-direction:column; gap:8px; margin-bottom:16px */
.form-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;           /* 8px */
  margin-bottom: 32rpx; /* 16px */
}

.form-row:last-child {
  margin-bottom: 0;
}

/* HTML: font-size:13.5px; color:var(--text-2); font-weight:600; letter-spacing:-0.01em */
.form-label {
  font-size: 27rpx;     /* 13.5px */
  color: var(--text-2);
  font-weight: 600;
  letter-spacing: -0.01em;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;           /* 6px */
}

/* HTML: font-size:11px; color:var(--text-3); background:var(--fill); padding:1px 6px; border:0.5px */
.form-label-opt {
  font-size: 22rpx;     /* 11px */
  color: var(--text-3);
  font-weight: 500;
  background: var(--fill);
  padding: 2rpx 12rpx;  /* 1px 6px */
  border-radius: var(--r-pill);
  border: 1rpx solid var(--sep); /* 0.5px */
}

/* ===== Neumorphic Inset Input（覆盖全局 .neu-input） ===== */
/* HTML: width:100%; display:flex; align-items:center; gap:8px; background:var(--bg); border-radius:var(--r); box-shadow:var(--neu-in); padding:12px 14px */
.neu-input {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;           /* 8px */
  background: var(--bg);
  border: none;
  border-radius: var(--r-md); /* --r = 1.2rem */
  box-shadow: var(--neu-inset);
  padding: 24rpx 28rpx; /* 12px 14px */
  transition: box-shadow var(--dur-base) var(--ease);
}

/* HTML: .neu-input:focus-within box-shadow:var(--neu-in),0 0 0 3px var(--brand-subtle) */
.neu-input.focus {
  box-shadow: var(--neu-inset), 0 0 0 6rpx var(--brand-subtle); /* 3px */
}

/* HTML: input/textarea flex:1; border:none; background:transparent; font-size:15px; color:var(--text-1); font-weight:500 */
.neu-input-el {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--font-body);
  font-size: 30rpx;     /* 15px */
  color: var(--text-1);
  font-weight: 500;
  padding: 0;
  line-height: 1.4;
}

.neu-input-ph {
  color: var(--text-3);
  font-weight: 400;
}

/* HTML: font-size:15px; color:var(--brand); font-weight:700 */
.neu-input-prefix {
  font-size: 30rpx;     /* 15px */
  color: var(--brand);
  font-weight: 700;
  flex-shrink: 0;
  font-family: var(--font-number);
}

/* HTML: svg 20px×20px; color:var(--text-3) */
.neu-input-suffix-ic {
  width: 40rpx;         /* 20px */
  height: 40rpx;        /* 20px */
  flex-shrink: 0;
}

/* Textarea variant: HTML: align-items:flex-start; textarea min-height:90px; line-height:1.55 */
.neu-input.neu-input-area {
  align-items: flex-start;
}

.neu-input-textarea {
  resize: none;
  min-height: 180rpx;   /* 90px */
  line-height: 1.55;
  width: 100%;
}

/* ===== Duration Chips ===== */
/* HTML: display:flex; gap:8px */
.duration-group {
  display: flex;
  gap: 16rpx;           /* 8px */
}

/* HTML: flex:1; height:42px; background:var(--bg-elevated); color:var(--text-2); font-size:13.5px; border:0.5px; border-radius:var(--r) */
.dur-chip {
  flex: 1;
  height: 84rpx;        /* 42px */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  color: var(--text-2);
  font-size: 27rpx;     /* 13.5px */
  font-weight: 600;
  font-family: var(--font-body);
  border: 1rpx solid rgba(255, 255, 255, 0.60); /* 0.5px */
  border-radius: var(--r-md); /* --r = 1.2rem */
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), color var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
}

.dur-chip:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

/* HTML: background:var(--brand); color:var(--text-inverse); box-shadow:var(--neu-in) */
.dur-chip.is-active {
  background: var(--brand);
  color: var(--text-inverse);
  box-shadow: var(--neu-inset), inset 0 0 0 2rpx rgba(45, 108, 223, 0.35); /* 1px */
}

/* ===== Quote Hint Card (light tinted) ===== */
/* HTML: padding:14px 16px; background:rgba(45,108,223,0.07); border-color:rgba(45,108,223,0.16); display:flex; align-items:flex-start; gap:10px */
.hint-card {
  padding: 28rpx 32rpx; /* 14px 16px */
  background: rgba(45, 108, 223, 0.07);
  border-color: rgba(45, 108, 223, 0.16);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;           /* 10px */
}

/* HTML: 26px×26px; border-radius:50%; background:var(--brand); color:var(--text-inverse) */
.hint-ic {
  width: 52rpx;         /* 26px */
  height: 52rpx;        /* 26px */
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--brand);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx var(--brand-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.30); /* 2px 8px / 1px 1px */
}

/* HTML: svg 15px×15px */
.hint-ic-img {
  width: 30rpx;         /* 15px */
  height: 30rpx;        /* 15px */
}

/* HTML: font-size:12.5px; line-height:1.55; font-weight:500; flex:1; padding-top:2px */
.hint-text {
  display: block;
  flex: 1;
  font-size: 25rpx;     /* 12.5px */
  color: var(--text-1);
  line-height: 1.55;
  font-weight: 500;
  padding-top: 4rpx;    /* 2px */
}

/* HTML: .hi-strong color:var(--brand); font-weight:700 */
.hi-strong {
  color: var(--brand);
  font-weight: 700;
}

/* HTML: .hi-net color:var(--brand); font-weight:800; font-size:14px; tabular-nums */
.hi-net {
  color: var(--brand);
  font-weight: 800;
  font-size: 28rpx;     /* 14px */
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
  font-family: var(--font-number);
}

/* ===== Bottom Fixed Action Bar ===== */
/* HTML: position:fixed; bottom:0; width:100%; display:flex; gap:12px; padding:14px 20px; padding-bottom:max(14px,env(safe-area-inset-bottom)); background:rgba(242,237,232,0.88); backdrop-filter:blur(20px); border-top:0.5px */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 24rpx;           /* 12px */
  padding: 28rpx 40rpx; /* 14px 20px */
  padding-bottom: max(28rpx, env(safe-area-inset-bottom)); /* 14px + safe area */
  background: rgba(242, 237, 232, 0.88);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.55); /* 0.5px */
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.05); /* 0 -4px 20px */
}

/* HTML: height:48px; flex:0 0 38%; background:var(--bg-elevated); color:var(--text-1); border:0.5px; border-radius:var(--r-pill); font-size:14px; gap:6px */
.action-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;           /* 6px */
  height: 96rpx;        /* 48px */
  flex: 0 0 38%;
  background: var(--bg-elevated);
  color: var(--text-1);
  border: 1rpx solid rgba(255, 255, 255, 0.60); /* 0.5px */
  border-radius: var(--r-pill);
  font-size: 28rpx;     /* 14px */
  font-weight: 600;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.action-btn-secondary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

/* HTML: svg 18px×18px; color:var(--text-2) */
.action-btn-secondary-icon {
  width: 36rpx;         /* 18px */
  height: 36rpx;        /* 18px */
}

/* HTML: height:48px; flex:1; background:var(--brand-gradient); color:var(--text-inverse); border-radius:var(--r-pill); font-size:15px; gap:6px */
.action-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;           /* 6px */
  height: 96rpx;        /* 48px */
  flex: 1;
  background: var(--brand-worker-gradient);
  color: var(--text-inverse);
  border: none;
  border-radius: var(--r-pill);
  font-size: 30rpx;     /* 15px */
  font-weight: 700;
  font-family: var(--font-body);
  letter-spacing: 0.02em;
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx var(--brand-glow); /* 0 4px 14px */
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.action-btn-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

.action-btn-primary.disabled {
  opacity: 0.6;
}

/* HTML: svg 19px×19px */
.action-btn-primary-icon {
  width: 38rpx;         /* 19px */
  height: 38rpx;        /* 19px */
}
