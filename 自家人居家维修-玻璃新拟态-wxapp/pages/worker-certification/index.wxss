/* pages/worker-certification/index.wxss — 师傅资质认证 玻璃新拟态
 * 像素级复刻 worker-certification.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

/* ===== 师傅端品牌色覆盖（蓝色 #2D6CDF） ===== */
page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
  --accent: #D4944C;
  --accent-light: #F5E6D0;
  --accent-glow: rgba(212, 148, 76, 0.25);
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== Back Bar (sticky) — 复用全局 .back-bar.worker ===== */
/* HTML: padding: max(16px, env(safe-area-inset-top)) 24px 12px; border-radius:0 0 28px 28px */
.back-bar.worker {
  padding: 0 48rpx 24rpx;
  /* padding-top 由内联 style 动态提供（statusBarHeight + 32rpx） */
  border-radius: 0 0 56rpx 56rpx;
}

/* HTML: back-btn 36x36 圆形玻璃 + neu-out-sm + brand 色 */
.back-btn {
  width: 72rpx;          /* 36px */
  height: 72rpx;         /* 36px */
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(32rpx) saturate(160%);
  -webkit-backdrop-filter: blur(32rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.back-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.9);
}
/* HTML: back-btn svg 18x18 */
.back-btn-icon { width: 36rpx; height: 36rpx; }

/* HTML: back-title 17px/700 居中 */
.back-title {
  position: absolute;
  left: 120rpx;
  right: 120rpx;
  text-align: center;
  font-size: 34rpx;      /* 17px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}
.back-spacer { width: 72rpx; flex-shrink: 0; }

/* ===== Cert Status Hero Card (glass gradient) ===== */
/* HTML: margin:14px 24px 0; padding:20px; border-radius:var(--r-lg) */
.cert-hero {
  margin: 28rpx 48rpx 0;       /* 14px 24px 0 */
  padding: 40rpx;              /* 20px */
  border-radius: var(--r-lg);  /* 1.6rem = 32px = 64rpx */
  position: relative;
  overflow: hidden;
  z-index: 5;
  background:
    radial-gradient(ellipse 440rpx 360rpx at 20% 30%, rgba(212,148,76,.12) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 85% 80%, rgba(45, 108, 223, 0.30) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.30) 0%, rgba(212,148,76,.10) 50%, rgba(45, 108, 223, 0.16) 100%);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: var(--neu-raised), 0 20rpx 72rpx rgba(0, 0, 0, 0.08), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
}
/* HTML: cert-hero::after 右上角 180x180 径向光晕 */
.cert-hero::after {
  content: "";
  position: absolute;
  top: -30%;
  right: -15%;
  width: 360rpx;       /* 180px */
  height: 360rpx;      /* 180px */
  background: radial-gradient(circle, rgba(255, 255, 255, 0.14) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* HTML: cert-hero-top display:flex; align-items:center; gap:14px */
.cert-hero-top {
  display: flex;
  align-items: center;
  gap: 28rpx;          /* 14px */
  position: relative;
  z-index: 2;
}
/* HTML: cert-shield 52x52 圆形琥珀渐变 + neu-out-sm + accent-glow */
.cert-shield {
  width: 104rpx;       /* 52px */
  height: 104rpx;      /* 52px */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #E8C088 0%, #D4944C 100%);
  color: #fff;
  box-shadow: var(--neu-raised-sm), 0 12rpx 36rpx var(--accent-glow), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40);
}
/* HTML: cert-shield svg 26x26 */
.cert-shield-icon { width: 52rpx; height: 52rpx; }

.cert-hero-info { flex: 1; min-width: 0; }
/* HTML: cert-hero-title 18px/700 letter-spacing:-0.02em line-height:1.2 */
.cert-hero-title {
  display: block;
  font-size: 36rpx;    /* 18px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  line-height: 1.2;
}
/* HTML: cert-hero-sub 12.5px/500 margin-top:5px letter-spacing:0.01em */
.cert-hero-sub {
  display: flex;
  align-items: center;
  font-size: 25rpx;    /* 12.5px */
  color: var(--text-2);
  font-weight: 500;
  margin-top: 10rpx;   /* 5px */
  letter-spacing: 0.01em;
}
.cert-progress-num {
  color: var(--brand);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
/* HTML: cert-progress-bar 6px 圆角条 inset shadow */
.cert-progress-bar {
  height: 12rpx;       /* 6px */
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.40);
  overflow: hidden;
  margin-top: 18rpx;   /* 9px */
  box-shadow: inset 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.06);
}
.cert-progress-fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, #E8C088 0%, #D4944C 100%);
  box-shadow: 0 0 16rpx var(--accent-glow);
}
/* HTML: cert-hero-benefits margin-top:14px; padding:9px 14px; 12.5px/500 */
.cert-hero-benefits {
  margin-top: 28rpx;   /* 14px */
  padding: 18rpx 28rpx;/* 9px 14px */
  border-radius: var(--r-sm);
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  font-size: 25rpx;    /* 12.5px */
  color: var(--text-1);
  font-weight: 500;
  line-height: 1.5;
  position: relative;
  z-index: 2;
}

/* ===== Section + Card (shared) ===== */
/* HTML: .section padding:0 24px; margin-top:18px */
.section {
  padding: 0 48rpx;     /* 0 24px */
  margin-top: 36rpx;    /* 18px */
  position: relative;
  z-index: 5;
}
/* HTML: .section-title 16px/700 margin:0 0 10px letter-spacing:-0.02em */
.section-title-row {
  font-size: 32rpx;     /* 16px */
  font-weight: 700;
  color: var(--text-1);
  margin: 0 0 20rpx;    /* 0 0 10px */
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* HTML: .card glass + neu-out-md + ring */
.card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised), 0 12rpx 48rpx rgba(0, 0, 0, 0.06), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
  overflow: hidden;
  position: relative;
}

/* ===== Cert Project Rows ===== */
/* HTML: .cert-card padding:4px 0 */
.cert-card { padding: 8rpx 0; }
/* HTML: .cert-row display:flex; align-items:center; gap:12px; padding:13px 18px */
.cert-row {
  display: flex;
  align-items: center;
  gap: 24rpx;          /* 12px */
  padding: 26rpx 36rpx;/* 13px 18px */
  position: relative;
  transition: transform var(--dur-base) var(--ease);
  z-index: 1;
}
.cert-row:active { transform: scale(0.98); }
/* HTML: cert-row + cert-row::before top:0; left:62px; right:18px; height:0.5px */
.cert-row + .cert-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 124rpx;        /* 62px */
  right: 36rpx;        /* 18px */
  height: 1rpx;        /* 0.5px */
  background: var(--sep);
}
/* HTML: cert-icon 40x40 圆角 r-sm + 双向阴影 + 内高光 */
.cert-icon {
  width: 80rpx;        /* 40px */
  height: 80rpx;       /* 40px */
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--canvas);
  box-shadow: 8rpx 8rpx 16rpx var(--neu-dark), -8rpx -8rpx 16rpx var(--neu-light), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}
/* HTML: cert-icon svg 20x20 */
.cert-icon-img { width: 40rpx; height: 40rpx; }
.cert-icon-indigo { color: var(--brand); }
.cert-icon-amber { color: var(--orange); }
.cert-icon-blue { color: var(--blue); }
.cert-icon-green { color: var(--green); }
.cert-icon-gray { color: var(--text-3); }

/* HTML: cert-info flex:1 display:flex; gap:8px */
.cert-info {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;          /* 8px */
}
/* HTML: cert-name 15px/600 letter-spacing:-0.01em */
.cert-name {
  font-size: 30rpx;    /* 15px */
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* HTML: cert-status 11.5px/600 padding:3px 9px pill tabular-nums */
.cert-status {
  font-size: 23rpx;    /* 11.5px */
  font-weight: 600;
  padding: 6rpx 18rpx; /* 3px 9px */
  border-radius: var(--r-pill);
  letter-spacing: 0.01em;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
/* HTML: status-pass green bg + 0.5px border */
.status-pass {
  color: var(--green);
  background: rgba(91, 140, 90, 0.12);
  border: 1rpx solid rgba(91, 140, 90, 0.22);
}
/* HTML: status-pending text-2 bg + 0.5px border */
.status-pending {
  color: var(--text-2);
  background: rgba(139, 129, 120, 0.10);
  border: 1rpx solid rgba(139, 129, 120, 0.18);
}

/* ===== 行内按钮 ===== */
/* HTML: btn-neu-secondary glass pill 8px 16px 13px/600 */
.btn-cert-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.50);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx; /* 8px 16px */
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: var(--neu-raised-sm);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.btn-cert-secondary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* HTML: btn-cert-primary brand bg + neu-out-sm + brand-glow */
.btn-cert-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--brand);
  color: #fff;
  border: 1rpx solid var(--brand-mid);
  border-radius: var(--r-pill);
  padding: 14rpx 28rpx; /* 7px 14px */
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: var(--neu-raised-sm), 0 8rpx 24rpx var(--brand-glow), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.30);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.btn-cert-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* ===== Skill Chips ===== */
/* HTML: skill-card padding:16px 18px */
.skill-card { padding: 32rpx 36rpx; }
/* HTML: skill-chips flex wrap gap:9px */
.skill-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;          /* 9px */
  position: relative;
  z-index: 1;
}
/* HTML: skill-chip 8px 14px pill glass + brand 色 */
.skill-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;          /* 6px */
  padding: 16rpx 28rpx;/* 8px 14px */
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  font-size: 26rpx;    /* 13px */
  font-weight: 600;
  color: var(--brand);
  letter-spacing: -0.01em;
}
/* HTML: skill-dot 6x6 brand bg + brand-glow */
.skill-dot {
  width: 12rpx;        /* 6px */
  height: 12rpx;       /* 6px */
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 12rpx var(--brand-glow);
  flex-shrink: 0;
}

/* ===== Benefit Rows ===== */
.benefit-card { padding: 8rpx 0; }
/* HTML: benefit-row display:flex; gap:12px; padding:13px 18px */
.benefit-row {
  display: flex;
  align-items: center;
  gap: 24rpx;          /* 12px */
  padding: 26rpx 36rpx;/* 13px 18px */
  position: relative;
  z-index: 1;
}
/* HTML: benefit-row + benefit-row::before top:0; left:46px; right:18px; height:0.5px */
.benefit-row + .benefit-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 92rpx;         /* 46px */
  right: 36rpx;        /* 18px */
  height: 1rpx;        /* 0.5px */
  background: var(--sep);
}
/* HTML: benefit-check 24x24 圆 green 半透 + 0.5px border */
.benefit-check {
  width: 48rpx;        /* 24px */
  height: 48rpx;       /* 24px */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(91, 140, 90, 0.14);
  color: var(--green);
  border: 1rpx solid rgba(91, 140, 90, 0.25);
}
/* HTML: benefit-check svg 14x14 */
.benefit-check-icon { width: 28rpx; height: 28rpx; }
/* HTML: benefit-text 15px/500 letter-spacing:-0.01em */
.benefit-text {
  flex: 1;
  font-size: 30rpx;    /* 15px */
  font-weight: 500;
  color: var(--text-1);
  letter-spacing: -0.01em;
}
/* HTML: benefit-tag 12px/500 text-2 tabular-nums */
.benefit-tag {
  font-size: 24rpx;    /* 12px */
  color: var(--text-2);
  font-weight: 500;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

/* ===== 底部 CTA (fixed) ===== */
/* HTML: bottom-cta position:absolute; bottom:0; padding:14px 24px 22px; glass */
.bottom-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 28rpx 48rpx calc(env(safe-area-inset-bottom) + 44rpx); /* 14px 24px 22px */
  background: linear-gradient(180deg, rgba(247, 243, 239, 0) 0%, rgba(247, 243, 239, 0.82) 38%, rgba(247, 243, 239, 0.96) 100%);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}
/* HTML: btn-neu-primary 100% brand-gradient pill 15px/600 */
.btn-neu-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;          /* 8px */
  width: 100%;
  background: var(--brand-gradient);
  color: #fff;
  border: none;
  border-radius: var(--r-pill);
  padding: 30rpx 48rpx; /* 15px 24px */
  font-size: 30rpx;     /* 15px */
  font-weight: 600;
  box-shadow: var(--neu-raised-sm), 0 16rpx 48rpx var(--brand-glow);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.btn-neu-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}
/* HTML: btn-neu-primary svg 18x18 */
.btn-neu-primary-icon { width: 36rpx; height: 36rpx; }

.scroll-bottom-spacer { height: 8rpx; }
