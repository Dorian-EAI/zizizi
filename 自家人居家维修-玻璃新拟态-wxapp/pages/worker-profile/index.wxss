/* pages/worker-profile/index.wxss — 师傅端个人中心 像素级复刻 worker-profile.html */
.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== HERO ===== */
.hero {
  padding: 0 48rpx 112rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 25% 40%, rgba(143, 169, 152, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 80% 80%, rgba(45, 108, 223, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.28) 0%, rgba(143, 169, 152, 0.20) 50%, rgba(90, 142, 232, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
  transition: padding var(--dur-base) var(--ease);
}
/* 滚动驱动 hero 收缩变形（参考 小程序动画与布局实现规范.md 第二章） */
.hero.hero-collapsed {
  padding-bottom: 72rpx;
}

/* Profile Row */
.profile-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  z-index: 2;
}
.avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.avatar.avatar-glass {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.28) 40%, var(--brand-worker-subtle) 78%, rgba(255, 255, 255, 0.18) 100%);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88), inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04), var(--neu-raised-sm);
}
.avatar-img {
  width: 52rpx;
  height: 52rpx;
}
.verify-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  color: var(--brand-worker);
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  line-height: 1.4;
  letter-spacing: 0.01em;
}
.verify-ic {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}
.profile-info {
  flex: 1;
  min-width: 0;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  line-height: 1.2;
}
.edit-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  color: var(--brand-worker);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  transition: transform var(--dur-base) var(--ease);
}
.edit-btn:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.96);
}
.edit-ic {
  width: 30rpx;
  height: 30rpx;
}

/* Rating Row */
.rating-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  position: relative;
  z-index: 2;
}
.rating-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 600;
}
.rating-star-ic {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.rating-num {
  color: var(--text-1);
  font-weight: 600;
}
.rating-divider {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--text-3);
  flex-shrink: 0;
}
.service-count {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* ===== STATS CARD（overlap hero -48rpx） ===== */
.stats-card {
  position: relative;
  z-index: 10;
  margin: -48rpx 48rpx 0;
  padding: 40rpx 24rpx;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-xl);
  box-shadow: var(--neu-raised-lg), 0 20rpx 72rpx rgba(0, 0, 0, 0.08), var(--shadow-card-ring), var(--shadow-card-worker);
  display: flex;
  align-items: center;
}
.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  padding: 0 16rpx;
}
.stat-col:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: var(--sep);
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.5px;
  line-height: 1;
  position: relative;
  z-index: 1;
}
.stat-num.brand {
  color: var(--brand-worker);
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* ===== Section ===== */
.section {
  padding: 0 48rpx;
  margin-top: 36rpx;
  position: relative;
  z-index: 5;
}
.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin: 0 8rpx 20rpx;
  letter-spacing: -0.02em;
}

/* ===== Info Card (glass + neu) ===== */
.info-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow: var(--neu-raised), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), var(--shadow-card-ring), var(--shadow-card-worker);
  overflow: hidden;
  position: relative;
}
.info-menu-card {
  overflow: hidden;
  padding: 8rpx 0;
}
.info-menu-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 36rpx;
  position: relative;
  z-index: 1;
}
.info-menu-row:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 128rpx;
  right: 36rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--sep);
}

/* Menu Icons — rounded square, neutral bg, colored icon */
.info-menu-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg-elevated);
  box-shadow: 8rpx 8rpx 16rpx var(--neu-dark), -8rpx -8rpx 16rpx var(--neu-light), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}
.info-menu-ic {
  width: 36rpx;
  height: 36rpx;
}
.info-menu-icon-teal { color: var(--brand-worker); }
.info-menu-icon-amber { color: var(--orange); }
.info-menu-icon-blue { color: var(--blue); }
.info-menu-icon-green { color: var(--green); }
.info-menu-icon-purple { color: var(--brand-worker); }
.info-menu-icon-gray { color: var(--text-2); }

.info-menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: -0.01em;
}
.info-menu-value {
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 500;
  margin-right: 4rpx;
  text-align: right;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-menu-value.text-green {
  color: var(--green);
  font-weight: 600;
}
.info-menu-chevron {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* ===== Rim Light 边缘高光（忠于 HTML .card::before / .stats-card::before）===== */
.stats-card::before,
.info-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}
