<!-- REVIEWED BUSINESS VIEW: services and workers come from /api/services/search. -->
<view class="phone-page design-detail-page" data-page-id="page-client-search">
  <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" bindtap="onBack"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">搜索</view><text class="tag-span"></text></view>
  <view class="page-body">
    <view class="section card">
      <view class="section-title"><text class="tag-strong">搜索状态</text><text class="badge {{loadError ? 'danger' : (searched ? 'success' : 'warning')}} tag-span">{{loadError ? '异常' : (searched ? '已搜索' : '待输入')}}</text></view>
      <view class="field"><text class="tag-label">服务、问题或师傅</text><input class="input" value="{{keyword}}" maxlength="40" confirm-type="search" bindinput="onInput" bindconfirm="search" placeholder="输入关键词" /></view>
      <view class="btn primary design-button" bindtap="search" loading="{{loading}}">搜索</view>
    </view>

    <view class="section" wx:if="{{history.length && !searched}}">
      <view class="section-title"><text class="tag-strong">历史搜索</text><text class="tag-span design-button" bindtap="onClearHistory">清空</text></view>
      <view class="chips"><view class="chip design-button" wx:for="{{history}}" wx:key="*this" data-keyword="{{item}}" bindtap="onTag">{{item}}</view></view>
    </view>

    <view class="section" wx:if="{{hotTags.length && !searched}}">
      <view class="section-title"><text class="tag-strong">热门搜索</text><text class="tag-span">平台实时配置</text></view>
      <view class="chips"><view class="chip design-button" wx:for="{{hotTags}}" wx:key="*this" data-keyword="{{item}}" bindtap="onTag">{{item}}</view></view>
    </view>

    <view class="section" wx:if="{{!searched}}">
      <view class="section-title"><text class="tag-strong">搜索发现</text><text class="tag-span">服务推荐</text></view>
      <view class="grid-2">
        <view class="card">
          <view class="media-placeholder media-visual"><view class="media-icon"><image class="design-svg-icon" src="{{icons.droplet}}" mode="aspectFit" /></view></view>
          <view class="card-title">按服务搜索</view><view class="card-copy">结果来自 /api/services/search</view>
        </view>
        <view class="card">
          <view class="media-placeholder media-visual"><view class="media-icon"><image class="design-svg-icon" src="{{icons.appliance}}" mode="aspectFit" /></view></view>
          <view class="card-title">按师傅搜索</view><view class="card-copy">仅展示已认证师傅</view>
        </view>
      </view>
    </view>

    <view class="section card" wx:if="{{loading}}"><view class="tag-p">正在搜索…</view></view>
    <view class="section card" wx:elif="{{loadError}}"><view class="tag-h2">搜索失败</view><view class="tag-p">{{loadError}}</view></view>
    <block wx:elif="{{searched}}">
      <view class="section">
        <view class="section-title"><text class="tag-strong">服务结果</text><text class="tag-span">{{services.length}} 条</text></view>
        <view class="card list-card" wx:if="{{services.length}}">
          <view class="list-row design-button" wx:for="{{services}}" wx:key="id" data-key="{{item.key || item.id}}" bindtap="onService">
            <text class="row-icon tag-span">{{item.initial}}</text>
            <view class="row-main"><view class="row-title">{{item.name}}</view><view class="row-copy">{{item.category || '居家维修'}} · {{item.priceText}}</view></view>
            <text class="chevron tag-span">›</text>
          </view>
        </view>
        <view class="card" wx:else><view class="tag-p">没有匹配的服务</view></view>
      </view>
      <view class="section">
        <view class="section-title"><text class="tag-strong">师傅结果</text><text class="tag-span">{{workers.length}} 位</text></view>
        <view class="card list-card" wx:if="{{workers.length}}">
          <view class="list-row design-button" wx:for="{{workers}}" wx:key="id" data-id="{{item.id}}" bindtap="onWorker">
            <text class="avatar tag-span">{{item.initial}}</text>
            <view class="row-main"><view class="row-title">{{item.name}} · ★{{item.rating}}</view><view class="row-copy">{{item.service_area || '服务区域未配置'}} · 已完成 {{item.completed_orders || 0}} 单</view></view>
            <text class="chevron tag-span">›</text>
          </view>
        </view>
        <view class="card" wx:else><view class="tag-p">没有匹配的已认证师傅</view></view>
      </view>
    </block>
  </view>
  <view class="fixed-actions"><view class="btn primary design-button" bindtap="search">{{keyword ? ('搜索“' + keyword + '”') : '开始搜索'}}</view></view>
</view>
