<view class="phone-page design-detail-page" data-page-id="page-client-order-picker">
  <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" bindtap="onBack"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">选择关联订单</view><text class="tag-span"></text></view>
  <view class="page-body">
    <view class="field">
      <text for="order-picker-search" class="tag-label">搜索订单号或服务</text>
      <input class="input" id="order-picker-search" placeholder="输入关键词" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">✕</view>
    </view>
    <view class="section-title"><text class="tag-strong">选择状态</text><text class="badge success tag-span" wx:if="{{selectedCount > 0}}">已选 {{selectedCount}} 笔</text></view>
    <view class="segmented">
      <view wx:for="{{tabs}}" wx:key="key" class="segment {{activeTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTabTap">{{item.name}}</view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载订单中…</text>
    </view>

    <!-- 加载失败 -->
    <view wx:elif="{{loadError}}" class="empty-state">
      <view class="empty-icon">!</view>
      <text class="empty-title">加载订单失败</text>
      <text class="empty-desc">网络异常或服务暂不可用</text>
      <view class="btn empty-btn" bindtap="onRetry">重新加载</view>
    </view>

    <!-- 空态 -->
    <view wx:elif="{{empty}}" class="empty-state">
      <view class="empty-icon"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m7%2012%203%203%207-7%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view>
      <text class="empty-title">暂无订单</text>
      <text class="empty-desc">当前分类下没有可关联的订单</text>
    </view>

    <!-- 订单列表 -->
    <block wx:else>
      <view class="section">
        <view class="card list-card">
          <view wx:for="{{filteredOrders}}" wx:key="id"
                class="list-row {{selectedOrderId === item.id ? 'selected' : ''}}"
                data-id="{{item.id}}" bindtap="onSelectOrder">
            <text class="row-icon tag-span">{{selectedOrderId === item.id ? '✓' : '○'}}</text>
            <view class="row-main">
              <view class="row-title">{{item.serviceName}}</view>
              <view class="row-copy">#{{item.orderNo}} · {{item.statusText}} · ¥{{item.amount}}</view>
            </view>
            <text wx:if="{{selectedOrderId === item.id}}" class="badge success tag-span">已选</text>
            <text wx:elif="{{item.status === 'completed' || item.status === 'paid' || item.status === 'pending_review' || item.status === 'reviewed'}}" class="badge warning tag-span">售后</text>
            <text wx:else class="chevron tag-span">›</text>
          </view>
        </view>
      </view>
      <view class="notice info">关联订单后，客服可查看必要的订单状态与支付信息，不会读取无关聊天内容。</view>
    </block>
  </view>
  <view class="fixed-actions">
    <view class="btn primary {{selectedOrderId ? '' : 'disabled'}}" bindtap="onConfirm">确认关联此订单</view>
  </view>
</view>

