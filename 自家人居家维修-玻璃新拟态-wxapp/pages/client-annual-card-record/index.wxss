@import "../../styles/generated-detail-page.wxss";

.progress-bar {
  position: relative;
  z-index: 1;
  margin: 20rpx 0 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.progress-fill {
  flex: 1;
  height: 16rpx;
  border-radius: 1998rpx;
  background: rgba(255, 255, 255, 0.24);
  box-shadow: inset 2rpx 2rpx 6rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
  transition: width 0.3s ease;
}

.progress-fill::after {
  content: "";
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 1998rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.72));
}

.progress-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  min-width: 72rpx;
  text-align: right;
}

.loading-state {
  padding: 100rpx 0;
  text-align: center;
}

.list-row .design-br {
  display: block;
  height: 8rpx;
}