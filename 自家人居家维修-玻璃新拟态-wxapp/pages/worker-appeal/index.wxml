<!-- pages/worker-appeal/index.wxml — 师傅申诉页 玻璃新拟态（像素级复刻 worker-appeal.html） -->
<view class="page">
  <!-- 背景装饰光斑：blue-sage 径向渐变 -->
  <view class="blob" style="top: -40px; right: -60px; width: 280px; height: 280px; background: radial-gradient(circle, var(--brand) 0%, transparent 70%);"></view>
  <view class="blob" style="top: 320px; left: -80px; width: 240px; height: 240px; background: radial-gradient(circle, var(--sage) 0%, transparent 70%);"></view>

  <scroll-view scroll-y class="page-scroll hide-scroll" style="padding-bottom: 220rpx;">

    <!-- ===== BACK BAR ===== -->
    <view class="back-bar" style="padding-top: calc({{statusBarHeight}}px + 32rpx);">
      <view class="back-btn press-neu" bindtap="onBack">
        <image src="{{icons.back}}" mode="aspectFit" class="back-btn-icon" lazy-load="{{false}}" />
      </view>
      <text class="back-title">申诉中心</text>
      <view class="back-spacer"></view>
    </view>

    <!-- ===== APPEAL HERO (说明卡 · 玻璃渐变) ===== -->
    <view class="appeal-hero">
      <view class="appeal-hero-icon">
        <image src="{{icons.scale}}" mode="aspectFit" class="appeal-hero-icon-img" lazy-load="{{false}}" />
      </view>
      <view class="appeal-hero-text">
        <text class="appeal-hero-title">对平台处罚有异议？</text>
        <text class="appeal-hero-desc">提交申诉后客服将在3个工作日内复核，请提供充分证据</text>
      </view>
    </view>

    <!-- ===== MY APPEALS ===== -->
    <view class="section">
      <view class="section-title-row">
        <text class="section-title-text">我的申诉</text>
      </view>
      <view class="appeal-card">
        <view class="appeal-item">
          <view class="appeal-item-top">
            <text class="penalty-tag">扣除保证金</text>
            <text class="status-badge status-pending">待复核</text>
          </view>
          <text class="appeal-item-title">扣除保证金 ¥200</text>
          <text class="appeal-item-reason">工单WO20260720</text>
          <view class="appeal-item-bottom">
            <text class="appeal-item-time">2小时前</text>
            <view class="appeal-view-btn press-neu">
              <text class="appeal-view-text">查看</text>
              <image src="{{icons.chevronRight}}" mode="aspectFit" class="appeal-view-icon" lazy-load="{{false}}" />
            </view>
          </view>
        </view>
        <view class="appeal-item">
          <view class="appeal-item-top">
            <text class="penalty-tag">限制抢单</text>
            <text class="status-badge status-rejected">已驳回</text>
          </view>
          <text class="appeal-item-title">限制抢单3天</text>
          <text class="appeal-item-reason">拒单率超标</text>
          <view class="appeal-item-bottom">
            <text class="appeal-item-time">2026-07-22</text>
            <view class="appeal-view-btn press-neu">
              <text class="appeal-view-text">查看</text>
              <image src="{{icons.chevronRight}}" mode="aspectFit" class="appeal-view-icon" lazy-load="{{false}}" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== SUBMIT NEW APPEAL (FORM) ===== -->
    <view class="section">
      <view class="section-title-row">
        <text class="section-title-text">提交新申诉</text>
      </view>
      <view class="form-card">
        <view class="form-field">
          <text class="form-label">处罚单号</text>
          <input
            class="form-input"
            type="text"
            placeholder="请输入处罚单号"
            placeholder-class="form-ph"
            value="{{orderId}}"
            data-field="orderId"
            bindinput="onInput"
          />
        </view>

        <view class="form-field">
          <text class="form-label">申诉类型</text>
          <view class="chip-group">
            <view
              class="chip-radio press-neu {{activeType === item.key ? 'active' : ''}}"
              wx:for="{{appealTypes}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="onTypeTap"
            >{{item.name}}</view>
          </view>
        </view>

        <view class="form-field">
          <text class="form-label">申诉理由</text>
          <textarea
            class="form-textarea"
            placeholder="请详细说明申诉理由..."
            placeholder-class="form-ph"
            maxlength="500"
            value="{{content}}"
            data-field="content"
            bindinput="onInput"
          />
        </view>

        <view class="form-field">
          <text class="form-label">证据图片</text>
          <view class="upload-grid">
            <view class="upload-cell" wx:for="{{images}}" wx:key="*this">
              <image src="{{item}}" mode="aspectFill" class="upload-preview" lazy-load="{{false}}" />
              <view class="upload-del" data-idx="{{index}}" catchtap="removeImage">×</view>
            </view>
            <view
              class="upload-cell upload-add press-neu"
              wx:if="{{images.length < maxImages}}"
              bindtap="chooseImage"
            >
              <image src="{{icons.plus}}" mode="aspectFit" class="upload-add-icon" lazy-load="{{false}}" />
            </view>
          </view>
          <text class="upload-hint">上传聊天截图/现场照片等证据</text>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- ===== FIXED SUBMIT BUTTON ===== -->
  <view class="submit-bar safe-bottom">
    <view class="btn-submit press-neu" bindtap="onSubmit">
      <image src="{{icons.send}}" mode="aspectFit" class="btn-submit-icon" lazy-load="{{false}}" />
      <text class="btn-submit-text">{{submitting ? '提交中...' : '提交申诉'}}</text>
    </view>
  </view>
</view>
