.points-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: var(--bg);
}

.points-hero {
  padding: 48rpx 40rpx 64rpx;
  background:
    radial-gradient(ellipse 560rpx 360rpx at 85% 30%, rgba(212, 148, 76, .16) 0%, transparent 66%),
    radial-gradient(ellipse 440rpx 320rpx at 10% 70%, rgba(13, 148, 136, .13) 0%, transparent 66%),
    linear-gradient(150deg, rgba(13, 148, 136, .10) 0%, rgba(212, 148, 76, .10) 100%);
  border-radius: 0 0 64rpx 64rpx;
  text-align: center;
  position: relative;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .35);
}

.points-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
}

.points-value {
  font-size: 112rpx;
  font-weight: 700;
  font-family: var(--font-display);
  letter-spacing: -.04em;
  line-height: 1;
  color: var(--brand-dark);
  background: linear-gradient(135deg, var(--brand-dark) 0%, var(--accent-dark) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.points-unit {
  font-size: 32rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

.points-actions {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 48rpx;
}

.points-action-btn {
  width: auto;
  margin: 0;
  padding: 20rpx 48rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--ease);
}

.points-action-btn.primary {
  background: var(--brand-gradient);
  color: #fff;
  box-shadow: var(--neu-out-sm), 0 8rpx 28rpx var(--brand-glow);
}

.points-action-btn.secondary {
  background: rgba(255, 255, 255, .52);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, .60);
  box-shadow: var(--neu-out-sm);
}

.points-action-btn:active {
  transform: scale(.94);
}

.points-action-btn[disabled] {
  opacity: .7;
}

.section {
  padding: 40rpx 40rpx 0;
}

.section-head,
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-2);
}

.glass-card {
  background: rgba(255, 255, 255, .52);
  backdrop-filter: blur(40rpx) saturate(140%);
  -webkit-backdrop-filter: blur(40rpx) saturate(140%);
  border-radius: var(--r-lg);
  border: 1rpx solid rgba(255, 255, 255, .60);
  box-shadow: var(--neu-out-md);
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .80), transparent);
  pointer-events: none;
}

.earn-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.earn-item {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.earn-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 32rpx;
  margin: 0 auto 16rpx;
  background: rgba(255, 255, 255, .52);
  box-shadow: var(--neu-out-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--ease);
}

.earn-item:active .earn-icon {
  box-shadow: var(--neu-in);
  transform: scale(.94);
}

.earn-icon image {
  width: 44rpx;
  height: 44rpx;
}

.earn-name {
  font-size: 24rpx;
  color: var(--text-1);
  margin-bottom: 4rpx;
}

.earn-points {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
}

.mall-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.mall-item {
  background: rgba(255, 255, 255, .52);
  border-radius: var(--r-md);
  border: 1rpx solid rgba(255, 255, 255, .60);
  box-shadow: var(--neu-out-sm);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}

.mall-item:active {
  transform: scale(.97);
  box-shadow: var(--neu-in);
}

.mall-img {
  height: 200rpx;
  background:
    radial-gradient(circle at 78% 22%, rgba(212, 148, 76, .20) 0%, transparent 56%),
    radial-gradient(circle at 18% 84%, rgba(13, 148, 136, .14) 0%, transparent 58%),
    rgba(255, 255, 255, .34);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  box-shadow: inset 6rpx 6rpx 16rpx var(--neu-dark), inset -6rpx -6rpx 16rpx var(--neu-light);
  filter: saturate(.92);
}

.mall-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.mall-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.mall-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.mall-points {
  font-size: 28rpx;
  font-weight: 700;
  font-family: var(--font-display);
  color: var(--accent);
  line-height: 1.35;
}

.mall-points text {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-3);
  margin-left: 8rpx;
}

.segmented-tabs {
  display: flex;
  background: var(--bg-elevated);
  border-radius: var(--r-pill);
  padding: 8rpx;
  box-shadow: var(--neu-in);
  margin-bottom: 32rpx;
}

.seg-tab {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  border-radius: var(--r-pill);
  color: var(--text-2);
  transition: color var(--dur) var(--ease), background var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}

.seg-tab.active {
  background: rgba(255, 255, 255, .80);
  color: var(--brand);
  box-shadow: var(--neu-out-sm);
  font-weight: 600;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--sep);
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.record-icon.plus {
  background: rgba(91, 140, 90, .12);
}

.record-icon.minus {
  background: var(--accent-subtle);
}

.record-icon image {
  width: 36rpx;
  height: 36rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.record-time {
  font-size: 24rpx;
  color: var(--text-2);
}

.record-points {
  font-size: 32rpx;
  font-weight: 700;
  font-family: var(--font-display);
}

.record-points.plus {
  color: var(--green);
}

.record-points.minus {
  color: var(--accent-dark);
}

.record-empty {
  padding: 64rpx 20rpx;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

.records-section {
  padding-bottom: 40rpx;
}

.state-panel {
  padding: 280rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: var(--text-2);
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 12rpx;
}

.state-desc {
  font-size: 26rpx;
  line-height: 1.5;
}
