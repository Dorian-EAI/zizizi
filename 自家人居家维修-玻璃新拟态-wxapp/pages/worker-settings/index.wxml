<!-- pages/worker-settings/index.wxml — 师傅设置页 玻璃新拟态（像素级复刻 worker-settings.html） -->
<view class="page">
  <!-- 背景装饰光斑：blue-sage 径向渐变 -->
  <view class="blob" style="top: -40px; right: -60px; width: 280px; height: 280px; background: radial-gradient(circle, var(--brand) 0%, transparent 70%);"></view>
  <view class="blob" style="top: 360px; left: -80px; width: 240px; height: 240px; background: radial-gradient(circle, var(--sage) 0%, transparent 70%);"></view>

  <scroll-view scroll-y enable-flex class="page-scroll hide-scroll" style="padding-bottom: 80rpx;">

    <!-- ===== TOP NAV BAR (sticky) ===== -->
    <view class="nav-bar" style="padding-top: calc({{statusBarHeight}}px + 36rpx);">
      <view class="nav-icon-btn press-neu" bindtap="onBack">
        <image src="{{icons.back}}" mode="aspectFit" class="nav-icon" lazy-load="{{false}}" />
      </view>
      <text class="nav-title">设置</text>
      <view class="nav-placeholder"></view>
    </view>

    <!-- ===== WORKER PROFILE PREVIEW CARD ===== -->
    <view class="section">
      <view class="worker-profile-card">
        <view class="worker-profile-main">
          <view class="avatar-col">
            <view class="worker-profile-avatar avatar-glass">
              <image src="{{icons.user}}" mode="aspectFit" class="worker-profile-avatar-icon" lazy-load="{{false}}" />
            </view>
            <view class="worker-gold-tag">
              <image src="{{icons.star}}" mode="aspectFit" class="worker-gold-tag-icon" lazy-load="{{false}}" />
              <text class="worker-gold-tag-text">金牌师傅</text>
            </view>
          </view>
          <view class="worker-profile-info">
            <view class="worker-profile-name-row">
              <text class="worker-profile-name">张师傅</text>
            </view>
          </view>
          <view class="online-pill {{isOnline ? '' : 'offline'}}" bindtap="onToggleOnline">
            <view class="online-dot"></view>
            <text class="online-pill-text">{{isOnline ? '在线接单' : '已离线'}}</text>
          </view>
        </view>
        <view class="worker-profile-stats">
          <text class="stats-main">已完成 328 单</text>
          <text class="stats-dot">·</text>
          <text class="stats-sub">好评率 98%</text>
        </view>
      </view>
    </view>

    <!-- ===== GROUP 1: 接单设置 ===== -->
    <view class="section">
      <view class="group-title">接单设置</view>
      <view class="setting-group">
        <view class="setting-row">
          <view class="row-icon row-icon-brand">
            <image src="{{icons.location}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">接单范围</text>
          <view class="row-tail">
            <text class="row-value">5 公里</text>
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
        <view class="setting-row">
          <view class="row-icon row-icon-blue">
            <image src="{{icons.grid}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">服务分类</text>
          <view class="row-tail">
            <text class="row-value">防水/家电/管道</text>
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
        <view class="setting-row">
          <view class="row-icon row-icon-green">
            <image src="{{icons.power}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">接单开关</text>
          <view class="row-tail">
            <view class="toggle {{isOnline ? 'toggle-on' : 'toggle-off'}}" data-key="online" catchtap="onToggleOnline">
              <view class="toggle-thumb"></view>
            </view>
          </view>
        </view>
        <view class="setting-row">
          <view class="row-icon row-icon-orange">
            <image src="{{icons.zap}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">自动接单</text>
          <view class="row-tail">
            <view class="toggle toggle-off">
              <view class="toggle-thumb"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== GROUP 2: 账号与安全 ===== -->
    <view class="section">
      <view class="group-title">账号与安全</view>
      <view class="setting-group">
        <view class="setting-row">
          <view class="row-icon row-icon-brand">
            <image src="{{icons.lock}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">修改密码</text>
          <view class="row-tail">
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
        <view class="setting-row">
          <view class="row-icon row-icon-blue">
            <image src="{{icons.phone}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">绑定手机</text>
          <view class="row-tail">
            <text class="row-value">已绑定</text>
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
        <view class="setting-row">
          <view class="row-icon row-icon-green">
            <image src="{{icons.shield}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">实名认证</text>
          <view class="row-tail">
            <text class="row-badge-green">已认证</text>
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
        <view class="setting-row">
          <view class="row-icon row-icon-orange">
            <image src="{{icons.award}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">资质证书</text>
          <view class="row-tail">
            <text class="row-value">3 张</text>
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
      </view>
    </view>

    <!-- ===== GROUP 3: 消息通知 ===== -->
    <view class="section">
      <view class="group-title">消息通知</view>
      <view class="setting-group">
        <view class="setting-row" wx:for="{{notifications}}" wx:key="key">
          <view class="row-icon {{item.iconClass}}">
            <image src="{{icons[item.iconKey]}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">{{item.label}}</text>
          <view class="row-tail">
            <view class="toggle {{item.value ? 'toggle-on' : 'toggle-off'}}" data-idx="{{index}}" catchtap="onToggleNotification">
              <view class="toggle-thumb"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== GROUP 4: 其他 ===== -->
    <view class="section">
      <view class="group-title">其他</view>
      <view class="setting-group">
        <view class="setting-row">
          <view class="row-icon row-icon-orange">
            <image src="{{icons.trash}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">清除缓存</text>
          <view class="row-tail">
            <text class="row-value mono">2.4MB</text>
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
        <view class="setting-row" data-key="about" bindtap="onAboutItem">
          <view class="row-icon row-icon-brand">
            <image src="{{icons.info}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">关于我们</text>
          <view class="row-tail">
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
        <view class="setting-row" data-key="agreement" bindtap="onAboutItem">
          <view class="row-icon row-icon-blue">
            <image src="{{icons.orders}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">用户协议</text>
          <view class="row-tail">
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
        <view class="setting-row" data-key="privacy" bindtap="onAboutItem">
          <view class="row-icon row-icon-green">
            <image src="{{icons.shield}}" mode="aspectFit" class="row-icon-img" lazy-load="{{false}}" />
          </view>
          <text class="row-title">隐私政策</text>
          <view class="row-tail">
            <image src="{{icons.chevronRight}}" mode="aspectFit" class="row-arrow" lazy-load="{{false}}" />
          </view>
        </view>
      </view>
    </view>

    <!-- ===== LOGOUT BUTTON ===== -->
    <view class="section logout-section">
      <view class="logout-btn press-neu" bindtap="onLogout">
        <text class="logout-btn-text">退出登录</text>
      </view>
    </view>

  </scroll-view>
</view>
