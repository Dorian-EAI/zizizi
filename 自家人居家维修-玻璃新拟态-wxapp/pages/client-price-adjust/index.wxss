.price-page{height:100vh;display:flex;flex-direction:column;overflow:hidden}.price-scroll{flex:1;min-height:0}.section{padding:32rpx 40rpx 0}.section-title{display:block;font-size:30rpx;margin-bottom:24rpx}.icon-title{display:flex;align-items:center;gap:12rpx}.icon-title image{width:32rpx;height:32rpx}.glass-card{background:rgba(255,255,255,.52);backdrop-filter:blur(40rpx) saturate(140%);border-radius:var(--r-lg);border:1rpx solid rgba(255,255,255,.60);box-shadow:var(--neu-out-md);padding:40rpx;position:relative}.status-banner{display:flex;align-items:center;gap:24rpx;padding:32rpx 40rpx;margin:32rpx 40rpx 0;background:linear-gradient(135deg,rgba(212,148,76,.15),rgba(212,148,76,.08));border-radius:var(--r-md);border:1rpx solid rgba(212,148,76,.30)}.status-icon{width:80rpx;height:80rpx;border-radius:24rpx;background:rgba(212,148,76,.20);display:flex;align-items:center;justify-content:center;flex-shrink:0}.status-icon image{width:40rpx;height:40rpx}.status-text{flex:1;display:flex;flex-direction:column}.status-title{font-size:28rpx;font-weight:600;color:var(--accent-dark);margin-bottom:4rpx}.status-desc{font-size:24rpx;color:var(--text-2);line-height:1.5}.amount-section{text-align:center;padding:48rpx 0}.amount-label{display:block;font-size:26rpx;color:var(--text-2);margin-bottom:16rpx}.amount-value{display:flex;justify-content:center;align-items:flex-start;font-size:96rpx;font-weight:700;color:var(--accent);letter-spacing:-.03em;line-height:1.1}.amount-value .currency{font-size:48rpx;margin-right:8rpx;font-weight:600}.amount-reason{display:block;font-size:24rpx;color:var(--text-2);margin-top:16rpx}.worker-row{display:flex;align-items:center;gap:24rpx}.worker-avatar{width:96rpx;height:96rpx;border-radius:28rpx;background:linear-gradient(135deg,var(--brand),var(--brand-mid));color:#fff;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:600;flex-shrink:0;box-shadow:var(--neu-out-sm)}.worker-info{flex:1;display:flex;flex-direction:column}.worker-name{font-size:30rpx;font-weight:600;margin-bottom:4rpx}.worker-service{font-size:24rpx;color:var(--text-2)}.row-arrow{width:36rpx;height:36rpx}.reason-box{display:block;padding:28rpx 32rpx;background:var(--bg-elevated);border-radius:var(--r-md);box-shadow:var(--neu-in);font-size:27rpx;color:var(--text-1);line-height:1.6;white-space:pre-wrap}.photo-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20rpx}.photo-item{aspect-ratio:1;border-radius:24rpx;overflow:hidden;box-shadow:var(--neu-out-sm)}.photo-item image{width:100%;height:100%}.fee-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:2rpx solid var(--sep)}.fee-row:last-child{border-bottom:none}.fee-label,.fee-value{font-size:27rpx}.fee-label{color:var(--text-2)}.fee-value{font-weight:500}.fee-value.accent{color:var(--accent)}.fee-total{padding-top:24rpx;border-top:2rpx dashed var(--sep);margin-top:8rpx}.fee-total .fee-label{font-weight:600;color:var(--text-1);font-size:28rpx}.fee-total .fee-value{font-size:40rpx;font-weight:700;color:var(--brand)}
.action-buttons{flex-shrink:0;display:flex;gap:24rpx;padding:24rpx 40rpx;background:rgba(255,255,255,.72);backdrop-filter:blur(48rpx) saturate(160%);border-top:1rpx solid rgba(255,255,255,.60);box-shadow:0 -8rpx 40rpx rgba(0,0,0,.06)}.action-btn{flex:1;margin:0;padding:28rpx;border-radius:var(--r-pill);font-size:30rpx;font-weight:600;line-height:1.4}.action-btn.reject{background:rgba(255,255,255,.52);color:var(--text-2);border:1rpx solid rgba(255,255,255,.60);box-shadow:var(--neu-out-sm)}.action-btn.confirm{background:var(--brand-gradient);color:#fff;box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow)}.action-btn[disabled]{background:var(--neu-dark);color:var(--text-3);box-shadow:none}.permission-warning{margin:24rpx 40rpx 0;padding:28rpx 32rpx;background:rgba(196,83,58,.08);border:1rpx solid rgba(196,83,58,.24);border-radius:var(--r-md);display:flex;flex-direction:column}.warning-title{font-size:28rpx;font-weight:700;color:var(--red);margin-bottom:8rpx}.warning-desc{font-size:24rpx;color:var(--text-2);line-height:1.5}.state-panel{padding:280rpx 64rpx;display:flex;flex-direction:column;align-items:center;text-align:center;color:var(--text-2)}.state-panel.compact{padding:120rpx 64rpx}.state-title{font-size:32rpx;font-weight:700;color:var(--text-1);margin-bottom:12rpx}.state-desc{font-size:26rpx;line-height:1.5}.scroll-spacer{height:48rpx}
.photo-item{min-height:132rpx}.glass-card,.action-buttons{-webkit-backdrop-filter:blur(40rpx) saturate(140%)}
