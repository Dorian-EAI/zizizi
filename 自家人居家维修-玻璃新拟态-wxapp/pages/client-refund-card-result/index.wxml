<view class="phone-page design-detail-page" data-page-id="page-client-refund-card-result">
  <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" data-route="/pages/client-annual-card/index" bindtap="onNavigate"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">退卡结果</view><text class="tag-span"></text></view>
  <view class="page-body">
    <view class="hero" style="text-align:center"><view class="hero-kicker tag-p">CARD REFUND STATUS</view><view class="avatar state-{{stateTone}}" style="margin:0 auto 24rpx">{{state === 'refunded' ? '✓' : '审'}}</view><view class="tag-h2">{{titleText}}</view><view class="tag-p">{{description}}</view></view>
    <view class="section"><view class="card list-card"><view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%23D4944C%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%225%22%20width%3D%2218%22%20height%3D%2214%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M3%209h18M8%2014h4%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">{{cardName}}</view><view class="row-copy">年卡编号 {{cardId || '未提供'}}</view></view><text class="badge {{stateTone}} tag-span">{{statusText}}</text></view><view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%23D4944C%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22M8%209h8M8%2015h8M12%206v12%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">退款金额</view><view class="row-copy">必须由服务端原支付渠道确认</view></view><text class="row-value tag-span">—</text></view></view></view>
    <view class="notice info">本页只展示服务端年卡状态；未进入 refunding/refunded 状态时不会显示“申请已提交”或“退款成功”。</view>
  </view>
  <view class="fixed-actions"><view class="btn secondary design-button" data-route="/pages/client-customer-service/index" bindtap="onNavigate">咨询客服</view><view class="btn primary design-button" data-route="/pages/client-annual-card/index" bindtap="onNavigate">返回年卡</view></view>
</view>
