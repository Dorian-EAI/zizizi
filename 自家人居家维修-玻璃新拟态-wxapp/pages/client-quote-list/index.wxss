/* pages/client-quote-list/index.wxss — 师傅报价列表 玻璃新拟态
 * 像素级复刻 client-quote-list.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  /* HTML .phone: padding-bottom:82px → 164rpx */
  padding-bottom: 164rpx;
}

/* ===== Top Nav Bar (sticky) ===== */
/* HTML .nav-bar: padding max(18px, env(safe-area-inset-top)) 20px 14px;
   border-radius:0 0 28px 28px → 0 0 56rpx 56rpx；
   background 三层径向 + 线性渐变（与全局 .nav-bar 一致，使用页面级覆写确保像素一致） */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* padding-top 由内联 style 动态提供（statusBarHeight + 36rpx），对应 HTML max(18px, env) */
  padding-right: 40rpx;
  padding-bottom: 28rpx;
  padding-left: 40rpx;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

/* HTML .nav-back: width:44px; height:44px → 88rpx；border-radius:50%；
   background:var(--bg-elevated); box-shadow:var(--neu-out-sm),inset 0 1.5px 2px rgba(255,255,255,0.6) */
/* 全局 .nav-icon-btn 已对齐（88rpx 圆形 + neu-raised-sm + inset 高光），此处不再覆写 */

/* HTML .nav-back svg: width:22px;height:22px → 44rpx */
.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

/* HTML .nav-title: font-size:17px;font-weight:700 → 34rpx 700 */
.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  text-align: center;
}

/* HTML .nav-spacer: width:44px;height:44px → 88rpx */
.nav-spacer {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* ===== Order Summary Card ===== */
/* HTML .summary-wrap: padding:16px 20px 0 → 32rpx 40rpx 0 */
.summary-wrap {
  padding: 32rpx 40rpx 0;
  position: relative;
  z-index: 1;
}

/* HTML .summary-card: padding:16px 18px → 32rpx 36rpx */
.summary-card {
  padding: 32rpx 36rpx;
  position: relative;
}

/* HTML .summary-top: margin-bottom:10px → 20rpx */
.summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

/* HTML .summary-svc: gap:9px → 18rpx */
.summary-svc {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

/* HTML .svc-icon: width:30px;height:30px → 60rpx；border-radius:var(--r-pill)；
   background:var(--brand-subtle)；box-shadow:var(--neu-in) */
.svc-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--r-pill);
  background: var(--brand-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  box-shadow: var(--neu-inset-sm);
  flex-shrink: 0;
}

/* HTML .svc-icon svg: width:16px;height:16px → 32rpx */
.svc-icon-img {
  width: 32rpx;
  height: 32rpx;
}

/* HTML .svc-name: font-size:15px;font-weight:700 → 30rpx 700 */
.svc-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

/* HTML .status-chip: font-size:11.5px;font-weight:700 → 23rpx 700；
   color:var(--accent-dark)；background:var(--accent-light)；padding:4px 12px → 8rpx 24rpx */
.status-chip {
  display: inline-flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--accent-dark);
  background: var(--accent-light);
  border-radius: var(--r-pill);
  padding: 8rpx 24rpx;
  letter-spacing: 0.01em;
  box-shadow: inset 0 0 0 1rpx rgba(212, 148, 76, 0.25);
}

/* HTML .summary-desc: font-size:13.5px;line-height:1.5;margin-bottom:10px → 27rpx / 1.5 / 20rpx */
.summary-desc {
  font-size: 27rpx;
  color: var(--text-1);
  font-weight: 500;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* HTML .summary-count: gap:6px;font-size:12px → 12rpx / 24rpx */
.summary-count {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* HTML .summary-count svg: width:14px;height:14px → 28rpx */
.count-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ===== Sort / Filter Bar ===== */
/* HTML .sort-wrap: padding:16px 20px 4px → 32rpx 40rpx 8rpx */
.sort-wrap {
  padding: 32rpx 40rpx 8rpx;
  position: relative;
  z-index: 1;
}

/* HTML .sort-scroll: gap:10px;padding-bottom:4px → 20rpx / 8rpx */
.sort-scroll {
  display: flex;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

/* HTML .sort-chip: padding:0 18px;font-size:13px;min-height:44px → 0 36rpx / 26rpx / 88rpx */
.sort-chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  border: none;
  font-family: var(--font-body);
  min-height: 88rpx;
  background: var(--bg-elevated);
  color: var(--text-2);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), background var(--dur-base) var(--ease), color var(--dur-base) var(--ease);
}

/* HTML .sort-active: background:var(--brand-subtle);color:var(--brand);
   box-shadow:var(--neu-in),0 0 0 0.5px rgba(13,148,136,0.15) */
.sort-active {
  background: var(--brand-subtle);
  color: var(--brand);
  box-shadow: var(--neu-inset), 0 0 0 1rpx rgba(13, 148, 136, 0.15);
}

/* ===== Quote Card List ===== */
/* HTML .quote-list: padding:8px 20px 0;gap:16px → 16rpx 40rpx 0 / 32rpx */
.quote-list {
  padding: 16rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  position: relative;
  z-index: 1;
}

/* HTML .quote-card: padding:16px 16px 14px → 32rpx 32rpx 28rpx */
.quote-card {
  padding: 32rpx 32rpx 28rpx;
  position: relative;
  overflow: hidden;
}

/* HTML .recommend-badge: font-size:10.5px;font-weight:7 → 21rpx 700；
   padding:5px 12px 5px 14px → 10rpx 24rpx 10rpx 28rpx；
   border-radius:0 var(--r-lg) 0 14px → 0 var(--r-lg) 0 28rpx */
.recommend-badge {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--text-inverse);
  background: linear-gradient(135deg, var(--accent-dark) 0%, var(--accent) 60%, var(--accent-mid) 100%);
  padding: 10rpx 24rpx 10rpx 28rpx;
  border-radius: 0 var(--r-lg) 0 28rpx;
  letter-spacing: 0.04em;
  box-shadow: 0 4rpx 16rpx var(--accent-glow);
}

/* HTML .quote-top: gap:12px;margin-bottom:14px → 24rpx / 28rpx */
.quote-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

/* HTML .avatar-inset: width:44px;height:44px → 88rpx；box-shadow:var(--neu-in-deep) */
.avatar-inset {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

/* HTML .worker-info: gap:3px → 6rpx */
.worker-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* HTML .worker-name-row: gap:7px → 14rpx */
.worker-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* HTML .worker-name: font-size:15.5px;font-weight:700 → 31rpx 700 */
.worker-name {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* HTML .verify-badge: gap:3px;font-size:10.5px → 6rpx / 21rpx；
   padding:2px 7px 2px 5px → 4rpx 14rpx 4rpx 10rpx */
.verify-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--brand);
  background: var(--brand-subtle);
  border-radius: var(--r-pill);
  padding: 4rpx 14rpx 4rpx 10rpx;
  letter-spacing: 0.01em;
}

/* HTML .verify-badge svg: width:11px;height:11px → 22rpx */
.verify-icon {
  width: 22rpx;
  height: 22rpx;
}

/* HTML .worker-rating: gap:3px;font-size:12.5px → 6rpx / 25rpx；color:var(--orange) */
.worker-rating {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--accent);
}

/* HTML .worker-rating svg: width:13px;height:13px → 26rpx */
.rating-icon {
  width: 26rpx;
  height: 26rpx;
}

/* HTML .quote-mid: gap:10px;margin-bottom:12px → 20rpx / 24rpx */
.quote-mid {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

/* HTML .quote-price: gap:1px → 2rpx */
.quote-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

/* HTML .currency: font-size:15px;font-weight:700 → 30rpx 700；color:var(--brand) */
.quote-price .currency {
  font-size: 30rpx;
  color: var(--brand);
  font-weight: 700;
}

/* HTML .amount: font-size:28px;font-weight:800 → 56rpx 800；letter-spacing:-0.03em */
.quote-price .amount {
  font-size: 56rpx;
  color: var(--brand);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1;
}

/* HTML .quote-note: font-size:12px;max-width:48% → 24rpx / 48% */
.quote-note {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
  text-align: right;
  max-width: 48%;
  line-height: 1.4;
}

/* HTML .quote-meta: gap:6px;font-size:11.5px;margin-bottom:14px → 12rpx / 23rpx / 28rpx */
.quote-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 23rpx;
  color: var(--text-2);
  font-weight: 500;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

/* HTML .meta-item: gap:3px → 6rpx */
.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

/* HTML .meta-item svg: width:13px;height:13px → 26rpx */
.meta-icon {
  width: 26rpx;
  height: 26rpx;
}

/* HTML .meta-dot: opacity:0.6 */
.meta-dot {
  color: var(--text-3);
  opacity: 0.6;
}

/* HTML .meta-arrival: color:var(--green);font-weight:600 */
.meta-arrival {
  color: var(--green);
  font-weight: 600;
}

/* HTML .quote-bottom: gap:12px;padding-top:12px;border-top:0.5px → 24rpx / 24rpx / 1rpx */
.quote-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--sep);
  position: relative;
  z-index: 1;
}

/* ===== Buttons — page-local .btn-neu-primary / .btn-neu-secondary（HTML 全局定义，app.wxss 未提供） ===== */
/* HTML .btn-neu-primary: brand-gradient pill 13px/600 + neu-out-sm + brand-glow + inset highlight */
.btn-neu-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;          /* 6px */
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border: 1rpx solid rgba(255, 255, 255, 0.40); /* 0.5px */
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx; /* 8px 16px */
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx var(--brand-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.30);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.btn-neu-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* HTML .btn-neu-secondary: glass pill 13px/600 + neu-out-md + inset highlights */
.btn-neu-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;          /* 6px */
  background: rgba(255, 255, 255, 0.92);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.95); /* 0.5px */
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx; /* 8px 16px */
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65), inset 0 -2rpx 2rpx rgba(0, 0, 0, 0.03);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
}
.btn-neu-secondary:active {
  box-shadow: var(--neu-inset-lg);
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.78);
}

/* HTML .quote-secondary: flex:0 0 auto;padding:0 18px;font-size:13px;min-height:44px → 0 36rpx / 26rpx / 88rpx */
.quote-secondary {
  flex: 0 0 auto;
  padding: 0 36rpx;
  font-size: 26rpx;
  min-height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* HTML .quote-primary: flex:1;padding:0 20px;font-size:13.5px;min-height:44px → 0 40rpx / 27rpx / 88rpx */
.quote-primary {
  flex: 1;
  padding: 0 40rpx;
  font-size: 27rpx;
  min-height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

/* HTML .quote-primary svg: width:14px;height:14px → 28rpx */
.btn-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ===== Bottom Safety Tip Card ===== */
/* HTML .safety-wrap: padding:20px 20px 0 → 40rpx 40rpx 0 */
.safety-wrap {
  padding: 40rpx 40rpx 0;
  position: relative;
  z-index: 1;
}

/* HTML .safety-card: gap:10px;padding:13px 16px → 20rpx / 26rpx 32rpx */
.safety-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 32rpx;
  position: relative;
}

/* HTML .safety-icon: width:30px;height:30px → 60rpx；box-shadow:var(--neu-in) */
.safety-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--brand-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  box-shadow: var(--neu-inset-sm);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

/* HTML .safety-icon svg: width:16px;height:16px → 32rpx */
.safety-icon-img {
  width: 32rpx;
  height: 32rpx;
}

/* HTML .safety-text: font-size:11.5px;line-height:1.45 → 23rpx / 1.45 */
.safety-text {
  font-size: 23rpx;
  color: var(--text-2);
  font-weight: 500;
  line-height: 1.45;
  position: relative;
  z-index: 1;
}

/* ===== 空态 ===== */
.empty {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
  gap: 16rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 16rpx;
}

.empty-img {
  width: 80rpx;
  height: 80rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-2);
  font-weight: 500;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-3);
}
