/* pages/worker-training-exam/index.wxss — 师傅培训考试 玻璃新拟态
 * 像素级复刻 worker-training-exam.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

/* ===== 师傅端品牌色覆盖（蓝色 #2D6CDF） ===== */
page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== Section + Card ===== */
/* HTML: section padding:0 24px; margin-top:20px */
.section {
  padding: 0 48rpx;      /* 0 24px */
  margin-top: 40rpx;     /* 20px */
  position: relative;
  z-index: 5;
}
/* HTML: section-title 17px/700 flex space-between margin-bottom:12px */
.section-title {
  font-size: 34rpx;      /* 17px */
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;  /* 12px */
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* HTML: section-title .more 13px/500 text-3 */
.section-title .more {
  font-size: 26rpx;      /* 13px */
  font-weight: 500;
  color: var(--text-3);
}

/* HTML: card glass + neu-out-md + ring + teal env glow */
.card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);   /* var(--r) = 1.2rem */
  box-shadow: var(--neu-raised), 0 12rpx 48rpx rgba(0, 0, 0, 0.06), 0 0 0 2rpx rgba(44, 40, 36, 0.05), 0 4rpx 16rpx rgba(20, 184, 166, 0.04);
  overflow: hidden;
  position: relative;
}

/* ===== Exam Hero / 返回栏 ===== */
/* HTML: exam-hero padding: max(24px, env(safe-area-inset-top)) 24px 16px; border-radius:0 0 32px 32px */
.exam-hero {
  padding: 0 48rpx 32rpx;        /* 0 24px 16px */
  /* padding-top 由内联 style 动态提供（statusBarHeight + 48rpx ≈ 24px） */
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 25% 40%, rgba(212,148,76,.12) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 80% 80%, rgba(45, 108, 223, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.28) 0%, rgba(212,148,76,.10) 50%, rgba(45, 108, 223, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;  /* 0 0 32px 32px */
  overflow: hidden;
}
/* HTML: exam-hero::before 右上 220x220 径向光晕 */
.exam-hero::before {
  content: "";
  position: absolute;
  top: -30%;
  right: -15%;
  width: 440rpx;       /* 220px */
  height: 440rpx;      /* 220px */
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
/* HTML: exam-hero::after 左下 180x180 径向光晕 */
.exam-hero::after {
  content: "";
  position: absolute;
  bottom: -25%;
  left: -8%;
  width: 360rpx;       /* 180px */
  height: 360rpx;      /* 180px */
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* HTML: exam-nav display:flex; justify-content:space-between; gap:12px; z-index:2 */
.exam-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;          /* 12px */
  position: relative;
  z-index: 2;
}
/* HTML: back-btn 44x44 圆形玻璃 + neu-out-sm + brand 色 */
.back-btn {
  width: 88rpx;        /* 44px */
  height: 88rpx;       /* 44px */
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), background 0.15s ease;
}
.back-btn:active {
  transform: scale(0.85);
  background: rgba(255, 255, 255, 0.70);
}
/* HTML: back-btn svg 22x22 */
.back-btn-icon { width: 44rpx; height: 44rpx; display: inline-block; }

/* HTML: exam-nav-title-block flex:1 text-align:center */
.exam-nav-title-block {
  flex: 1;
  min-width: 0;
  text-align: center;
}
/* HTML: exam-nav-title 17px/700 -0.02em line-height:1.2 */
.exam-nav-title {
  font-size: 34rpx;    /* 17px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  line-height: 1.2;
  display: block;
}
/* HTML: exam-nav-sub 12px text-2 margin-top:2px 500 */
.exam-nav-sub {
  font-size: 24rpx;    /* 12px */
  color: var(--text-2);
  margin-top: 4rpx;    /* 2px */
  font-weight: 500;
  letter-spacing: 0.01em;
  display: block;
}

/* HTML: withdraw-circle 44x44 圆形玻璃 + neu-out-sm + brand 色 */
.withdraw-circle {
  width: 88rpx;        /* 44px */
  height: 88rpx;       /* 44px */
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), background 0.15s ease;
}
.withdraw-circle:active {
  transform: scale(0.85);
  background: rgba(255, 255, 255, 0.70);
}
.withdraw-circle-icon { width: 44rpx; height: 44rpx; display: inline-block; }

/* HTML: exit-hint display:flex; center; gap:5px; margin-top:14px; 11.5px text-2 500 */
.exit-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;          /* 5px */
  margin-top: 28rpx;   /* 14px */
  position: relative;
  z-index: 2;
  font-size: 23rpx;    /* 11.5px */
  color: var(--text-2);
  font-weight: 500;
  letter-spacing: 0.01em;
}
/* HTML: exit-hint svg 13x13 orange */
.exit-hint-icon { width: 26rpx; height: 26rpx; display: inline-block; flex-shrink: 0; }

/* ===== 考试进度条卡 ===== */
/* HTML: exam-progress-section margin-top:-10px; z-index:10 */
.exam-progress-section {
  margin-top: -20rpx;  /* -10px */
  position: relative;
  z-index: 10;
}
/* HTML: exam-progress-card padding:16px 18px */
.exam-progress-card {
  padding: 32rpx 36rpx;  /* 16px 18px */
}
/* HTML: progress-top display:flex; justify-content:space-between; margin-bottom:12px */
.progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;  /* 12px */
  position: relative;
  z-index: 1;
}
/* HTML: progress-label 14px/600 -0.01em tabular-nums; em brand 700 */
.progress-label {
  font-size: 28rpx;    /* 14px */
  color: var(--text-1);
  font-weight: 600;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}
.progress-label .em {
  color: var(--brand);
  font-weight: 700;
  font-style: normal;
}
/* HTML: progress-timer inline-flex gap:5px 15px/700 orange tabular-nums */
.progress-timer {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;          /* 5px */
  font-size: 30rpx;    /* 15px */
  font-weight: 700;
  color: var(--orange);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
}
/* HTML: progress-timer svg 16x16 orange */
.progress-timer-icon { width: 32rpx; height: 32rpx; display: inline-block; }

/* HTML: progress-bar-wrap 8px pill inset shadow */
.progress-bar-wrap {
  height: 16rpx;       /* 8px */
  border-radius: var(--r-pill);
  background: var(--fill);
  box-shadow: inset 4rpx 4rpx 8rpx var(--neu-dark), inset -4rpx -4rpx 8rpx var(--neu-light);
  overflow: hidden;
  position: relative;
  z-index: 1;
}
/* HTML: progress-bar linear brand-mid→brand + glow */
.progress-bar {
  height: 100%;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, var(--brand-mid) 0%, var(--brand) 100%);
  box-shadow: 0 0 20rpx var(--brand-glow);
  transition: width 0.4s var(--ease);
}

/* ===== 题目卡 ===== */
/* HTML: question-card padding:20px 20px 16px */
.question-card {
  padding: 40rpx 40rpx 32rpx;  /* 20px 20px 16px */
}
/* HTML: question-head flex space-between margin-bottom:14px */
.question-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;  /* 14px */
  position: relative;
  z-index: 1;
}
/* HTML: question-type-badge pill 4px 11px brand-subtle 11.5px/600 */
.question-type-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;    /* 4px 11px */
  border-radius: var(--r-pill);
  background: var(--brand-subtle);
  border: 1rpx solid rgba(45, 108, 223, 0.22);
  color: var(--brand);
  font-size: 23rpx;       /* 11.5px */
  font-weight: 600;
  letter-spacing: 0.02em;
}
/* HTML: question-no 12.5px text-2 500 tabular-nums */
.question-no {
  font-size: 25rpx;     /* 12.5px */
  color: var(--text-2);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

/* HTML: question-stem 17px/600 line-height:1.55 margin-bottom:18px */
.question-stem {
  display: block;
  font-size: 34rpx;      /* 17px */
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.55;
  letter-spacing: -0.01em;
  margin-bottom: 36rpx;  /* 18px */
  position: relative;
  z-index: 1;
}

/* HTML: option-list flex column gap:10px */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;          /* 10px */
  position: relative;
  z-index: 1;
}
/* HTML: option-item flex gap:12px padding:14px 16px r radius glass 1.5px transparent border neu-out-sm */
.option-item {
  display: flex;
  align-items: center;
  gap: 24rpx;          /* 12px */
  padding: 28rpx 32rpx;  /* 14px 16px */
  border-radius: var(--r-md);  /* var(--r) = 1.2rem */
  background: rgba(255, 255, 255, 0.42);
  border: 3rpx solid transparent;  /* 1.5px */
  box-shadow: var(--neu-raised-sm);
  font-family: var(--font-body);
  text-align: left;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
  position: relative;
}
.option-item:active {
  transform: scale(0.98);
  box-shadow: var(--neu-inset);
}
/* HTML: option-letter 30x30 圆 inset shadow 14px/700 */
.option-letter {
  width: 60rpx;        /* 30px */
  height: 60rpx;       /* 30px */
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  box-shadow: inset 4rpx 4rpx 8rpx var(--neu-dark), inset -4rpx -4rpx 8rpx var(--neu-light);
  color: var(--text-2);
  font-size: 28rpx;    /* 14px */
  font-weight: 700;
  transition: background var(--dur-base) var(--ease), color var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
}
/* HTML: option-text flex:1 15px/500 -0.01em */
.option-text {
  flex: 1;
  font-size: 30rpx;    /* 15px */
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: -0.01em;
  transition: color var(--dur-base) var(--ease), font-weight var(--dur-base) var(--ease);
}

/* HTML: option-item.selected brand 0.10 bg + brand border + 3px brand-glow ring */
.option-item.selected {
  background: rgba(45, 108, 223, 0.10);
  border-color: var(--brand);
  box-shadow: var(--neu-raised-sm), 0 0 0 6rpx var(--brand-glow);  /* 3px ring */
}
/* HTML: option-item.selected .option-letter brand bg white text + glow */
.option-item.selected .option-letter {
  background: var(--brand);
  color: #fff;
  box-shadow: 0 8rpx 20rpx var(--brand-glow), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.30);
}
/* HTML: option-item.selected .option-text brand 600 */
.option-item.selected .option-text {
  color: var(--brand);
  font-weight: 600;
}
/* HTML: option-check 20x20 brand */
.option-check {
  width: 40rpx;        /* 20px */
  height: 40rpx;       /* 20px */
  color: var(--brand);
  flex-shrink: 0;
  display: inline-block;
}

/* HTML: question-foot 12px text-2 center margin-top:14px */
.question-foot {
  display: block;
  margin-top: 28rpx;   /* 14px */
  font-size: 24rpx;    /* 12px */
  color: var(--text-2);
  text-align: center;
  position: relative;
  z-index: 1;
  letter-spacing: 0.01em;
}

/* ===== 答题卡 ===== */
/* HTML: answer-sheet-card padding:18px */
.answer-sheet-card {
  padding: 36rpx;      /* 18px */
}
/* HTML: answer-grid grid 5列 gap:10px */
.answer-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20rpx;          /* 10px */
  position: relative;
  z-index: 1;
}
/* HTML: ans-cell 1:1 r-sm radius 14px/600 text-2 bg 1.5px transparent border neu-out-sm */
.ans-cell {
  aspect-ratio: 1 / 1;
  border-radius: var(--r-sm);   /* 0.75rem */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;    /* 14px */
  font-weight: 600;
  color: var(--text-2);
  background: var(--bg);
  border: 3rpx solid transparent;  /* 1.5px */
  box-shadow: var(--neu-raised-sm);
  font-family: var(--font-body);
  font-variant-numeric: tabular-nums;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.ans-cell:active {
  transform: scale(0.92);
  box-shadow: var(--neu-inset);
}
/* HTML: ans-cell.answered brand bg white text + brand-glow shadow */
.ans-cell.answered {
  background: var(--brand);
  color: #fff;
  box-shadow: var(--neu-raised-sm), 0 8rpx 24rpx var(--brand-glow);
}
/* HTML: ans-cell.current brand-subtle bg brand text brand border 3px brand-glow ring */
.ans-cell.current {
  background: rgba(45, 108, 223, 0.08);
  color: var(--brand);
  border-color: var(--brand);
  box-shadow: var(--neu-raised-sm), 0 0 0 6rpx var(--brand-glow);  /* 3px ring */
}

/* HTML: answer-legend flex center gap:18px margin-top:16px padding-top:14px border-top */
.answer-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;          /* 18px */
  margin-top: 32rpx;   /* 16px */
  padding-top: 28rpx;  /* 14px */
  border-top: 1rpx solid var(--sep);  /* 0.5px */
  position: relative;
  z-index: 1;
}
/* HTML: legend-item inline-flex gap:5px 12px text-2 500 */
.legend-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;          /* 5px */
  font-size: 24rpx;    /* 12px */
  color: var(--text-2);
  font-weight: 500;
}
/* HTML: legend-item .dot 12x12 r-sm(4px) bg inset shadow 1.5px transparent border */
.legend-item .dot {
  width: 24rpx;        /* 12px */
  height: 24rpx;       /* 12px */
  border-radius: 8rpx; /* 4px */
  background: var(--bg);
  box-shadow: inset 2rpx 2rpx 4rpx var(--neu-dark), inset -2rpx -2rpx 4rpx var(--neu-light);
  border: 3rpx solid transparent;  /* 1.5px */
}
.legend-item .dot.answered {
  background: var(--brand);
  box-shadow: none;
}
.legend-item .dot.current {
  background: rgba(45, 108, 223, 0.08);
  border-color: var(--brand);
  box-shadow: none;
}

/* ===== 底部固定双按钮 ===== */
/* HTML: exam-footer position:absolute bottom:0 padding:14px 24px 18px flex gap:12px */
.exam-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 28rpx 48rpx 36rpx;  /* 14px 24px 18px */
  background: linear-gradient(180deg, rgba(242, 237, 232, 0) 0%, rgba(242, 237, 232, 0.92) 32%, var(--bg) 60%);
  display: flex;
  gap: 24rpx;          /* 12px */
  align-items: center;
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}
/* HTML: btn-neu-ghost transparent text-2 0.5px border pill 8px 16px 13px/600 */
.btn-neu-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;          /* 6px */
  background: transparent;
  color: var(--text-2);
  border: 1rpx solid var(--border);
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx;  /* 8px 16px */
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
  font-family: var(--font-body);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), color var(--dur-base) var(--ease);
}
.btn-neu-ghost:active {
  transform: scale(0.94);
  color: var(--brand);
}
.btn-neu-ghost.disabled {
  opacity: 0.4;
  pointer-events: none;
}
/* HTML: btn-neu-primary brand-gradient bg white pill 14px 24px 15px/600 neu-out-sm + brand-glow */
.btn-neu-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;          /* 6px */
  background: var(--brand-gradient);
  color: #fff;
  border: none;
  border-radius: var(--r-pill);
  padding: 28rpx 48rpx;  /* 14px 24px */
  font-size: 30rpx;     /* 15px */
  font-weight: 600;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), 0 12rpx 36rpx var(--brand-glow);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.btn-neu-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}
/* HTML: exam-btn-prev flex:1 14px 20px 15px gap:6px */
.exam-btn-prev {
  flex: 1;
  padding: 28rpx 40rpx;  /* 14px 20px */
  font-size: 30rpx;      /* 15px */
  gap: 12rpx;           /* 6px */
}
/* HTML: exam-btn-next flex:1.5 14px 20px 15px */
.exam-btn-next {
  flex: 1.5;
  padding: 28rpx 40rpx;  /* 14px 20px */
  font-size: 30rpx;      /* 15px */
}
/* HTML: exam-btn-prev/next svg 18x18 */
.exam-btn-icon {
  width: 36rpx;        /* 18px */
  height: 36rpx;       /* 18px */
  display: inline-block;
}
