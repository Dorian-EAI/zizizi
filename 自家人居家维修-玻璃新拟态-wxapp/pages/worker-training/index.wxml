<!-- pages/worker-training/index.wxml — 师傅培训中心 玻璃新拟态（像素级复刻 worker-training.html） -->
<view class="page">
  <!-- 背景装饰光斑：blue-gold 径向渐变 -->
  <view class="blob" style="top: -40px; right: -60px; width: 280px; height: 280px; background: radial-gradient(circle, var(--brand) 0%, transparent 70%);"></view>
  <view class="blob" style="top: 420px; left: -80px; width: 240px; height: 240px; background: radial-gradient(circle, var(--sage) 0%, transparent 70%);"></view>

  <scroll-view scroll-y class="page-scroll hide-scroll" style="padding-bottom: 80rpx;">

    <!-- ===== Back Bar ===== -->
    <!-- HTML: padding: max(16px, env(safe-area-inset-top)) 24px 16px; border-radius:0 0 28px 28px -->
    <view class="back-bar worker" style="padding-top: calc({{statusBarHeight}}px + 32rpx);">
      <!-- HTML: back-btn 40x40 圆形玻璃 brand 色 -->
      <view class="back-btn" bindtap="onBack">
        <image src="{{icons.back}}" mode="aspectFit" class="back-btn-icon" lazy-load="{{false}}" />
      </view>
      <text class="back-title">培训中心</text>
      <view class="back-spacer"></view>
    </view>

    <!-- ===== Training Stats Hero (glass gradient) ===== -->
    <!-- HTML: margin:4px 24px 0; padding:22px 22px 20px; border-radius:var(--r-lg) -->
    <view class="training-hero">
      <!-- HTML: th-top display:flex; justify-content:space-between; gap:12px; margin-bottom:18px -->
      <view class="th-top">
        <view class="th-label-block">
          <!-- HTML: th-label 13px/500 -->
          <text class="th-label">培训学分</text>
          <!-- HTML: th-amount 38px/800 brand + th-unit 16px/600 -->
          <view class="th-amount-row">
            <text class="th-amount numeric">{{stats.credit}}</text>
            <text class="th-unit">分</text>
          </view>
        </view>
        <view class="th-meta">
          <!-- HTML: th-meta-label 12px/500 -->
          <text class="th-meta-label">已完成</text>
          <!-- HTML: th-meta-value 15px/700 pill glass -->
          <view class="th-meta-value">
            <text class="numeric">{{stats.completedCount}}</text>
            <text class="th-meta-divider">/</text>
            <text class="numeric">{{stats.totalCourses}}</text>
            <text class="th-meta-unit">门</text>
          </view>
        </view>
      </view>

      <!-- HTML: th-progress display:flex; gap:10px; margin-bottom:10px -->
      <view class="th-progress">
        <!-- HTML: th-progress-track 8px pill glass inset shadow -->
        <view class="th-progress-track">
          <view class="th-progress-fill" style="width:{{stats.creditPercent}}%"></view>
        </view>
        <!-- HTML: th-progress-text 12px/700 brand -->
        <text class="th-progress-text numeric">{{stats.completedCount}}/{{stats.totalCourses}}</text>
      </view>

      <!-- HTML: th-hint 12px/500 -->
      <text class="th-hint">课程完成进度，以服务端学习记录为准</text>
    </view>

    <!-- ===== 培训课程 ===== -->
    <!-- HTML: section padding:0 24px; margin-top:22px -->
    <view class="section">
      <view class="section-title-row"><text>培训课程</text></view>
      <!-- HTML: course-stack flex column gap:12px -->
      <view class="course-stack">
        <block wx:for="{{courses}}" wx:key="id">
          <view
            class="course-card"
            wx:if="{{activeTab === 'all' || item.category === activeTab}}"
            data-id="{{item.id}}"
          >
            <!-- HTML: course-icon 46x46 圆 + svg 22x22 -->
            <view class="course-icon icon-indigo" wx:if="{{item.category === 'required'}}">
              <image src="{{icons.book}}" mode="aspectFit" class="course-icon-img" lazy-load="{{false}}" />
            </view>
            <view class="course-icon icon-amber" wx:elif="{{item.category === 'optional'}}">
              <image src="{{icons.smile}}" mode="aspectFit" class="course-icon-img" lazy-load="{{false}}" />
            </view>
            <view class="course-icon icon-blue" wx:elif="{{item.category === 'skill'}}">
              <image src="{{icons.zap}}" mode="aspectFit" class="course-icon-img" lazy-load="{{false}}" />
            </view>
            <view class="course-icon icon-green" wx:else>
              <image src="{{icons.carpentry}}" mode="aspectFit" class="course-icon-img" lazy-load="{{false}}" />
            </view>

            <view class="course-info">
              <!-- HTML: course-name 15px/600 -->
              <text class="course-name">{{item.title}}</text>
              <!-- HTML: course-meta 12px/500 -->
              <text class="course-meta">{{item.durationText}} · {{item.creditText}}</text>
              <!-- HTML: course-progress margin-top:6px; track 5px -->
              <view class="course-progress" wx:if="{{item.progress > 0 && item.progress < 100}}">
                <view class="course-progress-track">
                  <view class="course-progress-fill" style="width:{{item.progress}}%"></view>
                </view>
              </view>
            </view>

            <!-- HTML: course-right flex column align-end gap:8px -->
            <view class="course-right">
              <view class="course-status done" wx:if="{{item.progress >= 100}}">
                <image src="{{icons.check}}" mode="aspectFit" class="course-status-icon" lazy-load="{{false}}" />
                <text>已完成</text>
              </view>
              <view class="course-status learning" wx:elif="{{item.progress > 0}}">
                <text>学习中 {{item.progress}}%</text>
              </view>
              <view class="course-status learning" wx:elif="{{item.learnStatus === 'studying'}}">
                <text>学习中</text>
              </view>
              <view class="course-status todo" wx:else>
                <text>未开始</text>
              </view>

              <view
                class="btn-neu-primary course-btn"
                wx:if="{{item.learnStatus === 'not_started'}}"
                data-id="{{item.id}}"
                catchtap="onStartCourse"
              >开始学习</view>
              <view
                class="btn-neu-primary course-btn"
                wx:elif="{{item.learnStatus === 'studying'}}"
                data-id="{{item.id}}"
                catchtap="onContinueCourse"
              >继续学习</view>
              <view
                class="btn-neu-secondary course-btn"
                wx:else
                data-id="{{item.id}}"
                catchtap="onContinueCourse"
              >参加考试</view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- ===== 学习说明 ===== -->
    <view class="section">
      <view class="section-title-row"><text>学习说明</text></view>
      <!-- HTML: benefit-card padding:18px -->
      <view class="card benefit-card">
        <!-- HTML: benefit-desc 14px/600 border-bottom -->
        <text class="benefit-desc">学分只反映已记录的课程学习结果</text>
        <!-- HTML: check-list gap:11px -->
        <view class="check-list">
          <view class="check-item" wx:for="{{benefits}}" wx:key="prefix">
            <view class="check-mark">
              <image src="{{icons.checkGreen}}" mode="aspectFit" class="check-mark-icon" lazy-load="{{false}}" />
            </view>
            <text class="check-text">{{item.prefix}}<text class="check-strong" wx:if="{{item.highlight}}">{{item.highlight}}</text>{{item.suffix}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 查看学习记录 ===== -->
    <!-- HTML: records-link-wrap padding:24px 24px 4px; center -->
    <view class="records-link-wrap">
      <view class="records-link" bindtap="onViewRecords">
        <text>查看学习记录</text>
        <image src="{{icons.arrowRight}}" mode="aspectFit" class="records-link-icon" lazy-load="{{false}}" />
      </view>
    </view>

    <view class="scroll-bottom-spacer"></view>
  </scroll-view>
</view>
