<view class="phone-page design-detail-page" data-page-id="page-client-refund">
  <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" bindtap="onBack"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">申请退款</view><text class="tag-span"></text></view>
  <view class="page-body">
    <view class="notice error" wx:if="{{loadError}}">{{loadError}}</view>
    <view class="card" wx:if="{{order}}"><view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M14.7%206.3a4%204%200%200%200-5-5L12%203.6%209.6%206%207.3%203.7a4%204%200%200%200%205%205L4%2017l3%203%208.3-8.3a4%204%200%200%200%205-5L18%209l-2.4-2.4%202.3-2.3a4%204%200%200%200-3.2%202Z%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">{{order.serviceName}}</view><view class="row-copy">订单 {{order.orderNo}} · {{order.statusText}}</view></view><text class="row-value tag-span">¥{{order.amountText}}</text></view></view>
    <view class="section"><view class="section-title"><text class="tag-strong">退款类型</text></view><view class="segmented"><view class="segment design-button {{refundType === 'full' ? 'active' : ''}}" data-type="full" bindtap="onType">全额退款</view><view class="segment design-button {{refundType === 'partial' ? 'active' : ''}}" data-type="partial" bindtap="onType">部分退款</view></view></view>
    <view class="section"><view class="section-title"><text class="tag-strong">退款原因</text><text class="tag-span">单选</text></view><view class="chips"><view class="chip design-button {{reason === '服务质量问题' ? 'active' : ''}}" data-reason="服务质量问题" bindtap="onReason">服务质量差</view><view class="chip design-button {{reason === '服务未完成' ? 'active' : ''}}" data-reason="服务未完成" bindtap="onReason">未完成服务</view><view class="chip design-button {{reason === '上门时间争议' ? 'active' : ''}}" data-reason="上门时间争议" bindtap="onReason">师傅迟到</view><view class="chip design-button {{reason === '价格争议' ? 'active' : ''}}" data-reason="价格争议" bindtap="onReason">价格争议</view><view class="chip design-button {{reason === '其他' ? 'active' : ''}}" data-reason="其他" bindtap="onReason">其他</view></view></view>
    <view class="field"><text class="tag-label">申请退款金额 · 最多 ¥{{order ? order.amountText : '—'}}</text><input class="input" type="digit" value="{{amount}}" disabled="{{!order}}" bindinput="onAmount" placeholder="请输入申请金额" /></view>
    <view class="field"><text class="tag-label">退款说明</text><textarea class="textarea" maxlength="500" value="{{note}}" bindinput="onNote" placeholder="请详细描述退款原因"></textarea></view>
    <view class="section"><view class="section-title"><text class="tag-strong">上传凭证</text><text class="badge warning tag-span">暂未开放</text></view><view class="upload-grid"><view class="upload-tile is-disabled">＋</view><view class="upload-tile is-disabled">＋</view><view class="upload-tile is-disabled">＋</view></view></view>
    <view class="notice info">当前提交的是退款审核工单，不直接执行退款。只有平台管理员审核后才可能进入真实退款链路。</view>
  </view>
  <view class="fixed-actions"><view class="btn primary design-button {{submitting || !order ? 'is-disabled' : ''}}" bindtap="onSubmit">{{submitting ? '正在提交审核工单…' : '提交退款审核工单'}}</view></view>
</view>
