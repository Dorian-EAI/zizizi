/* pages/client-order-tracking/index.wxss — 用户端实时追踪页 玻璃新拟态
 * 像素级复刻 zjrnew/pages/client-order-tracking.html + client-order-tracking-2.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 滚动变形：nav-bar → top-header（Hero + 状态横幅），地图收缩，状态横幅上浮
 */

/* ===== 页面布局 ===== */
.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.page-scroll {
  flex: 1;
  min-height: 0;
  background: transparent;
}

/* ===== 加载/错误态 ===== */
.state-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 400rpx 128rpx 160rpx;
  z-index: 1;
}

.state-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.state-spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid var(--fill);
  border-top-color: var(--brand);
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-emoji {
  font-size: 56rpx;
}

.state-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
}

.state-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 32rpx;
}

.state-retry-btn {
  padding: 16rpx 56rpx;
  border-radius: var(--r-pill);
  background: var(--brand);
}

.state-retry-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ===== 顶部 Hero + Nav + Status Tabs（复刻 client-order-tracking-2.html .top-header） ===== */
/* HTML: .top-header{position:sticky;top:0;z-index:50} 内含 .hero + .filter-tabs */
.top-header {
  position: relative;
  z-index: 50;
  padding-left: var(--nav-ph, 40rpx);
  padding-right: var(--nav-ph, 40rpx);
  padding-bottom: var(--nav-pb, 36rpx);
  border-radius: 0 0 var(--nav-radius, 64rpx) var(--nav-radius, 64rpx);
  overflow: hidden;
}

.top-header.nav-bar {
  display: block;
  align-items: initial;
  justify-content: initial;
  background: transparent;
}

/* Hero 渐变背景层 */
.hero-gradient {
  position: absolute;
  inset: 0;
  z-index: 0;
  border-radius: inherit;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

/* Hero 光斑装饰（复刻 .hero::before / .hero::after） */
.hero-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.hero-blob-1 {
  top: -30%;
  right: -15%;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
}
.hero-blob-2 {
  bottom: -30%;
  left: -10%;
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(200, 255, 250, 0.10) 0%, transparent 70%);
}

/* ===== 导航内容（Grid 布局：按钮 | 标题 | 按钮，复刻 .nav-content grid-template-columns） ===== */
.nav-content {
  display: grid;
  grid-template-columns: var(--btn-size, 80rpx) 1fr var(--btn-size, 80rpx);
  gap: 16rpx;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* HTML: width:40px;height:40px; border-radius:50%; */
.nav-icon-btn {
  width: var(--btn-size, 80rpx);
  height: var(--btn-size, 80rpx);
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  flex-shrink: 0;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease), width 0.05s linear, height 0.05s linear;
}

.nav-icon-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* 玻璃态按钮（复刻 HTML .nav-back / .nav-edit 滚动后玻璃态） */
.nav-icon-btn.glass-btn {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.30);
  justify-self: start;
}

.nav-icon-btn.glass-btn.nav-refresh {
  justify-self: end;
}

.nav-icon-btn.glass-btn:active {
  transform: scale(0.85);
  background: rgba(255, 255, 255, 0.32);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.30);
}

.nav-icon {
  width: 40rpx;
  height: 40rpx;
}

/* HTML: font-size:17px; font-weight:700; → 34rpx */
.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  text-align: center;
  justify-self: center;
  transition: font-size 0.05s linear;
}

/* ===== 状态横幅（固定在 hero 下方，复刻 .filter-tabs margin:-18px 20px 0） ===== */
.filter-tabs.status-tabs {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: calc(100% - 32rpx);
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  z-index: 10;
  overflow: hidden;
}

.filter-tabs.status-tabs::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
}

/* ===== Sections ===== */
/* HTML: .section{padding:0 20px;margin-top:16px;} → 0 40rpx; 32rpx */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}

.section:first-of-type {
  margin-top: 0;
}

.section-link {
  display: flex;
  justify-content: center;
  padding-top: 8rpx;
  padding-bottom: 40rpx;
}

.section.copied-below-anchor {
  margin-top: 32rpx;
}

/* ===== 地图区 ===== */
.tracking-map-section {
  position: relative;
  margin-top: 0;
  z-index: 1;
}

/* 地图顶部渐变叠加 */
.tracking-map-section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  z-index: 3;
  background: linear-gradient(180deg, rgba(13, 148, 136, 0.16) 0%, rgba(212, 148, 76, 0.08) 45%, transparent 100%);
  pointer-events: none;
}

/* HTML: height:420px; background:linear-gradient(180deg,#DBE8EC 0%,#C8D8DE 60%,#BECED4 100%); */
.tracking-map {
  position: relative;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #DBE8EC 0%, #C8D8DE 60%, #BECED4 100%);
  overflow: hidden;
  transform-origin: center center;
  transition: transform 0.05s linear, opacity 0.05s linear;
}

.map-canvas {
  width: 100%;
  height: 100%;
}

/* 模拟地图装饰层 */
.map-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
}

/* HTML: background-size:42px 42px; → 84rpx */
.map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.28) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.28) 1rpx, transparent 1rpx);
  background-size: 84rpx 84rpx;
  opacity: 0.6;
}

/* HTML: .map-road{height:18px/14px/16px;} → 36rpx/28rpx/32rpx */
.map-road {
  position: absolute;
  background: rgba(255, 255, 255, 0.55);
  border-radius: var(--r-pill);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.7), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.map-road-1 { top: 18%; left: -10%; width: 120%; height: 36rpx; transform: rotate(-12deg); }
.map-road-2 { top: 48%; left: -5%; width: 110%; height: 28rpx; transform: rotate(6deg); }
.map-road-3 { top: 72%; left: 5%; width: 90%; height: 32rpx; transform: rotate(-4deg); }

/* HTML: width:140px;height:140px; → 280rpx */
.map-park {
  position: absolute;
  top: 10%;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(91, 140, 90, 0.16);
  border-radius: 50%;
  filter: blur(4rpx);
}

.map-marker {
  position: absolute;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.map-marker.force-visible,
.force-visible {
  opacity: 1;
  visibility: visible;
}

.marker-core {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx rgba(0, 0, 0, 0.12);
  position: relative;
  z-index: 2;
}

.marker-icon {
  width: 44rpx;
  height: 44rpx;
}

.worker-marker {
  top: 24%;
  right: 22%;
  width: 88rpx;
  height: 88rpx;
}

.worker-marker-core {
  background: var(--brand);
}

.marker-pulse {
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--brand);
  opacity: 0.25;
  animation: markerPulse 2s var(--ease) infinite;
}

@keyframes markerPulse {
  0% { transform: translate(-50%, -50%) scale(1); opacity: 0.25; }
  70% { transform: translate(-50%, -50%) scale(1.6); opacity: 0; }
  100% { transform: translate(-50%, -50%) scale(1.6); opacity: 0; }
}

.dest-marker {
  bottom: 22%;
  left: 26%;
}

.dest-marker-core {
  width: 80rpx;
  height: 80rpx;
  background: var(--red);
}

.dest-marker-core .marker-icon {
  width: 40rpx;
  height: 40rpx;
}

.marker-pin {
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 24rpx solid var(--red);
  margin-top: -8rpx;
}

/* ===== 状态横幅（浮动在地图下沿，初始 margin:-32px 20px 0 → -64rpx 40rpx 0） ===== */
.tracking-status-bar {
  position: relative;
  z-index: 15;
  margin: -64rpx 40rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx 36rpx;
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: var(--r-lg);
  box-shadow: var(--neu-raised), 0 16rpx 64rpx rgba(0, 0, 0, 0.08), 0 0 0 2rpx rgba(44, 40, 36, 0.04);
  overflow: hidden;
  transition: transform 0.05s linear, margin-top 0.05s linear, padding 0.05s linear;
}

.tracking-status-bar::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.06) 30%, transparent 55%);
  pointer-events: none;
}

.status-bar-main {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

/* HTML: font-size:17px; font-weight:700; → 34rpx */
.status-bar-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 10rpx;
}

/* HTML: width:10px;height:10px; → 20rpx */
.status-pulse-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 0 8rpx rgba(13, 148, 136, 0.18);
  animation: dotPulse 1.8s var(--ease) infinite;
  flex-shrink: 0;
}

@keyframes dotPulse {
  0% { transform: scale(1); opacity: 1; }
  70% { transform: scale(2.2); opacity: 0; }
  100% { transform: scale(2.2); opacity: 0; }
}

/* HTML: font-size:13px; → 26rpx */
.status-bar-meta {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* HTML: width:32px;height:32px; → 64rpx */
.status-bar-arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  color: var(--text-2);
  flex-shrink: 0;
}

.status-bar-arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

/* stale 警告 chip */
.chip {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  margin-top: 8rpx;
}

.chip-warning {
  background: var(--warning-bg);
  color: var(--warning);
}

/* ===== 师傅信息卡 ===== */
/* HTML: gap:14px;padding:16px 18px; → gap:28rpx;padding:32rpx 36rpx */
.tracking-worker-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx 36rpx;
}

.avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* HTML: width:52px;height:52px; → 104rpx */
.worker-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  position: relative;
  overflow: hidden;
}

.worker-avatar.avatar-glass {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.28) 40%, var(--brand-subtle) 78%, rgba(255, 255, 255, 0.18) 100%);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88), inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04), var(--neu-raised-sm);
}

.worker-avatar.avatar-glass::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0.12) 35%, transparent 60%);
  pointer-events: none;
}

/* HTML: svg{width:28px;} → 56rpx */
.worker-avatar-img {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  z-index: 1;
}

/* HTML: font-size:10.5px;padding:2px 8px; → 21rpx; 4rpx 16rpx */
.verify-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: var(--brand-subtle);
  color: var(--brand);
  font-size: 21rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  border: 1rpx solid rgba(13, 148, 136, 0.18);
}

.verify-icon {
  width: 22rpx;
  height: 22rpx;
}

.verify-text {
  font-size: 21rpx;
}

.worker-info {
  flex: 1;
  min-width: 0;
}

/* HTML: gap:8px;margin-bottom:5px; → 16rpx;10rpx */
.worker-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

/* HTML: font-size:17px; → 34rpx */
.worker-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

/* HTML: font-size:12.5px;gap:6px; → 25rpx;12rpx */
.worker-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  color: var(--text-2);
  font-weight: 500;
}

.worker-star {
  color: var(--orange);
  font-weight: 600;
}

.meta-dot {
  color: var(--text-3);
}

/* HTML: gap:10px; → 20rpx */
.worker-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

/* HTML: width:48px;height:48px; → 96rpx */
.action-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.action-circle:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.action-circle-accent {
  color: var(--accent-dark);
}

/* HTML: svg{width:22px;} → 44rpx */
.action-icon {
  width: 44rpx;
  height: 44rpx;
}

/* ===== 服务进度时间线 ===== */
/* HTML: padding:18px; → 36rpx */
.tracking-timeline-card {
  padding: 36rpx;
}

/* HTML: font-size:16px;margin-bottom:14px; → 32rpx;28rpx */
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 28rpx;
  display: block;
}

.tracking-timeline {
  display: flex;
  flex-direction: column;
}

/* HTML: gap:14px; → 28rpx */
.tt-item {
  display: flex;
  gap: 28rpx;
  position: relative;
}

.tt-item:not(.tt-last) {
  padding-bottom: 36rpx;
}

.tt-item:last-child {
  padding-bottom: 0;
}

/* HTML: width:22px;padding-top:2px; → 44rpx;4rpx */
.tt-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 44rpx;
  padding-top: 4rpx;
}

/* HTML: width:22px;height:22px; → 44rpx */
.tt-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

/* HTML: svg{width:12px;} → 24rpx */
.tt-check {
  width: 24rpx;
  height: 24rpx;
}

/* HTML: width:2px;min-height:18px;margin-top:4px; → 4rpx;36rpx;8rpx */
.tt-line {
  flex: 1;
  width: 4rpx;
  min-height: 36rpx;
  margin-top: 8rpx;
  border-radius: var(--r-pill);
  opacity: 0.35;
}

.tt-content {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

/* HTML: gap:10px;margin-bottom:3px; → 20rpx;6rpx */
.tt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 6rpx;
}

/* HTML: font-size:14.5px; → 29rpx */
.tt-title {
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
}

/* HTML: font-size:12px; → 24rpx */
.tt-time {
  font-size: 24rpx;
  font-weight: 500;
}

/* HTML: font-size:12px;line-height:1.45; → 24rpx */
.tt-desc {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
  line-height: 1.45;
}

/* Mono / Tabular nums */
.mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* Done 状态 */
/* HTML: box-shadow:0 0 0 4px var(--brand-subtle),0 2px 6px var(--brand-glow); → 8rpx;4rpx 12rpx */
.tt-done .tt-dot {
  background: var(--brand);
  color: var(--text-inverse);
  box-shadow: 0 0 0 8rpx var(--brand-subtle), 0 4rpx 12rpx var(--brand-glow);
}

.tt-done .tt-line {
  background: linear-gradient(180deg, var(--brand) 0%, var(--brand-mid) 100%);
}

.tt-done .tt-title { color: var(--text-1); }
.tt-done .tt-time { color: var(--text-2); }

/* Active 状态 */
/* HTML: box-shadow:0 0 0 4px rgba(212,148,76,0.16),0 2px 8px var(--accent-glow); → 8rpx;4rpx 16rpx */
.tt-active .tt-dot {
  background: var(--accent);
  color: var(--text-inverse);
  box-shadow: 0 0 0 8rpx rgba(212, 148, 76, 0.16), 0 4rpx 16rpx var(--accent-glow);
}

.tt-active .tt-line {
  background: linear-gradient(180deg, var(--accent) 0%, var(--text-3) 100%);
}

.tt-active .tt-title { color: var(--accent-dark); }
.tt-active .tt-time { color: var(--accent); }

/* HTML: width:8px;height:8px; → 16rpx */
.tt-dot-inner {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--text-inverse);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.35);
}

.tt-dot-pulse {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid var(--accent);
  animation: tlPulse 1.8s var(--ease) infinite;
}

@keyframes tlPulse {
  0% { transform: scale(1); opacity: 0.6; }
  70% { transform: scale(1.5); opacity: 0; }
  100% { transform: scale(1.5); opacity: 0; }
}

/* Pending 状态 */
/* HTML: border:1.5px solid var(--neu-dark); → 3rpx */
.tt-pending .tt-dot {
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
  border: 3rpx solid var(--neu-dark);
}

.tt-pending .tt-line { background: var(--neu-dark); }
.tt-pending .tt-title { color: var(--text-3); }
.tt-pending .tt-time { color: var(--text-3); }
.tt-pending .tt-desc { color: var(--text-3); }

/* ===== 查看订单详情链接 ===== */
/* HTML: font-size:14px;gap:4px;padding:8px 12px; → 28rpx;8rpx;16rpx 24rpx */
.order-detail-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: transparent;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  padding: 16rpx 24rpx;
  transition: transform 0.2s var(--spring), color 0.2s var(--ease);
}

.order-detail-link:active {
  transform: scale(0.96);
  color: var(--brand-dark);
}

/* HTML: svg{width:16px;} → 32rpx */
.order-detail-link-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 按压动效 ===== */
.press-scale {
  transition: transform 0.2s var(--spring);
}

.press-scale:active {
  transform: scale(0.96);
}

.press-neu {
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.press-neu:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* ===== Reduced Motion ===== */
@media (prefers-reduced-motion: reduce) {
  .status-pulse-dot,
  .tt-dot-pulse {
    animation: none;
    opacity: 0;
  }
}
