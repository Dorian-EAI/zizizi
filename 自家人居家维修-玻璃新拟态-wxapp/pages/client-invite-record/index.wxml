<view class="phone-page design-detail-page" data-page-id="page-client-invite-record">
  <view class="status-bar"><text>9:41</text><text class="status-icons">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" data-route="/pages/client-invite/index" bindtap="onNavigate"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">邀请记录</view><text></text></view>
  <view class="page-body">
    <view class="hero"><view class="hero-kicker tag-p">我的邀请成果</view><view class="grid-2"><view class="metric"><text class="tag-strong">—</text><text class="tag-span">已邀请好友</text></view><view class="metric"><text class="tag-strong">—</text><text class="tag-span">累计奖励</text></view></view><view class="tag-p">邀请人数、首单进度与奖励必须以服务端记录为准。</view></view>
    <view class="segmented"><view wx:for="{{tabs}}" wx:key="key" class="segment {{activeTab === item.key ? 'active' : ''}} design-button" data-key="{{item.key}}" bindtap="onTab">{{item.name}}</view></view>
    <view class="section"><view class="section-title"><text class="tag-strong">本月</text><text class="badge info">— 条</text></view><view class="card list-card"><view class="list-row"><text class="avatar">—</text><view class="row-main"><view class="row-title">邀请关系待核验</view><view class="row-copy">需服务端返回被邀请人脱敏信息</view></view><view class="row-value"><text class="badge warning">待接入</text><text>—</text></view></view><view class="list-row"><text class="avatar">—</text><view class="row-main"><view class="row-title">首单状态待核验</view><view class="row-copy">不展示画布中的示例手机号和订单状态</view></view><view class="row-value"><text class="badge warning">待核算</text><text>—</text></view></view><view class="list-row"><text class="avatar">—</text><view class="row-main"><view class="row-title">奖励结算待核验</view><view class="row-copy">奖励金额或积分由服务端最终签发</view></view><view class="row-value"><text class="badge warning">未开放</text><text>—</text></view></view></view></view>
    <view class="empty-state"><view class="tag-h3">暂无真实邀请记录</view><view class="tag-p">邀请服务尚未完成后端对接，已移除画布中的示例好友、手机号和奖励金额。</view></view>
    <view class="notice info">后续接入时需包含邀请码、被邀请人脱敏信息、首单状态、奖励结算及防刷校验。</view>
    <view class="btn primary block design-button" data-route="/pages/client-invite/index" bindtap="onNavigate">继续邀请好友</view>
  </view>
</view>
