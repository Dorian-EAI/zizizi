/* pages/client-annual-card/index.wxss — 家庭年卡 像素级复刻 client-annual-card.html */

/* ===== Nav Bar 局部覆写 ===== */
.nav-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--neu-raised-sm);
  transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
}
.nav-back:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.88);
}
.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ===== Nav Title 局部覆写（HTML .nav-title: font-size 18px → 36rpx；全局 .nav-title 为 34rpx，需覆写） ===== */
.nav-title {
  font-size: 36rpx;
}

/* ===== Nav Spacer 局部覆写（HTML 无 spacer，但全局 .nav-bar 用 space-between 需平衡；
   HTML .nav-back 36px → 72rpx，全局 .nav-spacer 为 88rpx，需覆写以匹配 nav-back 宽度） ===== */
.nav-spacer {
  width: 72rpx;
  height: 72rpx;
}

/* ===== 我的年卡（玻璃渐变卡） ===== */
.my-card-wrap {
  padding: 32rpx 40rpx 0;
  position: relative;
  z-index: 2;
}
.my-card {
  position: relative;
  padding: 44rpx 44rpx 40rpx;
  border-radius: 52rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 400rpx 320rpx at 80% 15%, rgba(212, 148, 76, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 15% 88%, rgba(13, 148, 136, 0.36) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.34) 0%, rgba(20, 184, 166, 0.22) 45%, rgba(212, 148, 76, 0.20) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: var(--neu-raised), inset 0 2rpx 0 rgba(255, 255, 255, 0.35), 0 16rpx 56rpx rgba(13, 148, 136, 0.10);
}
.my-card-shine {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.06) 30%, transparent 55%);
  pointer-events: none;
}
.my-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}
.my-card-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-inverse);
  letter-spacing: -0.01em;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.14);
}
.my-card-expire {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 9999rpx;
  padding: 8rpx 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.my-card-usage {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
}
.usage-num {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--text-inverse);
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.16);
}
.usage-used {
  font-size: 88rpx;
  font-weight: 800;
  letter-spacing: -3rpx;
  line-height: 1;
}
.usage-sep {
  font-size: 52rpx;
  font-weight: 600;
  opacity: 0.7;
  margin: 0 6rpx;
}
.usage-total {
  font-size: 52rpx;
  font-weight: 600;
  opacity: 0.7;
}
.usage-unit {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 12rpx;
  opacity: 0.88;
  align-self: flex-end;
  padding-bottom: 6rpx;
}
.usage-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 10rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.progress-track {
  height: 16rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.28);
  box-shadow: inset 3rpx 3rpx 6rpx rgba(0, 0, 0, 0.10), inset -2rpx -2rpx 4rpx rgba(255, 255, 255, 0.18);
  overflow: hidden;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}
.progress-fill {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #FFFFFF 0%, #FFF8F2 60%, #F5E6D0 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.14);
}
.my-card-bottom {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}
.btn-use {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-gradient);
  border-radius: 9999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  box-shadow: var(--neu-raised-sm), 0 8rpx 24rpx var(--brand-glow);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}
.btn-use:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.94);
}
.btn-use-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-inverse);
}
.btn-refund {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 9999rpx;
  padding: 16rpx 32rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}
.btn-refund:active {
  transform: scale(0.94);
}
.btn-refund-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
}

/* ===== Section Title ===== */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  padding: 44rpx 48rpx 28rpx;
  letter-spacing: -0.02em;
  position: relative;
  z-index: 2;
}

/* ===== Plan Cards ===== */
.plan-card {
  margin: 0 40rpx 24rpx;
  padding: 36rpx 36rpx 32rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-raised-sm);
  position: relative;
  z-index: 2;
  transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
}
.plan-card:active {
  transform: scale(0.98);
}
.plan-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
}
.plan-card--featured {
  border: 3rpx solid var(--brand);
  box-shadow: var(--neu-raised-sm), 0 0 0 6rpx var(--brand-subtle), 0 12rpx 40rpx var(--brand-glow);
}
.plan-card--selected {
  border: 3rpx solid var(--brand);
  box-shadow: var(--neu-raised-sm), 0 0 0 6rpx var(--brand-subtle), 0 12rpx 40rpx var(--brand-glow);
}
.plan-badge {
  position: absolute;
  top: -18rpx;
  right: 32rpx;
  z-index: 3;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
  box-shadow: 0 6rpx 20rpx var(--brand-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.30);
  letter-spacing: 1rpx;
}
.plan-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}
.plan-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}
.plan-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.plan-price .cur {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 600;
}
.plan-price .amt {
  font-size: 52rpx;
  color: var(--accent);
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1;
}
.plan-card--featured .plan-price .cur,
.plan-card--featured .plan-price .amt {
  color: var(--brand);
}
.plan-benefits {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}
.plan-benefit {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.plan-benefit-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.plan-benefit-text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.4;
}
.plan-choose {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  position: relative;
  z-index: 1;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}
.plan-choose:active {
  transform: scale(0.94);
}
.plan-choose-primary {
  background: var(--brand-gradient);
  border: 1rpx solid rgba(255, 255, 255, 0.30);
  box-shadow: var(--neu-raised-sm), 0 8rpx 24rpx var(--brand-glow);
}
.plan-choose-primary:active {
  box-shadow: var(--neu-inset-sm);
}
.plan-choose-secondary {
  background: rgba(255, 255, 255, 0.50);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  box-shadow: var(--neu-raised-sm);
}
.plan-choose-secondary:active {
  box-shadow: var(--neu-inset-sm);
}
.plan-choose-text {
  font-size: 28rpx;
  font-weight: 600;
}
.plan-choose-primary .plan-choose-text {
  color: var(--text-inverse);
}
.plan-choose-secondary .plan-choose-text {
  color: var(--brand);
}

/* ===== Chips ===== */
/* HTML .chips-wrap: gap 10px → 20rpx；padding 0 24px 8px → 0 48rpx 16rpx */
.chips-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 48rpx 16rpx;
  position: relative;
  z-index: 2;
}
/* HTML .chip 局部覆写：padding 8px 16px → 16rpx 32rpx；font-size 13px → 26rpx；
   background var(--bg-elevated)；box-shadow var(--neu-out-sm)。
   全局 .chip-neu 为 16rpx 36rpx / 27rpx / --bg / 自定义阴影，需局部覆写以像素级对齐 */
.chip-neu {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm);
}

/* ===== 权益对比表 ===== */
.compare-card {
  margin: 0 40rpx 24rpx;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow: var(--neu-raised-sm);
  overflow: hidden;
  position: relative;
  z-index: 2;
}
.compare-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}
.compare-row.head {
  border-bottom: 1rpx solid var(--hairline);
  font-weight: 700;
  color: var(--text-1);
  font-size: 24rpx;
}
.compare-row:not(.head):not(:last-child) {
  border-bottom: 1rpx solid var(--hairline);
}
.compare-label {
  flex: 0 0 160rpx;
  padding-left: 32rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.compare-col {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-1);
}
.compare-col.highlight {
  color: var(--brand);
  font-weight: 700;
}

/* ===== 底部购买栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 60;
  padding: 28rpx 40rpx;  /* HTML .bottom-bar: padding 14px 20px 22px → 28rpx 40rpx 44rpx */
  padding-bottom: calc(env(safe-area-inset-bottom) + 44rpx);  /* HTML .bottom-bar padding-bottom 22px → 44rpx（+安全区） */
  background: linear-gradient(to top, rgba(242, 237, 232, 0.98) 72%, rgba(242, 237, 232, 0.80) 88%, rgba(242, 237, 232, 0));
  backdrop-filter: blur(24rpx) saturate(160%);
  -webkit-backdrop-filter: blur(24rpx) saturate(160%);
}
.btn-buy {
  width: 100%;
  height: 100rpx;
  border-radius: 9999rpx;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 44rpx var(--brand-glow), var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.25);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}
.btn-buy:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset-sm);
}
.btn-buy-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}
