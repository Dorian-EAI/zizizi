<!-- pages/client-service-detail/index.wxml — 服务详情页 玻璃新拟态（像素级复刻 zjrnew.DESIGN） -->
<view class="page">
  <!-- 背景装饰光斑 -->
  <view class="blob" style="top: -40px; right: -60px; width: 280px; height: 280px; background: var(--brand);"></view>
  <view class="blob" style="top: 360px; left: -80px; width: 240px; height: 240px; background: var(--accent);"></view>

  <scroll-view scroll-y class="page-scroll hide-scroll" style="padding-bottom: 200rpx;">

    <!-- ===== TOP NAV BAR (client 渐变 + 返回 + 标题 + 底部圆角 56rpx) ===== -->
    <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-btn press-scale" bindtap="onBack">
        <image src="{{icons.back}}" mode="aspectFit" class="nav-btn-icon" lazy-load="{{false}}" />
      </view>
      <text class="nav-title">服务详情</text>
      <view class="nav-btn press-scale" bindtap="onToggleFavorite">
        <image src="{{isFavorited ? icons.heartActive : icons.heart}}" mode="aspectFit" class="nav-btn-icon" lazy-load="{{false}}" />
      </view>
    </view>

    <!-- ===== SERVICE HERO（品牌渐变 + 装饰光斑 + 水印） ===== -->
    <view class="service-hero">
      <view class="hero-deco hero-deco-1"></view>
      <view class="hero-deco hero-deco-2"></view>
      <view class="hero-deco hero-deco-3"></view>
      <view class="hero-watermark">
        <image src="{{icons.droplet}}" mode="aspectFit" class="hero-watermark-icon" lazy-load="{{false}}" />
      </view>
      <view class="hero-content">
        <view class="hero-tag">{{service.category || '服务项目'}}</view>
        <text class="service-name">{{service.name || '服务详情'}}</text>
        <view class="service-meta">
          <text class="meta-star" wx:if="{{reviewSummary}}">★ {{reviewSummary.average}}</text>
          <text class="meta-dot" wx:if="{{reviewSummary}}">·</text>
          <text wx:if="{{reviewSummary}}">{{reviewSummary.total}}条评价</text>
          <text wx:else>服务数据以平台实时配置为准</text>
        </view>
      </view>
    </view>

    <!-- ===== PRICE CARD（服务报价） ===== -->
    <view class="section">
      <view class="glass-neu-card price-card">
        <view class="card-title">
          <view class="title-bar"></view>
          <text>服务报价</text>
        </view>
        <view class="price-list">
          <view
            class="price-row {{index === 1 ? 'price-row-selected' : ''}} press-scale"
            wx:for="{{priceItems}}"
            wx:key="label"
          >
            <view class="price-left">
              <view class="price-icon">
                <image src="{{icons.droplet}}" mode="aspectFit" class="price-icon-img" lazy-load="{{false}}" />
              </view>
              <view class="price-info">
                <text class="price-name">{{item.label}}</text>
                <text class="price-desc" wx:if="{{item.note}}">{{item.note}}</text>
              </view>
            </view>
            <view class="price-right">
              <view class="price-value">
                <text class="cur">¥</text>
                <text class="amt numeric">{{item.amount}}</text>
              </view>
              <view class="price-radio">
                <image src="{{icons.check}}" mode="aspectFit" class="price-radio-check" lazy-load="{{false}}" />
              </view>
            </view>
          </view>
          <view class="price-row" wx:if="{{!priceItems.length}}">
            <view class="price-info">
              <text class="price-name">暂无服务端价格明细</text>
              <text class="price-desc">提交需求后可查看师傅实际报价</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== SERVICE CONTENT CARD（服务内容） ===== -->
    <view class="section">
      <view class="glass-neu-card content-card">
        <view class="card-title">
          <view class="title-bar"></view>
          <text>服务内容</text>
        </view>
        <view class="content-list">
          <view
            class="content-item press-scale"
            wx:for="{{steps}}"
            wx:key="index"
          >
            <view class="check-icon">
              <image src="{{icons.check}}" mode="aspectFit" class="check-icon-img" lazy-load="{{false}}" />
            </view>
            <text class="step-text">{{item.title}}</text>
            <image src="{{icons.arrowDown}}" mode="aspectFit" class="step-arrow" lazy-load="{{false}}" />
          </view>
          <view class="content-item" wx:if="{{!steps.length}}">
            <text class="step-text">暂无服务端流程说明</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== RECOMMENDED MASTERS（推荐师傅） ===== -->
    <view class="section">
      <view class="section-title">
        <text>推荐师傅</text>
        <text class="more" wx:if="{{workers.length}}">{{workers.length}}位</text>
      </view>
      <scroll-view scroll-x class="master-scroll hide-scroll" enable-flex>
        <view class="master-card press-scale" wx:for="{{workers}}" wx:key="id" data-id="{{item.id}}" bindtap="onWorkerTap">
          <view class="master-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" class="avatar-inner" lazy-load="{{false}}" />
            <view wx:else class="avatar-inner">{{item.avatarText}}</view>
          </view>
          <text class="master-name">{{item.name}}</text>
          <text class="master-stats"><text class="star">★ {{item.ratingText}}</text> · {{item.serviceCountText}}次服务</text>
          <view class="btn-neu-primary master-book press-scale">
            <text class="master-book-text">查看</text>
          </view>
        </view>
        <view class="master-card" wx:if="{{!relatedLoading && !workers.length}}">
          <text class="master-name">暂无可展示的师傅</text>
          <text class="master-stats">请稍后再试</text>
        </view>
      </scroll-view>
    </view>

    <!-- ===== USER REVIEWS（用户评价） ===== -->
    <view class="section">
      <view class="section-title">
        <text>用户评价</text>
        <text class="more" wx:if="{{reviewSummary}}">共{{reviewSummary.total}}条</text>
      </view>
      <view class="review-list">
        <view class="glass-neu-card review-card" wx:for="{{reviews}}" wx:key="id">
          <view class="review-head">
            <view class="review-avatar">
              <view class="avatar-inner">{{item.avatarText}}</view>
            </view>
            <view class="review-info">
              <text class="review-name">{{item.displayName}}</text>
              <text class="review-stars">{{item.stars}}</text>
            </view>
            <text class="review-date">{{item.date}}</text>
          </view>
          <text class="review-text">{{item.content}}</text>
        </view>
        <view class="glass-neu-card review-card" wx:if="{{!relatedLoading && !reviews.length}}">
          <text class="review-text">暂无已通过审核的用户评价</text>
        </view>
      </view>
    </view>

    <!-- spacer so content clears the fixed CTA bar -->
    <view class="cta-spacer"></view>

  </scroll-view>

  <!-- ===== BOTTOM FIXED CTA BAR ===== -->
  <view class="cta-bar">
    <view class="cta-icon-btn press-scale" bindtap="onContactService">
      <image src="{{icons.message}}" mode="aspectFit" class="cta-icon-btn-img" lazy-load="{{false}}" />
    </view>
    <view class="cta-icon-btn press-scale" bindtap="onToggleFavorite">
      <image src="{{isFavorited ? icons.heartActive : icons.heart}}" mode="aspectFit" class="cta-icon-btn-img" lazy-load="{{false}}" />
    </view>
    <view class="cta-primary press-scale" bindtap="onPublish">
      <text class="cta-primary-text">立即预约</text>
    </view>
  </view>
</view>
