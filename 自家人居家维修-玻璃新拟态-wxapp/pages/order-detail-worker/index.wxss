  justify-content: space-between;
  padding: 18rpx 0;
}
/* HTML: .fee-label{font-size:13.5px;color:var(--text-2);font-weight:500;display:inline-flex;align-items:center;gap:6px} */
.fee-label {
  font-size: 27rpx;
  color: var(--text-2);
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}
/* HTML: .fee-value{font-size:14px;color:var(--text-1);font-weight:600} */
.fee-value {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 600;
}
/* HTML: .fee-value-coupon{color:var(--red)} */
.fee-value-coupon {
  color: var(--red);
}
/* HTML: .fee-divider{height:0.5px;background:var(--sep);margin:6px 0} */
.fee-divider {
  height: 1rpx;
  background: var(--sep);
  margin: 12rpx 0;
}
/* HTML: .fee-row-coupon{padding:6px 0} */
.fee-row-coupon {
  padding: 12rpx 0;
}
/* HTML: .fee-total-row{display:flex;align-items:baseline;justify-content:space-between;margin-top:10px;padding-top:12px;border-top:1.5px solid var(--sep)} */
.fee-total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 24rpx;
  border-top: 3rpx solid var(--sep);
}
/* HTML: .fee-total-label{font-size:14px;color:var(--text-1);font-weight:700} */
.fee-total-label {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 700;
}
/* HTML: .fee-total{font-size:24px;font-weight:800;color:var(--brand);letter-spacing:-0.02em;font-variant-numeric:tabular-nums} */
.fee-total {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--brand-worker);
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

/* ===== LBS Check-in Vertical Timeline ===== */
/* HTML: .checkin-card{padding:18px} */
.checkin-card {
  padding: 36rpx;
}
/* HTML: .checkin-list{display:flex;flex-direction:column} */
.checkin-list {
  display: flex;
  flex-direction: column;
}
/* HTML: .checkin-step{display:flex;gap:14px;position:relative;padding-bottom:18px} */
.checkin-step {
  display: flex;
  gap: 28rpx;
  position: relative;
  padding-bottom: 36rpx;
}
/* HTML: .checkin-step:last-child{padding-bottom:0} */
.checkin-step:last-child {
  padding-bottom: 0;
}
/* HTML: .checkin-step:not(:last-child)::after{content:'';position:absolute;left:15px;top:34px;bottom:2px;width:2px;background:var(--brand-light);border-radius:var(--r-pill)} */
.checkin-step:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 30rpx;
  top: 68rpx;
  bottom: 4rpx;
  width: 4rpx;
  background: var(--brand-worker-light);
  border-radius: var(--r-pill);
}
/* HTML: .checkin-step.done:not(:last-child)::after{background:var(--brand);opacity:0.45} */
.checkin-step.done:not(:last-child)::after {
  background: var(--brand-worker);
  opacity: 0.45;
}
/* HTML: .checkin-node{width:32px;height:32px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;position:relative;z-index:2} */
.checkin-node {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}
/* HTML: .checkin-step.done .checkin-node{background:var(--brand);color:var(--text-inverse);box-shadow:0 3px 10px var(--brand-glow),inset 0 1px 1px rgba(255,255,255,0.3)} */
.checkin-step.done .checkin-node {
  background: var(--brand-worker);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx var(--brand-worker-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
}
/* HTML: .checkin-step.current .checkin-node{background:var(--brand);color:var(--text-inverse);box-shadow:0 3px 14px var(--brand-glow),inset 0 1px 1px rgba(255,255,255,0.3)} */
.checkin-step.current .checkin-node {
  background: var(--brand-worker);
  color: #FFFFFF;
  box-shadow: 0 6rpx 28rpx var(--brand-worker-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
}
/* pending 态：HTML 未定义节点底色，沿用 tl-dot-pending 规范 */
.checkin-step.pending .checkin-node {
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset-sm);
  border: 1rpx solid var(--neu-dark);
}
/* HTML: .checkin-node svg{width:16px;height:16px} */
.checkin-ic {
  width: 32rpx;
  height: 32rpx;
}
/* HTML: .checkin-pulse{position:absolute;inset:-3px;border-radius:50%;border:2px solid var(--brand);animation:checkinPulse 1.8s var(--ease) infinite;pointer-events:none} */
.checkin-pulse {
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  border: 4rpx solid var(--brand-worker);
  animation: checkinPulse 1.8s var(--ease) infinite;
  pointer-events: none;
}
@keyframes checkinPulse {
  0% { transform: scale(1); opacity: 0.55; }
  70% { transform: scale(1.45); opacity: 0; }
  100% { transform: scale(1.45); opacity: 0; }
}
/* HTML: .checkin-body{flex:1;min-width:0;padding-top:3px} */
.checkin-body {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
}
/* HTML: .checkin-title-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px} */
.checkin-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
/* HTML: .checkin-title{font-size:14px;font-weight:700;color:var(--text-1);letter-spacing:-0.01em} */
.checkin-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}
/* HTML: .checkin-status{font-size:10.5px;font-weight:700;letter-spacing:0.02em;padding:2px 8px;border-radius:var(--r-pill);white-space:nowrap} */
.checkin-status {
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  white-space: nowrap;
}
/* HTML: .checkin-status-done{color:var(--green);background:rgba(91,140,90,0.14)} */
.checkin-status-done {
  color: var(--green);
  background: rgba(91, 140, 90, 0.14);
}
/* HTML: .checkin-status-current{color:var(--text-inverse);background:var(--brand);box-shadow:0 2px 6px var(--brand-glow)} */
.checkin-status-current {
  color: #FFFFFF;
  background: var(--brand-worker);
  box-shadow: 0 4rpx 12rpx var(--brand-worker-glow);
}
/* pending 态文案色：HTML 未定义，沿用 muted */
.checkin-status-pending {
  color: var(--text-3);
  background: var(--fill);
}
/* HTML: .checkin-meta{font-size:12px;color:var(--text-2);font-weight:500;line-height:1.45} */
.checkin-meta {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
  line-height: 1.45;
}
/* HTML: .checkin-action{margin-top:10px} */
.checkin-action {
  margin-top: 20rpx;
}

/* ===== Buttons (neu) ===== */
/* HTML: .btn-neu-primary{display:inline-flex;align-items:center;justify-content:center;background:var(--brand);color:var(--text-inverse);border:none;border-radius:9999px;padding:8px 16px;font-size:13px;font-weight:600;box-shadow:var(--neu-out-sm),0 2px 8px var(--brand-glow)} */
.btn-neu-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--brand-worker);
  color: #FFFFFF;
  border: none;
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--neu-raised-sm), 0 4rpx 16rpx var(--brand-worker-glow);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
/* HTML: .btn-neu-primary:active{box-shadow:var(--neu-in);transform:scale(0.94)} */
.btn-neu-primary:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.94);
}
/* HTML: .btn-neu-secondary{background:rgba(255,255,255,0.50);color:var(--brand);border:0.5px solid rgba(255,255,255,0.60);border-radius:9999px;padding:8px 16px;font-size:13px;font-weight:600;box-shadow:var(--neu-out-sm)} */
.btn-neu-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.50);
  color: var(--brand-worker);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--neu-raised-sm);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
/* HTML: .btn-neu-secondary:active{box-shadow:var(--neu-in);transform:scale(0.94)} */
.btn-neu-secondary:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.94);
}
/* HTML: .btn-neu-primary svg,.btn-neu-secondary svg{width:16px;height:16px;flex-shrink:0;margin-right:6px} */
.btn-ic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* ===== Extra Fee Card ===== */
/* HTML: .extra-fee-card{padding:18px} */
.extra-fee-card {
  padding: 36rpx;
}
/* HTML: .extra-fee-tip{display:flex;align-items:flex-start;gap:8px;background:var(--accent-light);border-radius:var(--r-sm);padding:10px 12px;margin-bottom:14px;border:0.5px solid rgba(212,148,76,0.25)} */
.extra-fee-tip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: var(--accent-light);
  border-radius: var(--r-sm);
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(212, 148, 76, 0.25);
}
/* HTML: .extra-fee-tip svg{width:15px;height:15px;color:var(--accent-dark);flex-shrink:0;margin-top:1px} */
.extra-fee-tip-ic {
  width: 30rpx;
  height: 30rpx;
  color: var(--accent-dark);
  flex-shrink: 0;
  margin-top: 2rpx;
}
/* HTML: .extra-fee-tip-text{font-size:12px;color:var(--accent-dark);font-weight:600;line-height:1.45} */
.extra-fee-tip-text {
  font-size: 24rpx;
  color: var(--accent-dark);
  font-weight: 600;
  line-height: 1.45;
  flex: 1;
}
/* HTML: .extra-fee-record{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;background:var(--fill);border-radius:var(--r-sm);border:0.5px solid var(--sep);margin-bottom:14px} */
.extra-fee-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--fill);
  border-radius: var(--r-sm);
  border: 1rpx solid var(--sep);
  margin-bottom: 28rpx;
}
/* HTML: .extra-fee-record-info{display:flex;flex-direction:column;gap:4px;min-width:0} */
.extra-fee-record-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}
.extra-fee-record-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
/* HTML: .extra-fee-record-title{font-size:13.5px;color:var(--text-1);font-weight:600;display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap} */
.extra-fee-record-title {
  font-size: 27rpx;
  color: var(--text-1);
  font-weight: 600;
}
/* HTML: .extra-fee-badge{display:inline-flex;align-items:center;gap:3px;background:rgba(91,140,90,0.14);color:var(--green);font-size:11px;font-weight:600;padding:2px 8px;border-radius:var(--r-pill)} */
.extra-fee-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(91, 140, 90, 0.14);
  color: var(--green);
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
}
/* HTML: .extra-fee-badge svg{width:11px;height:11px} */
.extra-fee-badge-ic {
  width: 22rpx;
  height: 22rpx;
}
/* HTML: .extra-fee-record-time{font-size:11.5px;color:var(--text-2);font-weight:500} */
.extra-fee-record-time {
  font-size: 23rpx;
  color: var(--text-2);
  font-weight: 500;
}
/* HTML: .extra-fee-amount{font-size:15px;color:var(--text-1);font-weight:700;letter-spacing:-0.01em} */
.extra-fee-amount {
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 700;
  letter-spacing: -0.01em;
}
/* HTML: .extra-fee-action{display:flex;justify-content:center} */
.extra-fee-action {
  display: flex;
  justify-content: center;
}

/* ===== Review Card (completed 状态，HTML 无此卡，沿用规范) ===== */
.review-card {
  padding: 36rpx;
}
.review-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.review-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--canvas);
  box-shadow: var(--neu-inset-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.review-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}
.review-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.review-stars {
  display: flex;
  gap: 6rpx;
}
.star {
  font-size: 28rpx;
  color: var(--text-4);
}
.star.filled {
  color: var(--accent);
}
.review-time {
  font-size: 22rpx;
  color: var(--text-3);
}
.review-content {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* ===== Bottom Fixed Action Bar ===== */
/* HTML: .action-bar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:414px;display:flex;align-items:center;gap:12px;padding:14px 20px;padding-bottom:max(14px,env(safe-area-inset-bottom));background:rgba(242,237,232,0.88);backdrop-filter:blur(20px) saturate(150%);border-top:0.5px solid rgba(255,255,255,0.55);box-shadow:0 -4px 20px rgba(0,0,0,0.05);z-index:60} */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 40rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  background: rgba(242, 237, 232, 0.88);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.05);
  z-index: 60;
}
/* HTML: .action-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:48px;flex:0 0 38%;background:var(--bg-elevated);color:var(--text-1);border:0.5px solid rgba(255,255,255,0.60);border-radius:var(--r-pill);font-size:14px;font-weight:600;box-shadow:var(--neu-out-sm),inset 0 1px 1px rgba(255,255,255,0.45)} */
.action-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  flex: 0 0 38%;
  background: var(--bg-elevated);
  color: var(--text-1);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: var(--r-pill);
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
/* HTML: .action-btn-secondary:active{box-shadow:var(--neu-in);transform:scale(0.96)} */
.action-btn-secondary:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.96);
}
/* HTML: .action-btn-secondary svg{width:18px;height:18px;color:var(--text-2)} */
.action-btn-ic {
  width: 36rpx;
  height: 36rpx;
  color: var(--text-2);
}
/* HTML: .action-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:48px;flex:1;background:var(--brand-gradient);color:var(--text-inverse);border:none;border-radius:var(--r-pill);font-size:15px;font-weight:700;letter-spacing:0.02em;box-shadow:var(--neu-out-sm),0 4px 14px var(--brand-glow)} */
.action-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  flex: 1;
  background: var(--brand-worker-gradient);
  color: #FFFFFF;
  border: none;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx var(--brand-worker-glow);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
/* HTML: .action-btn-primary:active{box-shadow:var(--neu-in);transform:scale(0.96)} */
.action-btn-primary:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.96);
}
.action-btn-primary.full {
  flex: 1;
}

/* ===== 滚动驱动标题栏变形动画（参考 小程序动画与布局实现规范.md 第二章）===== */
/* 滚动超过阈值时：加深背景不透明度 + 增加底部投影，过渡平滑 */
.nav-bar.worker.scrolled {
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(143, 169, 152, 0.18) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.20) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.18) 0%, rgba(143, 169, 152, 0.12) 50%, rgba(45, 108, 223, 0.10) 100%),
    rgba(247, 243, 239, 0.72);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  box-shadow: 0 8rpx 32rpx rgba(45, 108, 223, 0.08);
  transition: background var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
}
