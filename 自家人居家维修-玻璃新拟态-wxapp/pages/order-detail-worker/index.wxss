/* pages/order-detail-worker/index.wxss — 师傅端订单详情 玻璃新拟态
 * 像素级复刻 worker-order-detail.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 师傅端品牌色：--brand-worker #2D6CDF（蓝色），光斑 blue-sage 渐变
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

/* HTML: .page 为画布容器，min-height:100vh，overflow:hidden */
.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== 师傅端 Glass-Neu Card 覆盖（蓝色辉光）===== */
/* HTML .glass-neu-card box-shadow 第四层为 rgba(45,108,223,0.04) 蓝色辉光（客户端为 teal） */
.glass-neu-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  /* HTML: var(--neu-out-md),0 6px 28px rgba(0,0,0,0.06),0 2px 8px rgba(45,108,223,0.04),0 0 0 1px rgba(44,40,36,0.05) */
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(45, 108, 223, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  position: relative;
  overflow: hidden;
}
/* HTML: .glass-neu-card::before Rim Light 边缘高光（165deg 渐变） */
.glass-neu-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}
/* 卡片内容确保在 Rim Light 之上 */
.glass-neu-card > view,
.glass-neu-card > text {
  position: relative;
  z-index: 1;
}

/* ===== 更多按钮（三点菜单）===== */
/* HTML: nav-icon-btn 内 3 个 1.4r 圆点 */
.more-btn {
  flex-direction: column;
  gap: 6rpx;
}
.more-btn .dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-1);
}

/* ===== Sections ===== */
/* HTML: .section{padding:0 20px;margin-top:16px;position:relative;z-index:2} */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}
/* HTML: .section:first-of-type{margin-top:18px} */
.section:first-of-type {
  margin-top: 36rpx;
}

/* ===== Card Title ===== */
/* HTML: font-size:16px;font-weight:700;color:var(--text-1);letter-spacing:-0.01em;margin-bottom:14px */
.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 28rpx;
}

/* HTML: .mono{font-variant-numeric:tabular-nums;letter-spacing:-0.01em} */
.mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* ===== Status Card ===== */
/* HTML: .status-card{padding:0} */
.status-card {
  padding: 0;
}
/* HTML: .status-top-bar{height:5px;width:100%;background:var(--brand-gradient)} */
.status-top-bar {
  height: 10rpx;
  width: 100%;
  background: var(--brand-worker-gradient);
}
/* HTML: .status-card-body{padding:18px 18px 20px} */
.status-card-body {
  padding: 36rpx 36rpx 40rpx;
}
/* HTML: .status-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px} */
.status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
/* HTML: .status-chip font-size:12px;padding:4px 12px;border-radius:var(--r-pill);
   box-shadow:inset 0 1px 1px rgba(255,255,255,0.6),0 2px 6px var(--accent-glow) */
.status-chip {
  display: inline-flex;
  align-items: center;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.6), 0 4rpx 12rpx var(--accent-glow);
}
/* HTML: .status-eta{font-size:12px;color:var(--text-2);font-weight:500} */
.status-eta {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
}
/* HTML: .status-desc{font-size:21px;font-weight:700;letter-spacing:-0.02em;line-height:1.3;margin-bottom:20px} */
.status-desc {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  line-height: 1.3;
  margin-bottom: 40rpx;
}

/* ===== Horizontal Timeline ===== */
/* HTML: .timeline{position:relative;padding-top:4px} */
.timeline {
  position: relative;
  padding-top: 8rpx;
}
/* HTML: .timeline-line{position:absolute;top:16px;left:30px;right:30px;height:3px;background:var(--neu-dark);border-radius:var(--r-pill);opacity:0.5} */
.timeline-line {
  position: absolute;
  top: 32rpx;
  left: 60rpx;
  right: 60rpx;
  height: 6rpx;
  background: var(--neu-dark);
  border-radius: var(--r-pill);
  opacity: 0.5;
}
/* HTML: .timeline-line-fill{height:100%;width:62%;background:linear-gradient(90deg,var(--brand) 0%,var(--brand-mid) 60%,var(--accent) 100%);border-radius:var(--r-pill)} */
.timeline-line-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, var(--brand-worker) 0%, var(--brand-worker-mid) 60%, var(--accent) 100%);
  border-radius: var(--r-pill);
}
/* HTML: .timeline-nodes{display:flex;justify-content:space-between;position:relative} */
.timeline-nodes {
  display: flex;
  justify-content: space-between;
  position: relative;
}
/* HTML: .tl-node{display:flex;flex-direction:column;align-items:center;gap:6px;flex:1;min-width:0} */
.tl-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
/* HTML: .tl-dot{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative;z-index:2} */
.tl-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}
/* HTML: .tl-dot svg{width:16px;height:16px} */
.tl-dot-check {
  width: 32rpx;
  height: 32rpx;
}
/* HTML: .tl-dot-done{background:var(--brand);color:var(--text-inverse);box-shadow:0 3px 10px var(--brand-glow),inset 0 1px 1px rgba(255,255,255,0.3)} */
.tl-dot.done {
  background: var(--brand-worker);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx var(--brand-worker-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
}
/* HTML: .tl-dot-active{background:var(--accent);color:var(--text-inverse);box-shadow:0 3px 12px var(--accent-glow),inset 0 1px 1px rgba(255,255,255,0.3)} */
.tl-dot.active {
  background: var(--accent);
  color: #FFFFFF;
  box-shadow: 0 6rpx 24rpx var(--accent-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
}
/* HTML: .tl-dot-inner{width:10px;height:10px;border-radius:50%;background:var(--text-inverse);box-shadow:0 0 0 2px rgba(255,255,255,0.35)} */
.tl-dot-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.35);
}
/* HTML: .tl-dot-pulse{position:absolute;inset:0;border-radius:50%;border:2px solid var(--accent);animation:tlPulse 1.8s var(--ease) infinite} */
.tl-dot-pulse {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid var(--accent);
  animation: tlPulse 1.8s var(--ease) infinite;
}
@keyframes tlPulse {
  0% { transform: scale(1); opacity: 0.6; }
  70% { transform: scale(1.5); opacity: 0; }
  100% { transform: scale(1.5); opacity: 0; }
}
/* HTML: .tl-dot-pending{background:var(--bg-elevated);box-shadow:var(--neu-in),inset 0 1px 1px rgba(255,255,255,0.3);border:1.5px solid var(--neu-dark)} */
.tl-dot.pending {
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
  border: 3rpx solid var(--neu-dark);
}
/* HTML: .tl-label{font-size:12px;font-weight:600;line-height:1.2;text-align:center} */
.tl-label {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}
/* HTML: .tl-label-done{color:var(--brand)} */
.tl-label.done { color: var(--brand-worker); }
/* HTML: .tl-label-active{color:var(--accent-dark)} */
.tl-label.active { color: var(--accent-dark); }
/* HTML: .tl-label-pending{color:var(--text-3)} */
.tl-label.pending { color: var(--text-3); }
/* HTML: .tl-time{font-size:11px;color:var(--text-2);font-weight:500;font-variant-numeric:tabular-nums} */
.tl-time {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

/* ===== Worker / Customer Card ===== */
/* HTML: .worker-card{display:flex;align-items:center;gap:14px;padding:16px 18px} */
.worker-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx 36rpx;
}
/* HTML: .avatar-col{display:flex;flex-direction:column;align-items:center;gap:5px;flex-shrink:0} */
.avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
/* HTML: .worker-avatar{width:52px;height:52px;border-radius:50%;flex-shrink:0;background:var(--bg-elevated);box-shadow:var(--neu-in-deep);display:flex;align-items:center;justify-content:center;color:var(--brand)} */
.worker-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  z-index: 1;
}
/* HTML: .worker-avatar.avatar-glass{background:linear-gradient(145deg,rgba(255,255,255,0.68) 0%,rgba(255,255,255,0.28) 40%,var(--brand-subtle) 78%,rgba(255,255,255,0.18) 100%);backdrop-filter:blur(10px) saturate(160%);border:0.5px solid rgba(255,255,255,0.75);box-shadow:inset 0 2px 3px rgba(255,255,255,0.88),inset 0 -1px 2px rgba(0,0,0,0.04),var(--neu-out-sm)} */
.avatar-glass {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.28) 40%, var(--brand-worker-subtle) 78%, rgba(255, 255, 255, 0.18) 100%);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88), inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04), var(--neu-raised-sm);
}
/* HTML: .worker-avatar svg{width:28px;height:28px} */
.avatar-img {
  width: 56rpx;
  height: 56rpx;
}
/* HTML: .verify-badge{display:inline-flex;align-items:center;gap:3px;background:var(--brand-subtle);color:var(--brand);font-size:10.5px;font-weight:600;padding:2px 8px;border-radius:var(--r-pill);border:0.5px solid rgba(45,108,223,0.18)} */
.verify-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: var(--brand-worker-subtle);
  color: var(--brand-worker);
  font-size: 21rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  border: 1rpx solid rgba(45, 108, 223, 0.18);
}
/* HTML: .verify-badge svg{width:11px;height:11px} */
.verify-ic {
  width: 22rpx;
  height: 22rpx;
}
/* HTML: .worker-info{flex:1;min-width:0} */
.worker-info {
  flex: 1;
  min-width: 0;
}
/* HTML: .worker-name-row{display:flex;align-items:center;gap:8px;margin-bottom:5px} */
.worker-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
/* HTML: .worker-name{font-size:17px;font-weight:700;color:var(--text-1);letter-spacing:-0.01em} */
.worker-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}
/* HTML: .worker-meta{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text-2);font-weight:500} */
.worker-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  color: var(--text-2);
  font-weight: 500;
}
/* HTML: .worker-star{color:var(--orange);font-weight:600} */
.worker-star {
  color: var(--orange);
  font-weight: 600;
}
/* HTML: .meta-dot{color:var(--text-3)} */
.meta-dot {
  color: var(--text-3);
}
/* HTML: .worker-actions{display:flex;gap:10px;flex-shrink:0} */
.worker-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}
/* HTML: .action-circle{width:44px;height:44px;border-radius:50%;border:none;background:var(--bg-elevated);box-shadow:var(--neu-out-sm),inset 0 1px 1px rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;color:var(--brand);cursor:pointer} */
.action-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-worker);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
/* HTML: .action-circle:active{box-shadow:var(--neu-in);transform:scale(0.94)} */
.action-circle:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.94);
}
/* HTML: .action-circle:last-child{color:var(--accent-dark)} */
.action-circle.accent {
  color: var(--accent-dark);
}
/* HTML: .action-circle svg{width:20px;height:20px} */
.action-ic {
  width: 40rpx;
  height: 40rpx;
}

/* ===== Info Card ===== */
/* HTML: .info-card{padding:18px} */
.info-card {
  padding: 36rpx;
}
/* HTML: .info-list{display:flex;flex-direction:column;gap:0} */
.info-list {
  display: flex;
  flex-direction: column;
}
/* HTML: .info-row{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:0.5px solid var(--sep)} */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sep);
}
/* HTML: .info-row:last-of-type{border-bottom:none} */
.info-row:last-of-type {
  border-bottom: none;
}
.info-row-icon {
  align-items: center;
}
/* info-label-row：HTML 中 .info-label 为 inline-flex 含图标，这里拆为容器 */
.info-label-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
/* HTML: .info-label{display:inline-flex;align-items:center;gap:6px;font-size:13.5px;color:var(--text-2);font-weight:500;flex-shrink:0} */
.info-label {
  font-size: 27rpx;
  color: var(--text-2);
  font-weight: 500;
  flex-shrink: 0;
}
/* HTML: .info-ic{width:15px;height:15px;color:var(--text-3);flex-shrink:0} */
.info-ic {
  width: 30rpx;
  height: 30rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
/* HTML: .info-value{font-size:13.5px;color:var(--text-1);font-weight:600;text-align:right;max-width:60%} */
.info-value {
  font-size: 27rpx;
  color: var(--text-1);
  font-weight: 600;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}
/* HTML: .info-desc-block{margin-top:12px;padding:12px 14px;background:var(--fill);border-radius:var(--r-sm);border:0.5px solid var(--sep)} */
.info-desc-block {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--fill);
  border-radius: var(--r-sm);
  border: 1rpx solid var(--sep);
}
/* HTML: .info-desc-label{font-size:11.5px;color:var(--text-2);font-weight:600;margin-bottom:5px} */
.info-desc-label {
  display: block;
  font-size: 23rpx;
  color: var(--text-2);
  font-weight: 600;
  margin-bottom: 10rpx;
}
/* HTML: .info-desc-text{font-size:13px;color:var(--text-1);line-height:1.5;font-weight:500} */
.info-desc-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.5;
  font-weight: 500;
}

/* ===== Quote Input (available 状态，HTML 无此卡，沿用新拟态规范) ===== */
.quote-input-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  gap: 20rpx;
}
.quote-input-row + .quote-input-row {
  border-top: 1rpx solid var(--hairline);
}
.quote-input-label {
  font-size: 26rpx;
  color: var(--text-2);
  width: 140rpx;
  flex-shrink: 0;
}
.quote-input-wrap {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  background: var(--canvas);
  box-shadow: var(--neu-inset-sm);
  border-radius: var(--r-md);
  padding: 20rpx 28rpx;
}
.quote-input-cur {
  font-size: 30rpx;
  color: var(--accent);
  font-weight: 700;
}
.quote-input-field {
  flex: 1;
  font-size: 40rpx;
  color: var(--text-1);
  font-weight: 700;
}
.quote-input-ph {
  color: var(--text-4);
  font-weight: 400;
}
.eta-chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.eta-chip {
  padding: 14rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm);
  transition: all 0.2s var(--ease);
}
.eta-chip.active {
  background: var(--brand-worker-gradient);
  color: #FFFFFF;
  box-shadow: var(--shadow-glow-worker);
  font-weight: 600;
}

/* ===== Fee Card ===== */
