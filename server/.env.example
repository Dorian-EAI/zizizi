# ====================================================================
# 自家人居家维修后端 — 配置示例
# 复制为 .env 后填入真实值；切勿将含真实密钥的 .env 提交到 git
# ====================================================================

# ===== 应用配置 =====
APP_NAME=自家人居家维修后端
# 本地仅用 development；体验环境用 staging，正式环境用 production
# staging 与 production 执行同一套安全门禁，均禁止 Mock/本地降级
APP_ENV=development
# 开发模式开 true（暴露 /docs、热重载、详细错误）；生产必须 false
APP_DEBUG=true
# 内置后台仅供本地开发；staging/production 必须 false
ENABLE_BUILTIN_ADMIN=true

# ===== 数据库配置 =====
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=zjr_repair
# SQLite 兜底（仅本地测试用）
SQLITE_PATH=./zjr_repair.db

# ===== JWT 配置（生产必须改为随机 32 字符以上密钥） =====
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168
ADMIN_JWT_EXPIRE_MINUTES=60

# ===== 微信小程序配置 =====
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# 微信订阅消息模板 ID（按小程序后台实际模板填写）
WX_TEMPLATE_ORDER_BIDDING=
WX_TEMPLATE_ORDER_ACCEPTED=
WX_TEMPLATE_SERVICE_FINISHED=
WX_TEMPLATE_PAYMENT_SUCCESS_USER=
WX_TEMPLATE_PAYMENT_SUCCESS_WORKER=
WX_TEMPLATE_WITHDRAW_SUCCESS=
WX_TEMPLATE_COUPON_EXPIRE=

# ===== 微信支付 API v3（生产必填；开发 mock 也必须显式开启） =====
WX_PAY_MOCK_ENABLED=true
WX_PAY_MOCK_CALLBACK_SECRET=change-this-development-secret
WX_MCH_ID=
WX_API_V3_KEY=
# PEM 正文（换行写为 \n）或私钥绝对路径
WX_MERCHANT_PRIVATE_KEY=
WX_MERCHANT_SERIAL_NO=
WX_PLATFORM_CERT_DIR=
WX_PAY_NOTIFY_URL=https://api.example.com/api/wxpay/notify/payment
WX_REFUND_NOTIFY_URL=https://api.example.com/api/wxpay/notify/refund
WX_PAY_TIMEOUT_SECONDS=15
WX_PAYMENT_PENDING_TIMEOUT_MINUTES=30
WX_RECONCILE_BATCH_SIZE=100
WX_REFUND_RETRY_INTERVAL_MINUTES=5
WX_REFUND_MAX_RETRIES=5

# ===== AI 大模型配置 =====
# mock = 纯代码模拟，doubao = 豆包大模型，qwen = 通义千问
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# ===== 运营后台默认账号（仅首次 init_db 写入；运行时不再用作登录后门） =====
# 生产环境必须改为强密码（至少 8 位，建议含字母数字符号）
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN

# ====================================================================
# 以下为安全相关配置 — 生产环境必须配置
# ====================================================================

# ===== CORS 允许的源（逗号分隔）=====
# 微信小程序不走 CORS，但 H5 端/管理后台 Web 端必须显式配置
# 生产环境禁止使用 "*"（启动时会被 config.validate_security 拒绝）
# 例: https://m.example.com,https://admin.example.com
CORS_ORIGINS=

# ===== TrustedHost 白名单（逗号分隔）=====
# 生产环境必须配置，防 Host 头注入
# 例: api.example.com,localhost
ALLOWED_HOSTS=

# ===== PII 字段加密主密钥（AES-256）=====
# 用于加密身份证号等敏感字段；生产环境必须配置
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 注意：更换密钥后已加密的旧数据将无法解密，请妥善保管
FIELD_ENC_KEY=

# ===== API 限流存储（可选）=====
# 默认内存存储（单进程）；生产建议用 Redis 启用分布式限流
# 留空时自动用下方 REDIS_HOST/PORT 配置生成
# 例: redis://:password@127.0.0.1:6379/1
RATE_LIMIT_STORAGE=
RATE_LIMIT_REDIS_DB=1
# 仅当源站禁止公网直连、只能由受信 Nginx/负载均衡访问时设为 true
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
# 多实例可同时开启；任务执行由 Redis 分布式锁去重
SCHEDULER_ENABLED=true

# ====================================================================
# 第三方服务配置（按需开启）
# ====================================================================

# ===== Redis（仅 development/testing 可降级；staging/production 就绪探针要求可用） =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== 短信服务 =====
# mock = 控制台打印，aliyun = 阿里云 dysmsapi，tencent = 腾讯云 SMS
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_TENCENT_APP_ID=
SMS_TENCENT_REGION=ap-guangzhou
SMS_SIGN_NAME=自家人维修
SMS_TEMPLATE_ORDER_PENDING=
SMS_TEMPLATE_ORDER_COMPLETED=
SMS_TEMPLATE_ORDER_PAID=
SMS_TEMPLATE_WITHDRAW=
SMS_TEMPLATE_VERIFY_CODE=

# ===== 文件上传 / 对象存储 =====
UPLOAD_DIR=./uploads
UPLOAD_URL_PREFIX=/uploads
# local 仅限开发；staging/production 必须 aliyun 或 tencent
OSS_PROVIDER=local
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_REGION=
OSS_CDN_DOMAIN=

# 腾讯云 COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_CDN_DOMAIN=

# ===== 地图服务（留空 = 使用 Haversine 直线距离） =====
# local 仅限开发直线距离；staging/production 必须 amap 或 tencent
MAP_PROVIDER=local
AMAP_API_KEY=
TENCENT_MAP_KEY=
