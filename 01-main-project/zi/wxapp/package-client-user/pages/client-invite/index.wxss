.invite-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: var(--bg);
}

.invite-hero {
  padding: 64rpx 40rpx 80rpx;
  background:
    radial-gradient(ellipse 600rpx 400rpx at 80% 20%, rgba(212, 148, 76, .16) 0%, transparent 66%),
    radial-gradient(ellipse 500rpx 360rpx at 15% 65%, rgba(13, 148, 136, .13) 0%, transparent 66%),
    linear-gradient(150deg, rgba(13, 148, 136, .10) 0%, rgba(212, 148, 76, .10) 100%);
  border-radius: 0 0 72rpx 72rpx;
  text-align: center;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .35);
}

.invite-title {
  font-size: 48rpx;
  font-weight: 700;
  font-family: var(--font-display);
  letter-spacing: -.02em;
  margin-bottom: 16rpx;
}

.invite-subtitle {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 56rpx;
  line-height: 1.5;
}

.reward-cards {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  margin-bottom: 56rpx;
  width: 100%;
}

.reward-card {
  flex: 1;
  max-width: 280rpx;
  padding: 32rpx 24rpx;
  background: rgba(255, 255, 255, .52);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: var(--r-md);
  border: 1rpx solid rgba(255, 255, 255, .60);
  box-shadow: var(--neu-out-md);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.reward-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.reward-icon.accent {
  background: var(--brand-gradient);
}

.reward-icon image {
  width: 40rpx;
  height: 40rpx;
}

.reward-amount {
  font-size: 44rpx;
  font-weight: 700;
  font-family: var(--font-display);
  color: var(--brand);
  margin-bottom: 4rpx;
}

.reward-amount.accent-text {
  color: var(--brand);
}

.reward-label {
  font-size: 22rpx;
  color: var(--text-2);
}

.invite-code-box {
  display: inline-flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 40rpx;
  background: rgba(255, 255, 255, .60);
  border-radius: var(--r-pill);
  box-shadow: var(--neu-out-md);
}

.invite-code-label {
  font-size: 26rpx;
  color: var(--text-2);
}

.invite-code-value {
  font-size: 36rpx;
  font-weight: 700;
  font-family: var(--font-display);
  letter-spacing: .1em;
  color: var(--text-1);
}

.copy-btn {
  width: auto;
  margin: 0;
  padding: 12rpx 28rpx;
  background: var(--brand-gradient);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: var(--r-pill);
  line-height: 1.4;
  box-shadow: 0 4rpx 16rpx var(--brand-glow);
  transition: transform var(--dur) var(--spring);
}

.copy-btn:active {
  transform: scale(.92);
}

.copy-btn[disabled] {
  opacity: .9;
  color: #fff;
}

.feature-notice {
  margin: 32rpx 40rpx 0;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(212, 148, 76, .30);
  border-radius: var(--r-md);
  background: rgba(212, 148, 76, .10);
  display: flex;
  flex-direction: column;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-dark);
  margin-bottom: 8rpx;
}

.notice-desc {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.55;
}

.section {
  padding: 40rpx 40rpx 0;
}

.section-head,
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-2);
}

.glass-card {
  background: rgba(255, 255, 255, .52);
  backdrop-filter: blur(40rpx) saturate(140%);
  -webkit-backdrop-filter: blur(40rpx) saturate(140%);
  border-radius: var(--r-lg);
  border: 1rpx solid rgba(255, 255, 255, .60);
  box-shadow: var(--neu-out-md);
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .80), transparent);
  pointer-events: none;
}

.share-methods {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}

.share-item {
  text-align: center;
}

.share-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  box-shadow: var(--neu-out-md);
  border: 1rpx solid rgba(255, 255, 255, .62);
  transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--ease);
}

.share-item:active .share-icon {
  box-shadow: var(--neu-in);
  transform: scale(.92);
}

.share-icon image {
  width: 44rpx;
  height: 44rpx;
}

.share-icon.wechat,
.share-icon.link {
  background: radial-gradient(circle at 72% 18%, rgba(13, 148, 136, .16) 0%, transparent 58%), rgba(255, 255, 255, .44);
}

.share-icon.moments,
.share-icon.qq {
  background: radial-gradient(circle at 76% 20%, rgba(212, 148, 76, .18) 0%, transparent 58%), rgba(255, 255, 255, .44);
}

.share-name {
  font-size: 24rpx;
  color: var(--text-2);
}

.stats-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 32rpx;
  background: rgba(255, 255, 255, .40);
  border-radius: var(--r-md);
  box-shadow: var(--neu-out-sm);
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  font-family: var(--font-display);
  color: var(--brand);
  margin-bottom: 8rpx;
}

.stat-value.reward {
  color: var(--green);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-2);
}

.invite-list-card {
  padding: 0 40rpx;
}

.invite-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--sep);
}

.invite-item:last-child {
  border-bottom: none;
}

.invite-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: var(--brand-gradient);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: var(--neu-out-sm);
}

.invite-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.invite-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.invite-time {
  font-size: 24rpx;
  color: var(--text-2);
}

.invite-reward {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand);
  font-family: var(--font-display);
}

.invite-reward.pending {
  color: var(--text-3);
}

.empty-record {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}

.rule-item {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--sep);
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.rule-text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
  flex: 1;
}

.rules-section {
  padding-bottom: 40rpx;
}
