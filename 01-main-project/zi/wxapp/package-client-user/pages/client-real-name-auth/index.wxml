<view class="page">
  <view class="blob" style="top: -80rpx; right: -120rpx; width: 560rpx; height: 560rpx; background: var(--brand);"></view>
  <view class="blob" style="top: 480rpx; left: -160rpx; width: 480rpx; height: 480rpx; background: var(--accent);"></view>

  <scroll-view scroll-y class="page-scroll hide-scroll" style="padding-bottom: 200rpx;">
    <view class="hero" style="padding-top: calc({{statusBarHeight}}px + 76rpx);">
      <view class="nav-row">
        <view class="nav-icon-btn" bindtap="onBack">
          <image src="{{icons.back}}" mode="aspectFit" class="nav-icon" lazy-load="{{false}}" />
        </view>
        <text class="nav-title">实名认证</text>
        <view class="nav-spacer"></view>
      </view>

      <view class="auth-status-card status-{{authStatus}}">
        <view class="status-icon-circle">
          <text class="status-icon">{{authStatus === 'verified' ? '✅' : authStatus === 'pending' ? '⏳' : '🔐'}}</text>
        </view>
        <text class="status-title">{{authStatus === 'verified' ? '已完成认证' : authStatus === 'pending' ? '审核中' : '未认证'}}</text>
        <text class="status-desc">{{authStatus === 'verified' ? '您的身份信息已通过验证' : authStatus === 'pending' ? '您的认证信息正在审核中，请耐心等待' : '完成实名认证后可享受更多服务'}}</text>
      </view>
    </view>

    <view wx:if="{{authStatus !== 'verified'}}" class="section">
      <view class="section-title-row">
        <text class="section-title-text">填写信息</text>
      </view>

      <view class="glass-card">
        <view class="form-field">
          <text class="field-label">真实姓名</text>
          <input class="field-input" placeholder="请输入真实姓名" value="{{form.name}}" bindinput="onInput" data-field="name" />
        </view>
        <view class="form-field">
          <text class="field-label">身份证号</text>
          <input class="field-input" placeholder="请输入身份证号" value="{{form.idCard}}" bindinput="onInput" data-field="idCard" />
        </view>
        <view class="form-field">
          <text class="field-label">手机号</text>
          <input class="field-input" type="number" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
        </view>
        <view class="form-field" bindtap="onSelectRegion">
          <text class="field-label">所在地区</text>
          <view class="field-picker">
            <text class="picker-value">{{form.region || '请选择'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="section-title-row">
        <text class="section-title-text">上传证件</text>
      </view>

      <view class="id-upload-section">
        <view class="upload-grid">
          <view class="id-card-upload" bindtap="onUploadIdFront">
            <image wx:if="{{form.idFront}}" src="{{form.idFront}}" mode="aspectFill" class="id-img" lazy-load="{{false}}" />
            <view wx:else class="upload-placeholder">
              <text class="upload-icon">📷</text>
              <text class="upload-label">身份证人像面</text>
              <text class="upload-hint">点击上传</text>
            </view>
          </view>
          <view class="id-card-upload" bindtap="onUploadIdBack">
            <image wx:if="{{form.idBack}}" src="{{form.idBack}}" mode="aspectFill" class="id-img" lazy-load="{{false}}" />
            <view wx:else class="upload-placeholder">
              <text class="upload-icon">📷</text>
              <text class="upload-label">身份证国徽面</text>
              <text class="upload-hint">点击上传</text>
            </view>
          </view>
        </view>
        <view class="upload-tips">
          <text class="tips-title">📋 上传要求：</text>
          <text class="tips-text">· 照片清晰可见，四角完整</text>
          <text class="tips-text">· 身份证信息真实有效</text>
          <text class="tips-text">· 支持 JPG/PNG 格式</text>
        </view>
      </view>

      <view class="agreement-row">
        <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">
          <text class="check-mark" wx:if="{{agreed}}">✓</text>
        </view>
        <text class="agreement-text">我已阅读并同意</text>
        <text class="agreement-link" catchtap="onViewAgreement">《实名认证协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" catchtap="onViewPrivacy">《隐私政策》</text>
      </view>
    </view>

    <view wx:if="{{authStatus === 'verified'}}" class="section">
      <view class="glass-card verified-info">
        <view class="info-row">
          <text class="info-label">真实姓名</text>
          <text class="info-value">{{verifiedInfo.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">身份证号</text>
          <text class="info-value">{{verifiedInfo.idCard}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">认证时间</text>
          <text class="info-value">{{verifiedInfo.time}}</text>
        </view>
      </view>
      <view class="glass-card benefit-card">
        <text class="benefit-title">🎁 认证后可享受的权益</text>
        <view class="benefit-item">
          <text class="benefit-icon">✓</text>
          <text class="benefit-text">下单优先匹配师傅</text>
        </view>
        <view class="benefit-item">
          <text class="benefit-icon">✓</text>
          <text class="benefit-text">享专属优惠活动</text>
        </view>
        <view class="benefit-item">
          <text class="benefit-icon">✓</text>
          <text class="benefit-text">订单保障升级</text>
        </view>
      </view>
      <view class="contact-support" bindtap="onContactSupport">
        <text class="support-icon">💬</text>
        <text class="support-text">信息有误？联系客服修改</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{authStatus !== 'verified'}}" class="cta-bar safe-bottom">
    <view class="btn-cta {{canSubmit ? '' : 'disabled'}}" bindtap="onSubmit">提交认证</view>
  </view>
</view>
