/* pages/client-real-name-auth/index.wxss — 实名认证 */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
  --brand: #0D9488;
  --brand-dark: #0A7A70;
  --brand-mid: #14B8A6;
  --brand-light: #CCFBF1;
  --brand-glow: rgba(13, 148, 136, 0.28);
  --brand-subtle: rgba(13, 148, 136, 0.08);
  --brand-gradient: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  z-index: 0;
  pointer-events: none;
  opacity: 0.12;
}

.hero {
  padding: 0 48rpx 32rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nav-icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.nav-icon-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.nav-icon { width: 40rpx; height: 40rpx; }

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-spacer { width: 88rpx; height: 88rpx; }

.auth-status-card {
  margin-top: 32rpx;
  padding: 40rpx 32rpx;
  border-radius: var(--r-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-unverified {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  box-shadow: var(--neu-raised);
}

.status-pending {
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  box-shadow: var(--neu-raised);
}

.status-verified {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  box-shadow: var(--neu-raised);
}

.status-icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--neu-inset);
}

.status-icon { font-size: 56rpx; }

.status-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
}

.status-desc {
  font-size: 26rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.5;
}

.section {
  padding: 0 40rpx;
  margin-bottom: 32rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.glass-card {
  position: relative;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-card > view, .glass-card > text { position: relative; z-index: 1; }

.form-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.form-field:last-child { border-bottom: none; }

.field-label {
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  text-align: right;
}

.field-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker-value {
  font-size: 28rpx;
  color: var(--text-1);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--text-3);
  font-weight: 300;
}

.id-upload-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.id-card-upload {
  aspect-ratio: 1.586;
  background: var(--bg);
  border: 2rpx dashed var(--border);
  border-radius: var(--r-md);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.id-card-upload:active {
  border-color: var(--brand);
  background: var(--brand-subtle);
}

.id-img { width: 100%; height: 100%; object-fit: cover; }

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
}

.upload-icon { font-size: 48rpx; }

.upload-label {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 600;
}

.upload-hint {
  font-size: 22rpx;
  color: var(--text-3);
}

.upload-tips {
  background: var(--brand-subtle);
  border-radius: var(--r-md);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tips-title {
  font-size: 26rpx;
  color: var(--brand-dark);
  font-weight: 600;
  margin-bottom: 4rpx;
}

.tips-text {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}

.agreement-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx;
  padding: 24rpx 8rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: var(--bg);
  box-shadow: var(--neu-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--brand-gradient);
  box-shadow: 0 4rpx 12rpx var(--brand-glow);
}

.check-mark {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

.agreement-text {
  font-size: 24rpx;
  color: var(--text-3);
}

.agreement-link {
  font-size: 24rpx;
  color: var(--brand);
}

.verified-info {
  padding: 8rpx 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.info-row:last-child { border-bottom: none; }

.info-label {
  font-size: 28rpx;
  color: var(--text-2);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.benefit-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.benefit-icon {
  font-size: 28rpx;
  color: var(--brand);
}

.benefit-text {
  font-size: 26rpx;
  color: var(--text-1);
}

.contact-support {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 32rpx;
  background: var(--brand-subtle);
  border-radius: var(--r-lg);
  margin-top: 24rpx;
}

.support-icon { font-size: 32rpx; }

.support-text {
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 500;
}

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 40rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.btn-cta {
  width: 100%;
  background: var(--brand-gradient);
  color: #fff;
  height: 96rpx;
  border-radius: var(--r-pill);
  font-size: 32rpx;
  font-weight: 700;
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.btn-cta.disabled {
  opacity: 0.5;
  box-shadow: var(--neu-raised-sm);
}

.btn-cta:active {
  transform: scale(0.97);
}
