<view class="phone-page design-detail-page" data-page-id="page-client-review-list">
  <view class="status-bar"><text>9:41</text><text class="status-icons">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" data-route="/pages/client-mine/index" bindtap="onNavigate"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">我的评价</view><text></text></view>
  <view class="page-body">
    <view class="hero"><view class="hero-kicker tag-p">REVIEW SUMMARY</view><view class="tag-h2">已加载 {{loadedCount}} 条评价</view><view class="tag-p" wx:if="{{loadedCount}}">当前已加载记录的平均评分 {{averageText}}；服务端共记录 {{serverTotal}} 条。</view><view class="tag-p" wx:else>提交后的评价会按服务端状态展示在这里。</view><view class="spacer"></view><text class="badge info">服务端同步</text></view>
    <view class="segmented"><view class="segment {{activeFilter === 'all' ? 'active' : ''}} design-button" data-filter="all" bindtap="onFilter">全部</view><view class="segment {{activeFilter === 'image' ? 'active' : ''}} design-button" data-filter="image" bindtap="onFilter">有图</view><view class="segment {{activeFilter === 'replied' ? 'active' : ''}} design-button" data-filter="replied" bindtap="onFilter">已回复</view></view>
    <view class="notice info" wx:if="{{loading}}">正在同步评价记录…</view>
    <view class="empty-state" wx:elif="{{loadError}}"><view class="tag-h3">评价加载失败</view><view class="tag-p">{{loadError}}</view><view class="btn secondary design-button" bindtap="loadReviews">重新加载</view></view>
    <view class="section" wx:else><view class="section-title"><text class="tag-strong">评价记录</text><text class="badge info">{{filteredReviews.length}} 条</text></view>
      <view class="card design-button" wx:for="{{filteredReviews}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenReview"><view class="list-row"><text class="avatar">{{item.avatarText}}</text><view class="row-main"><view class="row-title">{{item.workerText}} · {{item.serviceText}}</view><view class="row-copy">{{item.createdText}} · {{item.orderText}}</view></view><text style="color:var(--accent)">{{item.starsText}}</text><text class="chevron">›</text></view><view class="divider"></view><view class="card-copy tag-p">{{item.contentText}}</view><view class="chips" wx:if="{{item.tags.length}}"><text class="chip" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view><view class="section-title"><text class="badge {{item.status === 'rejected' ? 'danger' : item.status === 'approved' ? 'success' : 'warning'}}">{{item.statusText}}</text><text class="tag-span" wx:if="{{item.hasReply}}">师傅已回复</text></view></view>
      <view class="empty-state" wx:if="{{!filteredReviews.length}}"><view class="tag-h3">当前筛选下暂无评价</view><view class="tag-p">可切换其他筛选条件，或前往订单查看待评价服务。</view></view>
    </view>
  </view>
  <view class="fixed-actions"><view class="btn primary design-button" data-route="/pages/client-orders/index" bindtap="onNavigate">查看订单</view></view>
</view>
