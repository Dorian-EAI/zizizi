<view class="page">
  <view class="blob" style="top: -80rpx; right: -120rpx; width: 560rpx; height: 560rpx; background: var(--brand);"></view>
  <view class="blob" style="top: 480rpx; left: -160rpx; width: 480rpx; height: 480rpx; background: var(--accent);"></view>

  <scroll-view scroll-y class="page-scroll hide-scroll" style="padding-bottom: 40rpx;">
    <view class="hero" style="padding-top: calc({{statusBarHeight}}px + 76rpx);">
      <view class="nav-row">
        <view class="nav-icon-btn" bindtap="onBack">
          <image src="{{icons.back}}" mode="aspectFit" class="nav-icon" lazy-load="{{false}}" />
        </view>
        <text class="nav-title">个人信息</text>
        <view class="nav-spacer"></view>
      </view>
    </view>

    <view class="section">
      <view class="profile-card">
        <view class="avatar-section" bindtap="onChangeAvatar">
          <view class="profile-avatar">
            <image src="{{user.avatar}}" mode="aspectFill" class="avatar-img" lazy-load="{{false}}" />
            <view class="avatar-badge">
              <text class="badge-icon">📷</text>
            </view>
          </view>
          <view class="profile-info">
            <text class="profile-name">{{user.nickname}}</text>
            <text class="profile-id">ID: {{user.userId}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="glass-card">
        <view class="form-item" bindtap="onEditNickname">
          <text class="form-label">昵称</text>
          <view class="form-value-wrap">
            <text class="form-value">{{user.nickname}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
        <view class="form-item" bindtap="onEditPhone">
          <text class="form-label">手机号</text>
          <view class="form-value-wrap">
            <text class="form-value">{{user.phone}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
        <view class="form-item" bindtap="onEditGender">
          <text class="form-label">性别</text>
          <view class="form-value-wrap">
            <text class="form-value">{{user.gender}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
        <view class="form-item" bindtap="onEditBirthday">
          <text class="form-label">生日</text>
          <view class="form-value-wrap">
            <text class="form-value">{{user.birthday}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
        <view class="form-item" bindtap="onEditRegion">
          <text class="form-label">地区</text>
          <view class="form-value-wrap">
            <text class="form-value">{{user.region}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="glass-card">
        <view class="form-item" bindtap="onEditAvatar">
          <text class="form-label">头像</text>
          <view class="form-value-wrap">
            <image src="{{user.avatar}}" mode="aspectFill" class="mini-avatar" lazy-load="{{false}}" />
            <text class="form-arrow">›</text>
          </view>
        </view>
        <view class="form-item" bindtap="onPreviewSignature">
          <text class="form-label">个性签名</text>
          <view class="form-value-wrap">
            <text class="form-value">{{user.signature || '点击设置'}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="glass-card danger-card" bindtap="onLogout">
        <text class="danger-text">退出登录</text>
      </view>
    </view>
  </scroll-view>
</view>
