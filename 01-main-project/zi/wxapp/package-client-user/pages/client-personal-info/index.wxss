/* pages/client-personal-info/index.wxss — 个人信息 */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
  --brand: #0D9488;
  --brand-dark: #0A7A70;
  --brand-mid: #14B8A6;
  --brand-light: #CCFBF1;
  --brand-glow: rgba(13, 148, 136, 0.28);
  --brand-subtle: rgba(13, 148, 136, 0.08);
  --brand-gradient: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  z-index: 0;
  pointer-events: none;
  opacity: 0.12;
}

.hero {
  padding: 0 48rpx 32rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nav-icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.nav-icon-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.nav-icon { width: 40rpx; height: 40rpx; }

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-spacer { width: 88rpx; height: 88rpx; }

.section {
  padding: 0 40rpx;
  margin-bottom: 32rpx;
}

.profile-card {
  background: var(--brand-gradient);
  border-radius: var(--r-lg);
  padding: 40rpx 32rpx;
  box-shadow: 0 20rpx 60rpx var(--brand-glow);
}

.avatar-section {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
  position: relative;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-img { width: 100%; height: 100%; }

.avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-icon { font-size: 24rpx; }

.profile-info { flex: 1; }

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.profile-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  display: block;
}

.glass-card {
  position: relative;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  padding: 8rpx 32rpx;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-card > view, .glass-card > text { position: relative; z-index: 1; }

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.form-item:last-child { border-bottom: none; }

.form-label {
  font-size: 28rpx;
  color: var(--text-2);
}

.form-value-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.form-value {
  font-size: 28rpx;
  color: var(--text-1);
}

.form-arrow {
  font-size: 32rpx;
  color: var(--text-3);
  font-weight: 300;
}

.mini-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg);
}

.danger-card {
  padding: 28rpx 32rpx;
  text-align: center;
}

.danger-text {
  font-size: 30rpx;
  color: var(--danger);
  font-weight: 600;
}
