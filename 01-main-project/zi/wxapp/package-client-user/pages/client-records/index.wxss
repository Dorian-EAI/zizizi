/* pages/client-records/index.wxss — 我的记录 */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
  --brand: #0D9488;
  --brand-dark: #0A7A70;
  --brand-mid: #14B8A6;
  --brand-light: #CCFBF1;
  --brand-glow: rgba(13, 148, 136, 0.28);
  --brand-subtle: rgba(13, 148, 136, 0.08);
  --brand-gradient: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  z-index: 0;
  pointer-events: none;
  opacity: 0.12;
}

.hero {
  padding: 0 48rpx 32rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nav-icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.nav-icon-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.nav-icon { width: 40rpx; height: 40rpx; }

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-spacer { width: 88rpx; height: 88rpx; }

.summary-row {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--brand-gradient);
  border-radius: var(--r-lg);
  padding: 32rpx 24rpx;
  box-shadow: 0 16rpx 48rpx var(--brand-glow);
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.summary-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.summary-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.tabs {
  display: flex;
  gap: 16rpx;
  padding: 0 40rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  padding: 20rpx 0;
  border-radius: var(--r-pill);
  background: var(--bg);
  box-shadow: var(--neu-raised-sm);
  text-align: center;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: var(--brand-gradient);
  box-shadow: 0 8rpx 24rpx var(--brand-glow);
}

.tab-text {
  font-size: 28rpx;
  color: var(--text-2);
}

.tab-item.active .tab-text {
  color: #fff;
  font-weight: 600;
}

.section {
  padding: 0 40rpx;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  padding: 14rpx 28rpx;
  border-radius: var(--r-pill);
  background: var(--bg);
  box-shadow: var(--neu-raised-sm);
  transition: all 0.2s ease;
}

.filter-item.active {
  background: var(--brand-gradient);
  box-shadow: 0 6rpx 20rpx var(--brand-glow);
}

.filter-text {
  font-size: 26rpx;
  color: var(--text-2);
}

.filter-item.active .filter-text {
  color: #fff;
  font-weight: 600;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.glass-card {
  position: relative;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  padding: 28rpx;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-card > view, .glass-card > text { position: relative; z-index: 1; }

.record-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-date {
  font-size: 24rpx;
  color: var(--text-3);
}

.record-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
}

.status-completed {
  background: var(--brand-light);
  color: var(--brand-dark);
}

.status-pending {
  background: #FEF3C7;
  color: #B45309;
}

.status-cancelled {
  background: #FEE2E2;
  color: #B91C1C;
}

.record-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.record-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-icon { font-size: 40rpx; }

.record-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }

.record-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.record-desc {
  font-size: 24rpx;
  color: var(--text-3);
}

.record-amount { flex-shrink: 0; }

.amount-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--accent);
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--neu-raised);
  overflow: hidden;
  min-height: 180rpx;
  border: 1rpx solid var(--border);
}

.coupon-card.used {
  opacity: 0.5;
}

.coupon-amount {
  width: 200rpx;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #fff;
  flex-shrink: 0;
}

.coupon-symbol {
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-value {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.coupon-info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  justify-content: center;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}

.coupon-condition {
  font-size: 24rpx;
  color: var(--text-2);
}

.coupon-expire {
  font-size: 22rpx;
  color: var(--text-3);
}

.coupon-action {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.coupon-status {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

.coupon-card.used .coupon-status {
  color: var(--text-3);
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fav-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.fav-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fav-icon { font-size: 40rpx; }

.fav-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }

.fav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}

.fav-desc {
  font-size: 24rpx;
  color: var(--text-3);
}

.fav-remove {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg);
  box-shadow: var(--neu-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.remove-icon { font-size: 28rpx; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}
