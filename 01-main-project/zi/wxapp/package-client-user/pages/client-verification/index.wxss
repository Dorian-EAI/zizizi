@import "../../../styles/generated-detail-page.wxss";

/* ===== client-verification Glass-Neu 样式覆盖 ===== */

.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

/* Hero 区域 */
.hero {
  padding: 48rpx 48rpx 56rpx;
  padding-top: calc(env(safe-area-inset-top) + 120rpx);
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 440rpx 360rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  top: -30%;
  right: -15%;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.hero::after {
  content: "";
  position: absolute;
  bottom: -20%;
  left: -8%;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 148, 136, 0.10) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.hero > view,
.hero > text {
  position: relative;
  z-index: 1;
}

.hero-kicker {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--text-3);
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

.hero .tag-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  margin-bottom: 12rpx;
}

.hero .tag-p {
  font-size: 26rpx;
  color: var(--text-2);
}

/* 区块 */
.section {
  padding: 40rpx 48rpx 0;
  position: relative;
  z-index: 2;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
}

.section-title .tag-strong {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.section-title .tag-span {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  font-weight: 600;
}

.badge.warning {
  background: var(--accent-light);
  color: var(--accent-dark);
}

/* 上传网格 */
.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.upload-tile {
  aspect-ratio: 3 / 4;
  border-radius: var(--r-md);
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
  transition: transform 0.2s var(--spring);
}

.upload-tile:active {
  transform: scale(0.97);
}

.upload-placeholder {
  background: var(--bg);
  box-shadow: var(--neu-inset);
  border: 2rpx dashed rgba(13, 148, 136, 0.20);
}

.upload-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-icon .design-svg-icon {
  width: 72rpx;
  height: 56rpx;
  opacity: 0.8;
}

.upload-icon .tag-span {
  color: var(--brand);
  font-size: 48rpx;
}

.upload-tile .tag-small {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
}

.media-visual {
  background: linear-gradient(145deg, var(--brand-subtle) 0%, rgba(212, 148, 76, 0.10) 100%);
  box-shadow: var(--neu-raised-sm);
  border: 2rpx solid rgba(13, 148, 136, 0.15);
}

.media-visual .tag-small {
  color: var(--brand);
  font-weight: 600;
}

/* 表单卡片 */
.card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  overflow: hidden;
  position: relative;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

/* 表单字段 */
.field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  position: relative;
  z-index: 1;
  border-bottom: 1rpx solid var(--sep);
}

.field:last-child {
  border-bottom: none;
}

.field .tag-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  flex-shrink: 0;
  width: 160rpx;
}

.field .input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}

.field .input::placeholder {
  color: var(--text-3);
}

/* 通知提示 */
.notice.info {
  margin: 24rpx 48rpx 0;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}

/* Topbar 覆盖 */
.topbar {
  background:
    radial-gradient(ellipse 220rpx 160rpx at 78% 45%, rgba(212, 148, 76, 0.10) 0%, transparent 70%),
    radial-gradient(ellipse 180rpx 140rpx at 18% 75%, rgba(13, 148, 136, 0.10) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.08) 0%, rgba(212, 148, 76, 0.06) 50%, rgba(13, 148, 136, 0.05) 100%);
  padding: 36rpx 40rpx;
  padding-top: calc(env(safe-area-inset-top) + 36rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}

.topbar .icon-button {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  flex-shrink: 0;
}

.topbar .tag-h1 {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

/* 固定底部操作栏 */
.fixed-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(48rpx) saturate(160%);
  -webkit-backdrop-filter: blur(48rpx) saturate(160%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.60);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}

.fixed-actions .btn.primary {
  width: 100%;
  height: 96rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border: none;
  border-radius: var(--r-pill);
  font-size: 32rpx;
  font-weight: 700;
  font-family: var(--font-body);
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
}

.page-body {
  padding-bottom: 200rpx;
}