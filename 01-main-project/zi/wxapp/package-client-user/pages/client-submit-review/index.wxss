/* pages/client-submit-review/index.wxss — 提交评价页面 玻璃新拟态 */

.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

/* ===== Nav Bar ===== */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 40rpx;
  padding-bottom: 36rpx;
  padding-left: 40rpx;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-placeholder {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* ===== Section ===== */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}

.section:first-of-type {
  margin-top: 36rpx;
}

/* ===== Glass Neu Card ===== */
.glass-neu-card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
}

.glass-neu-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-neu-card > view,
.glass-neu-card > text {
  position: relative;
  z-index: 1;
}

/* ===== Order Card ===== */
.order-card {
  padding: 28rpx;
}

.order-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.order-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx var(--brand-glow);
}

.order-avatar-img {
  width: 100%;
  height: 100%;
}

.order-avatar-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.order-detail {
  flex: 1;
  min-width: 0;
}

.order-worker {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  margin-bottom: 6rpx;
}

.order-service {
  font-size: 26rpx;
  color: var(--text-2);
  display: block;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== Rating Card ===== */
.rating-card {
  padding: 36rpx;
}

.rating-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rating-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.rating-stars {
  display: flex;
  gap: 12rpx;
}

.star-item {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset);
  transition: transform var(--dur-base) var(--spring);
}

.star-item:active {
  transform: scale(0.92);
}

.star-item.active .star-icon {
  color: var(--orange);
}

.star-icon {
  font-size: 36rpx;
  color: var(--text-3);
}

.rating-text {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* ===== Sub Rating Card ===== */
.sub-rating-card {
  padding: 8rpx 36rpx;
}

.sub-rating-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  position: relative;
}

.sub-rating-item:not(:last-child)::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: var(--sep);
}

.sub-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.sub-stars {
  display: flex;
  gap: 8rpx;
}

.sub-stars .star-item {
  width: 52rpx;
  height: 52rpx;
}

.sub-stars .star-icon {
  font-size: 30rpx;
}

/* ===== Content Card ===== */
.content-card {
  padding: 36rpx;
}

.content-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.content-count {
  font-size: 24rpx;
  color: var(--text-3);
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset);
  border: none;
  border-radius: var(--r-md);
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-1);
  font-family: var(--font-body);
  line-height: 1.6;
  outline: none;
}

.content-input::placeholder {
  color: var(--text-3);
}

.image-upload {
  margin-top: 24rpx;
}

.upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  background: var(--bg-elevated);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.upload-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

.upload-icon {
  width: 48rpx;
  height: 48rpx;
  color: var(--brand);
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: var(--text-3);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-md);
  overflow: hidden;
}

.uploaded-img {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 32rpx;
  color: #fff;
  font-weight: 300;
}

/* ===== Anonymous Card ===== */
.anonymous-card {
  padding: 28rpx 36rpx;
}

.anonymous-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.anonymous-info {
  flex: 1;
  min-width: 0;
}

.anonymous-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 6rpx;
}

.anonymous-desc {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== Toggle Switch ===== */
.toggle {
  width: 88rpx;
  height: 52rpx;
  border-radius: var(--r-pill);
  border: none;
  position: relative;
  flex-shrink: 0;
  padding: 0;
  transition: background var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
}

.toggle-on {
  background: var(--brand);
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.15), 0 4rpx 12rpx var(--brand-glow);
}

.toggle-off {
  background: var(--neu-dark);
  box-shadow: var(--neu-inset);
}

.toggle-thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.18);
  transition: transform var(--dur-base) var(--spring);
}

.toggle-on .toggle-thumb {
  transform: translateX(36rpx);
}

.toggle-off .toggle-thumb {
  transform: translateX(0);
}

/* ===== CTA ===== */
.cta-spacer {
  height: 168rpx;
}

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 24rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(242, 237, 232, 0.88);
  backdrop-filter: blur(48rpx) saturate(160%);
  -webkit-backdrop-filter: blur(48rpx) saturate(160%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.06);
}

.cta-primary {
  height: 96rpx;
  border-radius: var(--r-lg);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.cta-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.97);
}

.cta-primary-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}