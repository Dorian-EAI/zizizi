/* AUTO-GENERATED DESIGN STYLE ENTRY; page-specific overrides may follow this import. */
@import "../../../styles/generated-detail-page.wxss";

/* ============================================================
 * Glass-Neu: client-invite-record 邀请记录
 * 客户端 Teal 品牌 + 琥珀点缀
 * ============================================================ */

.design-detail-page {
  background: var(--canvas);
  min-height: 100vh;
}

.design-detail-page::after {
  background:
    radial-gradient(ellipse 400rpx 280rpx at 20% 90%, rgba(13, 148, 136, 0.07) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 240rpx at 80% 85%, rgba(212, 148, 76, 0.06) 0%, transparent 70%);
}

.topbar {
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

.hero {
  padding: 36rpx 40rpx;
  margin: 0 0 32rpx;
  background:
    radial-gradient(ellipse 360rpx 240rpx at 88% 15%, rgba(212, 148, 76, 0.12) 0%, transparent 72%),
    radial-gradient(ellipse 300rpx 220rpx at 8% 90%, rgba(13, 148, 136, 0.12) 0%, transparent 72%),
    rgba(255, 255, 255, 0.48);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.hero > view,
.hero > text {
  position: relative;
  z-index: 1;
}

.grid-2 .metric {
  background: var(--glass-bg);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow:
    var(--neu-raised-sm),
    0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding: 28rpx 20rpx;
  text-align: center;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.grid-2 .metric:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
}

.grid-2 .metric .tag-strong {
  display: block;
  color: var(--brand);
  font-family: var(--font-number);
  font-weight: 700;
  font-size: 44rpx;
  line-height: 1.1;
}

.grid-2 .metric .tag-span {
  display: block;
  margin-top: 12rpx;
  color: var(--text-2);
  font-size: 24rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow:
    var(--neu-raised-sm),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40);
}

.segment {
  flex: 1;
  text-align: center;
  padding: 20rpx 10rpx;
  border-radius: var(--r-sm);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  background: var(--canvas);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), all 0.2s var(--ease);
}

.segment:active {
  transform: scale(0.94);
}

.segment.active {
  background: var(--brand-subtle);
  box-shadow: inset 2rpx 2rpx 5rpx var(--neu-dark), inset -2rpx -2rpx 5rpx var(--neu-light);
  color: var(--brand);
}

.card {
  background: var(--glass-bg);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  overflow: hidden;
  position: relative;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.card > view,
.card > text {
  position: relative;
  z-index: 1;
}

.list-card {
  padding: 8rpx 28rpx;
}

.list-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid var(--sep);
}

.list-row:last-child {
  border-bottom: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--brand);
  background: var(--canvas);
  box-shadow: var(--neu-inset);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 32rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  color: var(--text-1);
  font-size: 30rpx;
  font-weight: 500;
}

.row-copy {
  margin-top: 6rpx;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.45;
}

.row-value {
  color: var(--text-2);
  font-size: 26rpx;
  text-align: right;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  border-radius: var(--r-pill);
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge.info { color: #46748D; background: rgba(90, 143, 173, 0.12); }
.badge.warning { color: #986326; background: rgba(212, 148, 76, 0.10); }

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 12rpx 18rpx;
}

.section-title .tag-strong {
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.empty-state {
  padding: 72rpx 44rpx;
  text-align: center;
}

.empty-state .tag-h3 {
  margin: 0;
  font-size: 32rpx;
  color: var(--text-1);
  font-weight: 700;
}

.empty-state .tag-p {
  margin: 16rpx 0 0;
  color: var(--text-2);
  font-size: 26rpx;
}

.notice {
  margin-bottom: 26rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(212, 148, 76, 0.14);
  border-radius: var(--r-sm);
  color: #315F74;
  background: rgba(90, 143, 173, 0.09);
  font-size: 24rpx;
  line-height: 1.55;
}

.btn.primary {
  min-height: 96rpx;
  border: none;
  border-radius: var(--r-pill);
  padding: 0 36rpx;
  font-weight: 600;
  font-size: 28rpx;
  color: #fff;
  background: var(--brand-gradient);
  box-shadow:
    var(--neu-raised-sm),
    0 4rpx 8rpx var(--brand-glow),
    0 12rpx 28rpx var(--brand-glow),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.40),
    inset 0 -2rpx 2rpx rgba(0, 0, 0, 0.16);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.btn.primary:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
}

.btn.block {
  width: 100%;
}

.icon-button {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.5);
  display: grid;
  place-items: center;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.icon-button:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}