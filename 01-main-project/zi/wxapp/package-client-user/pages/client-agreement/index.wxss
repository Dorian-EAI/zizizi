/* AUTO-GENERATED DESIGN STYLE ENTRY; page-specific overrides may follow this import. */
@import "../../../styles/generated-detail-page.wxss";

.phone-page {
  --neu-raised: var(--neu-out-md);
  --glass-bg: rgba(255, 255, 255, 0.52);
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.phone-page .topbar .top-action {
  color: var(--brand);
  font-weight: 600;
}

.agreement-scroll {
  height: calc(100vh - 98rpx);
  padding-bottom: 180rpx;
}

.document-card {
  min-height: 760rpx;
  padding: 40rpx 32rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--neu-out-md);
}

.document-content {
  display: block;
  white-space: pre-wrap;
  font-size: 25rpx;
  line-height: 1.85;
  color: var(--ink);
}

.document-card.large .document-content {
  font-size: 29rpx;
}

.document-card.small .document-content {
  font-size: 22rpx;
}

.state-copy {
  padding: 120rpx 20rpx;
  text-align: center;
  color: var(--muted);
}

.phone-page .segmented {
  margin-bottom: 28rpx;
}

.phone-page .segment {
  font-size: 26rpx;
  font-weight: 500;
}

.phone-page .segment.active {
  font-weight: 600;
}

.phone-page .empty-state {
  padding: 40rpx;
}

.phone-page .fixed-actions {
  border: 1rpx solid rgba(13, 148, 136, 0.18);
}
