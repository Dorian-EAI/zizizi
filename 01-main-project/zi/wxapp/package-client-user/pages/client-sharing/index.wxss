/* pages/client-sharing/index.wxss — 分享页面 玻璃新拟态 */

.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

/* ===== Nav Bar ===== */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 40rpx;
  padding-bottom: 36rpx;
  padding-left: 40rpx;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-placeholder {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* ===== Section ===== */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}

.section:first-of-type {
  margin-top: 36rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.title-count {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* ===== Glass Neu Card ===== */
.glass-neu-card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
}

.glass-neu-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-neu-card > view,
.glass-neu-card > text {
  position: relative;
  z-index: 1;
}

/* ===== Hero Card ===== */
.hero-card {
  padding: 48rpx 36rpx;
  text-align: center;
}

.hero-bg-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 148, 136, 0.18) 0%, transparent 70%);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
  margin-bottom: 36rpx;
}

.hero-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  box-shadow: 0 8rpx 32rpx var(--brand-glow);
}

.hero-icon {
  width: 60rpx;
  height: 60rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.02em;
}

.hero-desc {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
}

.qr-code-wrap {
  position: relative;
  z-index: 1;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--sep);
}

.qr-code-placeholder {
  width: 280rpx;
  height: 280rpx;
  background: #fff;
  border-radius: var(--r-md);
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--neu-raised-sm);
}

.qr-code {
  width: 240rpx;
  height: 240rpx;
}

.qr-tip {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== Link Card ===== */
.link-card {
  padding: 28rpx 36rpx;
}

.link-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.link-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.copy-btn {
  padding: 8rpx 24rpx;
  background: var(--brand);
  border-radius: var(--r-pill);
  box-shadow: 0 4rpx 12rpx var(--brand-glow);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.copy-btn text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.copy-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.link-value {
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-elevated);
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  box-shadow: var(--neu-inset);
  display: block;
  word-break: break-all;
}

.mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* ===== Share Grid ===== */
.share-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.share-item {
  padding: 28rpx 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.share-item:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

.share-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.share-icon-wechat {
  background: #07C160;
}

.share-icon-moments {
  background: #5A8FAD;
}

.share-icon-link {
  background: var(--accent);
}

.share-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.share-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-1);
}

/* ===== History List ===== */
.history-list {
  padding: 8rpx 0;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  position: relative;
}

.history-item:not(:last-child)::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 28rpx;
  right: 28rpx;
  height: 1rpx;
  background: var(--sep);
}

.his-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.his-avatar-img {
  width: 100%;
  height: 100%;
}

.his-avatar-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.his-info {
  flex: 1;
  min-width: 0;
}

.his-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 6rpx;
}

.his-time {
  font-size: 24rpx;
  color: var(--text-3);
}

.his-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  flex-shrink: 0;
}

.his-status-pending {
  background: var(--warning-bg);
  color: var(--warning);
}

.his-status-success {
  background: var(--success-bg);
  color: var(--success);
}

.his-status-failed {
  background: var(--danger-bg);
  color: var(--danger);
}

/* ===== CTA ===== */
.cta-spacer {
  height: 168rpx;
}

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 24rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(242, 237, 232, 0.88);
  backdrop-filter: blur(48rpx) saturate(160%);
  -webkit-backdrop-filter: blur(48rpx) saturate(160%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.06);
}

.cta-primary {
  height: 96rpx;
  border-radius: var(--r-lg);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.cta-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.97);
}

.cta-primary-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}