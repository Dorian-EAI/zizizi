/* AUTO-GENERATED DESIGN STYLE ENTRY; page-specific overrides may follow this import. */
@import "../../../styles/generated-detail-page.wxss";

.phone-page {
  --neu-raised: var(--neu-out-md);
  --glass-bg: rgba(255, 255, 255, 0.52);
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.phone-page .hero {
  border: 2rpx solid rgba(196, 83, 58, 0.18);
  background: linear-gradient(135deg, rgba(196, 83, 58, 0.06) 0%, rgba(212, 148, 76, 0.06) 100%), var(--summary-background);
}

.phone-page .hero .tag-h2 {
  color: var(--danger);
}

.phone-page .notice.error {
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.phone-page .list-row {
  min-height: 120rpx;
}

.phone-page .row-icon {
  background: var(--bg-elevated);
}

.phone-page .badge.danger {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.phone-page .badge.success {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.phone-page .card {
  margin-bottom: 28rpx;
}

.phone-page .fixed-actions {
  border: 1rpx solid rgba(196, 83, 58, 0.18);
}

.phone-page .btn.danger {
  background: linear-gradient(135deg, #C4533A 0%, #A53E2D 100%);
  color: #fff;
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3), 0 8rpx 24rpx rgba(196, 83, 58, 0.35);
}

.phone-page .btn.danger:disabled {
  opacity: 0.6;
}
