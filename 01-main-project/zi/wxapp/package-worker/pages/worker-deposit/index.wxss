/* pages/worker-deposit/index.wxss — 师傅保证金页 像素级复刻 worker-deposit.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 师傅端品牌色：--brand-worker #2D6CDF
 */
.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== Top Back Bar ===== */
/* HTML: .topbar{display:flex;align-items:center;gap:12px;padding:18px 20px 10px;background:radial-gradient(...);border-radius:0 0 28px 28px;overflow:hidden} */
.topbar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 40rpx 20rpx;
  position: relative;
  z-index: 20;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212,148,76,.10) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(212,148,76,.04) 50%, rgba(45, 108, 223, 0.06) 100%);
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  transition: background var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
}
.nav-bar.worker.scrolled,
.topbar.scrolled {
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212,148,76,.10) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.20) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.18) 0%, rgba(212,148,76,.04) 50%, rgba(45, 108, 223, 0.10) 100%),
    rgba(247, 243, 239, 0.72);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  box-shadow: 0 8rpx 32rpx rgba(45, 108, 223, 0.08);
}
/* HTML: .back-btn{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,0.50);backdrop-filter:blur(16px);border:0.5px solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm),inset 0 1px 1.5px rgba(255,255,255,0.50)} */
.back-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.back-btn:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.90);
}
.back-ic {
  width: 38rpx;
  height: 38rpx;
}
.topbar-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  flex: 1;
}
.topbar-spacer {
  width: 76rpx;
  flex-shrink: 0;
}

/* ===== Deposit Balance Hero ===== */
/* HTML: .dep-hero{padding:8px 24px 40px;background:radial-gradient(ellipse 240px 200px at 25% 40%, rgba(212,148,76,.12) 0%, transparent 70%),
             radial-gradient(ellipse 200px 160px at 80% 80%, rgba(45,108,223,0.24) 0%, transparent 70%),
             linear-gradient(135deg, rgba(45,108,223,0.28) 0%, rgba(212,148,76,.10) 50%, rgba(45,108,223,0.12) 100%);border-radius:0 0 32px 32px;overflow:hidden} */
.dep-hero {
  padding: 16rpx 48rpx 80rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 25% 40%, rgba(212,148,76,.12) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 80% 80%, rgba(45, 108, 223, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.28) 0%, rgba(212,148,76,.10) 50%, rgba(45, 108, 223, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}
/* HTML: .dep-hero::before / ::after 光斑装饰 */
.dep-hero::before {
  content: "";
  position: absolute;
  top: -30%;
  right: -15%;
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.dep-hero::after {
  content: "";
  position: absolute;
  bottom: -25%;
  left: -8%;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
/* HTML: .dep-hero-label{font-size:13px;color:var(--text-2);font-weight:500;margin-bottom:8px} */
.dep-hero-label {
  display: flex;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  margin-bottom: 16rpx;
  letter-spacing: 0.02em;
  position: relative;
  z-index: 2;
}
/* HTML: .dep-hero-amount{font-size:38px;font-weight:800;color:var(--brand);letter-spacing:-1.2px;line-height:1.1} */
.dep-hero-amount {
  display: flex;
  justify-content: center;
  font-size: 76rpx;
  font-weight: 800;
  color: var(--brand-worker);
  letter-spacing: -2.4rpx;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  position: relative;
  z-index: 2;
}
/* HTML: .dep-hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px} */
.dep-hero-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}

/* HTML: .status-badge{display:inline-flex;align-items:center;gap:5px;padding:6px 12px;border-radius:var(--r-pill);background:rgba(255,255,255,0.50);backdrop-filter:blur(12px);border:0.5px solid rgba(255,255,255,0.55);box-shadow:var(--neu-out-sm);font-size:12.5px;color:var(--text-1);font-weight:600} */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  font-size: 25rpx;
  color: var(--text-1);
  font-weight: 600;
}
.status-badge.green { color: var(--green); }
.status-badge-ic {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
/* HTML: .level-chip{...;color:var(--brand);font-weight:600} */
.level-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  font-size: 25rpx;
  color: var(--brand-worker);
  font-weight: 600;
}
.level-chip-ic {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* ===== Section + Card ===== */
/* HTML: .section{padding:0 24px;margin-top:20px} */
.section {
  padding: 0 48rpx;
  margin-top: 40rpx;
  position: relative;
  z-index: 5;
}
/* HTML: .section-title{font-size:17px;font-weight:700;margin-bottom:12px;letter-spacing:-0.02em} */
.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;
  letter-spacing: -0.02em;
}
/* HTML: .card{background:rgba(255,255,255,0.52);backdrop-filter:blur(20px) saturate(150%);border:1px solid rgba(255,255,255,0.70);border-radius:var(--r);box-shadow:var(--neu-out-md),0 6px 24px rgba(0,0,0,0.06),0 0 0 1px rgba(44,40,36,0.05),0 2px 8px rgba(20,184,166,0.04)} */
.card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised), 0 12rpx 48rpx rgba(0, 0, 0, 0.06), var(--shadow-card-ring), var(--shadow-card-worker);
  overflow: hidden;
  position: relative;
}
/* HTML: .card::before Rim Light */
.card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

/* ===== Benefit Card ===== */
/* HTML: .benefit-card{padding:6px 18px} */
.benefit-card {
  padding: 12rpx 36rpx;
}
/* HTML: .benefit-row{display:flex;align-items:center;gap:12px;padding:13px 0;position:relative;z-index:1} */
.benefit-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0;
  position: relative;
  z-index: 1;
}
/* HTML: .benefit-row+.benefit-row::before{content:"";position:absolute;top:0;left:34px;right:0;height:0.5px;background:var(--sep)} */
.benefit-row + .benefit-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 68rpx;
  right: 0;
  height: 1rpx;
  background: var(--sep);
}
/* HTML: .benefit-check{width:26px;height:26px;border-radius:50%;background:rgba(91,140,90,0.12);color:var(--green)} */
.benefit-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(91, 140, 90, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--green);
  flex-shrink: 0;
}
.benefit-check-ic {
  width: 30rpx;
  height: 30rpx;
}
/* HTML: .benefit-text{font-size:15px;color:var(--text-1);font-weight:500} */
.benefit-text {
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: -0.01em;
}

/* ===== Level Cards ===== */
/* HTML: .level-list{display:flex;flex-direction:column;gap:12px} */
.level-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* HTML: .level-card{background:rgba(255,255,255,0.52);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.70);border-radius:var(--r);box-shadow:var(--neu-out-sm);padding:16px 18px;overflow:hidden} */
.level-card {
  position: relative;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm), 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  padding: 32rpx 36rpx;
  overflow: hidden;
  transition: transform var(--dur-base) var(--ease);
}
.level-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}
/* HTML: .level-card.locked{opacity:0.62} */
.level-card.locked {
  opacity: 0.62;
}
/* HTML: .level-card.current{background:linear-gradient(135deg,rgba(45,108,223,0.20) 0%,rgba(45,108,223,0.08) 100%);border-color:rgba(45,108,223,0.42);box-shadow:var(--neu-out-sm),0 6px 22px var(--brand-glow)} */
.level-card.current {
  /* HTML: background-image: linear-gradient(135deg, rgba(45,108,223,0.20) 0%, rgba(45,108,223,0.08) 100%); */
  background: linear-gradient(135deg, rgba(45, 108, 223, 0.20) 0%, rgba(45, 108, 223, 0.08) 100%);
  border-color: rgba(45, 108, 223, 0.42);
  box-shadow: var(--neu-raised-sm), 0 12rpx 44rpx var(--brand-worker-glow);
  opacity: 1;
}
.level-card.current::after {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(45, 108, 223, 0.10) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

/* HTML: .level-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px} */
.level-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}
/* HTML: .level-name-block{display:flex;align-items:baseline;gap:8px} */
.level-name-block {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
/* HTML: .level-name{font-size:16px;font-weight:700} */
.level-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}
.level-card.locked .level-name { color: var(--text-2); }
.level-card.current .level-name { color: var(--brand-worker); }
/* HTML: .level-amount{font-size:15px;font-weight:700;color:var(--brand)} */
.level-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-worker);
  font-variant-numeric: tabular-nums;
}
.level-card.locked .level-amount { color: var(--text-2); }
/* HTML: .level-tag{font-size:11px;font-weight:600;padding:3px 9px;border-radius:var(--r-pill)} */
.level-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  letter-spacing: 0.01em;
}
.level-tag.gray {
  color: var(--text-2);
  background: rgba(44, 40, 36, 0.06);
}
.level-tag.brand {
  color: #fff;
  background: var(--brand-worker);
}

/* HTML: .level-benefits{display:flex;flex-direction:column;gap:5px} */
.level-benefits {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}
/* HTML: .level-benefit{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--text-2)} */
.level-benefit {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}
/* HTML: .level-benefit::before{content:"";width:4px;height:4px;border-radius:50%;background:var(--text-3)} */
.level-benefit::before {
  content: "";
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-3);
  flex-shrink: 0;
}
.level-card.current .level-benefit { color: var(--text-1); }
.level-card.current .level-benefit::before { background: var(--brand-worker); }

/* HTML: .current-corner{position:absolute;top:0;right:0;font-size:11px;font-weight:700;color:#fff;background:var(--brand);padding:4px 12px;border-radius:0 var(--r) 0 10px;box-shadow:0 2px 8px var(--brand-glow)} */
.current-corner {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 3;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: var(--brand-worker);
  padding: 8rpx 24rpx;
  border-radius: 0 var(--r-md) 0 20rpx;
  box-shadow: 0 4rpx 16rpx var(--brand-worker-glow);
  letter-spacing: 0.02em;
}

/* ===== Record Card ===== */
/* HTML: .record-card{padding:2px 0} */
.record-card {
  padding: 4rpx 0;
}
/* HTML: .record-row{display:flex;align-items:center;gap:12px;padding:14px 18px} */
.record-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 36rpx;
  position: relative;
  z-index: 1;
}
.record-row + .record-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 120rpx;
  right: 36rpx;
  height: 1rpx;
  background: var(--sep);
}
/* HTML: .record-icon{width:40px;height:40px;border-radius:var(--r-sm);background:var(--bg);box-shadow:4px 4px 8px var(--neu-dark),-4px -4px 8px var(--neu-light)} */
.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg-elevated);
  box-shadow: 8rpx 8rpx 16rpx var(--neu-dark), -8rpx -8rpx 16rpx var(--neu-light), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}
.record-ic {
  width: 40rpx;
  height: 40rpx;
}
.record-icon.income { color: var(--green); }
.record-icon.outcome { color: var(--red); }
.record-icon.pending { color: var(--orange); }
/* HTML: .record-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px} */
.record-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
/* HTML: .record-title{font-size:15px;font-weight:600;color:var(--text-1)} */
.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* HTML: .record-time{font-size:12px;color:var(--text-2)} */
.record-time {
  font-size: 24rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
/* HTML: .record-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px} */
.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
/* HTML: .record-amount{font-size:16px;font-weight:700} */
.record-amount {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}
.record-amount.plus { color: var(--green); }
.record-amount.minus { color: var(--red); }
.record-amount.zero { color: var(--text-2); }
/* HTML: .record-status{font-size:11px;font-weight:600;padding:2px 8px;border-radius:var(--r-pill)} */
.record-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
}
.record-status.green { color: var(--green); background: rgba(91, 140, 90, 0.10); }
.record-status.red { color: var(--red); background: rgba(196, 83, 58, 0.10); }
.record-status.orange { color: var(--orange); background: rgba(212, 148, 76, 0.12); }

/* ===== Buttons ===== */
/* HTML: .btn-neu-ghost{background:transparent;color:var(--text-2);border:0.5px solid var(--border);border-radius:9999px;padding:8px 16px;font-size:13px;font-weight:600;box-shadow:none} */
.btn-neu-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: transparent;
  color: var(--text-2);
  border: 1rpx solid var(--border);
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: transform var(--dur-base) var(--spring), color var(--dur-base) var(--ease);
}
.btn-neu-ghost:active {
  transform: scale(0.94);
  color: var(--brand-worker);
}
/* HTML: .btn-neu-primary{background:var(--brand-gradient);color:#fff;border:0.5px solid rgba(255,255,255,0.40);border-radius:9999px;padding:8px 16px;font-size:13px;font-weight:600;box-shadow:var(--neu-out-sm),0 4px 14px var(--brand-glow)} */
.btn-neu-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--brand-worker-gradient);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.40);
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx var(--brand-worker-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.30);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.btn-neu-primary:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.94);
}
.btn-ic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* ===== Bottom Fixed Dual Buttons ===== */
/* HTML: .bottom-actions{position:absolute;bottom:0;left:0;right:0;display:flex;gap:12px;padding:14px 20px 24px;background:linear-gradient(180deg,rgba(242,237,232,0) 0%,rgba(242,237,232,0.92) 32%,var(--bg) 60%);z-index:60} */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 28rpx 40rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  background: linear-gradient(180deg, rgba(242, 237, 232, 0) 0%, rgba(242, 237, 232, 0.92) 32%, var(--bg) 60%);
  z-index: 60;
}
/* HTML: .bottom-actions .btn-neu-ghost,.bottom-actions .btn-neu-primary{flex:1;height:48px;font-size:15px;border-radius:var(--r-pill)} */
.bottom-actions .btn-neu-ghost,
.bottom-actions .btn-neu-primary {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  border-radius: var(--r-pill);
}
