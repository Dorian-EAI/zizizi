/* pages/worker-income-stat/index.wxss — 收入统计页 玻璃新拟态
 * 继承 generated-detail-page.wxss 基础样式，补充页面专属 Glass-Neu 效果
 * 师傅端主题（蓝色 #2D6CDF）
 */

@import "../../../styles/generated-detail-page.wxss";

/* ===== 页面容器 ===== */
.phone-page {
  position: relative;
  min-height: 100vh;
  background: var(--bg);
}

/* ===== Hero 区域（收入总览卡） ===== */
.hero {
  position: relative;
  overflow: hidden;
  margin: 0 0 40rpx;
  padding: 56rpx 40rpx;
  color: var(--ink);
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.18) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.16) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(45, 108, 223, 0.06) 100%);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--radius-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(45, 108, 223, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
}

.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.hero > view,
.hero > text {
  position: relative;
  z-index: 1;
}

.hero .hero-kicker {
  margin: 0 0 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
}

.hero-number {
  color: var(--brand-dark);
  font: 700 80rpx/1.1 var(--font-nums);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.hero .tag-p {
  margin: 16rpx 0 0;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.55;
}

/* ===== Segmented 分段控件 ===== */
.segmented {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40), 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.segment {
  flex: 1;
  border: 0;
  border-radius: var(--radius-sm);
  padding: 20rpx 10rpx;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.35);
  box-shadow: var(--neu-out-sm);
  font-size: 24rpx;
  font-weight: 500;
}

.segment.active {
  color: var(--brand);
  background: var(--brand-soft);
  box-shadow: var(--neu-in);
  font-weight: 600;
}

.segment:active {
  transform: scale(0.96);
}

/* ===== Section 区域 ===== */
.section {
  margin: 0 0 36rpx;
}

.section-title {
  margin: 0 12rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 500;
}

.section-title .tag-strong {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

/* ===== 卡片（Glass-Neu） ===== */
.card {
  position: relative;
  padding: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--radius-md);
  background: var(--surface);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(45, 108, 223, 0.04);
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}

/* ===== Grid 布局 ===== */
.grid-2,
.grid-3 {
  display: grid;
  gap: 24rpx;
}

.grid-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* ===== Metric 指标卡 ===== */
.metric {
  padding: 28rpx 20rpx;
  text-align: center;
  border-radius: var(--radius-sm);
  transition: transform var(--dur) var(--ease);
}

.metric:active {
  transform: scale(0.96);
}

.metric .tag-strong {
  display: block;
  color: var(--brand-dark);
  font: 700 44rpx/1.1 var(--font-nums);
  font-variant-numeric: tabular-nums;
}

.metric .tag-span {
  display: block;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 24rpx;
}

/* ===== 分隔线 ===== */
.divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: var(--line);
}

/* ===== 列表卡片 ===== */
.list-card {
  padding: 8rpx 28rpx;
  overflow: hidden;
}

.list-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.list-row:last-child {
  border-bottom: 0;
}

.list-row .row-icon {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  font-size: 30rpx;
}

.list-row .row-main {
  flex: 1;
  min-width: 0;
}

.list-row .row-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 500;
}

.list-row .row-copy {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.list-row .row-value {
  color: var(--text-1);
  font-size: 28rpx;
  font-weight: 700;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.list-row .chevron {
  position: relative;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  color: var(--faint);
}

.list-row:active {
  transform: scale(0.985);
  background: var(--fill);
}

/* ===== Topbar 区域 ===== */
.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: 160rpx;
  padding: 36rpx 40rpx;
  padding-top: max(36rpx, env(safe-area-inset-top));
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
  border-radius: 0 0 56rpx 56rpx;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(45, 108, 223, 0.06) 100%);
}

.topbar .tag-h1 {
  margin: 0;
  text-align: center;
  color: var(--ink);
  font: 700 34rpx/1.3 var(--font-body);
  letter-spacing: -0.02em;
}

.topbar .icon-button {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: var(--ink);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.5);
  display: inline-grid;
  place-items: center;
}

.topbar .icon-button:active {
  box-shadow: var(--neu-in);
  transform: scale(0.94);
}

.topbar .top-action {
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  text-align: right;
}

/* ===== 页面主体 ===== */
.page-body {
  padding: 36rpx 40rpx 224rpx;
}

/* ===== 响应式适配 ===== */
@media (max-width: 750rpx) {
  .hero-number {
    font-size: 64rpx;
  }

  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
