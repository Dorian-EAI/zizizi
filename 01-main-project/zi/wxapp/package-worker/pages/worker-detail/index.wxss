/* pages/worker-detail/index.wxss — 师傅详情页 玻璃新拟态
 * 师傅端蓝色主题
 */

@import "../../../styles/generated-detail-page.wxss";

.phone-page {
  position: relative;
  min-height: 100vh;
  background: var(--bg);
}

.hero {
  position: relative;
  overflow: hidden;
  margin: 0 0 40rpx;
  padding: 48rpx 40rpx;
  color: var(--ink);
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.18) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.16) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(45, 108, 223, 0.06) 100%);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--radius-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(45, 108, 223, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
}

.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.hero > view, .hero > text {
  position: relative;
  z-index: 1;
}

.hero-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--brand);
  background: linear-gradient(145deg,
    rgba(255, 255, 255, 0.68) 0%,
    rgba(255, 255, 255, 0.28) 40%,
    var(--brand-soft) 78%,
    rgba(255, 255, 255, 0.18) 100%);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow:
    inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04),
    var(--neu-raised-sm);
}

.hero-name {
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.02em;
}

.hero-rating {
  text-align: center;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--orange);
  font-weight: 600;
}

.hero-meta {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.section {
  margin: 0 0 36rpx;
}

.section-title {
  margin: 0 12rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 500;
}

.section-title .tag-strong {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.card {
  position: relative;
  padding: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--radius-md);
  background: var(--surface);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(45, 108, 223, 0.04);
}

.card-title {
  margin: 0 0 16rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.chip {
  border: 0;
  border-radius: var(--radius-full);
  padding: 14rpx 28rpx;
  color: var(--brand);
  background: var(--brand-soft);
  box-shadow: var(--neu-in);
  font-size: 24rpx;
  font-weight: 600;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.info-row:last-of-type {
  border-bottom: none;
}

.info-label {
  font-size: 27rpx;
  color: var(--text-2);
  font-weight: 500;
}

.info-value {
  font-size: 27rpx;
  color: var(--text-1);
  font-weight: 600;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: 160rpx;
  padding: 36rpx 40rpx;
  padding-top: max(36rpx, env(safe-area-inset-top));
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
  border-radius: 0 0 56rpx 56rpx;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(45, 108, 223, 0.06) 100%);
}

.topbar .tag-h1 {
  margin: 0;
  text-align: center;
  color: var(--ink);
  font: 700 34rpx/1.3 var(--font-body);
  letter-spacing: -0.02em;
}

.topbar .icon-button {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: var(--ink);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.5);
  display: inline-grid;
  place-items: center;
}

.topbar .icon-button:active {
  box-shadow: var(--neu-in);
  transform: scale(0.94);
}

.page-body {
  padding: 36rpx 40rpx 224rpx;
}

.fixed-actions {
  position: fixed;
  z-index: 20;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  padding: 20rpx;
  display: flex;
  gap: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40), 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.fixed-actions .btn.primary {
  flex: 1;
  min-height: 96rpx;
  border: 0;
  border-radius: var(--radius-full);
  padding: 0 36rpx;
  font-weight: 600;
  font-size: 28rpx;
  color: var(--text-inverse);
  background: var(--brand-gradient);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.40), inset 0 -2rpx 2rpx rgba(0, 0, 0, 0.16), 0 4rpx 8rpx var(--brand-glow), 0 12rpx 28rpx var(--brand-glow);
}
