<view class="phone-page design-detail-page worker-theme">
  <view class="topbar">
    <view class="icon-button design-button" bindtap="onBack"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view>
    <view class="tag-h1">师傅入驻申请</view>
    <view class="top-action"></view>
  </view>

  <view class="page-body">
    <view class="notice">提交申请后，平台将在 1-3 个工作日内完成审核。审核通过后即可接单。</view>

    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="card">
        <view class="field">
          <view class="tag-label">真实姓名</view>
          <input class="input" placeholder="请输入真实姓名" value="{{form.name}}" bindinput="onInput" data-field="name" />
        </view>
        <view class="field">
          <view class="tag-label">手机号码</view>
          <input class="input" placeholder="请输入手机号" type="number" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
        </view>
        <view class="field">
          <view class="tag-label">身份证号</view>
          <input class="input" placeholder="请输入身份证号" value="{{form.idCard}}" bindinput="onInput" data-field="idCard" />
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">服务技能</view>
      <view class="card">
        <view class="field">
          <view class="tag-label">擅长服务类型</view>
          <view class="chips">
            <view class="chip {{item.active ? 'active' : ''}}" wx:for="{{skillOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onSkillToggle">{{item.name}}</view>
          </view>
        </view>
        <view class="field">
          <view class="tag-label">从业年限</view>
          <input class="input" placeholder="请输入从业年限" type="number" value="{{form.experience}}" bindinput="onInput" data-field="experience" />
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">资质证书</view>
      <view class="card">
        <view class="field">
          <view class="tag-label">身份证照片</view>
          <view class="upload-grid">
            <view class="upload-tile design-button" bindtap="onUploadCert">+</view>
            <view class="upload-tile design-button" bindtap="onUploadCert">+</view>
            <view class="upload-tile design-button" bindtap="onUploadCert">+</view>
          </view>
        </view>
        <view class="field">
          <view class="tag-label">个人简介</view>
          <textarea class="textarea" placeholder="介绍一下您的专业技能和服务经验..." value="{{form.bio}}" bindinput="onInput" data-field="bio"></textarea>
        </view>
      </view>
    </view>
  </view>

  <view class="fixed-actions">
    <view class="btn primary design-button" bindtap="onSubmit">提交申请</view>
  </view>
</view>
