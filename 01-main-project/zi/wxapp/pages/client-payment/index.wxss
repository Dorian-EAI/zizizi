@import "../../styles/glass-detail-page.wxss";

/* —— 支付页面特定样式 —— */

/* 页面滚动区 */
.payment-scroll {
  height: calc(100vh - 180rpx);
}

/* 金额展示区 */
.amount-section {
  padding: 24rpx 40rpx 0;
}

.amount-card {
  position: relative;
  overflow: hidden;
  padding: 40rpx 36rpx;
  text-align: center;
}

.amount-card::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 148, 136, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.amount-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.amount-value {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  font-family: var(--font-number);
  color: var(--brand-dark);
}

.amount-value .currency {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-2);
}

.amount-value text {
  font-size: 72rpx;
  font-weight: 700;
  font-family: var(--font-number);
  color: var(--brand-dark);
  letter-spacing: -0.02em;
}

.order-no {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
  font-family: var(--font-number);
}

/* 状态横幅 */
.contract-warning {
  margin: 24rpx 40rpx 0;
  padding: 24rpx 28rpx;
  border-radius: var(--r-md);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  background: var(--glass-bg);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  box-shadow: var(--neu-raised-sm);
}

.contract-warning.checking {
  border-color: rgba(13, 148, 136, 0.20);
}

.warning-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 6rpx;
}

.warning-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}

/* 支付方式列表 */
.payment-page .section {
  margin: 28rpx 40rpx;
}

.pay-method-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pay-method-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 28rpx;
  border-radius: var(--r-lg);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  background: var(--glass-bg);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  box-shadow: var(--neu-raised-sm);
  transition: all var(--dur) var(--ease);
}

.pay-method-item:active {
  transform: scale(0.98);
}

.pay-method-item.selected {
  background: var(--glass-bg-strong);
  border: 2rpx solid var(--brand);
  box-shadow: var(--neu-raised-sm), 0 0 0 6rpx var(--brand-subtle);
}

.pay-method-item.disabled {
  opacity: 0.5;
}

.pay-method-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.pay-method-icon.wechat {
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.24);
}

.pay-method-icon.wallet {
  background: var(--brand-subtle);
  color: var(--brand);
  box-shadow: var(--neu-raised-sm);
}

.pay-method-icon.combined {
  background: linear-gradient(135deg, var(--brand), var(--accent));
  color: #fff;
  box-shadow: 0 6rpx 20rpx var(--brand-glow);
}

.pay-method-icon.offline {
  background: var(--bg-elevated);
  color: var(--text-3);
  box-shadow: var(--neu-inset-sm);
}

.pay-method-icon image {
  width: 40rpx;
  height: 40rpx;
}

.pay-method-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pay-method-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.pay-method-desc {
  font-size: 22rpx;
  color: var(--text-3);
}

.pay-method-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-3);
  background: var(--bg);
  flex-shrink: 0;
  position: relative;
}

.pay-method-item.selected .pay-method-radio {
  border-color: var(--brand);
  background: var(--brand);
}

.pay-method-item.selected .pay-method-radio::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  background: #fff;
}

/* 优惠券选择器 */
.coupon-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-radius: var(--r-lg);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  background: var(--glass-bg);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  box-shadow: var(--neu-raised-sm);
  transition: all var(--dur) var(--ease);
}

.coupon-selector:active {
  transform: scale(0.98);
}

.coupon-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.coupon-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  box-shadow: 0 6rpx 18rpx rgba(212, 148, 76, 0.24);
}

.coupon-icon image {
  width: 36rpx;
  height: 36rpx;
}

.coupon-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.coupon-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-discount {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-dark);
  font-family: var(--font-number);
}

.coupon-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}

/* 费用明细卡片 */
.detail-card {
  padding: 8rpx 28rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 26rpx;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  color: var(--text-2);
}

.detail-label.strong {
  font-weight: 700;
  color: var(--text-1);
  font-size: 28rpx;
}

.detail-value {
  color: var(--text-1);
  font-family: var(--font-number);
}

.detail-value.highlight {
  color: var(--accent-dark);
}

.detail-row.total .detail-total {
  font-weight: 700;
  font-size: 36rpx;
  color: var(--brand-dark);
  font-family: var(--font-number);
}

/* 安全提示 */
.security-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 40rpx 0;
  font-size: 22rpx;
  color: var(--text-3);
}

.security-tip image {
  width: 24rpx;
  height: 24rpx;
}

/* 底部支付栏 */
.pay-bottom-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-radius: var(--r-lg);
  background: rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40),
    0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

.pay-total-label {
  font-size: 24rpx;
  color: var(--text-2);
  display: block;
}

.pay-total-amount {
  font-family: var(--font-number);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand-dark);
}

.pay-total-amount .currency {
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 4rpx;
}

.pay-now-btn {
  min-height: 88rpx;
  padding: 0 48rpx;
  border: 0;
  border-radius: var(--r-pill);
  background: var(--brand-gradient);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), 0 10rpx 32rpx var(--brand-glow);
  transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--ease);
}

.pay-now-btn:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
}

.pay-now-btn:disabled {
  opacity: 0.52;
  box-shadow: none;
}

/* 底部间距 */
.scroll-spacer {
  height: 200rpx;
}