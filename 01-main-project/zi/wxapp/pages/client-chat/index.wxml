<!-- pages/client-chat/index.wxml — AI 下单助手 玻璃新拟态 -->
<view class="page">
  <!-- 背景装饰光斑：teal-amber 径向渐变 -->
  <view class="blob" style="top: -40px; right: -60px; width: 280px; height: 280px; background: radial-gradient(circle, var(--brand) 0%, transparent 70%);"></view>
  <view class="blob" style="top: 320px; left: -80px; width: 240px; height: 240px; background: radial-gradient(circle, var(--accent) 0%, transparent 70%);"></view>

  <!-- ===== Top Nav Bar ===== -->
  <view class="nav-bar" style="padding-top: calc({{statusBarHeight}}px + 36rpx);">
    <view class="nav-back press-neu" bindtap="onBack">
      <image class="nav-back-icon" src="{{icons.back}}" mode="aspectFit" lazy-load="{{false}}" />
    </view>
    <view class="nav-titles">
      <text class="nav-title">AI下单助手</text>
      <text class="nav-subtitle">说句话 · 拍张照 · 帮你叫师傅</text>
    </view>
    <view class="nav-slot press-scale" bindtap="onMore">
      <image class="nav-slot-icon" src="{{icons.more}}" mode="aspectFit" lazy-load="{{false}}" />
    </view>
  </view>

  <!-- ===== Chat Area ===== -->
  <scroll-view
    scroll-y
    enable-flex
    class="chat-area hide-scroll"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation
  >
    <!-- Time divider -->
    <view class="chat-time">{{chatTime || '今天'}}</view>

    <!-- 消息列表 -->
    <view
      class="bubble-row {{item.role === 'user' ? 'bubble-row-right' : 'bubble-row-left'}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
    >
      <!-- AI 头像 -->
      <view class="bubble-avatar" wx:if="{{item.role !== 'user'}}">
        <image src="{{icons.bot}}" mode="aspectFit" lazy-load="{{false}}" class="bubble-avatar-img" />
      </view>

      <view class="bubble-group" wx:if="{{item.role !== 'user'}}">
        <view class="bubble bubble-assistant">
          <text>{{item.content}}</text>
        </view>

        <!-- 订单草稿卡 -->
        <view class="agent-card" wx:if="{{item.draft}}">
          <view class="card-head">
            <text class="card-title">订单确认</text>
            <text class="card-price" wx:if="{{item.draft.estimate}}">¥{{item.draft.estimate.min_price}}-{{item.draft.estimate.max_price}}</text>
          </view>
          <view class="card-row">
            <text class="card-key">服务</text>
            <text class="card-val">{{item.draft.service_name || '上门维修'}}</text>
          </view>
          <view class="card-row">
            <text class="card-key">问题</text>
            <text class="card-val">{{item.draft.description || '待补充'}}</text>
          </view>
          <view class="card-row">
            <text class="card-key">地址</text>
            <text class="card-val">{{item.draft.address_text || '待选择'}}</text>
          </view>
          <view class="card-row">
            <text class="card-key">上门</text>
            <text class="card-val">{{item.draft.appoint_text || '待确认'}}</text>
          </view>
          <view class="card-hint">参考价最终以师傅上门检测为准</view>
          <view class="card-actions">
            <block wx:for="{{item.actions}}" wx:for-item="act" wx:for-index="actIndex" wx:key="text">
              <view
                wx:if="{{act.type === 'confirm_order'}}"
                class="btn-neu-primary card-btn"
                data-msgid="{{item.id}}"
                data-index="{{actIndex}}"
                catchtap="onActionTap"
              >{{act.text}}</view>
              <view
                wx:if="{{act.type === 'cancel_order_draft'}}"
                class="ghost-btn card-btn"
                data-msgid="{{item.id}}"
                data-index="{{actIndex}}"
                catchtap="onActionTap"
              >{{act.text}}</view>
            </block>
          </view>
        </view>

        <!-- 已创建订单卡 -->
        <view class="agent-card order-card" wx:if="{{item.order}}">
          <view class="card-head">
            <text class="card-title">订单已提交</text>
            <text class="order-status">待接单</text>
          </view>
          <view class="card-row">
            <text class="card-key">订单号</text>
            <text class="card-val">{{item.order.order_no}}</text>
          </view>
          <view class="card-row">
            <text class="card-key">服务</text>
            <text class="card-val">{{item.order.service_name}}</text>
          </view>
          <view class="card-row">
            <text class="card-key">地址</text>
            <text class="card-val">{{item.order.address}}</text>
          </view>
        </view>

        <!-- 补全信息选项 -->
        <view class="opt-group" wx:if="{{item.options.services.length}}">
          <view
            class="opt-chip"
            wx:for="{{item.options.services}}"
            wx:for-item="opt"
            wx:for-index="optIndex"
            wx:key="value"
            data-msgid="{{item.id}}"
            data-kind="service"
            data-index="{{optIndex}}"
            catchtap="onOptionTap"
          >{{opt.text}}</view>
        </view>
        <view class="opt-group" wx:if="{{item.options.times.length}}">
          <view
            class="opt-chip"
            wx:for="{{item.options.times}}"
            wx:for-item="opt"
            wx:for-index="optIndex"
            wx:key="text"
            data-msgid="{{item.id}}"
            data-kind="time"
            data-index="{{optIndex}}"
            catchtap="onOptionTap"
          >{{opt.text}}</view>
        </view>
        <view class="opt-group" wx:if="{{item.options.addresses.length}}">
          <view
            class="opt-chip opt-address"
            wx:for="{{item.options.addresses}}"
            wx:for-item="opt"
            wx:for-index="optIndex"
            wx:key="id"
            data-msgid="{{item.id}}"
            data-kind="address"
            data-index="{{optIndex}}"
            catchtap="onOptionTap"
          >{{opt.label}} · {{opt.text}}</view>
        </view>

        <!-- 跳转类动作（绑定手机号 / 查看订单 / 添加地址） -->
        <view class="act-row" wx:if="{{item.hasNavigate}}">
          <block wx:for="{{item.actions}}" wx:for-item="act" wx:for-index="actIndex" wx:key="text">
            <view
              wx:if="{{act.type === 'navigate'}}"
              class="mini-btn"
              data-msgid="{{item.id}}"
              data-index="{{actIndex}}"
              catchtap="onActionTap"
            >{{act.text}}</view>
          </block>
        </view>
      </view>

      <!-- 用户气泡 -->
      <view class="bubble-group user-group" wx:if="{{item.role === 'user'}}">
        <view class="bubble bubble-user">
          <text>{{item.content}}</text>
        </view>
        <view class="msg-images" wx:if="{{item.localImages && item.localImages.length}}">
          <image
            class="msg-image"
            wx:for="{{item.localImages}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="*this"
            src="{{img}}"
            mode="aspectFill"
            lazy-load="{{false}}"
            bindtap="onPreviewImage"
            data-src="{{img}}"
            data-msgid="{{item.id}}"
          />
        </view>
        <view class="photo-hint" wx:if="{{!item.localImages && item.imageCount}}">已上传 {{item.imageCount}} 张照片</view>
      </view>
    </view>

    <!-- 正在输入提示 -->
    <view class="bubble-row bubble-row-left" wx:if="{{sending}}">
      <view class="bubble-avatar">
        <image src="{{icons.bot}}" mode="aspectFit" lazy-load="{{false}}" class="bubble-avatar-img" />
      </view>
      <view class="bubble bubble-assistant">
        <view class="typing-dots">
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
        </view>
      </view>
    </view>

    <!-- 快捷服务标签 -->
    <scroll-view scroll-x enable-flex class="chips-scroll hide-scroll" enhanced show-scrollbar="{{false}}" wx:if="{{quickServices.length}}">
      <view
        class="chip press-neu"
        wx:for="{{quickServices}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onQuickService"
      >{{item.name}}</view>
    </scroll-view>

    <!-- 底部留白，避免输入栏遮挡 -->
    <view style="height: 220rpx;"></view>
  </scroll-view>

  <!-- ===== 底部固定：输入栏 ===== -->
  <view class="input-bar">
    <!-- 待发送照片 -->
    <scroll-view scroll-x enable-flex class="pending-bar hide-scroll" enhanced show-scrollbar="{{false}}" wx:if="{{pendingImages.length}}">
      <view class="pending-item" wx:for="{{pendingImages}}" wx:key="*this">
        <image class="pending-thumb" src="{{item}}" mode="aspectFill" lazy-load="{{false}}" />
        <view class="thumb-del" data-index="{{index}}" catchtap="onRemovePending">×</view>
      </view>
    </scroll-view>

    <!-- 快捷提问 -->
    <scroll-view scroll-x enable-flex class="quick-questions hide-scroll" enhanced show-scrollbar="{{false}}" wx:if="{{quickQuestions.length}}">
      <view
        class="qq-chip press-scale"
        wx:for="{{quickQuestions}}"
        wx:key="*this"
        data-text="{{item}}"
        bindtap="onQuickTap"
      >{{item}}</view>
    </scroll-view>

    <!-- 输入行 -->
    <view class="input-row">
      <view class="mic-btn press-neu" bindtap="onChooseImage">
        <image src="{{icons.camera}}" mode="aspectFit" lazy-load="{{false}}" class="mic-icon" />
      </view>
      <view class="mic-btn press-neu" bindtap="onMicTap">
        <image src="{{icons.mic}}" mode="aspectFit" lazy-load="{{false}}" class="mic-icon" />
      </view>
      <input
        class="chat-input-v2"
        placeholder="说下哪里坏了，或直接拍张照..."
        placeholder-class="input-ph"
        value="{{inputValue}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
      />
      <view class="send-btn {{(inputValue || pendingImages.length) && !sending ? 'active' : ''}}" bindtap="onSend">
        <image src="{{icons.send}}" mode="aspectFit" lazy-load="{{false}}" class="send-icon" />
      </view>
    </view>
  </view>

</view>
