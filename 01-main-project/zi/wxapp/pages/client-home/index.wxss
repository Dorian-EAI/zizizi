/* pages/client-home/index.wxss — 像素级复刻 client-home-glass-neu-contrast-1.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 *
 * 滚动变形（参照动效规范文档）：
 *   y > 20px:  greeting 渐隐上移
 *   y > 40px:  标题栏 visible（背景+模糊+不透明）
 *   y > 60px:  app-name, search-bar, hot-tags, stats 全部渐隐上移
 *   y > 90px:  标题栏 search-mode（应用名淡出，搜索框展开）
 *   y > 100px: hero 压缩（只剩状态栏+搜索栏）
 */

/* ===== 页面局部令牌 ===== */
.page {
  --surface-1: rgba(255, 255, 255, 0.50);
  --surface-2: rgba(255, 255, 255, 0.45);
  --border-glass: 1rpx solid rgba(255, 255, 255, 0.60);
  --border-glass-soft: 1rpx solid rgba(255, 255, 255, 0.45);
  --icon-raise: 10rpx 10rpx 20rpx var(--neu-dark), -10rpx -10rpx 20rpx var(--neu-light);

  position: relative;
  min-height: 100vh;
  background: var(--phone-bg, #F2EDE8);
}

/* ===== 滚动容器 ===== */
.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  padding-bottom: calc(env(safe-area-inset-bottom) + 220rpx);
}

/* ===== 固定标题栏（滚动变形） ===== */
.title-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(env(safe-area-inset-top) + 64rpx);
  padding-top: env(safe-area-inset-top);
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  opacity: 0;
  pointer-events: none;
  z-index: 100;
  transition: background 0.3s ease, box-shadow 0.3s ease, opacity 0.25s ease, backdrop-filter 0.3s ease;
}

.title-bar.visible {
  background: rgba(242, 237, 232, 0.92);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.04);
  opacity: 1;
  pointer-events: auto;
}

.title-bar.search-mode {
  background: rgba(242, 237, 232, 0.95);
  backdrop-filter: blur(56rpx) saturate(180%);
  -webkit-backdrop-filter: blur(56rpx) saturate(180%);
}

/* 标题名 */
.title-bar__name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  opacity: 1;
  transform: translateX(0);
  transition: opacity 0.2s ease, transform 0.25s ease;
  font-family: var(--font-display);
}

.title-bar.search-mode .title-bar__name {
  opacity: 0;
  transform: translateX(-24rpx);
}

/* 标题栏搜索框 */
.title-bar__search {
  position: absolute;
  left: 32rpx;
  right: calc(32rpx + 160rpx);
  top: calc(env(safe-area-inset-top) + 32rpx);
  transform: translateY(-50%) scaleX(0.88);
  transform-origin: left center;
  opacity: 0;
  height: 56rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 28rpx;
  box-shadow: var(--neu-raised-sm);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  color: var(--text-3);
  font-size: 24rpx;
  transition: opacity 0.25s ease, transform 0.3s var(--ease);
}

.title-bar.search-mode .title-bar__search {
  opacity: 1;
  transform: translateY(-50%) scaleX(1);
}

.title-bar__search-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.title-bar__search-text {
  font-size: 26rpx;
  color: var(--text-3);
}

/* ===== HERO 区域 ===== */
.hero {
  padding: 28rpx 48rpx 48rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 440rpx 360rpx at 75% 45%, rgba(212, 148, 76, 0.10) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 20% 80%, rgba(13, 148, 136, 0.08) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.10) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.05) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
  transition: padding 0.3s var(--ease), max-height 0.35s var(--ease);
}

/* Hero 压缩态：保留状态栏+搜索栏 */
.hero.hero-collapsed {
  padding-bottom: 24rpx;
}

.hero > view,
.hero > text {
  position: relative;
  z-index: 1;
}

/* ===== 状态栏 ===== */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.status-time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.status-icons {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-icon-img {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 问候语 ===== */
.greeting {
  font-size: 28rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
  transition: opacity 0.25s ease, transform 0.3s ease;
  font-family: var(--font-body);
}

/* ===== 应用名 ===== */
.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 36rpx;
  letter-spacing: -0.02em;
  transition: opacity 0.25s ease, transform 0.3s ease;
  font-family: var(--font-display);
}

/* ===== 玻璃搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface-2);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: var(--border-glass);
  border-radius: 56rpx;
  padding: 24rpx 36rpx;
  margin-bottom: 32rpx;
  color: var(--text-3);
  font-size: 28rpx;
  transition: transform 0.2s var(--spring), opacity 0.25s ease;
}

.search-bar:active {
  transform: scale(0.97);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.search-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* ===== 热门标签（Hero 内） ===== */
.hot-tags {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 20rpx 0;
  margin-bottom: 8rpx;
  white-space: nowrap;
  transition: opacity 0.25s ease, transform 0.3s ease;
}

.hot-tag {
  flex-shrink: 0;
  background: var(--bg-elevated);
  border-radius: 9999rpx;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  white-space: nowrap;
  box-shadow: var(--neu-raised-sm);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease), color 0.2s var(--ease);
}

.hot-tag:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
  color: var(--brand);
}

/* ===== 统计卡片 ===== */
.stats {
  display: flex;
  gap: 24rpx;
  transition: opacity 0.25s ease, transform 0.3s ease;
}

.stat-card {
  flex: 1;
  background: var(--surface-2);
  backdrop-filter: blur(32rpx) saturate(140%);
  -webkit-backdrop-filter: blur(32rpx) saturate(140%);
  border: var(--border-glass-soft);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  padding: 28rpx 16rpx;
  text-align: center;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.stat-card:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  font-family: var(--font-number);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-2);
}

.stat-card:nth-child(1) .stat-value { color: var(--brand); }
.stat-card:nth-child(2) .stat-value { color: var(--accent); }
.stat-card:nth-child(3) .stat-value { color: var(--text-1); }

/* ===== 区块标题 + 更多 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 48rpx 14rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  padding: 0;
  letter-spacing: -0.01em;
  font-family: var(--font-display);
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  transition: background 0.2s ease;
}

.section-more:active {
  background: var(--brand-subtle);
}

.section-more__text {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
  font-family: var(--font-body);
}

.section-more__icon {
  width: 20rpx;
  height: 20rpx;
}

/* ===== 服务网格 ===== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 202rpx);
  gap: 22rpx;
  justify-content: center;
  padding: 22rpx 48rpx;
}

.service-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 202rpx;
  height: 180rpx;
  background: var(--surface-1);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 44rpx;
  box-shadow: var(--neu-raised), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65);
  padding: 16rpx 12rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.service-card:active {
  transform: scale(0.95);
  box-shadow: var(--neu-inset);
}

.icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg);
  box-shadow: var(--icon-raise), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow 0.2s var(--ease), transform 0.2s var(--spring);
}

.service-card:active .icon-circle {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.service-icon {
  width: 44rpx;
  height: 44rpx;
}

.service-name {
  font-size: 24rpx;
  color: var(--text-1);
  font-weight: 600;
  white-space: nowrap;
}

/* ===== AI 智能助手卡片 ===== */
.ai-card {
  margin: 28rpx 48rpx 0;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  border-radius: 48rpx;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 75% 40%, rgba(212, 148, 76, 0.16) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 20% 80%, rgba(13, 148, 136, 0.12) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.12) 0%, rgba(212, 148, 76, 0.14) 50%, rgba(20, 184, 166, 0.12) 100%);
  box-shadow: var(--neu-raised), 0 16rpx 56rpx rgba(13, 148, 136, 0.07);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.ai-card:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset);
}

.ai-icon {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 50%, var(--accent) 100%);
  box-shadow: var(--neu-raised-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.ai-text {
  flex: 1;
  min-width: 0;
}

.ai-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 6rpx;
  letter-spacing: -0.01em;
}

.ai-desc {
  font-size: 24rpx;
  color: var(--text-2);
}

.ai-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 9999rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.55);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease), background 0.2s var(--ease);
  flex-shrink: 0;
}

.ai-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
  background: var(--brand-subtle);
}

/* ===== 分类筛选 Chips ===== */
.chips-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 20rpx 48rpx 22rpx;
  white-space: nowrap;
}

.chip {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  font-family: var(--font-body);
  background: var(--bg-elevated);
  color: var(--text-2);
  box-shadow: var(--neu-raised-sm);
}

.chip:active {
  transform: scale(0.94);
  box-shadow: var(--neu-inset);
}

.chip-active {
  background: var(--brand-subtle);
  color: var(--brand);
  box-shadow: var(--neu-inset), 0 0 0 1rpx var(--brand-subtle);
}

/* ===== 推荐师傅卡片 ===== */
.recommend-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 0 48rpx 28rpx;
  background: var(--surface-1);
  backdrop-filter: blur(32rpx) saturate(140%);
  -webkit-backdrop-filter: blur(32rpx) saturate(140%);
  border: var(--border-glass-soft);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  padding: 28rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.recommend-card:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.28) 40%, var(--brand-subtle) 78%, rgba(255, 255, 255, 0.18) 100%);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88), inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04), var(--icon-raise);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 52rpx;
  height: 52rpx;
  position: relative;
  z-index: 1;
}

.recommend-info {
  flex: 1;
  min-width: 0;
}

.recommend-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 4rpx;
}

.recommend-sub {
  font-size: 24rpx;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommend-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
  white-space: nowrap;
  font-family: var(--font-number);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* ===== 推荐服务横滑区 ===== */
.rec-scroll {
  display: flex;
  gap: 24rpx;
  overflow-x: auto;
  padding: 0 48rpx 16rpx;
  white-space: nowrap;
}

.rec-card {
  flex-shrink: 0;
  width: 360rpx;
  background: var(--surface-1);
  backdrop-filter: blur(32rpx) saturate(140%);
  -webkit-backdrop-filter: blur(32rpx) saturate(140%);
  border: var(--border-glass-soft);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  overflow: hidden;
  padding: 20rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.rec-card:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
}

.rec-img {
  width: 100%;
  height: 200rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: inset 4rpx 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.rec-img-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-inverse);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
  position: relative;
  z-index: 2;
  letter-spacing: 0.02em;
}

.rec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}

.rec-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
}

.rec-star {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: var(--orange);
  font-weight: 600;
}

.rec-star-icon {
  width: 24rpx;
  height: 24rpx;
}

.rec-star-num {
  font-size: 22rpx;
  color: var(--orange);
  font-weight: 600;
}

.rec-count {
  color: var(--text-3);
}

.rec-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.rec-currency {
  font-size: 24rpx;
  color: var(--red);
  font-weight: 600;
}

.rec-amount {
  font-size: 38rpx;
  color: var(--red);
  font-weight: 700;
  letter-spacing: -0.02em;
}

.rec-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 9999rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.55);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease), background 0.2s var(--ease);
}

.rec-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
  background: var(--brand-subtle);
}

/* ===== Hero 滚动渐隐动效 ===== */
/* y > 20: greeting 渐隐上移 */
.page.scrolled .hero .greeting {
  opacity: 0;
  transform: translateY(-24rpx);
}

/* y > 60: app-name, search-bar, hot-tags, stats 渐隐上移 */
.page.scrolled-2 .hero .app-name {
  opacity: 0;
  transform: translateY(-16rpx);
}

.page.scrolled-2 .hero .search-bar {
  opacity: 0;
  transform: translateY(-32rpx) scale(0.96);
  pointer-events: none;
}

.page.scrolled-2 .hero .hot-tags {
  opacity: 0;
  transform: translateY(-16rpx);
  pointer-events: none;
}

.page.scrolled-2 .hero .stat-card {
  opacity: 0;
  transform: translateY(-16rpx);
  pointer-events: none;
}

/* Hero 压缩后：移除多余底部间距 */
.page.scrolled-2 .hero {
  padding-bottom: 24rpx;
}

/* Hero 压缩：除状态栏和搜索栏外全部折叠 */
.hero.hero-collapsed .greeting,
.hero.hero-collapsed .app-name,
.hero.hero-collapsed .hot-tags,
.hero.hero-collapsed .stats {
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: 0;
  margin-bottom: 0;
  pointer-events: none;
}

/* Hero 压缩后搜索栏保持可见（取消渐隐状态） */
.page.scrolled-2 .hero.hero-collapsed .search-bar {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

.hero.hero-collapsed {
  padding-bottom: 24rpx;
}

/* Hero 子元素过渡 */
.hero .greeting,
.hero .app-name,
.hero .hot-tags,
.hero .stats {
  transition: opacity 0.25s ease, transform 0.3s ease, max-height 0.35s ease, margin 0.3s ease, padding 0.3s ease;
  overflow: hidden;
}

.hero .search-bar {
  transition: opacity 0.25s ease, transform 0.3s var(--ease);
}
