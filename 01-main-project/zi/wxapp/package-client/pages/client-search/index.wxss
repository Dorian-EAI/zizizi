/* AUTO-GENERATED DESIGN STYLE ENTRY; page-specific overrides may follow this import. */
@import "../../../styles/generated-detail-page.wxss";

/* pages/client-search/index.wxss — 搜索页 玻璃新拟态 */

.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

/* ===== Top Bar ===== */
.topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}

.tag-h1 {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.icon-button {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: none;
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.icon-button:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.design-svg-icon {
  width: 44rpx;
  height: 44rpx;
}

/* ===== Page Body ===== */
.page-body {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

/* ===== Section & Card ===== */
.section {
  margin-bottom: 32rpx;
}

.card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  padding: 36rpx;
  position: relative;
  overflow: hidden;
}

.card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.card > view,
.card > text {
  position: relative;
  z-index: 1;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.tag-strong {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.tag-span {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

.badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
}

.badge.warning {
  background: var(--warning-bg);
  color: var(--warning);
}

.badge.success {
  background: var(--success-bg);
  color: var(--success);
}

.badge.danger {
  background: var(--danger-bg);
  color: var(--danger);
}

/* ===== Field & Input ===== */
.field {
  margin-bottom: 28rpx;
}

.tag-label {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  width: 100%;
  background: var(--background);
  box-shadow: var(--neu-inset);
  border: none;
  border-radius: var(--r-md);
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: var(--text-1);
  font-family: var(--font-body);
  outline: none;
}

.input::placeholder {
  color: var(--text-3);
}

.input:focus {
  box-shadow: var(--neu-inset), 0 0 0 4rpx var(--brand-subtle), 0 0 0 8rpx var(--brand-glow);
}

/* ===== Buttons ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-lg);
  font-size: 30rpx;
  font-weight: 600;
  font-family: var(--font-body);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.btn.primary {
  background: var(--brand-gradient);
  color: #fff;
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
}

.btn.primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.97);
}

/* ===== Chips ===== */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 32rpx;
  background: var(--bg-elevated);
  border-radius: var(--r-pill);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-1);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.chip:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

/* ===== Grid 2 ===== */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* ===== Media Placeholder ===== */
.media-placeholder {
  width: 100%;
  height: 160rpx;
  border-radius: var(--r-md);
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.media-icon {
  width: 80rpx;
  height: 80rpx;
  color: var(--brand);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 8rpx;
}

.card-copy {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}

/* ===== List Card ===== */
.list-card {
  padding: 8rpx 0;
}

.list-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-elevated);
  border-radius: var(--r-md);
  margin-bottom: 16rpx;
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.50);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.list-row:last-child {
  margin-bottom: 0;
}

.list-row:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.98);
}

.row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
  font-weight: 700;
  font-size: 28rpx;
  box-shadow: 0 4rpx 16rpx var(--brand-glow);
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
  font-weight: 700;
  font-size: 28rpx;
  box-shadow: 0 4rpx 16rpx var(--accent-glow);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-copy {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.4;
}

.chevron {
  font-size: 36rpx;
  color: var(--text-3);
  font-weight: 300;
  flex-shrink: 0;
}

/* ===== Fixed Actions ===== */
.fixed-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 24rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(242, 237, 232, 0.88);
  backdrop-filter: blur(48rpx) saturate(160%);
  -webkit-backdrop-filter: blur(48rpx) saturate(160%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.06);
}

.fixed-actions .btn {
  height: 96rpx;
}

/* ===== Status Bar ===== */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.status-icons {
  display: flex;
  gap: 12rpx;
}

/* ===== Empty State ===== */
.tag-p {
  font-size: 28rpx;
  color: var(--text-2);
  text-align: center;
  padding: 24rpx 0;
}