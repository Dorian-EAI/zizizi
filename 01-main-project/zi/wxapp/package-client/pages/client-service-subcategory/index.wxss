/* pages/client-service-subcategory/index.wxss — 服务子分类页面 玻璃新拟态 */

.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

/* ===== Nav Bar ===== */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 40rpx;
  padding-bottom: 36rpx;
  padding-left: 40rpx;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-placeholder {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* ===== Section ===== */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}

.section:first-of-type {
  margin-top: 36rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.title-link {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
}

/* ===== Glass Neu Card ===== */
.glass-neu-card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
}

.glass-neu-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-neu-card > view,
.glass-neu-card > text {
  position: relative;
  z-index: 1;
}

/* ===== Banner Card ===== */
.banner-card {
  padding: 48rpx 36rpx;
  background:
    linear-gradient(135deg, rgba(13, 148, 136, 0.10) 0%, rgba(212, 148, 76, 0.08) 100%),
    rgba(255, 255, 255, 0.52);
}

.banner-bg-deco {
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 148, 136, 0.18) 0%, transparent 70%);
  pointer-events: none;
}

.banner-content {
  position: relative;
  z-index: 1;
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: -0.02em;
}

.banner-desc {
  font-size: 26rpx;
  color: var(--text-2);
}

/* ===== Category Grid ===== */
.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.category-item {
  padding: 28rpx 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.category-item:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

.cat-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--brand-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.cat-icon {
  width: 48rpx;
  height: 48rpx;
}

.cat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
}

.cat-count {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ===== Empty State ===== */
.empty-card {
  padding: 60rpx 36rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* ===== Hot List ===== */
.hot-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.hot-item:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.98);
}

.hot-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  background: var(--brand-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hot-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.hot-info {
  flex: 1;
  min-width: 0;
}

.hot-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-desc {
  font-size: 24rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-arrow {
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 36rpx;
  color: var(--text-3);
  font-weight: 300;
}

/* ===== Spacer ===== */
.cta-spacer {
  height: 64rpx;
}