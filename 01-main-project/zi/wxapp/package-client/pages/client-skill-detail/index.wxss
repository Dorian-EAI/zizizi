/* pages/client-skill-detail/index.wxss — 技能详情页面 玻璃新拟态 */

.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

/* ===== Nav Bar ===== */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 32rpx;
  padding-bottom: 24rpx;
  padding-left: 32rpx;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: none;
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.nav-icon-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* ===== Section ===== */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}

.section:first-of-type {
  margin-top: 36rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.title-count {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* ===== Glass Neu Card ===== */
.glass-neu-card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
}

.glass-neu-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-neu-card > view,
.glass-neu-card > text {
  position: relative;
  z-index: 1;
}

/* ===== Skill Hero ===== */
.skill-hero {
  padding: 48rpx 36rpx;
  text-align: center;
}

.hero-bg-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 148, 76, 0.16) 0%, transparent 70%);
  pointer-events: none;
}

.skill-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--r-xl);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  box-shadow: 0 8rpx 32rpx var(--brand-glow);
}

.skill-icon {
  width: 72rpx;
  height: 72rpx;
}

.skill-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.02em;
}

.skill-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.skill-category {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 600;
  background: var(--brand-subtle);
  padding: 6rpx 20rpx;
  border-radius: var(--r-pill);
}

.skill-dot {
  font-size: 24rpx;
  color: var(--text-3);
}

.skill-workers {
  font-size: 26rpx;
  color: var(--text-2);
}

.skill-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--sep);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  font-family: var(--font-number);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--sep);
}

/* ===== Intro Card ===== */
.intro-card {
  padding: 36rpx;
}

.intro-text {
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.8;
  display: block;
  margin-bottom: 24rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 10rpx 24rpx;
  background: var(--brand-subtle);
  border-radius: var(--r-pill);
}

.tag-item text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand);
}

/* ===== Process Card ===== */
.process-card {
  padding: 8rpx 36rpx;
}

.process-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  position: relative;
}

.process-item:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 27rpx;
  top: 60rpx;
  width: 4rpx;
  height: calc(100% - 40rpx);
  background: var(--brand-subtle);
}

.process-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx var(--brand-glow);
}

.process-content {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.process-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 6rpx;
}

.process-desc {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}

/* ===== Worker Scroll ===== */
.worker-scroll {
  display: flex;
  gap: 20rpx;
  padding-bottom: 12rpx;
}

.worker-card {
  flex-shrink: 0;
  width: 240rpx;
  padding: 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.worker-card:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

.worker-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.worker-avatar-img {
  width: 100%;
  height: 100%;
}

.worker-avatar-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand);
}

.worker-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.worker-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rating-star {
  font-size: 24rpx;
  color: var(--orange);
}

.rating-num {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--orange);
}

.worker-orders {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ===== CTA ===== */
.cta-spacer {
  height: 168rpx;
}

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 24rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(242, 237, 232, 0.88);
  backdrop-filter: blur(48rpx) saturate(160%);
  -webkit-backdrop-filter: blur(48rpx) saturate(160%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.06);
}

.cta-primary {
  height: 96rpx;
  border-radius: var(--r-lg);
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.cta-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.97);
}

.cta-primary-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}