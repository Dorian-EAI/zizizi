/* pages/client-skill-list/index.wxss — 技能列表页面 玻璃新拟态 */

.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

/* ===== Nav Bar ===== */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 40rpx;
  padding-bottom: 36rpx;
  padding-left: 40rpx;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-placeholder {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* ===== Filter Bar ===== */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 40;
  padding: 16rpx 40rpx;
  background: rgba(242, 237, 232, 0.92);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
}

.filter-scroll {
  white-space: nowrap;
}

.filter-pill {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: var(--bg-elevated);
  border-radius: var(--r-pill);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-2);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.filter-pill text {
  font-size: 26rpx;
  font-weight: 500;
}

.filter-pill.active {
  background: var(--brand);
  color: #fff;
  box-shadow: 0 4rpx 16rpx var(--brand-glow);
}

.filter-pill:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.96);
}

/* ===== Section ===== */
.section {
  padding: 0 40rpx;
  margin-top: 24rpx;
  position: relative;
  z-index: 2;
}

/* ===== Glass Neu Card ===== */
.glass-neu-card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
}

.glass-neu-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-neu-card > view,
.glass-neu-card > text {
  position: relative;
  z-index: 1;
}

/* ===== Skill List ===== */
.skill-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skill-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.skill-item:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.98);
}

.skill-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-md);
  background: var(--brand-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.skill-icon {
  width: 48rpx;
  height: 48rpx;
}

.skill-info {
  flex: 1;
  min-width: 0;
}

.skill-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}

.skill-desc {
  font-size: 24rpx;
  color: var(--text-2);
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.skill-tag {
  padding: 4rpx 16rpx;
  background: var(--bg-elevated);
  border-radius: var(--r-pill);
  box-shadow: var(--neu-inset);
}

.skill-tag text {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 500;
}

.skill-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.skill-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-from {
  font-size: 22rpx;
  color: var(--text-3);
}

.price-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
  font-family: var(--font-number);
  letter-spacing: -0.02em;
}

.skill-workers {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ===== Empty State ===== */
.empty-card {
  padding: 60rpx 36rpx;
  text-align: center;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-2);
  display: block;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-3);
}

/* ===== Spacer ===== */
.cta-spacer {
  height: 48rpx;
}