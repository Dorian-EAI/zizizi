<!-- pages/client-skill-list/index.wxml — 技能列表页面 玻璃新拟态 -->
<view class="page">
  <view class="blob" style="top: -40px; right: -60px; width: 280px; height: 280px; background: var(--brand);"></view>
  <view class="blob" style="top: 320px; left: -80px; width: 240px; height: 240px; background: var(--accent);"></view>

  <view class="nav-bar" style="padding-top: calc({{statusBarHeight}}px + 36rpx);">
    <view class="nav-icon-btn press-neu" bindtap="onBack">
      <image class="nav-icon" src="{{icons.back}}" mode="aspectFit" lazy-load="{{false}}" />
    </view>
    <text class="nav-title">{{title || '技能列表'}}</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="filter-bar">
    <scroll-view scroll-x class="filter-scroll hide-scroll" enable-flex>
      <view
        class="filter-pill {{activeFilter === item.key ? 'active' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onFilter"
      >
        <text>{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <scroll-view scroll-y class="page-scroll" style="padding-bottom: 120rpx;">
    <view class="section">
      <view class="skill-list" wx:if="{{skillList.length}}">
        <view
          class="glass-neu-card skill-item press-scale"
          wx:for="{{skillList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSkillDetail"
        >
          <view class="skill-icon-wrap">
            <image src="{{item.iconUrl}}" mode="aspectFit" class="skill-icon" lazy-load="{{false}}" />
          </view>
          <view class="skill-info">
            <text class="skill-name">{{item.name}}</text>
            <text class="skill-desc">{{item.desc}}</text>
            <view class="skill-tags">
              <view class="skill-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">
                <text>{{tag}}</text>
              </view>
            </view>
          </view>
          <view class="skill-meta">
            <view class="skill-price">
              <text class="price-from">起</text>
              <text class="price-amount">¥{{item.minPrice}}</text>
            </view>
            <view class="skill-workers">
              <text>{{item.workerCount}} 位师傅</text>
            </view>
          </view>
        </view>
      </view>
      <view class="glass-neu-card empty-card" wx:else>
        <text class="empty-text">暂无相关技能</text>
        <text class="empty-desc">换个关键词试试吧</text>
      </view>
    </view>

    <view class="cta-spacer"></view>
  </scroll-view>
</view>