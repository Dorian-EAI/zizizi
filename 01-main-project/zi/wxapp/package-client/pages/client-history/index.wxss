/* AUTO-GENERATED DESIGN STYLE ENTRY; page-specific overrides may follow this import. */
@import "../../../styles/generated-detail-page.wxss";
@import "../../../styles/glass-neu.wxss";

/* ===== 浏览历史页 玻璃新拟态覆盖 ===== */

/* 分段控制器 - 玻璃新拟态 */
.segmented {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(48rpx) saturate(180%);
  -webkit-backdrop-filter: blur(48rpx) saturate(180%);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40), 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.segment {
  flex: 1;
  border: 0;
  border-radius: var(--r-sm);
  padding: 20rpx 10rpx;
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: var(--neu-out-sm);
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s var(--ease);
}

.segment.active {
  color: var(--brand);
  background: var(--brand-soft);
  box-shadow: var(--neu-in);
  font-weight: 600;
}

/* 分区标题 */
.section-title {
  color: var(--text-2);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.section-title .tag-strong {
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 700;
}

/* 历史卡片 - 玻璃新拟态 */
.card.list-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-out-md), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(13, 148, 136, 0.04);
}

/* 历史列表行图标 */
.list-row .row-icon {
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.5);
}

/* 列表行标题 */
.list-row .row-title {
  color: var(--text-1);
  font-size: 30rpx;
  font-weight: 500;
}

.list-row .row-copy {
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.45;
}

/* 全宽按钮 - 玻璃次按钮 */
.btn.block.secondary {
  margin-top: 16rpx;
  background: var(--surface-strong);
  color: var(--brand);
  box-shadow: var(--neu-out-sm);
}

.btn.block.secondary:active {
  box-shadow: var(--neu-in);
  transform: scale(0.98);
}

/* 通知提示 */
.notice.info {
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

/* 底部固定操作栏 */
.fixed-actions {
  background: rgba(255, 255, 255, 0.32);
  backdrop-filter: blur(56rpx) saturate(180%);
  -webkit-backdrop-filter: blur(56rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--neu-out-md), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.5);
}

/* 编辑模式按钮 */
.top-action {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: var(--neu-out-sm);
}

.top-action:active {
  box-shadow: var(--neu-in);
  transform: scale(0.96);
}
