/* pages/client-service/index.wxss — 客服中心 玻璃新拟态（像素级复刻 zjrnew.DESIGN，1px=2rpx） */
.page {
  position: relative;
  min-height: 100vh;
}

/* ===== btn-neu-primary 基础（品牌渐变 + 新拟态阴影） ===== */
.btn-neu-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border: 1rpx solid rgba(255, 255, 255, 0.40);
  border-radius: 9999rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx var(--brand-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.30);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.btn-neu-primary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* ===== btn-neu-secondary（玻璃表面 + 品牌色文字） ===== */
.btn-neu-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.50);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 9999rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised-sm);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.btn-neu-secondary:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* ===== Sub Header（client 渐变 + 返回 + 标题） ===== */
.sub-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}

.back-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 40rpx 24rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--neu-raised-sm);
  transition: transform var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
}

.back-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.9);
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
}

.back-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  text-align: center;
}

.back-spacer {
  width: 72rpx;
  flex-shrink: 0;
}

/* ===== Section Title ===== */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  padding: 40rpx 48rpx 28rpx;
  letter-spacing: -0.02em;
  position: relative;
  z-index: 1;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 48rpx 24rpx;
  position: relative;
  z-index: 1;
}

.section-header .section-title {
  padding: 0;
}

.section-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 9999rpx;
  font-family: var(--font-body);
  padding: 12rpx 24rpx;
  box-shadow: var(--neu-raised-sm);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
}

.section-link:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.40);
}

.link-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ===== Online Service Cards ===== */
.online-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 32rpx 48rpx 24rpx;
  padding: 32rpx;
  background: var(--surface);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 44rpx;
  box-shadow: var(--neu-raised-sm);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
  position: relative;
  z-index: 1;
}

.online-card:active {
  transform: scale(0.98);
  box-shadow: var(--neu-inset);
}

.online-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--neu-raised-sm);
}

.online-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.online-icon-teal {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 100%);
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx var(--brand-glow);
}

.online-icon-teal .online-icon-img {
  filter: brightness(0) invert(1);
}

.online-icon-amber {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-mid) 100%);
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx var(--accent-glow);
}

.online-icon-amber .online-icon-img {
  filter: brightness(0) invert(1);
}

.online-info {
  flex: 1;
  min-width: 0;
}

.online-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 8rpx;
}

.online-sub {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}

.hotline-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand);
  letter-spacing: -0.02em;
  margin-bottom: 4rpx;
  font-variant-numeric: tabular-nums;
}

/* 按钮特化 */
.btn-consult {
  flex-shrink: 0;
}

.btn-consult-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-inverse);
}

.btn-call {
  flex-shrink: 0;
  gap: 12rpx;
}

.call-icon {
  width: 28rpx;
  height: 28rpx;
}

.btn-call-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

/* ===== Filter Pills ===== */
.pills {
  display: flex;
  gap: 16rpx;
  padding: 0 48rpx 28rpx;
  position: relative;
  z-index: 1;
}

.pill {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), background var(--dur-base) var(--ease), color var(--dur-base) var(--ease);
  background: var(--bg-elevated);
  color: var(--text-2);
  box-shadow: var(--neu-raised-sm);
}

.pill:active {
  transform: scale(0.94);
  box-shadow: var(--neu-inset);
}

.pill-active {
  background: var(--brand-subtle);
  color: var(--brand);
  box-shadow: var(--neu-inset), 0 0 0 1rpx var(--brand-subtle);
}

/* ===== Ticket Cards ===== */
.ticket-list {
  position: relative;
  z-index: 1;
  padding: 0 48rpx;
}

.ticket-card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: var(--surface);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.ticket-card:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset);
}

.ticket-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.type-badge {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
  letter-spacing: 0.02em;
}

.type-complaint {
  color: var(--orange);
  background: rgba(212, 148, 76, 0.12);
  border: 1rpx solid rgba(212, 148, 76, 0.22);
}

.type-refund {
  color: var(--blue);
  background: rgba(90, 143, 173, 0.12);
  border: 1rpx solid rgba(90, 143, 173, 0.22);
}

.type-claim {
  color: var(--red);
  background: rgba(196, 83, 58, 0.12);
  border: 1rpx solid rgba(196, 83, 58, 0.22);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
}

.status-badge::before {
  content: "";
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-processing {
  color: var(--orange);
  background: rgba(212, 148, 76, 0.10);
}

.status-reply {
  color: var(--blue);
  background: rgba(90, 143, 173, 0.10);
}

.status-resolved {
  color: var(--green);
  background: rgba(91, 140, 90, 0.10);
}

.ticket-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 24rpx;
}

.ticket-foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.ticket-no {
  font-variant-numeric: tabular-nums;
  color: var(--text-2);
}

.ticket-dot {
  color: var(--text-3);
}

.ticket-time {
  color: var(--text-3);
}

.ticket-view {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  color: var(--brand);
  font-weight: 600;
}

.view-arrow {
  width: 24rpx;
  height: 24rpx;
}

/* ===== FAQ Card ===== */
.faq-card {
  margin: 0 48rpx;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised);
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.faq-card::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.faq-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx 36rpx;
  position: relative;
  transition: transform var(--dur-base) var(--ease), background 0.15s ease;
}

.faq-item:active {
  transform: scale(0.98);
  background: var(--fill);
}

.faq-item:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--sep);
}

.faq-q {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: -0.01em;
}

.faq-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  filter: brightness(0) opacity(0.55);
}

/* ===== Bottom Bar ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  padding: 28rpx 48rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  background: linear-gradient(180deg, rgba(242, 237, 232, 0) 0%, rgba(242, 237, 232, 0.88) 35%, rgba(242, 237, 232, 0.96) 100%);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.btn-submit {
  width: 100%;
  height: 100rpx;
  border-radius: 36rpx;
  font-size: 32rpx;
}

.btn-submit:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.97);
}

.btn-submit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-inverse);
}
