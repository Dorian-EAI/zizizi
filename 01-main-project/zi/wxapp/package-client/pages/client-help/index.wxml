<view class="phone-page design-detail-page" data-page-id="page-client-help">
  <view class="status-bar"><text>9:41</text><text class="status-icons">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" data-route="/pages/client-service/index" bindtap="onNavigate"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">帮助中心</view><text></text></view>
  <view class="page-body">
    <view class="hero"><view class="hero-kicker tag-p">HOW CAN WE HELP?</view><view class="tag-h2">遇到什么问题？</view><view class="tag-p">帮助内容由运营后台发布；订单、资金或账号争议请提交工单。</view></view>
    <view class="section-title"><text class="tag-strong">服务状态</text><text class="badge info">异步工单可用</text></view>
    <view class="field"><text class="tag-label">搜索帮助</text><input class="input" placeholder="搜索订单、支付、退款或账号问题" value="{{keyword}}" bindinput="onSearch" /></view>
    <view class="section" wx:if="{{categories.length}}"><view class="section-title"><text class="tag-strong">常用分类</text></view><view class="chips"><view class="chip {{selectedCategory === item.name ? 'active' : ''}} design-button" wx:for="{{categories}}" wx:key="category_id" data-name="{{item.name}}" bindtap="onCategory">{{item.name}}</view></view></view>
    <view class="notice info" wx:if="{{loading}}">正在同步帮助内容…</view>
    <view class="notice error" wx:elif="{{loadError}}">{{loadError}}</view>
    <view class="section" wx:else><view class="section-title"><text class="tag-strong">常见问题</text><text>{{visibleFaqs.length}} 条</text></view><view class="card list-card" wx:if="{{visibleFaqs.length}}"><view class="list-row" wx:for="{{visibleFaqs}}" wx:key="viewId" data-id="{{item.viewId}}" bindtap="onToggle"><view class="row-icon"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20aria-hidden%3D%22true%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22M9.8%209a2.4%202.4%200%201%201%203.6%202.1c-.9.5-1.4%201-1.4%202.2M12%2017h.01%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">{{item.question}}</view><view class="row-copy" wx:if="{{expandedId === item.viewId}}">{{item.answer}}</view></view><text class="chevron">{{expandedId === item.viewId ? '⌃' : '›'}}</text></view></view><view class="empty-state" wx:else><view class="tag-h3">暂无匹配内容</view><view class="tag-p">可换个关键词，或提交客服工单。</view></view></view>
    <view class="btn secondary block design-button" data-route="/pages/client-ticket-submit/index" bindtap="onNavigate">问题未解决 · 提交工单</view>
  </view>
  <view class="fixed-actions"><view class="btn primary design-button" data-route="/pages/client-customer-service/index" bindtap="onNavigate">进入客服中心</view></view>
</view>
