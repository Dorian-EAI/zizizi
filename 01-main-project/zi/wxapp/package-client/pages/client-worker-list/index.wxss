/* pages/client-worker-list/index.wxss — 师傅列表页 玻璃新拟态
 * 客户端 Teal 主题
 */

@import "../../../styles/generated-detail-page.wxss";

.phone-page {
  position: relative;
  min-height: 100vh;
  background: var(--bg);
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: 160rpx;
  padding: 36rpx 40rpx;
  padding-top: max(36rpx, env(safe-area-inset-top));
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
  border-radius: 0 0 56rpx 56rpx;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

.topbar .tag-h1 {
  margin: 0;
  text-align: center;
  color: var(--ink);
  font: 700 34rpx/1.3 var(--font-body);
  letter-spacing: -0.02em;
}

.topbar .icon-button {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: var(--ink);
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.5);
  display: inline-grid;
  place-items: center;
}

.topbar .icon-button:active {
  box-shadow: var(--neu-in);
  transform: scale(0.94);
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 40rpx 0;
  overflow-x: auto;
}

.filter-pill {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.50);
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  box-shadow: var(--neu-out-sm);
}

.filter-pill.active {
  color: var(--brand);
  background: var(--brand-soft);
  box-shadow: var(--neu-in);
  font-weight: 600;
}

.filter-pill:active {
  transform: scale(0.96);
}

.worker-list {
  padding: 24rpx 40rpx 224rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.worker-card {
  position: relative;
  padding: 28rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--radius-md);
  background: var(--surface);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx var(--brand-soft);
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}

.worker-card:active {
  transform: scale(0.98);
}

.worker-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.worker-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand);
  background: linear-gradient(145deg,
    rgba(255, 255, 255, 0.68) 0%,
    rgba(255, 255, 255, 0.28) 40%,
    var(--brand-soft) 78%,
    rgba(255, 255, 255, 0.18) 100%);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow:
    inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04),
    var(--neu-raised-sm);
}

.worker-info {
  flex: 1;
  min-width: 0;
}

.worker-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

.worker-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
}

.worker-star {
  color: var(--orange);
  font-weight: 600;
}

.worker-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.worker-tag {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
  color: var(--brand);
  background: var(--brand-soft);
}

.worker-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--sep);
}

.worker-price {
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.worker-price-label {
  color: var(--text-2);
  font-size: 24rpx;
  margin-right: 8rpx;
}

.worker-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: var(--radius-full);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--neu-raised-sm), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65);
}

.worker-action:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  gap: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-2);
  font-weight: 500;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-3);
}
