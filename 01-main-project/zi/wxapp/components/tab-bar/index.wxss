/* components/tab-bar/index.wxss
 * Premium Liquid Glass 浮动 TabBar（忠于设计画布 zjrnew.design）
 * 核心特征：
 *   - 容器：高透明底 + 模糊 + 半透明边框 + 多层阴影
 *   - 选中态：独立玻璃背景层 + 品牌色边框 + 深度阴影
 */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 8rpx);
  z-index: 100;
}

/* ===== 容器：液态玻璃 ===== */
.tab-bar-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 112rpx;
  padding: 0 12rpx;

  /* 非常透明的玻璃底色 */
  background: rgba(255, 255, 255, 0.18);
  /* 高模糊 + 高饱和度 */
  backdrop-filter: blur(96rpx) saturate(210%);
  -webkit-backdrop-filter: blur(96rpx) saturate(210%);

  /* 半透明边框 */
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 48rpx;

  /* 多层阴影：顶部高光 + 底部深度 */
  box-shadow:
    /* 顶部内高光 */
    inset 0 3rpx 6rpx rgba(255, 255, 255, 0.60),
    /* 底部内阴影 */
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.20),
    /* 细边光 */
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    /* 近距阴影 */
    0 4rpx 20rpx rgba(0, 0, 0, 0.06),
    /* 远距阴影 */
    0 24rpx 72rpx rgba(0, 0, 0, 0.08);
}

/* ===== Tab 项：基础样式 ===== */
.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 88rpx;
  border-radius: 28rpx;
  color: var(--text-3);
  transition: all 0.2s var(--ease);
}

/* ===== 选中态玻璃背景层（替代 ::before） ===== */
.tab-item__glass {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 108rpx;
  height: 84rpx;
  border-radius: 32rpx;

  /* 品牌色半透明底 */
  background: rgba(13, 148, 136, 0.16);
  /* 玻璃模糊 */
  backdrop-filter: blur(48rpx);
  -webkit-backdrop-filter: blur(48rpx);
  /* 品牌色边框 */
  border: 1rpx solid rgba(13, 148, 136, 0.30);

  /* 多层阴影 */
  box-shadow:
    /* 顶部内高光 */
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.55),
    /* 底部内阴影 */
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.15),
    /* 外发光 */
    0 4rpx 20rpx rgba(13, 148, 136, 0.20),
    /* 细边光 */
    0 0 0 1rpx rgba(13, 148, 136, 0.08);

  z-index: 0;
}

/* ===== 内容层（确保在玻璃背景之上） ===== */
.tab-item__content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  z-index: 1;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0;
}

/* ===== 活跃态 ===== */
.tab-item.is-active {
  color: var(--brand);
}

.tab-item.is-active .tab-icon {
  transform: scale(1.08);
  transition: transform 0.2s var(--spring);
}

.tab-item.is-active .tab-text {
  font-weight: 600;
}

/* ===== 师傅端活跃态：蓝色玻璃 ===== */
.tab-bar-worker .tab-item__glass {
  background: rgba(45, 108, 223, 0.16);
  border: 1rpx solid rgba(45, 108, 223, 0.30);
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.55),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.15),
    0 4rpx 20rpx rgba(45, 108, 223, 0.20),
    0 0 0 1rpx rgba(45, 108, 223, 0.08);
}

.tab-bar-worker .tab-item.is-active {
  color: var(--brand-worker);
}

/* ===== 按压反馈 ===== */
.tab-item:active .tab-item__glass {
  transform: translate(-50%, -50%) scale(0.95);
  transition: transform 0.15s var(--spring);
}

.tab-item:active .tab-item__content {
  transform: scale(0.95);
  transition: transform 0.15s var(--spring);
}
