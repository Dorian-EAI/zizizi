page {
  --brand: #0D9488;
  --brand-dark: #0A7A70;
  --brand-mid: #14B8A6;
  --brand-light: #CCFBF1;
  --brand-glow: rgba(13, 148, 136, 0.24);
  --brand-subtle: rgba(13, 148, 136, 0.10);
  --brand-gradient: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);

  --accent: #D4944C;
  --accent-dark: #A0723C;
  --accent-mid: #E8C088;
  --accent-light: #F5E6D0;
  --accent-glow: rgba(212, 148, 76, 0.20);

  --bg: #F2EDE8;
  --body-bg: #E8E4DF;
  --bg-elevated: #F7F3EF;

  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;

  --text-1: #2C2824;
  --text-2: #8B8178;
  --text-3: #B5ADA5;
  --text-inverse: #ffffff;

  --sep: rgba(44, 40, 36, 0.06);
  --fill: rgba(44, 40, 36, 0.04);

  --r-sm: 24rpx;
  --r-md: 38rpx;
  --r-lg: 52rpx;
  --r-xl: 64rpx;
  --r-pill: 9999rpx;

  --dur: 0.2s;
  --spring: cubic-bezier(0.175, 0.885, 0.32, 1.275);
  --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);

  background: var(--bg);
  color: var(--text-1);
  font-family: 'Noto Serif SC', 'PingFang SC', -apple-system, Georgia, serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view, text, input, button, textarea, scroll-view, image {
  box-sizing: border-box;
}

button::after {
  border: none;
}

view {
  -webkit-tap-highlight-color: transparent;
}

.design-detail-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: env(safe-area-inset-bottom);
}

.design-detail-page::after {
  content: "";
  position: absolute;
  z-index: 0;
  left: 0;
  right: 0;
  bottom: 0;
  height: 520rpx;
  pointer-events: none;
  background:
    radial-gradient(ellipse 400rpx 280rpx at 20% 90%, var(--brand-subtle) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 240rpx at 80% 85%, var(--accent-glow) 0%, transparent 70%);
  opacity: 0.72;
}

.design-detail-page > view,
.design-detail-page > text,
.design-detail-page > image {
  position: relative;
  z-index: 1;
}

.status-bar {
  display: none;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  min-height: 160rpx;
  padding: 36rpx 40rpx;
  padding-top: max(36rpx, env(safe-area-inset-top));
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
  border-radius: 0 0 56rpx 56rpx;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

.topbar .tag-h1 {
  margin: 0;
  text-align: center;
  color: var(--text-1);
  font: 700 34rpx/1.3 var(--font, 'Noto Serif SC', serif);
  letter-spacing: -0.02em;
}

.icon-button {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: var(--text-1);
  background: var(--bg-elevated);
  box-shadow:
    10rpx 10rpx 28rpx var(--neu-dark),
    -10rpx -10rpx 28rpx var(--neu-light),
    inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.5);
  display: inline-grid;
  place-items: center;
  font-size: 38rpx;
  transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--ease);
}

.icon-button:active {
  box-shadow: inset 6rpx 6rpx 12rpx var(--neu-dark), inset -6rpx -6rpx 12rpx var(--neu-light);
  transform: scale(0.94);
}

.icon-button .design-svg-icon {
  width: 40rpx;
  height: 40rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.top-action {
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-body {
  padding: 36rpx 40rpx 224rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  margin: 0 0 40rpx;
  padding: 40rpx;
  color: var(--text-1);
  background:
    radial-gradient(ellipse 360rpx 240rpx at 88% 15%, rgba(212, 148, 76, 0.08) 0%, transparent 72%),
    radial-gradient(ellipse 300rpx 220rpx at 8% 90%, rgba(13, 148, 136, 0.08) 0%, transparent 72%),
    rgba(255, 255, 255, 0.48);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    16rpx 16rpx 36rpx var(--neu-dark),
    -16rpx -16rpx 36rpx var(--neu-light),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
}

.hero::after {
  display: none;
}

.hero > view,
.hero > text,
.hero > image {
  position: relative;
  z-index: 1;
}

.hero-kicker {
  margin: 0 0 12rpx;
  color: var(--text-2);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
}

.hero .tag-h2 {
  margin: 0;
  color: var(--text-1);
  font: 700 42rpx/1.25 var(--font, 'Noto Serif SC', serif);
  letter-spacing: -0.02em;
}

.hero .tag-p {
  margin: 16rpx 0 0;
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-number {
  color: var(--brand-dark);
  font: 700 64rpx/1.1 var(--font, 'Cormorant Garamond', 'Noto Serif SC', serif);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.tag-small {
  margin-left: 8rpx;
  font-size: 30rpx;
}

.section {
  margin: 0 0 36rpx;
}

.section-title {
  margin: 0 12rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 500;
}

.section-title .tag-strong {
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 700;
}

.card {
  position: relative;
  padding: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  box-shadow:
    16rpx 16rpx 36rpx var(--neu-dark),
    -16rpx -16rpx 36rpx var(--neu-light),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  overflow: hidden;
}

.card:active {
  transform: scale(0.98);
  box-shadow: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
}

.card + .card {
  margin-top: 24rpx;
}

.card-title {
  margin: 0 0 16rpx;
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 700;
}

.card-copy {
  margin: 0;
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.55;
}

.list-card {
  padding: 8rpx 28rpx;
  overflow: hidden;
}

.list-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid var(--sep);
}

.list-row:last-child {
  border-bottom: 0;
}

.list-row:active {
  transform: scale(0.985);
  background: var(--fill);
}

.row-icon {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow:
    10rpx 10rpx 28rpx var(--neu-dark),
    -10rpx -10rpx 28rpx var(--neu-light),
    inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.45);
  font-size: 30rpx;
}

.row-icon .design-svg-icon {
  width: 36rpx;
  height: 36rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  color: var(--text-1);
  font-size: 30rpx;
  font-weight: 500;
}

.row-copy {
  margin-top: 6rpx;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.45;
}

.row-value {
  color: var(--text-2);
  font-size: 26rpx;
  text-align: right;
}

.chevron {
  position: relative;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  color: var(--text-3);
  font-size: 0;
}

.chevron::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.grid-2,
.grid-3 {
  display: grid;
  gap: 24rpx;
}

.grid-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.metric {
  padding: 28rpx 20rpx;
  text-align: center;
}

.metric .tag-strong {
  display: block;
  color: var(--brand-dark);
  font: 700 44rpx/1.1 var(--font, 'Cormorant Garamond', serif);
  font-variant-numeric: tabular-nums;
}

.metric .tag-span {
  display: block;
  margin-top: 14rpx;
  color: var(--text-2);
  font-size: 24rpx;
}

.field {
  margin-bottom: 32rpx;
}

.field .tag-label {
  display: block;
  margin: 0 8rpx 16rpx;
  color: var(--text-2);
  font-size: 26rpx;
  font-weight: 500;
}

.input,
.textarea,
.select-like {
  width: 100%;
  border: 0;
  border-radius: var(--r-md);
  outline: 0;
  color: var(--text-1);
  background: var(--bg);
  box-shadow: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
  font-family: var(--font, 'Noto Serif SC', serif);
}

.input,
.select-like {
  min-height: 96rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
}

.textarea {
  min-height: 212rpx;
  padding: 28rpx 32rpx;
  resize: none;
  line-height: 1.55;
  font-size: 28rpx;
}

.select-like {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.input::placeholder,
.textarea::placeholder {
  color: var(--text-3);
}

.input:focus,
.textarea:focus {
  box-shadow:
    inset 8rpx 8rpx 16rpx var(--neu-dark),
    inset -8rpx -8rpx 16rpx var(--neu-light),
    0 0 0 4rpx var(--brand-subtle),
    0 0 0 8rpx var(--brand-glow);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.chip {
  border: 0;
  border-radius: var(--r-pill);
  padding: 16rpx 28rpx;
  color: var(--text-2);
  background: var(--bg-elevated);
  box-shadow:
    12rpx 12rpx 28rpx var(--neu-dark),
    -12rpx -12rpx 28rpx var(--neu-light),
    inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.45);
  font-size: 24rpx;
  font-weight: 500;
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}

.chip.active {
  color: var(--brand);
  background: rgba(13, 148, 136, 0.15);
  box-shadow: inset 6rpx 6rpx 12rpx var(--neu-dark), inset -6rpx -6rpx 12rpx var(--neu-light);
  font-weight: 600;
}

.chip:active {
  transform: scale(0.96);
}

.segmented {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40),
    0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.segment {
  flex: 1;
  border: 0;
  border-radius: var(--r-sm);
  padding: 20rpx 10rpx;
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.35);
  box-shadow:
    10rpx 10rpx 24rpx var(--neu-dark),
    -10rpx -10rpx 24rpx var(--neu-light),
    inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.45);
  font-size: 24rpx;
  font-weight: 500;
}

.segment.active {
  color: var(--brand);
  background: rgba(13, 148, 136, 0.15);
  box-shadow: inset 6rpx 6rpx 12rpx var(--neu-dark), inset -6rpx -6rpx 12rpx var(--neu-light);
  font-weight: 600;
}

.badge,
.status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  border-radius: var(--r-pill);
  padding: 10rpx 18rpx;
  color: var(--brand-dark);
  background: rgba(13, 148, 136, 0.10);
  font-size: 22rpx;
  font-weight: 600;
}

.badge.success {
  color: #3D6E3E;
  background: rgba(91, 140, 90, 0.12);
}

.badge.warning {
  color: #986326;
  background: rgba(212, 148, 76, 0.10);
}

.badge.danger {
  color: #A53E2D;
  background: rgba(196, 83, 58, 0.11);
}

.badge.info {
  color: #46748D;
  background: rgba(90, 143, 173, 0.12);
}

.empty-state {
  padding: 72rpx 44rpx;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow:
    16rpx 16rpx 36rpx var(--neu-dark),
    -16rpx -16rpx 36rpx var(--neu-light);
  font-size: 40rpx;
}

.empty-icon .design-svg-icon {
  width: 44rpx;
  height: 44rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.empty-state .tag-h3 {
  margin: 0;
  font-size: 32rpx;
  color: var(--text-1);
}

.empty-state .tag-p {
  margin: 16rpx 0 0;
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.55;
}

.notice {
  margin-bottom: 26rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(212, 148, 76, 0.14);
  border-radius: var(--r-sm);
  color: #77501F;
  background: rgba(245, 230, 208, 0.58);
  font-size: 24rpx;
  line-height: 1.55;
}

.notice.error {
  color: #8C392D;
  background: rgba(196, 83, 58, 0.08);
  border-color: rgba(196, 83, 58, 0.18);
}

.notice.info {
  color: #315F74;
  background: rgba(90, 143, 173, 0.09);
  border-color: rgba(90, 143, 173, 0.18);
}

.notice.warning {
  color: #986326;
  background: rgba(212, 148, 76, 0.10);
  border-color: rgba(212, 148, 76, 0.20);
}

.fixed-actions {
  position: fixed;
  z-index: 20;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  padding: 20rpx;
  display: flex;
  gap: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40),
    0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn {
  min-height: 96rpx;
  border: 0;
  border-radius: var(--r-pill);
  padding: 0 36rpx;
  font-weight: 600;
  font-size: 28rpx;
  transition: transform var(--dur) var(--spring), box-shadow var(--dur) var(--ease);
}

.btn.primary {
  flex: 1;
  color: #fff;
  background: var(--brand-gradient);
  box-shadow:
    inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.40),
    inset -2rpx -2rpx 2rpx rgba(0, 0, 0, 0.16),
    0 4rpx 8rpx var(--brand-glow),
    12rpx 12rpx 28rpx var(--neu-dark),
    -12rpx -12rpx 28rpx var(--neu-light);
}

.btn.secondary {
  color: var(--brand);
  background: rgba(255, 255, 255, 0.68);
  box-shadow:
    12rpx 12rpx 28rpx var(--neu-dark),
    -12rpx -12rpx 28rpx var(--neu-light),
    inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.45);
}

.btn.danger {
  color: #C4533A;
  background: rgba(255, 255, 255, 0.68);
  box-shadow:
    12rpx 12rpx 28rpx var(--neu-dark),
    -12rpx -12rpx 28rpx var(--neu-light),
    inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.45);
}

.btn.block {
  width: 100%;
}

.btn:active {
  transform: scale(0.96);
  box-shadow: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
}

.btn.is-disabled,
.btn:disabled {
  cursor: default;
  opacity: 0.52;
  box-shadow: none;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--brand);
  background: var(--bg);
  box-shadow: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
  font: 700 32rpx/1 var(--font, 'Noto Serif SC', serif);
}

.avatar img {
  width: 44rpx;
  height: 44rpx;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.upload-tile {
  aspect-ratio: 1;
  border: 2rpx dashed rgba(13, 148, 136, 0.15);
  border-radius: var(--r-md);
  display: grid;
  place-items: center;
  color: var(--brand);
  background: rgba(255, 255, 255, 0.28);
  box-shadow:
    12rpx 12rpx 28rpx var(--neu-dark),
    -12rpx -12rpx 28rpx var(--neu-light);
  font-size: 44rpx;
  min-height: 190rpx;
}

.upload-tile .design-svg-icon {
  width: 48rpx;
  height: 48rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.media-placeholder {
  min-height: 300rpx;
  position: relative;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.62);
  border-radius: var(--r-md);
  display: grid;
  place-items: center;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
  font-size: 48rpx;
}

.media-placeholder .design-svg-icon {
  width: 56rpx;
  height: 56rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.media-icon {
  display: inline-grid;
  place-items: center;
  color: var(--brand);
}

.media-icon .design-svg-icon {
  width: 40rpx;
  height: 40rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.media-label {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  color: var(--brand-dark);
  font: 700 28rpx/1 var(--font, 'Cormorant Garamond', serif);
}

.result-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--brand);
  background: var(--bg-elevated);
  box-shadow: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
}

.result-icon.success {
  color: #5B8C5A;
}

.result-icon.warning {
  color: var(--accent);
}

.result-icon.danger {
  color: #C4533A;
}

.result-icon .design-svg-icon {
  width: 44rpx;
  height: 44rpx;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.amount {
  color: var(--brand-dark);
  font: 700 60rpx/1.1 var(--font, 'Cormorant Garamond', serif);
  font-variant-numeric: tabular-nums;
}

.divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: var(--sep);
}

.text-center {
  text-align: center;
}

.row-value .tag-strong {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.tag-b {
  font-weight: 700;
}

.tag-span {
  font-size: 24rpx;
  color: var(--text-2);
}

.tag-p {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.55;
}

.tag-h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.tag-h3 {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}

.tag-strong {
  font-weight: 700;
}

.design-button {
  margin: 0;
  padding: 0;
  line-height: inherit;
}

.design-svg-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.icon-button .design-svg-icon {
  width: 40rpx;
  height: 40rpx;
}

.row-icon .design-svg-icon {
  width: 36rpx;
  height: 36rpx;
}

.empty-icon .design-svg-icon,
.result-icon .design-svg-icon {
  width: 72rpx;
  height: 72rpx;
}

.notice .tag-p {
  margin: 0;
}

.note .tag-p {
  margin-top: 24rpx;
  display: block;
}

.hero .grid-2 {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.state-panel {
  padding: 280rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: var(--text-2);
}

.state-panel .tag-p {
  color: var(--text-2);
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}
