@import "./styles/business-state.wxss";

/* ==================== 全局样式与设计令牌 ====================
 * 风格：玻璃新拟态（Glass Neumorphism）
 * 设计原则：
 *   - 暖米色画布 #F2EDE8，柔和不刺眼
 *   - 客户端青色 #0D9488，师傅端蓝色 #2D6CDF，点缀琥珀 #D4944C
 *   - 玻璃质感：半透明白 + backdrop-filter 模糊 + 高光描边
 *   - 新拟态：双向阴影（暗+亮）创造凸起/凹陷立体感
 *   - 浮动胶囊 TabBar，底部悬浮玻璃质感
 *   - 动效：按压 scale + 弹簧曲线，过渡时长 ≤ 300ms
 */

page {
  /* ===== 品牌色 — 客户端（Teal）===== */
  --brand: #0D9488;
  --brand-dark: #0A7A70;
  --brand-mid: #14B8A6;
  --brand-light: #CCFBF1;
  --brand-glow: rgba(13, 148, 136, 0.24);
  --brand-subtle: rgba(13, 148, 136, 0.10);
  /* 三色渐变：teal → 青绿 → 琥珀（设计画布要求） */
  --brand-gradient: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);

  /* ===== 品牌色 — 师傅端（蓝色，非蓝紫）===== */
  --brand-worker: #2D6CDF;
  --brand-worker-dark: #2456B8;
  --brand-worker-mid: #5A8EE8;
  --brand-worker-light: #DCE8FB;
  --brand-worker-glow: rgba(45, 108, 223, 0.28);
  --brand-worker-subtle: rgba(45, 108, 223, 0.08);
  /* 三色渐变：蓝 → 中蓝 → 琥珀（设计画布要求） */
  --brand-worker-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);

  /* ===== 强调色（琥珀）===== */
  --accent: #D4944C;
  --accent-dark: #A0723C;
  --accent-mid: #E8C088;
  --accent-light: #F5E6D0;
  --accent-glow: rgba(212, 148, 76, 0.20);
  --accent-subtle: rgba(212, 148, 76, 0.12);

  /* ===== 鼠尾草绿 — 师傅端辅助色（设计画布要求）===== */
  --sage: #D4944C;
  --sage-light: #F5E6D0;

  /* ===== 画布与背景 — 暖灰米色，新拟态最佳底色 ===== */
  --canvas: #F2EDE8;
  --bg: #F2EDE8;
  --background: #F2EDE8;
  --foreground: #2C2824;
  --body-bg: #E8E4DF;
  --bg-elevated: #F7F3EF;
  --bg-soft: #F7F3EE;
  --paper: #FFFCF8;
  --surface: rgba(255, 255, 255, 0.50); /* 玻璃表面 */
  --card: rgba(255, 255, 255, 0.52);
  --card-foreground: #2C2824;
  --popover: #FFFFFF;
  --popover-foreground: #2C2824;
  --muted: #F7F3EF;
  --muted-foreground: #8B8178;

  /* ===== 新拟态阴影色 ===== */
  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;
  --neu-light-soft: #FBF6F0;
  --neu-dark-soft: #E5DFD8;

  /* ===== 文字 ===== */
  --text-1: #2C2824;
  --text-2: #8B8178;
  --text-3: #B5ADA5;
  --text-4: #B5ADA5;
  --text-inverse: #FFFFFF;

  /* ===== 分隔与填充 ===== */
  --hairline: rgba(44, 40, 36, 0.06);
  --sep: rgba(44, 40, 36, 0.06);
  --border: rgba(44, 40, 36, 0.06);
  --input: rgba(44, 40, 36, 0.06);
  --ring: #0D9488;
  --hairline-strong: rgba(44, 40, 36, 0.12);
  --fill: rgba(44, 40, 36, 0.04);
  --fill-strong: rgba(44, 40, 36, 0.08);

  /* ===== 语义色 ===== */
  --success: #16A34A;
  --state-success: #5B8C5A;
  --success-bg: #DCFCE7;
  --warning: #D97706;
  --state-warning: #D4944C;
  --warning-bg: #FEF3C7;
  --danger: #DC2626;
  --state-error: #C4533A;
  --danger-bg: #FEE2E2;
  --info: #0D9488;
  --state-info: #5A8FAD;
  --info-bg: #CCFBF1;
  --primary: #0D9488;
  --primary-foreground: #FFFFFF;
  --green: #5B8C5A;
  --red: #C4533A;
  --orange: #D4944C;
  --blue: #5A8FAD;
  --blue-subtle: rgba(90, 143, 173, 0.12);

  /* ===== 圆角（对齐 colors_and_type.css：0.75/1.2/1.6rem，1px=2rpx）===== */
  --r-sm: 24rpx;        /* 0.75rem = 12px */
  --r-md: 38rpx;        /* 1.2rem = 19.2px */
  --r-lg: 52rpx;        /* 1.6rem = 25.6px */
  --r-xl: 64rpx;       /* 2rem = 32px */
  --r-2xl: 80rpx;       /* 2.5rem = 40px */
  --r-pill: 9999rpx;
  /* spec 别名（与 colors_and_type.css 同名，便于页面直接引用） */
  --radius-sm: var(--r-sm);
  --radius-md: var(--r-md);
  --radius-lg: var(--r-lg);
  --radius-full: var(--r-pill);

  /* ===== 新拟态阴影（凸起）— 对齐 colors_and_type.css，1px=2rpx，含第三层投影 ===== */
  --neu-raised-sm: 12rpx 12rpx 28rpx var(--neu-dark), -12rpx -12rpx 28rpx var(--neu-light), 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  --neu-raised: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light), 0 12rpx 48rpx rgba(0, 0, 0, 0.05);
  --neu-raised-lg: 20rpx 20rpx 48rpx var(--neu-dark), -20rpx -20rpx 48rpx var(--neu-light), 0 16rpx 64rpx rgba(0, 0, 0, 0.06);
  /* spec 别名 */
  --neu-out-sm: var(--neu-raised-sm);
  --neu-out-md: var(--neu-raised);
  --neu-out-lg: var(--neu-raised-lg);
  /* ===== 新拟态阴影（凹陷）===== */
  --neu-inset-sm: inset 6rpx 6rpx 12rpx var(--neu-dark), inset -6rpx -6rpx 12rpx var(--neu-light);
  --neu-inset: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-inset-lg: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
  /* spec 别名 */
  --neu-in: var(--neu-inset);
  --neu-in-deep: var(--neu-inset-lg);

  /* ===== 常规投影 ===== */
  --shadow-sm: 0 2rpx 6rpx rgba(44, 40, 36, 0.04);
  --shadow-card: 0 4rpx 16rpx rgba(44, 40, 36, 0.05);
  --shadow-elevated: 0 8rpx 24rpx rgba(44, 40, 36, 0.08), 0 2rpx 6rpx rgba(44, 40, 36, 0.04);
  --shadow-glass: 0 8rpx 64rpx rgba(0,0,0,0.04), 0 1rpx 4rpx rgba(0,0,0,0.03);
  --shadow-float: 0 16rpx 64rpx rgba(0,0,0,0.06), 0 4rpx 16rpx rgba(0,0,0,0.03);
  --shadow-glow-brand: 0 6rpx 20rpx rgba(13, 148, 136, 0.28);
  --shadow-glow-worker: 0 6rpx 20rpx rgba(45, 108, 223, 0.28);
  --shadow-glow-accent: 0 6rpx 20rpx rgba(212, 148, 76, 0.25);

  /* ===== 玻璃质感令牌 ===== */
  --glass-bg: rgba(255, 255, 255, 0.52);
  --glass-bg-strong: rgba(255, 255, 255, 0.70);
  --glass-bg-soft: rgba(255, 255, 255, 0.35);
  --glass-border: rgba(255, 255, 255, 0.70);   /* 可见实体边框（设计画布升级） */
  --glass-border-soft: rgba(255, 255, 255, 0.45);
  --glass-blur: blur(40rpx) saturate(150%);
  --glass-blur-light: blur(40rpx) saturate(160%);
  --glass-blur-strong: blur(96rpx) saturate(210%);

  /* ===== Premium Liquid Glass Tab Bar 专用令牌（设计画布要求）===== */
  --glass-tab-bg: rgba(255, 255, 255, 0.18);
  --glass-tab-blur: blur(96rpx) saturate(210%);
  --glass-tab-border: rgba(255, 255, 255, 0.45);
  --r-tab: 48rpx;   /* Tab Bar 圆角（略大于 Glass Neumorphism 的 44rpx） */

  /* ===== 卡片三层阴影令牌（设计画布升级）===== */
  --shadow-card-ring: 0 0 0 2rpx rgba(44, 40, 36, 0.05);       /* 外环描边 */
  --shadow-card-brand: 0 4rpx 16rpx rgba(13, 148, 136, 0.04);  /* 品牌色环境辉光 */
  --shadow-card-worker: 0 4rpx 16rpx rgba(45, 108, 223, 0.04); /* 师傅端品牌色辉光 */

  /* ===== 动效 ===== */
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
  --spring: cubic-bezier(0.175, 0.885, 0.32, 1.275);
  --dur-fast: 0.15s;
  --dur-base: 0.2s;
  --dur-slow: 0.3s;

  /* ===== 间距 ===== */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 48rpx;
  --space-3xl: 64rpx;

  /* ===== 字体策略 — 混合方案 =====
   * 固定内容（标题、按钮、数字等）：衬线字体
   *   - base64 内嵌 Noto Serif SC（主要）
   *   - 系统字体 Songti SC/STSimSun（回退）
   *
   * UGC 内容（评论、聊天等）：无衬线字体
   *   - 网络加载 Noto Sans CJK SC（主要）
   *   - 系统字体 PingFang SC/Microsoft YaHei（回退）
   *
   * 跨平台兼容：
   *   iOS/macOS：衬线→Songti SC；UGC→PingFang SC
   *   Android：衬线→Noto Serif SC（网络）；UGC→Noto Sans CJK SC（网络）
   */
  --font-serif-safe: "Noto Serif SC", "Songti SC", "STSong", "SimSun",
    "Noto Serif CJK SC", "Source Han Serif SC",
    "Cormorant Garamond", Georgia, serif;
  --font-display: "Noto Serif SC", "Songti SC", "STSong", "SimSun",
    "Cormorant Garamond", Georgia, serif;
  --font-body: "Noto Serif SC", "Songti SC", "STSong", "SimSun",
    "Cormorant Garamond", "Noto Serif CJK SC", serif;
  --font-nums: "Cormorant Garamond", "Noto Serif SC",
    "Songti SC", "STSong", Georgia, serif;
  /* UGC 字体：网络加载 Noto Sans CJK SC + 系统回退 */
  --font-ugc: "Noto Sans CJK SC", "PingFang SC", "Helvetica Neue",
    "Microsoft YaHei", "Heiti SC", system-ui, -apple-system, sans-serif;
  --font-sans: var(--font-ugc);
  --font-number: var(--font-nums);
  --font-mono: "SF Mono", "Menlo", "Courier New", monospace;
  --font: var(--font-body);

  background: var(--background);
  color: var(--text-1);
  font-family: var(--font-body);
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  letter-spacing: 0;
}

view, text, scroll-view, image, button, input, textarea {
  box-sizing: border-box;
  font-family: var(--font-body);
}

/* ==================== 强制衬线字体 ====================
 * 使用 !important 确保衬线字体优先级最高
 * 优先使用 base64 内嵌的 Noto Serif SC，系统字体作为回退
 */

/* 所有文字元素强制使用衬线 */
view, text, button, label, p, span, div, h1, h2, h3, h4, h5, h6 {
  font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif !important;
}

/* 标题类 — 使用更优雅的 display 字体 */
.app-name,
.page-title,
.title-bar__name,
.section-title,
.card-title,
.modal-title,
.dialog-title,
.greeting,
[class*="-title"],
[class*="-name"] {
  font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif !important;
}

/* 按钮文字 — 使用衬线 */
button,
.btn-text,
.button-text,
[class*="-btn"] {
  font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif !important;
}

/* 数字 — 使用衬线 */
.stat-value,
.price-value,
.amount-value,
[class*="-value"],
[class*="-num"],
[class*="-count"] {
  font-family: "Cormorant Garamond", "Noto Serif SC", "Songti SC", serif !important;
}

/* ==================== 跨平台一致性修复 ====================
 * 解决真机与开发者工具的渲染差异，确保 iOS / Android / 开发者工具一致
 */

/* 1. 移除点击高亮（iOS 蓝色半透明矩形） */
view, text, image, button, input, textarea, scroll-view, navigator {
  -webkit-tap-highlight-color: transparent;
}

/* 2. 文字渲染优化（iOS / Android 统一） */
page {
  -webkit-text-size-adjust: 100%;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  /* 防止 iOS 横屏字体放大 */
  text-size-adjust: 100%;
}

/* 3. scroll-view iOS 动量滚动 + 隐藏滚动条 */
scroll-view {
  -webkit-overflow-scrolling: touch;
}
scroll-view::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* 4. input / textarea 默认样式重置 */
input, textarea {
  appearance: none;
  -webkit-appearance: none;
  outline: none;
  border: none;
  background: transparent;
}
/* placeholder 颜色跨平台统一 */
input[placeholder], textarea[placeholder] {
  color: var(--text-3);
}

/* 5. button 默认样式重置 */
button {
  appearance: none;
  -webkit-appearance: none;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
  line-height: normal;
}
button::after {
  border: none;
}

/* 6. image 渲染优化（防止模糊和锯齿） */
image {
  image-rendering: -webkit-optimize-contrast;
  -webkit-user-drag: none;
}

/* 7. 玻璃拟态 backdrop-filter 降级方案
 * Android 部分机型不支持 backdrop-filter，需要更不透明的背景兜底
 * 通过 @supports 检测：不支持时提高背景透明度
 */
@supports not (backdrop-filter: blur(1px)) {
  .glass-card,
  .glass-card-lg {
    background: rgba(255, 255, 255, 0.85);
  }
  .glass-bar-inner,
  .tab-bar-inner {
    background: rgba(255, 255, 255, 0.88);
  }
}
@supports not (-webkit-backdrop-filter: blur(1px)) {
  .glass-card,
  .glass-card-lg {
    background: rgba(255, 255, 255, 0.85);
  }
  .glass-bar-inner,
  .tab-bar-inner {
    background: rgba(255, 255, 255, 0.88);
  }
}

/* 8. safe-area-inset 兼容（constant() 用于 iOS < 11.2）
 * 在不支持 env() 的旧设备上回退到 0
 */
.safe-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top, 0px);
}
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
.safe-left {
  padding-left: constant(safe-area-inset-left);
  padding-left: env(safe-area-inset-left, 0px);
}
.safe-right {
  padding-right: constant(safe-area-inset-right);
  padding-right: env(safe-area-inset-right, 0px);
}

/* 9. 1rpx 边框渲染优化（Android 部分机型 1rpx 不显示）
 * 使用 transform: scale 配合伪元素实现 hairline border
 * 仅在需要极细边框时使用 .hairline 类
 */
.hairline-bottom {
  position: relative;
}
.hairline-bottom::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 1rpx;
  background: var(--hairline, rgba(0, 0, 0, 0.06));
  transform: scaleY(0.5);
  transform-origin: 0 100%;
}
.hairline-top::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 1rpx;
  background: var(--hairline, rgba(0, 0, 0, 0.06));
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

/* 10. 安全区底部占位（为 tab-bar 预留空间） */
.safe-tabbar-bottom {
  padding-bottom: calc(constant(safe-area-inset-bottom) + 120rpx);
  padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 120rpx);
}

/* 11. flex gap 降级方案
 * 部分 Android 机型不支持 flex gap，使用 @supports 检测并回退到 margin
 * 支持 gap 时不执行任何操作；不支持时用负 margin + 子项正 margin
 */
@supports not (gap: 10rpx) {
  .flex-row-gap-sm { margin-left: -12rpx; }
  .flex-row-gap-sm > view,
  .flex-row-gap-sm > text { margin-left: 12rpx; }
  .flex-row-gap-md { margin-left: -20rpx; }
  .flex-row-gap-md > view,
  .flex-row-gap-md > text { margin-left: 20rpx; }
  .flex-row-gap-lg { margin-left: -32rpx; }
  .flex-row-gap-lg > view,
  .flex-row-gap-lg > text { margin-left: 32rpx; }
}

/* 12. aspect-ratio 降级方案
 * 不支持 aspect-ratio 的设备使用 padding-top 百分比模拟
 */
@supports not (aspect-ratio: 1 / 1) {
  .ar-square-fallback::before {
    content: "";
    display: block;
    padding-top: 100%;
  }
  .ar-4-3-fallback::before {
    content: "";
    display: block;
    padding-top: 75%;
  }
  .ar-16-9-fallback::before {
    content: "";
    display: block;
    padding-top: 56.25%;
  }
}

/* 13. position: sticky 降级方案
 * 不支持 sticky 的设备回退为 fixed（需要额外占位元素）
 */
@supports not (position: sticky) {
  .sticky-fallback {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }
}

/* 14. 全局动画性能优化（Android GPU 加速） */
.animated,
.transition,
.glass-card,
.glass-card-lg,
.tab-bar-inner,
.elevated-circle,
.service-card {
  transform: translateZ(0);
  will-change: transform, opacity;
  backface-visibility: hidden;
}

/* 15. 防止 iOS 长按选择文字 */
view, text {
  -webkit-user-select: none;
  user-select: none;
}
/* 但 input/textarea 允许选择 */
input, textarea {
  -webkit-user-select: text;
  user-select: text;
}

/* ==================== UGC 字体应用 ====================
 * UGC 内容使用无衬线字体，支持全量字符和 emoji
 * 网络加载 Noto Sans CJK SC，系统回退 PingFang SC
 *
 * 固定内容（标题、按钮、装饰文字等）继续使用衬线字体
 */

/* UGC 内容容器 — 使用无衬线字体 */
.ugc-content,
.ugc-text,
.user-content,
.review-text,
.review-content,
.review-body,
.review-article,
.msg-bubble,
.msg-content,
.chat-bubble,
.chat-content,
.reply-text,
.reply-content,
.comment-text,
.comment-content,
.feedback-text,
.feedback-content,
.ticket-content,
.ticket-reply,
.card-copy,
.card-content,
.card-text,
.item-content,
.item-text,
.desc-text,
.desc-content,
.description,
.content-text,
.text-content {
  font-family: var(--font-ugc) !important;
  word-break: break-all;
}

/* 聊天/评论中的文本内容 */
.chat-thread .row-copy,
.chat-thread .card-copy,
.chat-thread .tag-p,
.ticket-thread .row-copy,
.ticket-thread .card-copy,
.review-card .card-copy,
.feedback-card .card-copy {
  font-family: var(--font-ugc) !important;
}

/* 用户输入框 — 始终用系统无衬线字体 */
input, textarea, editor {
  font-family: var(--font-ugc);
}

/* image 组件防御性样式：确保 data URI 和 SVG 正确渲染 */
image {
  display: inline-block;
  vertical-align: middle;
  max-width: 100%;
}

/* ==================== 玻璃新拟态卡片 ==================== */

/* 玻璃卡片（设计画布升级版）：
 *   1. 可见实体边框 1rpx solid rgba(255,255,255,0.70)
 *   2. 新拟态凸起阴影（骨骼）
 *   3. 外层投影加深
 *   4. 外环描边
 *   5. 品牌色环境辉光
 *   6. Rim Light 边缘高光（伪元素）
 */
.glass-card {
  position: relative;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(44, 40, 36, 0.06),
    var(--shadow-card-ring),
    var(--shadow-card-brand);
}

.glass-card-lg {
  position: relative;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-xl);
  box-shadow:
    var(--neu-raised-lg),
    0 12rpx 56rpx rgba(44, 40, 36, 0.06),
    var(--shadow-card-ring),
    var(--shadow-card-brand);
}

/* 师傅端卡片使用蓝色辉光（设计画布区分双端） */
.glass-card-worker {
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(44, 40, 36, 0.06),
    var(--shadow-card-ring),
    var(--shadow-card-worker);
}

/* Rim Light 边缘高光 — 克制使用（设计画布要求） */
.glass-card::before,
.glass-card-lg::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%
  );
  pointer-events: none;
  z-index: 0;
}

/* 卡片内容确保在 Rim Light 之上 */
.glass-card > view,
.glass-card > text,
.glass-card-lg > view,
.glass-card-lg > text {
  position: relative;
  z-index: 1;
}

/* 实色卡片：暖白底 + 新拟态凸起 */
.neu-card {
  background: var(--paper);
  border-radius: var(--r-lg);
  box-shadow: var(--neu-raised), var(--shadow-sm);
}

.neu-card-lg {
  background: var(--paper);
  border-radius: var(--r-xl);
  box-shadow: var(--neu-raised-lg), var(--shadow-sm);
}

/* 凹陷容器：新拟态 inset */
.neu-inset {
  background: var(--canvas);
  border-radius: var(--r-md);
  box-shadow: var(--neu-inset);
}

/* ==================== 新拟态图标圆 ==================== */

/* 凸起图标圆 */
.neu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--canvas);
  border-radius: 50%;
  box-shadow: var(--neu-raised-sm);
  flex-shrink: 0;
}

/* 凹陷图标圆 */
.neu-icon-inset {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--canvas);
  border-radius: 50%;
  box-shadow: var(--neu-inset-sm);
  flex-shrink: 0;
}

/* ==================== 文字层级 ==================== */
.text-1 { color: var(--text-1); }
.text-2 { color: var(--text-2); }
.text-3 { color: var(--text-3); }
.text-4 { color: var(--text-4); }
.text-brand { color: var(--brand); }
.text-brand-worker { color: var(--brand-worker); }
.text-accent { color: var(--accent); }
.text-inverse { color: var(--text-inverse); }

.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }
.font-light { font-weight: 300; }

/* 数字字体：忠于 zjrnew 的 Cormorant 展示数字，并启用等宽数字减少跳动 */
.numeric {
  font-family: var(--font-number);
  font-weight: 700;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ==================== zjrnew.DESIGN 全局对齐层 ==================== */
/* 页面画布：暖米色底 + 底部环境光晕 */
.page {
  background: var(--background);
  color: var(--text-1);
  font-family: var(--font-body);
}

.page-scroll {
  background: transparent;
}

/* 标题体系统一：画布中标题均为 700 + 微负字距 */
.hero-title,
.section-title,
.bar-title,
.back-title,
.nav-title,
.topbar-title,
.card-title,
.timeline-title {
  font-family: var(--font-body);
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

/* 金额、统计、评分、余额：只对数字展示使用 Cormorant，UGC 中文不受影响 */
.stat-num,
.bottom-num,
.amount-num,
.amount-cur,
.amount-symbol,
.amount-input,
.price-num,
.price-cur,
.price-value,
.price-symbol,
.rec-amount,
.plan-num,
.my-bal-num,
.hero-balance,
.hero-stat-num,
.hero-rating-num,
.income-amount,
.fee-value,
.fee-total,
.cta-amount-value {
  font-family: var(--font-number);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  letter-spacing: -0.01em;
}

/* 玻璃新拟态标准卡片：与 zjrnew.DESIGN 的 glass-neu-card 视觉一致 */
.glass-neu-card,
.card-glass {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
}

/* 按钮、标签统一使用画布字体变量 */
.btn-primary,
.btn-secondary,
.btn-cta,
.primary-btn,
.submit-btn,
.action-btn,
.claim-btn,
.publish-btn,
.cancel-btn,
.send-btn,
.rec-btn,
.ai-btn,
.chip,
.chip-neu,
.hot-tag,
.type-chip,
.tab-chip,
.quick-chip,
.skill-chip,
.chip-eta {
  font-family: var(--font-body);
}

/* ==================== 分隔线 ==================== */
/* .hairline-top / .hairline-bottom 已在跨平台兼容块中用伪元素实现 */
.divider {
  height: 1rpx;
  background: var(--hairline);
  margin: var(--space-md) 0;
}

/* ==================== 工具类 ==================== */
.hide-scroll ::-webkit-scrollbar { display: none; }

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
}

.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

/* ==================== 按压动效 ==================== */
.press-scale:active {
  transform: scale(0.96);
  transition: transform var(--dur-fast) var(--ease);
}

.press-card:active {
  transform: scale(0.98);
  transition: transform var(--dur-base) var(--ease);
}

.press-neu:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset-sm);
  transition: all var(--dur-fast) var(--ease);
}

/* ==================== 背景装饰光斑 ==================== */
.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  z-index: 0;
  pointer-events: none;
  opacity: 0.12;
}

/* ==================== 页面容器 ==================== */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  /* 底部空间预留：Tab Bar 高度 + 安全区 + 缓冲 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 220rpx);
}

/* ==================== 区块标题 ==================== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-xl) var(--space-xl) var(--space-md);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.section-link {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ==================== 状态标签 ==================== */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  font-weight: 500;
}

.chip-success { background: var(--success-bg); color: var(--success); }
.chip-warning { background: var(--warning-bg); color: var(--warning); }
.chip-danger { background: var(--danger-bg); color: var(--danger); }
.chip-info { background: var(--info-bg); color: var(--info); }
.chip-accent { background: var(--accent-light); color: var(--accent-dark); }

/* ============================================================ */
/* === 主样式规范 + 评审画布组件实现 ========================= */
/* ============================================================ */

/* ==================== Hero 区域 — 活力渐变光晕（加重版） ==================== */

/* 用户端 Hero — Teal + 琥珀暖光（对齐主样式规范与 HTML 渲染源：0.14 轻量版） */
.hero {
  padding: 28rpx 48rpx 48rpx;
  padding-top: calc(env(safe-area-inset-top) + 28rpx);
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 440rpx 360rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

/* 师傅端 Hero — 蓝色 + 鼠尾草暖光（对齐主样式规范：0.14 轻量版） */
.hero-worker {
  background:
    radial-gradient(ellipse 440rpx 360rpx at 78% 45%, rgba(212,148,76,.10) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(212,148,76,.04) 50%, rgba(45, 108, 223, 0.06) 100%);
}

/* Hero 光斑：忠于 zjrnew.DESIGN 的 ::before / ::after 叠光 */
.hero::before {
  content: "";
  position: absolute;
  top: -30%;
  right: -15%;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.hero::after {
  content: "";
  position: absolute;
  bottom: -20%;
  left: -8%;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 148, 136, 0.10) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.hero-worker::after {
  background: radial-gradient(circle, rgba(45, 108, 223, 0.10) 0%, transparent 70%);
}

.hero > view,
.hero > text,
.hero > scroll-view,
.hero > image {
  position: relative;
  z-index: 1;
}

/* Hero 文字使用暖近黑色（设计画布要求高对比度可读性） */
.hero .hero-title,
.hero .hero-text {
  color: var(--text-1);
}

/* ==================== Hero 搜索栏（Glass 控件，非新拟态） ==================== */

.hero .search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(48rpx) saturate(180%);
  -webkit-backdrop-filter: blur(48rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: var(--r-pill);
  padding: 26rpx 36rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.5);
  position: relative;
}

/* ==================== 背景三色径向光晕装饰 ==================== */

.page::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  background:
    radial-gradient(ellipse 400rpx 280rpx at 20% 90%, rgba(13, 148, 136, 0.07) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 240rpx at 80% 85%, rgba(212, 148, 76, 0.06) 0%, transparent 70%),
    radial-gradient(ellipse 320rpx 200rpx at 50% 95%, rgba(20, 184, 166, 0.04) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* ==================== 按钮三层阴影规范（设计画布要求） ==================== */
/* 所有可点击按钮统一遵循：新拟态凸起 + 品牌色辉光 + 顶部内高光 */

.btn-primary {
  background: var(--brand-gradient);
  color: #fff;
  border: none;
  height: 96rpx;
  padding: 0 48rpx;
  border-radius: var(--r-lg);
  font-size: 30rpx;
  font-weight: 600;
  font-family: var(--font-sans);
  /* 三层阴影：新拟态凸起 + 品牌色辉光 + 顶部内高光 */
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
  transition: all 0.2s var(--ease);
}
.btn-primary:active {
  background: var(--brand-dark);
  box-shadow:
    0 4rpx 12rpx var(--brand-glow),
    inset 4rpx 4rpx 10rpx rgba(0, 0, 0, 0.15);
  transform: scale(0.97);
}

/* 师傅端主按钮使用蓝色渐变 */
.btn-primary-worker {
  background: var(--brand-worker-gradient);
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-worker-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
}

.btn-secondary {
  background: var(--canvas);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: var(--r-lg);
  font-size: 28rpx;
  font-weight: 600;
  font-family: var(--font-sans);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}
.btn-secondary:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.97);
}

/* 底部 CTA */
.btn-cta {
  width: 100%;
  background: var(--brand-gradient);
  border: none;
  border-radius: var(--r-pill);
  padding: 32rpx 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  font-family: var(--font-sans);
  box-shadow: 0 16rpx 48rpx var(--brand-glow), var(--neu-raised-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
}
.btn-cta:active {
  box-shadow: 0 8rpx 24rpx var(--brand-glow), var(--neu-inset);
  transform: scale(0.98);
}

/* ==================== Rim Light 工具类 ==================== */
/* 给任意元素添加左上边缘高光 */

.rim-light {
  position: relative;
}
.rim-light::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.30) 0%,
    rgba(255, 255, 255, 0.08) 30%,
    transparent 55%
  );
  pointer-events: none;
  z-index: 0;
}

/* ==================== 新拟态签名动效强化 ==================== */
/* 凸起↔凹陷切换是本风格的视觉签名（设计画布要求） */

/* 通用按压：凸起 → 凹陷 */
.press-neu:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset);
  transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
}

/* 服务卡片按压：整卡凹陷 + 图标圆凹陷 */
.press-service:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset-lg);
  transition: all 0.15s var(--ease);
}
.press-service:active .icon-circle {
  box-shadow: var(--neu-inset-sm);
}

/* ==================== 实时位置追踪组件（PRD v6.0，设计画布规范） ==================== */

/* 地图区 */
.tracking-map {
  width: 100%;
  height: 840rpx;
  border-radius: 0 0 var(--r-xl) var(--r-xl);
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, rgba(226, 232, 240, 0.9) 0%, rgba(208, 220, 235, 0.9) 100%);
  box-shadow: var(--neu-raised);
}

/* 地图浮动按钮 — Glass 圆形 */
.map-float-btn {
  position: absolute;
  top: 28rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-raised-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  z-index: 10;
}

/* 师傅位置标记 */
.map-marker-worker {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--brand-worker);
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 28rpx rgba(45, 108, 223, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

/* 目的地标记 */
.map-marker-dest {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--red, #C4533A);
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 28rpx rgba(196, 83, 58, 0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

/* 状态横幅 — Glass 胶囊悬浮在地图下沿 */
.tracking-status-bar {
  margin: -44rpx 40rpx 0;
  padding: 28rpx 36rpx;
  border-radius: var(--r-lg);
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(48rpx) saturate(170%);
  -webkit-backdrop-filter: blur(48rpx) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-raised), 0 16rpx 56rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 5;
}

.tracking-status-bar .status-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 脉冲指示点 */
.tracking-status-bar .status-title::before {
  content: "";
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand-worker);
  box-shadow: 0 0 0 8rpx rgba(45, 108, 223, 0.16);
  animation: pulse-dot 1.8s ease infinite;
}

.tracking-status-bar .status-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

/* 师傅信息卡 */
.tracking-worker-card {
  margin: 32rpx 40rpx 0;
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-raised), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), var(--shadow-card-ring), var(--shadow-card-worker);
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.tracking-worker-card .worker-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--bg);
  box-shadow: var(--neu-inset-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
}

.tracking-worker-card .action-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-worker);
  border: none;
}
.tracking-worker-card .action-circle:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

/* 服务进度时间线 */
.tracking-timeline {
  margin: 32rpx 40rpx 0;
  padding: 36rpx;
  border-radius: var(--r-lg);
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-raised), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), var(--shadow-card-ring), var(--shadow-card-worker);
}

.tracking-timeline .tl-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 20rpx 0;
  position: relative;
}

.tracking-timeline .tl-row:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 68rpx;
  width: 4rpx;
  height: calc(100% - 28rpx);
  background: var(--brand-worker-light);
}

.tracking-timeline .tl-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-worker-light);
  color: var(--brand-worker);
}

.tracking-timeline .tl-dot.done {
  background: var(--brand-worker);
  color: #fff;
}

.tracking-timeline .tl-dot.pending {
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset-sm);
}

.tracking-timeline .tl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.tracking-timeline .tl-time {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* 脉冲动画（位置追踪指示器专用） */
@keyframes pulse-dot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.35); opacity: 0.65; }
}

/* ==================== 师傅端位置上报页组件（设计画布规范） ==================== */

/* 顶部上报状态条 */
.location-report-bar {
  margin: 32rpx 40rpx 0;
  padding: 24rpx 32rpx;
  border-radius: var(--r-pill);
  background: rgba(45, 108, 223, 0.10);
  border: 1rpx solid rgba(45, 108, 223, 0.22);
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: var(--brand-worker);
  font-size: 26rpx;
  font-weight: 600;
}

.location-report-bar .pulse {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--brand-worker);
  box-shadow: 0 0 0 8rpx rgba(45, 108, 223, 0.18);
  animation: pulse-dot 1.6s ease infinite;
}

/* 当前位置信息卡 */
.location-info-card {
  margin: 32rpx 40rpx 0;
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-raised), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), var(--shadow-card-ring), var(--shadow-card-worker);
}

.location-info-card .loc-coord {
  font-family: var(--font-mono);
  font-size: 26rpx;
  color: var(--text-2);
  letter-spacing: -0.01em;
}

.location-info-card .loc-update {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* 操作按钮组 */
.location-actions {
  margin: 32rpx 40rpx 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.location-actions .btn-arrive {
  grid-column: span 2;
  height: 104rpx;
  border-radius: var(--r-pill);
  background: var(--brand-worker-gradient);
  color: #fff;
  border: none;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: var(--neu-raised), 0 12rpx 40rpx var(--brand-worker-glow), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
}
.location-actions .btn-arrive:active {
  box-shadow: 0 4rpx 12rpx var(--brand-worker-glow), inset 4rpx 4rpx 10rpx rgba(0, 0, 0, 0.15);
  transform: scale(0.97);
}

/* ==================== 筛选标签（设计画布规范） ==================== */
/* 未选中：新拟态凸起；选中：新拟态凹陷 + 品牌色 */

.chip-neu {
  padding: 16rpx 36rpx;
  border-radius: var(--r-pill);
  font-size: 27rpx;
  font-weight: 600;
  border: none;
  font-family: var(--font-sans);
  white-space: nowrap;
  transition: all 0.2s var(--ease);
  background: var(--bg);
  box-shadow: 6rpx 6rpx 16rpx var(--neu-dark), -6rpx -6rpx 16rpx var(--neu-light);
  color: var(--text-2);
}

.chip-neu.active {
  background: rgba(13, 148, 136, 0.15);
  box-shadow: inset 4rpx 4rpx 10rpx var(--neu-dark), inset -4rpx -4rpx 10rpx var(--neu-light);
  color: var(--brand);
}

.chip-neu:active {
  transform: scale(0.96);
}

/* 师傅端选中态使用蓝色 */
.chip-neu-worker.active {
  background: rgba(45, 108, 223, 0.15);
  color: var(--brand-worker);
}

/* ==================== AI 助手卡片 — 三种材质融合（设计画布视觉焦点） ==================== */

.ai-card {
  margin: 40rpx 48rpx 0;
  background:
    linear-gradient(135deg, rgba(13, 148, 136, 0.14), rgba(212, 148, 76, 0.10)),
    rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(48rpx) saturate(160%);
  -webkit-backdrop-filter: blur(48rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  border-radius: var(--r-xl);
  box-shadow: var(--neu-raised), 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
  padding: 36rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰性径向光晕 */
.ai-card::before {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 148, 136, 0.18), transparent 70%);
  z-index: 0;
}

/* WXSS 不支持通配符 *，枚举常见子元素 */
.ai-card > view,
.ai-card > text,
.ai-card > image {
  position: relative;
  z-index: 1;
}

/* ==================== 顶部导航栏（渐变 + 径向光斑 + 下部倒圆角）忠于 zjrnew ==================== */
/* 客户端：teal + 琥珀；师傅端页面内覆写为 蓝 + 鼠尾草绿 */

.nav-bar,
.back-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 36rpx;
  padding-top: calc(env(safe-area-inset-top) + 36rpx);
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
}

/* 师傅端导航栏（页面内使用 .nav-bar.worker 即可） */
.nav-bar.worker,
.back-bar.worker {
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212,148,76,.10) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(212,148,76,.04) 50%, rgba(45, 108, 223, 0.06) 100%);
}

.nav-icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: none;
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  cursor: pointer;
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.nav-icon-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}
.nav-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-spacer {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* 菜单列表：玻璃 + 新拟态 */
.menu-card {
  margin: 32rpx 40rpx 0;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  overflow: hidden;
  position: relative;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 36rpx;
  position: relative;
  cursor: pointer;
  transition: transform var(--dur-base) var(--ease), background 0.15s ease;
}
.menu-row:active {
  transform: scale(0.98);
  background: var(--fill);
}
.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--background);
  box-shadow: 4rpx 4rpx 8rpx var(--neu-dark), -4rpx -4rpx 8rpx var(--neu-light), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}
.menu-icon {
  width: 36rpx;
  height: 36rpx;
  color: var(--brand);
}
.menu-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.menu-sub {
  font-size: 24rpx;
  color: var(--text-2);
}
.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
.menu-hairline {
  height: 1rpx;
  background: var(--sep);
  margin: 0 36rpx;
}

/* 订单卡片 */
.order-card {
  margin: 24rpx 40rpx 0;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  cursor: pointer;
  transition: transform var(--dur-base) var(--ease), box-shadow 0.2s var(--ease);
  position: relative;
  overflow: hidden;
}
.order-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
}
.order-card:active {
  box-shadow: var(--neu-inset-lg);
  transform: scale(0.98);
}
.order-card > view,
.order-card > text,
.order-card > button,
.order-card > image {
  position: relative;
  z-index: 1;
}

/* 推荐师傅卡片 */
.recommend-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 0 48rpx 22rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(140%);
  -webkit-backdrop-filter: blur(32rpx) saturate(140%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  padding: 28rpx;
  cursor: pointer;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.recommend-card:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset);
}

/* 统计卡片 */
.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(32rpx) saturate(140%);
  -webkit-backdrop-filter: blur(32rpx) saturate(140%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 40rpx;
  box-shadow: var(--neu-raised-sm);
  padding: 28rpx 16rpx;
  text-align: center;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.stat-card:active {
  transform: scale(0.96);
  box-shadow: var(--neu-inset);
}

/* 底部汇总/操作栏（玻璃悬浮） */
.summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0 32rpx 32rpx;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: var(--r-lg);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40),
    0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.summary-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-2);
}
.summary-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  font-family: var(--font-number);
}

/* 玻璃筛选栏 */
.filter-tabs {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  margin: -36rpx 40rpx 0;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  position: relative;
  z-index: 10;
}
.filter-tabs::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
}
.filter-pill {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--r-sm);
  font-size: 27rpx;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: transform var(--dur-base) var(--spring), all 0.2s var(--ease);
  border: none;
  background: transparent;
  font-family: var(--font-body);
  position: relative;
  z-index: 1;
}
.filter-pill:active { transform: scale(0.94); }
.filter-pill:not(.active) {
  background: var(--background);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  color: var(--text-2);
}
.filter-pill.active {
  background: rgba(13, 148, 136, 0.15);
  box-shadow: inset 2rpx 2rpx 5rpx var(--neu-dark), inset -2rpx -2rpx 5rpx var(--neu-light);
  color: var(--brand);
}
.filter-tabs.worker .filter-pill.active {
  background: rgba(45, 108, 223, 0.15);
  color: var(--brand-worker);
}

/* 凹陷输入框（新拟态） */
.neu-input {
  background: var(--background);
  box-shadow: var(--neu-inset);
  border: none;
  border-radius: var(--r-md);
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: var(--text-1);
  font-family: var(--font-body);
  outline: none;
}
.neu-input::placeholder { color: var(--text-3); }
.neu-input:focus {
  box-shadow: var(--neu-inset), 0 0 0 4rpx var(--brand-subtle), 0 0 0 8rpx var(--brand-glow);
}

/* ============================================================ */
/* === 主样式规范的业务级组件（订单/营销/保障/交易/评价/AI/运营） === */
/* === 统一复用 design tokens，保持玻璃新拟态融合语言 ============ */
/* ============================================================ */

/* ==================== 订单状态标签（8 状态） ==================== */
.order-status-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 600;
  font-family: var(--font-body);
  background: var(--fill);
  color: var(--text-2);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.35);
  position: relative;
}
.order-status-tag::before {
  content: "";
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}
.order-status-pending   { color: var(--blue);   background: rgba(90, 143, 173, 0.10); }
.order-status-bidding   { color: var(--blue);   background: rgba(90, 143, 173, 0.10); }
.order-status-accepted  { color: var(--brand);  background: var(--brand-subtle); }
.order-status-departing { color: var(--brand);  background: var(--brand-subtle); }
.order-status-departing::before { animation: dotPulse 1.8s var(--ease) infinite; }
.order-status-arrived   { color: var(--green);  background: rgba(91, 140, 90, 0.10); }
.order-status-serving   { color: var(--accent);  background: rgba(212, 148, 76, 0.10); }
.order-status-completed { color: var(--orange); background: rgba(212, 148, 76, 0.10); }
.order-status-paid      { color: var(--brand);  background: var(--brand-subtle); }
.order-status-reviewed  { color: var(--text-3); background: var(--fill); }
.order-status-pending-review { color: var(--orange); background: rgba(212, 148, 76, 0.10); }
.order-status-canceled  { color: var(--text-3); background: var(--fill); }
.order-status-reviewing { color: var(--orange); background: rgba(212, 148, 76, 0.10); }
.order-status-reviewing-fee { color: var(--accent); background: rgba(212, 148, 76, 0.10); }
.order-status-expired { color: var(--text-3); background: var(--fill); }

/* 订单卡片左侧状态色条（增强状态识别） */
.order-card { position: relative; overflow: hidden; }
.order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  border-radius: 8rpx 0 0 8rpx;
  z-index: 1;
}
.order-card.status-pending::before   { background: var(--blue); }
.order-card.status-bidding::before   { background: var(--blue); }
.order-card.status-accepted::before  { background: var(--brand); }
.order-card.status-departing::before { background: var(--brand); }
.order-card.status-arrived::before   { background: var(--green); }
.order-card.status-serving::before   { background: var(--accent); }
.order-card.status-completed::before { background: var(--orange); }
.order-card.status-paid::before      { background: var(--brand); }
.order-card.status-reviewed::before  { background: var(--text-3); }
.order-card.status-pending-review::before { background: var(--orange); }
.order-card.status-canceled::before  { background: var(--text-3); }
.order-card.status-reviewing::before { background: var(--orange); }
.order-card.status-reviewing-fee::before { background: var(--accent); }
.order-card.status-expired::before   { background: var(--text-3); }
.order-card.status-reviewed { opacity: 0.92; }
.order-card.status-reviewed .order-title,
.order-card.status-reviewed .order-price { color: var(--text-2); }

/* ==================== 优惠券卡片（票据造型） ==================== */
.coupon-card-v2 {
  position: relative;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
  overflow: visible;
  margin: 0 40rpx 28rpx;
}
.coupon-v2-left {
  width: 184rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  position: relative;
  border-radius: var(--r-md) 0 0 var(--r-md);
}
.coupon-v2-amount {
  font-family: var(--font-number);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}
.coupon-v2-amount .cur { font-size: 28rpx; font-weight: 600; margin-right: 4rpx; }
.coupon-v2-threshold {
  font-size: 20rpx;
  font-weight: 600;
  opacity: 0.92;
  background: rgba(255, 255, 255, 0.20);
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  margin-top: 8rpx;
}
.coupon-v2-right {
  flex: 1;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.coupon-v2-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  line-height: 1.3;
}
.coupon-v2-desc {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.coupon-v2-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}
.coupon-v2-expiry {
  font-size: 22rpx;
  color: var(--text-3);
}
.coupon-v2-use-btn {
  align-self: flex-start;
  background: var(--brand);
  color: var(--text-inverse);
  border-radius: var(--r-pill);
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx var(--brand-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.25);
}
.coupon-card-v2.used,
.coupon-card-v2.expired { opacity: 0.72; filter: grayscale(0.4); }
.coupon-card-v2.used .coupon-v2-left,
.coupon-card-v2.expired .coupon-v2-left { background: linear-gradient(135deg, #B5ADA5, #8B8178); }
.coupon-v2-status-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  font-weight: 700;
  background: var(--fill);
  color: var(--text-3);
}

/* ==================== 家庭年卡（大套餐卡） ==================== */
.annual-card-v2 {
  position: relative;
  overflow: hidden;
  color: var(--text-inverse);
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 50%, var(--accent) 100%);
  border-radius: var(--r-lg);
  padding: 44rpx;
  box-shadow: var(--neu-raised), 0 16rpx 56rpx var(--brand-glow);
}
.annual-card-v2::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.18) 0%, transparent 55%);
  pointer-events: none;
}
.annual-v2-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.annual-v2-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.annual-v2-price {
  font-family: var(--font-number);
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1;
}
.annual-v2-price .cur { font-size: 28rpx; font-weight: 500; opacity: 0.85; margin-right: 4rpx; }
.annual-v2-benefits {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}
.annual-v2-benefit {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.annual-v2-benefit-ic {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.annual-v2-cta {
  margin-top: 36rpx;
  width: 100%;
  height: 88rpx;
  border-radius: var(--r-pill);
  border: none;
  background: rgba(255, 255, 255, 0.92);
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 700;
  font-family: var(--font-body);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.12);
  position: relative;
  z-index: 1;
}
.annual-v2-cta:active { transform: scale(0.96); }

/* ==================== 保险档位卡 ==================== */
.insurance-tier {
  flex: 1;
  padding: 36rpx 24rpx;
  border-radius: var(--r-md);
  text-align: center;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.50);
  box-shadow: var(--neu-raised-sm);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}
.insurance-tier:active { transform: scale(0.96); box-shadow: var(--neu-inset); }
.insurance-tier.active {
  background: var(--brand-subtle);
  border: 1rpx solid rgba(13, 148, 136, 0.25);
  box-shadow: var(--neu-inset), 0 0 0 3rpx var(--brand-glow);
}
.insurance-tier-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}
.insurance-tier-price {
  margin-top: 16rpx;
  font-family: var(--font-number);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand);
}
.insurance-tier-price .cur { font-size: 24rpx; color: var(--text-2); font-weight: 500; }
.insurance-tier-cover {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.4;
}

/* 理赔进度时间线 */
.claim-timeline {
  margin: 0 40rpx;
  padding: 36rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
}
.claim-timeline-item {
  display: flex;
  gap: 28rpx;
  padding: 20rpx 0;
  position: relative;
}
.claim-timeline-item:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 56rpx;
  bottom: -12rpx;
  width: 4rpx;
  background: var(--sep);
}
.claim-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
}
.claim-dot.pending {
  background: var(--bg-elevated);
  color: var(--text-3);
  box-shadow: var(--neu-inset);
}
.claim-timeline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.claim-timeline-desc {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 4rpx;
  line-height: 1.4;
}

/* ==================== 保证金等级卡 ==================== */
.deposit-level-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
}
.deposit-level {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: var(--text-inverse);
  flex-shrink: 0;
  font-size: 30rpx;
}
.deposit-level.l1 { background: linear-gradient(135deg, #B5ADA5, #DDD6CE); }
.deposit-level.l2 { background: linear-gradient(135deg, var(--accent), var(--accent-mid)); }
.deposit-level.l3 { background: linear-gradient(135deg, var(--brand), var(--brand-mid)); }
.deposit-level-info { flex: 1; }
.deposit-level-title { font-size: 30rpx; font-weight: 700; color: var(--text-1); }
.deposit-level-desc  { font-size: 24rpx; color: var(--text-2); margin-top: 4rpx; }
.deposit-level-amount {
  font-family: var(--font-number);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-top: 8rpx;
}

/* ==================== 报价卡片 ==================== */
.bid-card {
  margin: 0 40rpx 24rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
  position: relative;
  overflow: hidden;
}
.bid-card.recommended {
  box-shadow: var(--neu-raised-sm), 0 0 0 3rpx var(--brand-glow);
}
.bid-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.bid-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  flex-shrink: 0;
  font-size: 36rpx;
  font-weight: 700;
}
.bid-meta { flex: 1; }
.bid-name { font-size: 30rpx; font-weight: 700; color: var(--text-1); }
.bid-rating { font-size: 24rpx; color: var(--text-2); margin-top: 4rpx; }
.bid-rating-stars { color: var(--accent); letter-spacing: 2rpx; }
.bid-price {
  font-family: var(--font-number);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand);
  text-align: right;
}
.bid-price .cur { font-size: 24rpx; color: var(--text-2); font-weight: 500; margin-right: 2rpx; }
.bid-note {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--background);
  border-radius: var(--r-sm);
  box-shadow: var(--neu-inset);
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.5;
}
.bid-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 20rpx;
}
.bid-actions .btn-primary,
.bid-actions .btn-secondary { flex: 1; height: 72rpx; font-size: 26rpx; }

/* ==================== 支付方式卡片 ==================== */
.payment-method {
  margin: 0 40rpx 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}
.payment-method:active { transform: scale(0.98); box-shadow: var(--neu-inset); }
.payment-method.selected {
  box-shadow: var(--neu-inset), 0 0 0 3rpx var(--brand-glow);
}
.payment-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm);
  color: var(--brand);
  flex-shrink: 0;
}
.payment-info { flex: 1; }
.payment-name { font-size: 30rpx; font-weight: 700; color: var(--text-1); }
.payment-desc  { font-size: 24rpx; color: var(--text-2); margin-top: 4rpx; }
.payment-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid var(--text-3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s var(--ease);
}
.payment-method.selected .payment-check {
  background: var(--brand);
  border-color: var(--brand);
  color: var(--text-inverse);
}

/* ==================== AI 聊天消息气泡 ==================== */
.chat-bubble {
  max-width: 78%;
  padding: 24rpx 28rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  line-height: 1.55;
  position: relative;
  word-break: break-word;
  font-family: var(--font-body);
}
.chat-bubble.user {
  align-self: flex-end;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 100%);
  color: var(--text-inverse);
  border-bottom-right-radius: 8rpx;
  box-shadow: var(--neu-raised-sm), 0 8rpx 28rpx var(--brand-glow);
}
.chat-bubble.ai {
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  color: var(--text-1);
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--neu-raised-sm);
}
.chat-bubble.ai .price-highlight {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 20rpx;
  background: var(--brand-subtle);
  color: var(--brand);
  border-radius: var(--r-pill);
  font-family: var(--font-number);
  font-size: 30rpx;
  font-weight: 700;
}

/* AI 聊天输入栏 */
.chat-input-bar-v2 {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.60);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}
.chat-input-v2 {
  flex: 1;
  padding: 20rpx 28rpx;
  border-radius: var(--r-pill);
  border: none;
  background: var(--background);
  box-shadow: var(--neu-inset);
  font-size: 28rpx;
  color: var(--text-1);
}
.chat-send-btn-v2 {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--text-inverse);
  box-shadow: var(--neu-raised-sm), 0 8rpx 24rpx var(--brand-glow);
  display: flex;
  align-items: center;
  justify-content: center;
}
.chat-send-btn-v2:active { transform: scale(0.92); box-shadow: var(--neu-inset); }

/* ==================== 培训卡片与进度条 ==================== */
.training-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
  margin: 0 40rpx 24rpx;
}
.training-thumb {
  width: 160rpx;
  height: 112rpx;
  border-radius: var(--r-sm);
  background: linear-gradient(135deg, var(--brand-subtle), var(--accent-light));
  box-shadow: var(--neu-raised-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  flex-shrink: 0;
}
.training-info { flex: 1; }
.training-title { font-size: 30rpx; font-weight: 700; color: var(--text-1); }
.training-meta { font-size: 24rpx; color: var(--text-2); margin-top: 8rpx; }
.training-progress {
  margin-top: 16rpx;
  height: 12rpx;
  border-radius: var(--r-pill);
  background: var(--background);
  box-shadow: var(--neu-inset);
  overflow: hidden;
}
.training-progress-bar {
  height: 100%;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, var(--brand), var(--brand-mid));
  box-shadow: 0 0 16rpx var(--brand-glow);
}

/* 考试选项 */
.exam-option {
  margin: 0 40rpx 20rpx;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}
.exam-option:active { transform: scale(0.98); box-shadow: var(--neu-inset); }
.exam-option.correct { box-shadow: 0 0 0 3rpx rgba(91, 140, 90, 0.35), var(--neu-raised-sm); }
.exam-option.wrong   { box-shadow: 0 0 0 3rpx rgba(196, 83, 58, 0.35), var(--neu-raised-sm); }
.exam-option.selected { box-shadow: 0 0 0 3rpx var(--brand-glow), var(--neu-raised-sm); }

/* ==================== 客服工单卡片 ==================== */
.ticket-card {
  margin: 0 40rpx 24rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
}
.ticket-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ticket-id { font-size: 22rpx; color: var(--text-3); font-family: var(--font-number); }
.ticket-status {
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  font-weight: 700;
}
.ticket-status.open       { background: rgba(90, 143, 173, 0.10); color: var(--blue); }
.ticket-status.processing { background: var(--brand-subtle); color: var(--brand); }
.ticket-status.closed     { background: var(--fill); color: var(--text-3); }
.ticket-title { margin-top: 16rpx; font-size: 30rpx; font-weight: 700; color: var(--text-1); }
.ticket-preview { margin-top: 8rpx; font-size: 26rpx; color: var(--text-2); line-height: 1.5; }

/* ==================== 评价系统 ==================== */
.star-rating {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}
.star-rating .star {
  width: 56rpx;
  height: 56rpx;
  color: var(--text-3);
  transition: transform 0.15s var(--spring), color 0.15s var(--ease);
}
.star-rating .star.active { color: var(--accent); }
.star-rating .star:active { transform: scale(0.88); }

.review-tag {
  padding: 14rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  font-weight: 600;
  background: var(--bg-elevated);
  color: var(--text-2);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: all 0.2s var(--ease);
}
.review-tag:active { transform: scale(0.94); }
.review-tag.selected {
  background: var(--brand-subtle);
  color: var(--brand);
  box-shadow: var(--neu-inset), 0 0 0 1rpx rgba(13, 148, 136, 0.15);
}

.review-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.review-upload-slot {
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--r-sm);
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  font-size: 48rpx;
}
.review-upload-slot:active { transform: scale(0.94); }
.review-upload-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--r-sm);
  object-fit: cover;
  box-shadow: var(--neu-raised-sm);
}

/* ==================== 补差价卡 ==================== */
.extra-fee-card {
  margin: 0 40rpx 24rpx;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
  border-left: 8rpx solid var(--accent);
}
.extra-fee-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.extra-fee-label { font-size: 26rpx; color: var(--text-2); }
.extra-fee-amount {
  font-family: var(--font-number);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--accent);
}
.extra-fee-reason {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--background);
  border-radius: var(--r-sm);
  box-shadow: var(--neu-inset);
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.5;
}

/* ==================== 地理围栏异常 ==================== */
.geo-alert {
  margin: 0 40rpx 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  background: rgba(196, 83, 58, 0.08);
  border: 1rpx solid rgba(196, 83, 58, 0.18);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
}
.geo-alert-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--red);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.geo-alert-title { font-size: 28rpx; font-weight: 700; color: var(--red); }
.geo-alert-desc  { margin-top: 4rpx; font-size: 24rpx; color: var(--text-2); line-height: 1.5; }

/* ==================== 通用空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 64rpx;
  text-align: center;
}
.empty-state .empty-ic {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-inset-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  font-size: 80rpx;
  margin-bottom: 32rpx;
}
.empty-state .empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}
.empty-state .empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.empty-state .empty-action { margin-top: 36rpx; }

/* ==================== 骨架屏 shimmer ==================== */
.skeleton {
  background: linear-gradient(90deg, var(--bg-elevated) 0%, var(--background) 50%, var(--bg-elevated) 100%);
  background-size: 400rpx 100%;
  border-radius: var(--r-sm);
  animation: skeletonShimmer 1.4s ease infinite;
}
@keyframes skeletonShimmer {
  0%   { background-position: 400rpx 0; }
  100% { background-position: -400rpx 0; }
}

/* ==================== Glass Toast 轻提示 ==================== */
.glass-toast {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 192rpx;
  z-index: 200;
  padding: 20rpx 36rpx;
  background: rgba(44, 40, 36, 0.82);
  backdrop-filter: blur(32rpx) saturate(140%);
  -webkit-backdrop-filter: blur(32rpx) saturate(140%);
  border-radius: var(--r-pill);
  color: var(--text-inverse);
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.18);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
}
.glass-toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(-16rpx);
}

/* ==================== 登录授权页 ==================== */
.auth-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 128rpx;
  background: var(--background);
  position: relative;
  overflow: hidden;
}
.auth-logo {
  width: 192rpx;
  height: 192rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--accent) 100%);
  box-shadow: var(--neu-raised), 0 24rpx 72rpx var(--brand-glow);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-inverse);
  font-size: 80rpx;
  font-weight: 700;
}
.auth-title {
  margin-top: 48rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}
.auth-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.5;
}
.auth-btn {
  margin-top: 80rpx;
  width: 100%;
  max-width: 640rpx;
  height: 96rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 50%, var(--accent) 100%);
  color: var(--text-inverse);
  font-size: 32rpx;
  font-weight: 700;
  font-family: var(--font-body);
  box-shadow: var(--neu-raised), 0 16rpx 48rpx var(--brand-glow);
  transition: transform 0.2s var(--spring);
}
.auth-btn:active { transform: scale(0.96); box-shadow: var(--neu-inset); }
.auth-agreement {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.6;
}
.auth-agreement .link { color: var(--brand); }

/* ==================== 报价提交页（师傅端） ==================== */
.quote-input-card {
  margin: 0 40rpx 24rpx;
  padding: 36rpx;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised-sm);
}
.quote-input-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: var(--background);
  border-radius: var(--r-md);
  box-shadow: var(--neu-inset);
}
.quote-input-row .cur {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
}
.quote-input-row .amount {
  flex: 1;
  border: none;
  background: transparent;
  font-family: var(--font-number);
  font-size: 56rpx;
  font-weight: 700;
  color: var(--brand);
}

/* ==================== 动效关键帧 ==================== */
@keyframes dotPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(1.35); }
}

/* 师傅端专属覆写：订单/报价/保证金/工单等使用蓝绿品牌色 */
.bid-card.worker .bid-price,
.bid-card.worker .bid-name { color: var(--brand-worker); }
.bid-card.worker .bid-avatar { color: var(--brand-worker); }
.insurance-tier.worker.active {
  background: rgba(45, 108, 223, 0.10);
  border-color: rgba(45, 108, 223, 0.25);
  box-shadow: var(--neu-inset), 0 0 0 3rpx rgba(45, 108, 223, 0.28);
}
.insurance-tier.worker .insurance-tier-price { color: var(--brand-worker); }
.payment-method.worker.selected { box-shadow: var(--neu-inset), 0 0 0 3rpx rgba(45, 108, 223, 0.28); }
.bid-card.worker.recommended { box-shadow: var(--neu-raised-sm), 0 0 0 3rpx rgba(45, 108, 223, 0.28); }
