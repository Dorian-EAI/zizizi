<view class="phone-page design-detail-page" data-dom-id="page-client-order-cancel">
    <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● ◒ ▰</text></view>
    <view class="topbar"><view class="icon-button design-button" data-dom-id="order-cancel-back" data-route="/pages/order-detail-client/index" bindtap="onBack"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">取消订单</view><text class="tag-span"></text></view>
    <view class="page-body">
      <!-- 加载态 -->
      <block wx:if="{{loading}}">
        <view class="card">
          <view class="list-row">
            <view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20aria-hidden%3D%22true%22%3E%3Cpath%20d%3D%22M14.7%206.3a4%204%200%200%200-5-5L12%203.6%209.6%206%207.3%203.7a4%204%200%200%200%205%205L4%2017a2.1%202.1%200%200%200%203%203l8.3-8.3a4%204%200%200%200%205-5L18%209l-2.4-2.4L18%204.3a4%204%200%200%200-3.3%202Z%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view>
            <text class="row-main tag-span">
              <text class="row-title tag-b">加载中...</text>
              <text class="row-copy tag-small">正在获取订单信息</text>
            </text>
            <text class="row-value tag-span"></text>
          </view>
        </view>
      </block>

      <!-- 错误态 -->
      <block wx:elif="{{loadError}}">
        <view class="card">
          <view class="list-row" bindtap="onRetryLoad">
            <text class="row-icon tag-span">⚠️</text>
            <text class="row-main tag-span">
              <text class="row-title tag-b">加载失败</text>
              <text class="row-copy tag-small">{{errorMessage}} · 点击重试</text>
            </text>
            <text class="row-value tag-span"></text>
          </view>
        </view>
      </block>

      <!-- 空态 -->
      <block wx:elif="{{empty}}">
        <view class="card">
          <view class="list-row">
            <text class="row-icon tag-span">📭</text>
            <text class="row-main tag-span">
              <text class="row-title tag-b">未找到订单</text>
              <text class="row-copy tag-small">{{errorMessage || '订单可能已被删除'}}</text>
            </text>
            <text class="row-value tag-span"></text>
          </view>
        </view>
      </block>

      <!-- 订单信息 -->
      <block wx:else>
        <view class="card">
          <view class="list-row">
            <text class="row-icon tag-span">🔧</text>
            <text class="row-main tag-span">
              <text class="row-title tag-b">{{serviceName || '服务'}}</text>
              <text class="row-copy tag-small">订单号 {{orderNo}}{{orderStatusText ? ' · ' + orderStatusText : ''}}</text>
            </text>
            <text class="row-value tag-span"><text class="tag-b">¥{{amountText}}</text></text>
          </view>
        </view>

        <view class="section">
          <view class="section-title"><text class="tag-strong">请选择取消原因</text><text class="tag-span">单选</text></view>
          <view class="chips">
            <block wx:for="{{reasonOptions}}" wx:key="key">
              <view class="chip {{selectedReasonIndex === index ? 'active' : ''}} design-button"
                    data-dom-id="cancel-reason-{{item.key}}"
                    data-index="{{index}}"
                    bindtap="onSelectReason">{{item.label}}</view>
            </block>
          </view>
        </view>

        <view class="field">
          <text for="cancel-note" class="tag-label">补充说明（选填）</text>
          <textarea class="textarea"
                    id="cancel-note"
                    maxlength="300"
                    placeholder="请补充说明取消原因，便于我们改进服务"
                    value="{{note}}"
                    data-dom-id="cancel-note"
                    bindinput="onNoteInput"></textarea>
        </view>

        <view class="notice">
          <text class="tag-b">退款说明</text>
          <text class="design-br"></text>
          未开始服务将全额退款；已产生服务费用时按实际情况结算。退款原路返回，预计 1–3 个工作日到账。
        </view>
      </block>
    </view>

    <!-- 底部操作栏：加载/错误/空态时隐藏取消按钮 -->
    <view class="fixed-actions" wx:if="{{!loading && !loadError && !empty}}">
      <view class="btn secondary design-button" bindtap="onKeepOrder">{{cancelling ? '取消中...' : '暂不取消'}}</view>
      <view class="btn danger design-button" bindtap="onConfirmCancel">{{cancelling ? '提交中...' : '确认取消订单'}}</view>
    </view>
  </view>
