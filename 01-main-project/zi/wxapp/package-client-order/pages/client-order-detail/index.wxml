<view class="page">
  <view class="blob" style="top: -80rpx; right: -120rpx; width: 560rpx; height: 560rpx; background: var(--brand);"></view>
  <view class="blob" style="top: 480rpx; left: -160rpx; width: 480rpx; height: 480rpx; background: var(--accent);"></view>

  <scroll-view scroll-y class="page-scroll hide-scroll" style="padding-bottom: 220rpx;">
    <view class="hero" style="padding-top: calc({{statusBarHeight}}px + 76rpx);">
      <view class="nav-row">
        <view class="nav-icon-btn" bindtap="onBack">
          <image src="{{icons.back}}" mode="aspectFit" class="nav-icon" lazy-load="{{false}}" />
        </view>
        <text class="nav-title">订单详情</text>
        <view class="nav-spacer"></view>
      </view>

      <view class="status-banner status-{{order.status}}">
        <view class="status-icon-wrap">
          <text class="status-icon">{{statusIcon}}</text>
        </view>
        <view class="status-info">
          <text class="status-text">{{statusText}}</text>
          <text class="status-desc">{{statusDesc}}</text>
        </view>
        <view wx:if="{{order.status === 'pending'}}" class="status-action" bindtap="onCancel">
          <text class="status-action-text">取消</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="glass-card">
        <view class="timeline">
          <view class="timeline-item {{order.statusIndex >= 1 ? 'done' : ''}}">
            <view class="timeline-dot"></view>
            <text class="timeline-label">订单已提交</text>
            <text class="timeline-time">{{order.createdAt}}</text>
          </view>
          <view class="timeline-item {{order.statusIndex >= 2 ? 'done' : ''}}">
            <view class="timeline-dot"></view>
            <text class="timeline-label">师傅已接单</text>
            <text class="timeline-time">{{order.acceptedAt}}</text>
          </view>
          <view class="timeline-item {{order.statusIndex >= 3 ? 'done' : ''}}">
            <view class="timeline-dot"></view>
            <text class="timeline-label">师傅已到达</text>
            <text class="timeline-time">{{order.arrivedAt}}</text>
          </view>
          <view class="timeline-item {{order.statusIndex >= 4 ? 'done' : ''}}">
            <view class="timeline-dot"></view>
            <text class="timeline-label">服务完成</text>
            <text class="timeline-time">{{order.completedAt || '--'}}</text>
          </view>
        </view>
      </view>
      <view class="glass-card worker-info" bindtap="onChat">
        <view class="worker-info-row">
          <view class="mini-avatar">
            <image src="{{order.workerAvatar}}" mode="aspectFill" class="avatar-img" lazy-load="{{false}}" />
          </view>
          <view class="worker-info-detail">
            <text class="worker-name">{{order.workerName}}</text>
            <view class="rating-mini">
              <text class="star-icon">★</text>
              <text class="rating-score">{{order.workerRating}}</text>
              <text class="rating-count">({{order.orderCount}}单)</text>
            </view>
          </view>
          <view class="chat-btn" catchtap="onChat">
            <text class="chat-icon">💬</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title-row">
        <text class="section-title-text">服务信息</text>
      </view>
      <view class="glass-card">
        <view class="info-row">
          <text class="info-label">服务类型</text>
          <text class="info-value">{{order.serviceType}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">服务时间</text>
          <text class="info-value">{{order.serviceTime}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">服务地址</text>
          <text class="info-value">{{order.address}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">备注</text>
          <text class="info-value">{{order.remark || '无'}}</text>
        </view>
      </view>

      <view class="section-title-row">
        <text class="section-title-text">费用明细</text>
      </view>
      <view class="glass-card">
        <view class="info-row">
          <text class="info-label">服务费</text>
          <text class="info-value">¥{{order.serviceFee}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">上门费</text>
          <text class="info-value">¥{{order.deliveryFee}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">优惠券</text>
          <text class="info-value discount">-¥{{order.discount}}</text>
        </view>
        <view class="info-row total-row">
          <text class="info-label">合计</text>
          <text class="info-value total">¥{{order.total}}</text>
        </view>
      </view>
      <view class="glass-card">
        <view class="info-row">
          <text class="info-label">订单编号</text>
          <text class="info-value mono">{{order.orderNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">支付方式</text>
          <text class="info-value">{{order.payMethod}}</text>
        </view>
      </view>
      <view wx:if="{{order.status === 'completed'}}" class="glass-card" bindtap="onComment">
        <view class="comment-entry">
          <view class="comment-icon-wrap">
            <text class="comment-icon">✏️</text>
          </view>
          <view class="comment-info">
            <text class="comment-title">{{order.commented ? '已评价' : '去评价'}}</text>
            <text class="comment-desc">{{order.commented ? '感谢您的评价' : '您的评价将帮助我们提供更好的服务'}}</text>
          </view>
          <view class="comment-arrow">
            <text class="arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="cta-bar safe-bottom">
    <block wx:if="{{order.status === 'pending'}}">
      <view class="btn-secondary" bindtap="onCancel">取消订单</view>
      <view class="btn-cta" bindtap="onPay">立即支付</view>
    </block>
    <block wx:elif="{{order.status === 'paid'}}">
      <view class="btn-cta" bindtap="onContactWorker">联系师傅</view>
    </block>
    <block wx:elif="{{order.status === 'completed'}}">
      <view class="btn-secondary" bindtap="onRebook">再次预约</view>
      <view class="btn-cta" bindtap="onComment">评价订单</view>
    </block>
  </view>
</view>
