/* pages/client-order-comment/index.wxss — 订单评价 */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
  --brand: #0D9488;
  --brand-dark: #0A7A70;
  --brand-mid: #14B8A6;
  --brand-light: #CCFBF1;
  --brand-glow: rgba(13, 148, 136, 0.28);
  --brand-subtle: rgba(13, 148, 136, 0.08);
  --brand-gradient: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  z-index: 0;
  pointer-events: none;
  opacity: 0.12;
}

.hero {
  padding: 0 48rpx 48rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nav-icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.nav-icon-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.94);
}

.nav-icon { width: 40rpx; height: 40rpx; }

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-spacer { width: 88rpx; height: 88rpx; }

.section {
  padding: 0 40rpx;
  margin-bottom: 32rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.glass-card {
  position: relative;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  pointer-events: none;
  z-index: 0;
}

.glass-card > view, .glass-card > text { position: relative; z-index: 1; }

.worker-card { text-align: center; }

.worker-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg);
  box-shadow: var(--neu-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img { width: 100%; height: 100%; }

.worker-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}

.rating-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rating-stars {
  color: var(--accent);
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.rating-score {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

.order-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.order-info-row:last-child { border-bottom: none; }

.order-info-label {
  font-size: 28rpx;
  color: var(--text-2);
}

.order-info-value {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.order-info-value.price {
  color: var(--accent);
  font-weight: 700;
  font-size: 32rpx;
}

.rating-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.rating-section:last-child { border-bottom: none; }

.rating-question {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.star-rating { display: flex; gap: 12rpx; }

.star {
  font-size: 48rpx;
  color: var(--text-3);
  transition: transform 0.15s ease, color 0.15s ease;
}
.star.active { color: var(--accent); }
.star:active { transform: scale(1.2); }

.neu-textarea {
  width: 100%;
  min-height: 240rpx;
  background: var(--bg);
  box-shadow: var(--neu-inset);
  border: none;
  border-radius: var(--r-md);
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.55;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

.upload-row {
  margin-top: 24rpx;
}

.upload-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: var(--bg);
  box-shadow: var(--neu-raised-sm);
  border-radius: var(--r-md);
  align-self: flex-start;
}

.upload-icon { font-size: 32rpx; }
.upload-text { font-size: 26rpx; color: var(--text-2); }

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 40rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.btn-cta {
  width: 100%;
  background: var(--brand-gradient);
  color: #fff;
  border: none;
  height: 96rpx;
  border-radius: var(--r-pill);
  font-size: 32rpx;
  font-weight: 700;
  box-shadow:
    var(--neu-raised),
    0 12rpx 40rpx var(--brand-glow),
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.40);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}
.btn-cta:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset), 0 4rpx 12rpx var(--brand-glow);
}
