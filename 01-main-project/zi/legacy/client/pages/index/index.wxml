<view class="page">
  <!-- ===== SCROLL TITLE BAR（滚动时显示） ===== -->
  <view class="title-bar {{navScrolled ? 'visible' : ''}}">
    <view class="title-bar__search">
      <image class="title-bar-icon" src="/assets/svg/search.svg" mode="aspectFit" />
      <text class="title-bar-placeholder">搜索维修服务、师傅</text>
    </view>
  </view>

  <!-- ===== HERO（渐变区域） ===== -->
  <view class="hero">
    <!-- 问候语 -->
    <view class="hero-greeting-wrap">
      <text class="hero-greeting">晚上好，{{user.nickname || '用户'}} 👋</text>
      <text class="hero-greeting-sub">专业维修，随叫随到</text>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar" bindtap="onSearch">
      <image class="search-icon" src="/assets/svg/search.svg" mode="aspectFit" />
      <text class="search-placeholder">搜索维修服务、师傅</text>
    </view>

    <!-- 热门标签横向滚动 -->
    <scroll-view class="hot-tags" scroll-x enable-flex>
      <view class="hot-tag" wx:for="{{hotTags}}" wx:key="key" bindtap="onHotTag" data-key="{{item.key}}">
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 统计卡片 3列 -->
    <view class="stats-row">
      <view class="stats-item" bindtap="goOrders">
        <text class="stats-num">4<span class="unit">单</span></text>
        <text class="stats-label">进行中订单</text>
      </view>
      <view class="stats-item" bindtap="goFavorites">
        <text class="stats-num">12<span class="unit">位</span></text>
        <text class="stats-label">收藏师傅</text>
      </view>
      <view class="stats-item" bindtap="goCoupons">
        <text class="stats-num">3<span class="unit">张</span></text>
        <text class="stats-label">可用优惠券</text>
      </view>
    </view>
  </view>

  <!-- ===== 快捷服务 4x2 网格 ===== -->
  <view class="section-header">
    <text class="section-title">快捷服务</text>
  </view>
  <view class="services-grid-4col">
    <view class="service-item" wx:for="{{services}}" wx:key="key"
          bindtap="goService" data-key="{{item.key}}">
      <view class="icon-circle">
        <image class="icon-svg" src="{{item.icon_svg}}" mode="aspectFit" />
      </view>
      <text class="service-name">{{item.name}}</text>
    </view>
  </view>

  <!-- ===== 筛选分类 Chips ===== -->
  <view class="filter-tabs">
    <view class="filter-pill {{activeCategory === item.key ? 'active' : ''}}"
          wx:for="{{categories}}" wx:key="key"
          bindtap="onCategoryTap" data-key="{{item.key}}">
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- ===== AI 智能助手卡片 ===== -->
  <view class="ai-card" bindtap="onAI">
    <view class="ai-icon">
      <image class="ai-svg" src="/assets/svg/bot.svg" mode="aspectFit" />
    </view>
    <view class="ai-text">
      <text class="ai-title">AI 智能助手</text>
      <text class="ai-desc">描述问题，智能匹配最优方案</text>
    </view>
    <view class="btn-neu-primary rec-btn" catchtap="onAI">去问问</view>
  </view>

  <!-- ===== 推荐师傅 ===== -->
  <view class="section-header">
    <text class="section-title">推荐师傅</text>
    <view class="section-more" bindtap="goMasterList">更多 ›</view>
  </view>
  <view class="master-list">
    <view class="recommend-card" wx:for="{{masters}}" wx:key="id"
          bindtap="goMaster" data-id="{{item.id}}">
      <view class="avatar">
        <image class="avatar-svg" src="/assets/svg/user.svg" mode="aspectFit" />
      </view>
      <view class="recommend-info">
        <text class="recommend-name">{{item.name}}</text>
        <text class="recommend-sub">{{item.subtitle}}</text>
      </view>
      <view class="recommend-right">
        <text class="recommend-price">¥{{item.price}}起</text>
        <view class="rating-row">
          <text class="star-icon">★</text>
          <text class="rating-num">{{item.rating || '4.9'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 推荐服务 ===== -->
  <view class="section-header">
    <text class="section-title">推荐服务</text>
  </view>
  <scroll-view class="rec-scroll" scroll-x enable-flex>
    <view class="rec-card" wx:for="{{recServices}}" wx:key="id"
          bindtap="goService" data-key="{{item.key}}">
      <view class="rec-img" style="background:{{item.color}};">
        <text class="rec-img-label">{{item.label}}</text>
      </view>
      <text class="rec-title">{{item.title}}</text>
      <view class="rec-meta">
        <view class="rec-star">
          <text class="star-icon">★</text>
          <text>{{item.rating}}</text>
        </view>
        <text class="rec-count">· {{item.count}}次服务</text>
      </view>
      <view class="rec-bottom">
        <view class="rec-price">
          <text class="currency">¥</text>
          <text class="amount">{{item.price}}</text>
        </view>
        <view class="btn-neu-primary rec-btn" catchtap="goService" data-key="{{item.key}}">预约</view>
      </view>
    </view>
  </scroll-view>

  <!-- Bottom padding for tabbar -->
  <view class="tabbar-placeholder"></view>

  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab-item tab-item-active">
      <view class="tab-item-active-bg"></view>
      <text class="tab-icon tab-icon-active">🏠</text>
      <text class="tab-label tab-label-active">首页</text>
    </view>
    <view class="tab-item" bindtap="goPublish">
      <text class="tab-icon">＋</text>
      <text class="tab-label">发布</text>
    </view>
    <view class="tab-item" bindtap="goOrders">
      <text class="tab-icon">📋</text>
      <text class="tab-label">订单</text>
    </view>
    <view class="tab-item" bindtap="goMine">
      <text class="tab-icon">👤</text>
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>
