.container { background: #f5f6fa; min-height: 100vh; padding-bottom: 40rpx; }

.section { padding: 20rpx; }
.section-title { display: flex; align-items: center; padding: 10rpx 8rpx 20rpx; }
.st-icon { font-size: 32rpx; margin-right: 12rpx; }
.st-text { font-size: 30rpx; font-weight: 700; color: #333; }

.my-scroll { white-space: nowrap; }
.my-card-wrap { display: inline-block; margin-right: 20rpx; vertical-align: top; }
.my-card-wrap:last-child { margin-right: 0; }
.my-card { width: 520rpx; background: linear-gradient(135deg, #004080 0%, #0066cc 50%, #3385ff 100%); border-radius: 20rpx; padding: 36rpx 32rpx; color: #fff; box-shadow: 0 8rpx 24rpx rgba(0,64,128,0.2); }
.mc-header { display: flex; justify-content: space-between; align-items: center; }
.mc-name { font-size: 34rpx; font-weight: 700; }
.mc-tag { font-size: 22rpx; padding: 6rpx 16rpx; background: rgba(255,255,255,0.25); border-radius: 20rpx; }
.mc-body { padding: 40rpx 0; }
.mc-stat { display: flex; flex-direction: column; }
.mc-num { font-size: 72rpx; font-weight: 800; line-height: 1; }
.mc-label { font-size: 24rpx; opacity: 0.85; margin-top: 10rpx; }
.mc-footer { font-size: 24rpx; opacity: 0.9; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,0.2); }

.empty-my { background: #fff; border-radius: 16rpx; padding: 60rpx 40rpx; text-align: center; }
.empty-my-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-my-text { font-size: 26rpx; color: #888; line-height: 1.5; }

.tpl-list { display: flex; flex-direction: column; gap: 20rpx; }
.tpl-card { background: #fff; border-radius: 20rpx; padding: 36rpx 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.tpl-header { display: flex; justify-content: space-between; align-items: flex-end; }
.tpl-name { font-size: 34rpx; font-weight: 700; color: #333; }
.tpl-price { color: #e64340; display: flex; align-items: baseline; }
.tpl-symbol { font-size: 26rpx; font-weight: 600; }
.tpl-price .tpl-symbol + text { font-size: 48rpx; font-weight: 800; }
.tpl-unit { font-size: 24rpx; color: #999; margin-left: 4rpx; }
.tpl-times { display: flex; align-items: baseline; margin-top: 20rpx; }
.tpl-times-num { font-size: 36rpx; font-weight: 700; color: #004080; }
.tpl-times-label { font-size: 24rpx; color: #666; margin-left: 8rpx; }
.tpl-benefits { margin-top: 24rpx; background: #f8faff; border-radius: 12rpx; padding: 20rpx 24rpx; }
.benefit-item { display: flex; align-items: flex-start; padding: 8rpx 0; }
.b-check { color: #07c160; font-weight: 700; margin-right: 12rpx; font-size: 26rpx; }
.b-text { font-size: 26rpx; color: #555; line-height: 1.4; }
.tpl-btn { margin-top: 32rpx; text-align: center; padding: 24rpx 0; background: #004080; color: #fff; border-radius: 40rpx; font-size: 30rpx; font-weight: 600; }

.empty-tpl { background: #fff; border-radius: 16rpx; padding: 60rpx 40rpx; text-align: center; color: #999; font-size: 26rpx; }
