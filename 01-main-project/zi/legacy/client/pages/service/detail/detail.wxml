<view class="page">
  <!-- TOP NAV -->
  <view class="nav-bar">
    <view class="nav-btn" bindtap="onBack">
      <text class="nav-icon">‹</text>
    </view>
    <view class="nav-title">服务详情</view>
    <view class="nav-btn" bindtap="onToggleFav">
      <text class="nav-icon {{isFav ? 'nav-icon-fav' : ''}}">{{isFav ? '♥' : '♡'}}</text>
    </view>
  </view>

  <!-- SERVICE HERO -->
  <view class="service-hero">
    <view class="hero-deco hero-deco-1"></view>
    <view class="hero-deco hero-deco-2"></view>
    <view class="hero-deco hero-deco-3"></view>
    <view class="hero-watermark">💧</view>
    <view class="hero-content">
      <view class="hero-tag">官方认证服务</view>
      <view class="service-name">{{service.name || '防水维修'}}</view>
      <view class="service-meta">
        <text class="meta-star">★ {{service.rating || '4.9'}}</text>
        <text class="meta-dot">·</text>
        <text>{{service.service_count || '128'}}次服务</text>
        <text class="meta-dot">·</text>
        <text>3分钟响应</text>
      </view>
    </view>
  </view>

  <!-- PRICE CARD -->
  <view class="section">
    <view class="glass-neu-card price-card">
      <view class="card-title">
        <view class="title-bar"></view>
        <text>服务报价</text>
      </view>
      <view class="price-list">
        <view class="price-row {{selectedPrice === 0 ? 'price-row-selected' : ''}}" bindtap="pickPrice" data-index="0">
          <view class="price-left">
            <view class="price-icon {{selectedPrice === 0 ? 'price-icon-selected' : ''}}">
              <text class="price-icon-text">💧</text>
            </view>
            <view class="price-info">
              <view class="price-name">基础维修</view>
              <view class="price-desc">小面积渗漏修补</view>
            </view>
          </view>
          <view class="price-right">
            <view class="price-value"><text class="cur">¥</text><text class="amt">128</text></view>
            <view class="price-radio {{selectedPrice === 0 ? 'price-radio-selected' : ''}}">
              <text wx:if="{{selectedPrice === 0}}" class="price-check">✓</text>
            </view>
          </view>
        </view>

        <view class="price-row {{selectedPrice === 1 ? 'price-row-selected' : ''}}" bindtap="pickPrice" data-index="1">
          <view class="price-left">
            <view class="price-icon {{selectedPrice === 1 ? 'price-icon-selected' : ''}}">
              <text class="price-icon-text">🔧</text>
            </view>
            <view class="price-info">
              <view class="price-name">标准维修</view>
              <view class="price-desc">中等面积渗漏治理</view>
            </view>
          </view>
          <view class="price-right">
            <view class="price-value"><text class="cur">¥</text><text class="amt">268</text></view>
            <view class="price-radio {{selectedPrice === 1 ? 'price-radio-selected' : ''}}">
              <text wx:if="{{selectedPrice === 1}}" class="price-check">✓</text>
            </view>
          </view>
        </view>

        <view class="price-row {{selectedPrice === 2 ? 'price-row-selected' : ''}}" bindtap="pickPrice" data-index="2">
          <view class="price-left">
            <view class="price-icon {{selectedPrice === 2 ? 'price-icon-selected' : ''}}">
              <text class="price-icon-text">🛡</text>
            </view>
            <view class="price-info">
              <view class="price-name">全面维修</view>
              <view class="price-desc">大面积防水层重做</view>
            </view>
          </view>
          <view class="price-right">
            <view class="price-value"><text class="cur">¥</text><text class="amt">468</text></view>
            <view class="price-radio {{selectedPrice === 2 ? 'price-radio-selected' : ''}}">
              <text wx:if="{{selectedPrice === 2}}" class="price-check">✓</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- CONTENT CARD -->
  <view class="section">
    <view class="glass-neu-card content-card">
      <view class="card-title">
        <view class="title-bar"></view>
        <text>服务内容</text>
      </view>
      <view class="content-list">
        <view class="content-item">
          <view class="check-icon"><text class="check-text">✓</text></view>
          <text class="step-text">现场勘查</text>
          <text class="step-arrow">›</text>
        </view>
        <view class="content-item">
          <view class="check-icon"><text class="check-text">✓</text></view>
          <text class="step-text">方案制定</text>
          <text class="step-arrow">›</text>
        </view>
        <view class="content-item">
          <view class="check-icon"><text class="check-text">✓</text></view>
          <text class="step-text">施工维修</text>
          <text class="step-arrow">›</text>
        </view>
        <view class="content-item">
          <view class="check-icon"><text class="check-text">✓</text></view>
          <text class="step-text">验收保洁</text>
          <text class="step-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- RECOMMENDED MASTERS -->
  <view class="section">
    <view class="section-title">
      <text>推荐师傅</text>
      <text class="more" bindtap="goAllMasters">查看全部 ›</text>
    </view>
    <scroll-view scroll-x class="master-scroll" enhanced show-scrollbar="{{false}}">
      <view class="master-card" wx:for="{{masters}}" wx:key="id">
        <view class="master-avatar">
          <view class="avatar-inner {{index === 1 ? 'avatar-amber' : ''}}">{{item.name[0]}}</view>
        </view>
        <view class="master-name">{{item.name}}</view>
        <view class="master-stats"><text class="star">★ {{item.rating}}</text> · {{item.services}}次服务</view>
        <view class="btn-neu-primary master-book" bindtap="bookMaster" data-id="{{item.id}}">预约</view>
      </view>
    </scroll-view>
  </view>

  <!-- USER REVIEWS -->
  <view class="section">
    <view class="section-title">
      <text>用户评价</text>
      <text class="more" bindtap="goAllReviews">查看全部 ›</text>
    </view>
    <view class="review-list">
      <view class="glass-neu-card review-card" wx:for="{{reviews}}" wx:key="id">
        <view class="review-head">
          <view class="review-avatar">
            <view class="avatar-inner {{index === 1 ? 'avatar-amber' : ''}}">{{item.name[0]}}</view>
          </view>
          <view class="review-info">
            <view class="review-name">{{item.name}}</view>
            <view class="review-stars">★★★★★</view>
          </view>
          <view class="review-date">{{item.date}}</view>
        </view>
        <view class="review-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <view class="cta-spacer"></view>

  <!-- BOTTOM CTA BAR -->
  <view class="cta-bar">
    <view class="cta-icon-btn" bindtap="onService">
      <text class="cta-icon">💬</text>
    </view>
    <view class="cta-icon-btn" bindtap="onToggleFav">
      <text class="cta-icon {{isFav ? 'cta-icon-fav' : ''}}">{{isFav ? '♥' : '♡'}}</text>
    </view>
    <view class="cta-primary" bindtap="onBookNow">立即预约</view>
  </view>
</view>
