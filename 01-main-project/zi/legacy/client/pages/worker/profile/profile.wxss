/* ===== Worker Profile - Glass Neumorphic ===== */
page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --accent: #D4944C;
  --bg: #F2EDE8;
  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;
  --text-1: #2C2824;
  --text-2: #8B8178;
  --text-3: #B5ADA5;
  --green: #5B8C5A;
  --red: #C4533A;
  --blue: #5A8FAD;
  --orange: #D4944C;
  --sep: rgba(44, 40, 36, 0.06);
  --r: 24rpx;
  --r-lg: 32rpx;
  --r-sm: 16rpx;
  --r-pill: 9999rpx;
  background: var(--bg);
  min-height: 100vh;
}

.page {
  padding-bottom: 200rpx;
}

/* ===== Hero ===== */
.hero {
  padding: 76rpx 48rpx 112rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 25% 40%, rgba(143, 169, 152, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 80% 80%, rgba(45, 108, 223, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.28) 0%, rgba(143, 169, 152, 0.20) 50%, rgba(45, 108, 223, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

/* Profile Row */
.profile-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  z-index: 2;
}

.avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  background: var(--bg);
}

.avatar.avatar-glass {
  background: linear-gradient(145deg,
    rgba(255, 255, 255, 0.68) 0%,
    rgba(255, 255, 255, 0.28) 40%,
    var(--brand-subtle) 78%,
    rgba(255, 255, 255, 0.18) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow:
    inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04),
    10rpx 10rpx 24rpx var(--neu-dark),
    -10rpx -10rpx 24rpx var(--neu-light);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar .icon-svg {
  width: 52rpx;
  height: 52rpx;
  color: var(--brand);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

/* Verify badge */
.verify-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.45);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  line-height: 1.4;
  letter-spacing: 0.01em;
}

.verify-badge .icon-svg {
  width: 22rpx;
  height: 22rpx;
  color: var(--brand);
}

/* Edit Button */
.edit-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.50);
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  color: var(--brand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow:
    10rpx 10rpx 24rpx var(--neu-dark),
    -10rpx -10rpx 24rpx var(--neu-light),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
}

.edit-btn .icon-svg {
  width: 30rpx;
  height: 30rpx;
  color: var(--brand);
}

/* Rating Row */
.rating-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  position: relative;
  z-index: 2;
}

.rating-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 600;
}

.rating-chip .icon-svg {
  width: 28rpx;
  height: 28rpx;
  color: var(--orange);
}

.rating-divider {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--text-3);
  flex-shrink: 0;
}

.service-count {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* Stats Card */
.stats-card {
  position: relative;
  z-index: 10;
  margin: -48rpx 48rpx 0;
  padding: 40rpx 24rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    20rpx 20rpx 48rpx var(--neu-dark),
    -20rpx -20rpx 48rpx var(--neu-light),
    0 20rpx 72rpx rgba(0, 0, 0, 0.08),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  display: flex;
  align-items: center;
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  padding: 0 16rpx;
}

.stat-col:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: var(--sep);
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.5rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.stat-num.brand {
  color: var(--brand);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* Section + Card */
.section {
  padding: 0 48rpx;
  margin-top: 36rpx;
  position: relative;
  z-index: 5;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin: 0 8rpx 20rpx;
  letter-spacing: -0.02em;
}

.card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow:
    16rpx 16rpx 36rpx var(--neu-dark),
    -16rpx -16rpx 36rpx var(--neu-light),
    0 12rpx 48rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  overflow: hidden;
  position: relative;
}

.card-gloss {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, transparent 100%);
  pointer-events: none;
}

/* Menu Card */
.menu-card {
  overflow: hidden;
  padding: 8rpx 0;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 36rpx;
  position: relative;
  z-index: 1;
}

.menu-row:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 128rpx;
  right: 36rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--sep);
}

/* Menu Icons */
.menu-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg);
  box-shadow:
    8rpx 8rpx 16rpx var(--neu-dark),
    -8rpx -8rpx 16rpx var(--neu-light),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}

.menu-icon .icon-svg {
  width: 36rpx;
  height: 36rpx;
}

.menu-icon-teal {
  color: var(--brand);
}

.menu-icon-blue {
  color: var(--blue);
}

.menu-icon-amber {
  color: var(--orange);
}

.menu-icon-purple {
  color: var(--brand);
}

.menu-icon-gray {
  color: var(--text-2);
}

.menu-icon-green {
  color: var(--green);
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: -0.01em;
}

.menu-value {
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 500;
  margin-right: 4rpx;
  text-align: right;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-value.green {
  color: var(--green);
  font-weight: 600;
}

.menu-chevron {
  flex-shrink: 0;
}

.menu-chevron .icon-svg {
  width: 28rpx;
  height: 28rpx;
  color: var(--text-3);
}

/* ===== Icon SVG Placeholders ===== */
.icon-svg {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}

.svg-home {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.svg-home::before {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 20rpx solid currentColor;
  top: 0;
  left: 0;
}

.svg-home::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  bottom: 0;
  left: 4rpx;
}

.svg-orders {
  width: 28rpx;
  height: 32rpx;
  position: relative;
  border: 3rpx solid currentColor;
  border-radius: 2rpx;
}

.svg-orders::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 4rpx;
  right: 4rpx;
  height: 3rpx;
  background: currentColor;
}

.svg-orders::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 4rpx;
  right: 4rpx;
  height: 3rpx;
  background: currentColor;
}

.svg-wallet {
  width: 32rpx;
  height: 26rpx;
  position: relative;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.svg-wallet::before {
  content: '';
  position: absolute;
  right: -2rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.svg-user {
  width: 28rpx;
  height: 32rpx;
  position: relative;
}

.svg-user::before {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  top: 0;
  left: 6rpx;
}

.svg-user::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 12rpx 12rpx 0 0;
  bottom: 0;
  left: 2rpx;
}

.svg-user-lg {
  width: 52rpx;
  height: 52rpx;
  color: var(--brand);
}

.svg-check {
  width: 22rpx;
  height: 22rpx;
  position: relative;
}

.svg-check::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 10rpx;
  width: 8rpx;
  height: 4rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

.svg-edit {
  width: 30rpx;
  height: 30rpx;
  position: relative;
  color: var(--brand);
}

.svg-edit::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 16rpx;
  height: 3rpx;
  background: currentColor;
  transform: rotate(-45deg);
}

.svg-star {
  width: 28rpx;
  height: 28rpx;
  background: currentColor;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.svg-star-outline {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  color: var(--brand);
}

.svg-star-outline::before {
  content: '';
  position: absolute;
  inset: 0;
  background: currentColor;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  opacity: 0.9;
}

.svg-chevron-right {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  color: var(--text-3);
}

.svg-chevron-right::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 10rpx;
  height: 10rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.svg-wrench {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.svg-wrench::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.svg-wrench::after {
  content: '';
  position: absolute;
  left: 14rpx;
  bottom: 2rpx;
  width: 3rpx;
  height: 14rpx;
  background: currentColor;
  transform: rotate(45deg);
}

.svg-clock {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.svg-clock::before {
  content: '';
  position: absolute;
  inset: 2rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.svg-clock::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 3rpx;
  height: 10rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.svg-location {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.svg-location::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 20rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 10rpx 10rpx 10rpx 0;
  transform: translateX(-50%) rotate(-45deg);
}

.svg-location::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  transform: translateX(-50%);
}

.svg-shield-check {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.svg-shield-check::before {
  content: '';
  position: absolute;
  inset: 2rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx 4rpx 50% 50%;
}

.svg-shield-check::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 12rpx;
  width: 10rpx;
  height: 6rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

.svg-chart {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.svg-chart::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 4rpx;
  width: 4rpx;
  height: 20rpx;
  background: currentColor;
}

.svg-chart::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 14rpx;
  width: 4rpx;
  height: 28rpx;
  background: currentColor;
  box-shadow: 12rpx -10rpx 0 currentColor;
}

.svg-message {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.svg-message::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.svg-message::after {
  content: '';
  position: absolute;
  left: 10rpx;
  bottom: 2rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid currentColor;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
}

.svg-gear {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.svg-gear::before {
  content: '';
  position: absolute;
  inset: 6rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.svg-gear::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(0deg, transparent 40%, currentColor 40%, currentColor 60%, transparent 60%),
    linear-gradient(90deg, transparent 40%, currentColor 40%, currentColor 60%, transparent 60%);
  opacity: 0.3;
}

/* ===== FLOATING TAB BAR ===== */
.tab-bar {
  position: fixed;
  bottom: max(28rpx, env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 64rpx);
  max-width: 720rpx;
  height: 112rpx;
  z-index: 100;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(96rpx) saturate(210%);
  -webkit-backdrop-filter: blur(96rpx) saturate(210%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 48rpx;
  box-shadow:
    inset 0 3rpx 6rpx rgba(255, 255, 255, 0.60),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.20),
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 4rpx 20rpx rgba(0, 0, 0, 0.06),
    0 24rpx 72rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 12rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  width: 124rpx;
  height: 76rpx;
  border-radius: 28rpx;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 500;
  position: relative;
  transition: all 0.2s;
}

.tab-item.active {
  color: var(--brand);
  font-weight: 600;
}

.tab-item.active::before {
  content: "";
  position: absolute;
  width: 108rpx;
  height: 84rpx;
  border-radius: 32rpx;
  background: rgba(45, 108, 223, 0.16);
  border: 1rpx solid rgba(45, 108, 223, 0.30);
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.55),
    0 4rpx 20rpx rgba(45, 108, 223, 0.20);
  z-index: -1;
}

.tab-icon .icon-svg {
  width: 40rpx;
  height: 40rpx;
}

.tab-label {
  font-size: 22rpx;
  font-weight: 500;
}

.tab-item.active .tab-label {
  font-weight: 600;
}
