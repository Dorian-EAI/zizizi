.container { background: #f5f6fa; min-height: 100vh; padding-bottom: 40rpx; }

.tab-bar { display: flex; background: #fff; position: sticky; top: 0; z-index: 10; border-bottom: 1rpx solid #f0f0f0; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; }
.tab-item.active { color: #004080; font-weight: 600; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 4rpx; background: #004080; border-radius: 2rpx; }

.coupon-list { padding: 20rpx; }
.coupon-card { display: flex; background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.status-unused .cc-left { background: linear-gradient(135deg, #004080, #0066cc); }
.status-used .cc-left, .status-expired .cc-left { background: #bbb; }

.cc-left { width: 220rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30rpx 20rpx; position: relative; }
.cc-left::before, .cc-left::after { content: ''; position: absolute; right: -10rpx; width: 20rpx; height: 20rpx; background: #f5f6fa; border-radius: 50%; }
.cc-left::before { top: -10rpx; }
.cc-left::after { bottom: -10rpx; }
.cc-amount { display: flex; align-items: baseline; color: #fff; }
.cc-symbol { font-size: 28rpx; font-weight: 600; }
.cc-value { font-size: 64rpx; font-weight: 800; line-height: 1; }
.cc-unit { font-size: 28rpx; font-weight: 600; margin-left: 4rpx; }
.cc-min { font-size: 22rpx; color: rgba(255,255,255,0.9); margin-top: 10rpx; }

.cc-right { flex: 1; padding: 20rpx 24rpx; display: flex; flex-direction: column; gap: 8rpx; }
.cc-row1 { display: flex; justify-content: space-between; align-items: flex-start; }
.cc-name { font-size: 30rpx; font-weight: 600; color: #333; flex: 1; }
.cc-badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin-left: 12rpx; }
.badge-unused { background: #e6f7ed; color: #07c160; }
.badge-used { background: #f5f5f5; color: #999; }
.badge-expired { background: #f5f5f5; color: #999; }
.cc-scope { font-size: 24rpx; color: #888; }
.cc-expire { font-size: 24rpx; color: #999; }
.cc-btn { align-self: flex-end; margin-top: auto; padding: 10rpx 30rpx; background: #004080; color: #fff; font-size: 26rpx; border-radius: 30rpx; }
.cc-btn.disabled { background: #e0e0e0; color: #999; }

.empty { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #999; }

.loading { text-align: center; padding: 40rpx; color: #999; font-size: 26rpx; }
.load-end { text-align: center; padding: 30rpx; color: #ccc; font-size: 24rpx; }
