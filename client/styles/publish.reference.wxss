/* =========================================================
 * 发布订单页面样式 · 参考 lilu-value-investing-30.html
 * - 步骤指示器使用 serif 大号数字
 * - 选择项卡片使用选中态（indigo 主题色边框）
 * - 底部操作按钮使用胶囊式
 * ========================================================= */

.page-container.data-v-54e48627 {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom, 0px));
}

/* ---------- 顶部导航 ---------- */
.custom-nav.data-v-54e48627 {
  position: sticky;
  top: 0;
  z-index: 101;
  padding-top: max(env(safe-area-inset-top), 59px);
  background: var(--surface);
  border-bottom: 1rpx solid var(--divider);
}
.nav-title.data-v-54e48627 {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 0.08em;
}

/* ---------- 步骤指示器 ---------- */
.step-indicator.data-v-54e48627 {
  position: sticky;
  top: calc(max(env(safe-area-inset-top), 59px) + 92rpx);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  background: var(--surface);
  margin: 16rpx 30rpx 0;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-card);
}
.step-item.data-v-54e48627 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 110rpx;
}
.step-num.data-v-54e48627 {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  color: var(--text-3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Georgia, serif;
  font-size: 26rpx;
  font-weight: 700;
}
.step-num.active.data-v-54e48627 {
  background: var(--indigo);
  color: #fff;
}
.step-num.completed.data-v-54e48627 {
  background: var(--teal);
  color: #fff;
}
.step-label.data-v-54e48627 {
  font-size: 22rpx;
  color: var(--text-3);
  font-weight: 500;
}
.step-label.active.data-v-54e48627 {
  color: var(--text-1);
  font-weight: 700;
}
.step-line.data-v-54e48627 {
  width: 60rpx;
  height: 2rpx;
  background: var(--divider);
  margin: 0 8rpx 30rpx;
}
.step-line.active.data-v-54e48627 {
  background: var(--indigo);
}

/* ---------- 内容区 ---------- */
.step-content.data-v-54e48627 {
  padding: 24rpx 30rpx 160rpx;
}

.section-header.data-v-54e48627 {
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
.section-title.data-v-54e48627 {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 8rpx;
  letter-spacing: 0.02em;
}
.section-hint.data-v-54e48627 {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.5;
}

/* ---------- 服务类型网格 ---------- */
.service-type-grid.data-v-54e48627 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.type-card.data-v-54e48627 {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: border-color 0.2s, transform 0.2s;
}
.type-card.selected.data-v-54e48627 {
  border-color: var(--indigo);
  border-width: 2rpx;
  background: var(--indigo-soft);
}
.type-icon.data-v-54e48627 {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 14rpx;
}
.type-name.data-v-54e48627 {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 6rpx;
  text-align: center;
}
.type-desc.data-v-54e48627 {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.4;
}
.type-check.data-v-54e48627 {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--indigo);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

/* ---------- 输入卡 ---------- */
.input-card.data-v-54e48627 {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}
.desc-input.data-v-54e48627 {
  width: 100%;
  min-height: 220rpx;
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
  background: transparent;
}
.input-counter.data-v-54e48627 {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

/* 输入行 */
.input-line.data-v-54e48627 {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.input-line.data-v-54e48627 + .input-line.data-v-54e48627 {
  border-top: 1rpx solid var(--divider);
}
.input-label.data-v-54e48627 {
  flex: 0 0 160rpx;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}
.input-field.data-v-54e48627 {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-1);
}
.input-placeholder.data-v-54e48627 {
  color: var(--text-4);
}
.input-suffix.data-v-54e48627 {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 12rpx;
}
.input-arrow.data-v-54e48627 {
  font-size: 28rpx;
  color: var(--text-4);
  font-weight: 300;
  margin-left: 12rpx;
}

/* 图片上传 */
.image-uploader.data-v-54e48627 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}
.image-item.data-v-54e48627 {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  background: var(--bg-soft);
}
.image-item image.data-v-54e48627 {
  width: 100%;
  height: 100%;
}
.image-del.data-v-54e48627 {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(24, 24, 27, 0.7);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-btn.data-v-54e48627 {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--border);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  font-size: 40rpx;
  gap: 6rpx;
}
.upload-btn text.data-v-54e48627 {
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.2;
}

/* ---------- 摘要卡 ---------- */
.summary-card.data-v-54e48627 {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 8rpx solid var(--teal);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}
.summary-row.data-v-54e48627 {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
}
.summary-row.data-v-54e48627 + .summary-row.data-v-54e48627 {
  border-top: 1rpx solid var(--divider);
}
.summary-label.data-v-54e48627 {
  font-size: 24rpx;
  color: var(--text-3);
  flex: 0 0 180rpx;
}
.summary-value.data-v-54e48627 {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
  line-height: 1.5;
}

/* 价格强调 */
.price-emphasis.data-v-54e48627 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--indigo-soft);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}
.price-emphasis-label.data-v-54e48627 {
  font-size: 24rpx;
  color: var(--indigo-text);
  font-weight: 600;
}
.price-emphasis-value.data-v-54e48627 {
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--indigo);
}

/* ---------- 底部操作按钮 ---------- */
.bottom-actions.data-v-54e48627 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface);
  border-top: 1rpx solid var(--divider);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 200;
}
.action-btn.data-v-54e48627,
.submit-btn.data-v-54e48627,
.next-btn.data-v-54e48627 {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}
.action-btn.data-v-54e48627 {
  background: var(--bg-soft);
  color: var(--text-2);
  border: 1rpx solid var(--border);
}
.next-btn.data-v-54e48627,
.submit-btn.data-v-54e48627 {
  background: var(--text-1);
  color: #fff;
}
.next-btn.indigo.data-v-54e48627,
.submit-btn.indigo.data-v-54e48627 {
  background: var(--indigo);
}

/* ---------- 提示条 ---------- */
.tip-bar.data-v-54e48627 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--amber-soft);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  margin-top: 16rpx;
}
.tip-icon.data-v-54e48627 {
  font-size: 28rpx;
}
.tip-text.data-v-54e48627 {
  flex: 1;
  font-size: 22rpx;
  color: var(--amber);
  line-height: 1.5;
}
