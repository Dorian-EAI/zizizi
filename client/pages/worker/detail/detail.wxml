<view class="page" wx:if="{{order}}">
  <view wx:if="{{loading}}" class="loading-wrap">加载中...</view>
  <block wx:else>
    <!-- Top Nav Bar -->
    <view class="nav-bar">
      <view class="nav-icon-btn" bindtap="goBack">
        <image class="nav-icon" src="/assets/svg/arrow-left.svg" mode="aspectFit"></image>
      </view>
      <text class="nav-title">订单详情</text>
      <view class="nav-icon-btn" bindtap="onMoreTap">
        <text class="more-dots">⋯</text>
      </view>
    </view>

    <!-- Status Card -->
    <view class="section">
      <view class="glass-neu-card status-card">
        <view class="status-top-bar"></view>
        <view class="status-card-body">
          <view class="status-head">
            <text class="status-chip">{{order.status_chip || '待服务'}}</text>
            <text class="status-eta">{{order.eta_text || '预约今天 15:00-18:00'}}</text>
          </view>
          <view class="status-desc">{{order.status_desc || '客户已确认，等待您上门服务'}}</view>

          <!-- Timeline -->
          <view class="timeline">
            <view class="timeline-line">
              <view class="timeline-line-fill" style="width: {{order.timeline_progress || 62}}%"></view>
            </view>
            <view class="timeline-nodes">
              <view class="tl-node" wx:for="{{order.timeline}}" wx:key="key">
                <view class="tl-dot tl-dot-{{item.state}}">
                  <image wx:if="{{item.state === 'done'}}" class="tl-check" src="/assets/svg/check.svg" mode="aspectFit"></image>
                  <view wx:if="{{item.state === 'active'}}" class="tl-dot-inner-wrap">
                    <view class="tl-dot-inner"></view>
                    <view class="tl-dot-pulse"></view>
                  </view>
                </view>
                <text class="tl-label tl-label-{{item.state}}">{{item.label}}</text>
                <text class="tl-time">{{item.time}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Customer Info Card -->
    <view class="section">
      <view class="glass-neu-card worker-card">
        <view class="avatar-col">
          <view class="worker-avatar avatar-glass">
            <image wx:if="{{order.customer_avatar}}" class="avatar-img" src="{{order.customer_avatar}}" mode="aspectFill"></image>
            <image wx:else class="avatar-icon" src="/assets/svg/user.svg" mode="aspectFit"></image>
          </view>
          <view class="verify-badge avatar-verify">
            <image class="verify-icon" src="/assets/svg/check.svg" mode="aspectFit"></image>
            <text>实名认证</text>
          </view>
        </view>
        <view class="worker-info">
          <view class="worker-name-row">
            <text class="worker-name">{{order.customer_name || '客户'}}</text>
          </view>
          <view class="worker-meta">
            <text class="worker-star">★ {{order.customer_rating || '4.8'}}</text>
            <text class="meta-dot">·</text>
            <text>{{order.order_count || 12}}次下单</text>
          </view>
        </view>
        <view class="worker-actions">
          <view class="action-circle" catchtap="callCustomer" data-phone="{{order.customer_phone}}">
            <image class="action-icon" src="/assets/svg/phone.svg" mode="aspectFit"></image>
          </view>
          <view class="action-circle" catchtap="messageCustomer">
            <image class="action-icon" src="/assets/svg/message.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>

    <!-- Service Info Card -->
    <view class="section">
      <view class="glass-neu-card info-card">
        <view class="card-title">服务信息</view>
        <view class="info-list">
          <view class="info-row">
            <text class="info-label">订单编号</text>
            <text class="info-value mono">{{order.order_no}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">服务类型</text>
            <text class="info-value">{{order.service_type || order.service_name}}</text>
          </view>
          <view class="info-row info-row-icon">
            <text class="info-label">
              <image class="info-ic" src="/assets/svg/location.svg" mode="aspectFit"></image>
              服务地址
            </text>
            <text class="info-value">{{order.address}}</text>
          </view>
          <view class="info-row info-row-icon">
            <text class="info-label">
              <image class="info-ic" src="/assets/svg/calendar.svg" mode="aspectFit"></image>
              预约时间
            </text>
            <text class="info-value mono">{{order.appoint_time_text || order.appoint_time}}</text>
          </view>
          <view class="info-desc-block" wx:if="{{order.description}}">
            <text class="info-desc-label">问题描述</text>
            <text class="info-desc-text">{{order.description}}</text>
          </view>
          <view class="info-desc-block" wx:if="{{order.remark}}">
            <text class="info-desc-label">备注</text>
            <text class="info-desc-text">{{order.remark}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Fee Card -->
    <view class="section">
      <view class="glass-neu-card fee-card">
        <view class="card-title">报价信息</view>
        <view class="fee-list">
          <view class="fee-row">
            <text class="fee-label">我的报价</text>
            <text class="fee-value mono">¥{{order.quote_price || order.final_price}}</text>
          </view>
          <view class="fee-row" wx:if="{{order.estimated_time}}">
            <text class="fee-label">预计用时</text>
            <text class="fee-value">{{order.estimated_time}}</text>
          </view>
          <view class="fee-row" wx:if="{{order.material_cost}}">
            <text class="fee-label">材料费</text>
            <text class="fee-value mono">¥{{order.material_cost}}</text>
          </view>
          <view class="fee-divider" wx:if="{{order.platform_fee}}"></view>
          <view class="fee-row fee-row-coupon" wx:if="{{order.platform_fee}}">
            <text class="fee-label">平台抽成</text>
            <text class="fee-value fee-value-coupon mono">-¥{{order.platform_fee}}</text>
          </view>
          <view class="fee-total-row">
            <text class="fee-total-label">预计到手</text>
            <text class="fee-total mono">¥{{order.estimated_income || order.final_price}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Check-in Card -->
    <view class="section">
      <view class="glass-neu-card checkin-card">
        <view class="card-title">服务签到</view>
        <view class="checkin-list">
          <view class="checkin-step {{item.state}}" wx:for="{{order.checkin_steps}}" wx:key="key">
            <view class="checkin-node">
              <view wx:if="{{item.state === 'current'}}" class="checkin-pulse"></view>
              <image wx:if="{{item.state === 'done'}}" class="checkin-check" src="/assets/svg/check.svg" mode="aspectFit"></image>
              <image wx:elif="{{item.icon}}" class="checkin-step-icon" src="{{item.icon}}" mode="aspectFit"></image>
              <text wx:else class="checkin-step-emoji">{{item.emoji || '📷'}}</text>
            </view>
            <view class="checkin-body">
              <view class="checkin-title-row">
                <text class="checkin-title">{{item.title}}</text>
                <text class="checkin-status checkin-status-{{item.state}}">{{item.status_text}}</text>
              </view>
              <text class="checkin-meta">{{item.meta}}</text>
              <view wx:if="{{item.action}}" class="checkin-action">
                <view class="btn-neu-primary" catchtap="onCheckinAction" data-key="{{item.key}}">
                  <image class="btn-icon" src="/assets/svg/plus.svg" mode="aspectFit"></image>
                  <text>{{item.action_text || '上传签到'}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Extra Fee Card -->
    <view class="section" wx:if="{{order.extra_fee || order.can_apply_extra_fee}}">
      <view class="glass-neu-card extra-fee-card">
        <view class="card-title">补差价申请</view>
        <view class="extra-fee-tip">
          <image class="tip-icon" src="/assets/svg/zap.svg" mode="aspectFit"></image>
          <text class="extra-fee-tip-text">单次补差价不超过原订单50%，单订单最多2次</text>
        </view>
        <view wx:if="{{order.extra_fee_record}}" class="extra-fee-record">
          <view class="extra-fee-record-info">
            <view class="extra-fee-record-title">
              <text>{{order.extra_fee_record.title}}</text>
              <text class="extra-fee-badge">
                <image class="badge-icon" src="/assets/svg/check.svg" mode="aspectFit"></image>
                {{order.extra_fee_record.status || '已确认'}}
              </text>
            </view>
            <text class="extra-fee-record-time">{{order.extra_fee_record.time}}</text>
          </view>
          <text class="extra-fee-amount mono">¥{{order.extra_fee_record.amount}}</text>
        </view>
        <view wx:if="{{order.can_apply_extra_fee}}" class="extra-fee-action">
          <view class="btn-neu-secondary" catchtap="applyExtraFee">
            <image class="btn-icon" src="/assets/svg/plus.svg" mode="aspectFit"></image>
            <text>申请补差价</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Bottom Action Bar -->
    <view class="action-bar">
      <view class="action-btn-secondary" catchtap="contactCustomer" data-phone="{{order.customer_phone}}">
        <image class="action-btn-icon" src="/assets/svg/phone.svg" mode="aspectFit"></image>
        <text>联系客户</text>
      </view>
      <view class="action-btn-primary" catchtap="departAction">
        <image class="action-btn-icon" src="/assets/svg/shield.svg" mode="aspectFit"></image>
        <text>{{order.primary_action_text || '立即出发'}}</text>
      </view>
      <view class="safe-bottom-space"></view>
    </view>
  </block>
</view>
