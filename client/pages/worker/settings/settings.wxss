page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --accent: #D4944C;
  --accent-dark: #A0723C;
  --bg: #F2EDE8;
  --bg-elevated: #F7F3EF;
  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;
  --text-1: #2C2824;
  --text-2: #8B8178;
  --text-3: #B5ADA5;
  --text-inverse: #FFFFFF;
  --sep: rgba(44, 40, 36, 0.06);
  --green: #5B8C5A;
  --red: #C4533A;
  --orange: #D4944C;
  --blue: #5A8FAD;
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
  --neu-out-sm: 12rpx 12rpx 28rpx var(--neu-dark), -12rpx -12rpx 28rpx var(--neu-light), 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  --neu-out-md: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light), 0 12rpx 48rpx rgba(0, 0, 0, 0.05);
  --neu-in: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
  background: var(--bg);
  min-height: 100vh;
}

.page {
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 164rpx;
}

/* ===== Nav Bar ===== */
.nav-bar {
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(143, 169, 152, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(143, 169, 152, 0.08) 50%, rgba(45, 108, 223, 0.06) 100%);
  padding: calc(max(36rpx, env(safe-area-inset-top)) + 36rpx) 40rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}

.nav-icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-placeholder {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* ===== Section ===== */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}

.section:first-of-type {
  margin-top: 36rpx;
}

/* ===== Glass Neu Card ===== */
.glass-neu-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  box-shadow: var(--neu-out-md), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(45, 108, 223, 0.04), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
  position: relative;
  overflow: hidden;
}

.glass-neu-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, transparent 100%);
  pointer-events: none;
}

/* ===== Worker Profile Card ===== */
.worker-profile-card {
  padding: 36rpx;
}

.worker-profile-main {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.worker-profile-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-in-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
}

.worker-profile-avatar.avatar-glass {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.28) 40%, var(--brand-subtle) 78%, rgba(255, 255, 255, 0.18) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88), inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04), var(--neu-out-sm);
}

.avatar-icon {
  width: 60rpx;
  height: 60rpx;
}

.worker-profile-info {
  flex: 1;
  min-width: 0;
}

.worker-profile-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.worker-profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

.worker-gold-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: var(--brand-subtle);
  color: var(--brand);
  font-size: 21rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(45, 108, 223, 0.18);
}

.gold-icon {
  width: 22rpx;
  height: 22rpx;
}

.online-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--green);
  background: rgba(91, 140, 90, 0.12);
  padding: 10rpx 22rpx;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(91, 140, 90, 0.22);
  flex-shrink: 0;
}

.online-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 6rpx rgba(91, 140, 90, 0.20);
  flex-shrink: 0;
}

.worker-profile-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--sep);
  font-size: 25rpx;
  color: var(--text-2);
  font-weight: 500;
}

.worker-profile-stats text:first-child {
  color: var(--text-1);
  font-weight: 600;
}

.stats-dot {
  color: var(--text-3);
}

/* ===== Group Title ===== */
.group-title {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 600;
  padding: 0 12rpx;
  margin-bottom: 16rpx;
  letter-spacing: 0.01em;
}

/* ===== Setting Group & Rows ===== */
.setting-group {
  padding: 8rpx 0;
}

.setting-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  padding: 16rpx 36rpx;
  border-bottom: 1rpx solid var(--sep);
}

.setting-row:last-child {
  border-bottom: none;
}

.row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-icon-svg {
  width: 36rpx;
  height: 36rpx;
}

.row-icon-brand { color: var(--brand); }
.row-icon-green { color: var(--green); }
.row-icon-blue { color: var(--blue); }
.row-icon-orange { color: var(--orange); }

.row-title {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: -0.01em;
}

.row-tail {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.row-value {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

.row-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.row-badge-green {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--green);
  background: rgba(91, 140, 90, 0.12);
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
}

.mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

/* ===== Toggle Switch ===== */
.toggle {
  width: 88rpx;
  height: 52rpx;
  border-radius: 9999rpx;
  position: relative;
  flex-shrink: 0;
  padding: 0;
}

.toggle-on {
  background: var(--brand);
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.15), 0 4rpx 12rpx var(--brand-glow);
}

.toggle-off {
  background: var(--neu-dark);
  box-shadow: var(--neu-in);
}

.toggle-thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.toggle-on .toggle-thumb {
  transform: translateX(36rpx);
}

.toggle-off .toggle-thumb {
  transform: translateX(0);
}

/* ===== Logout Button ===== */
.logout-section {
  margin-top: 48rpx;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.55);
  color: var(--red);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  box-shadow: var(--neu-out-sm);
}
