@import '/styles/glass-neu.wxss';

.page {
  min-height: 100vh;
  background: #F2EDE8;
  padding-bottom: 320rpx;
}

.hero {
  padding: calc(76rpx + env(safe-area-inset-top)) 48rpx 72rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 75% 40%, rgba(212, 148, 76, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 20% 80%, rgba(13, 148, 136, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.28) 0%, rgba(212, 148, 76, 0.20) 50%, rgba(20, 184, 166, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

.hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 2;
}

.hero-title-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #2C2824;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #8B8178;
  margin-top: 4rpx;
  font-weight: 500;
}

.close-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2C2824;
  flex-shrink: 0;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
}

.close-icon {
  font-size: 32rpx;
}

.steps {
  display: flex;
  align-items: center;
  gap: 0;
  position: relative;
  z-index: 2;
  padding: 0 8rpx;
  margin-top: 40rpx;
}

.step-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.step-done {
  background: rgba(255, 255, 255, 0.85);
  color: #0D9488;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.step-check {
  font-size: 28rpx;
}

.step-current {
  background: transparent;
  border: 3rpx solid rgba(255, 255, 255, 0.80);
  color: #2C2824;
}

.step-pending {
  background: rgba(255, 255, 255, 0.15);
  border: 3rpx solid rgba(255, 255, 255, 0.25);
  color: rgba(44, 40, 36, 0.6);
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.25);
  margin: 0 16rpx;
  border-radius: 2rpx;
}

.step-line-active {
  background: rgba(255, 255, 255, 0.7);
}

.section {
  padding: 0 48rpx;
  margin-top: 40rpx;
  position: relative;
  z-index: 2;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #8B8178;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
  letter-spacing: 0.2px;
}

.card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  box-shadow: 16rpx 16rpx 36rpx #DDD6CE, -16rpx -16rpx 36rpx #FFF8F2, 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  overflow: hidden;
  position: relative;
}

.service-card {
  padding: 32rpx 24rpx;
  position: relative;
  z-index: 1;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32rpx 8rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.service-icon-chip {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #F2EDE8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0D9488;
  font-size: 44rpx;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: all 0.2s ease;
}

.service-item-selected .service-icon-chip {
  box-shadow: inset 6rpx 6rpx 12rpx #DDD6CE, inset -6rpx -6rpx 12rpx #FFF8F2;
  background: rgba(13, 148, 136, 0.12);
  color: #0D9488;
}

.service-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #2C2824;
  text-align: center;
  line-height: 1.25;
}

.service-item-selected .service-label {
  color: #0D9488;
  font-weight: 600;
}

.desc-card {
  padding: 32rpx;
  position: relative;
  z-index: 1;
}

.desc-textarea {
  width: 100%;
  min-height: 192rpx;
  border: none;
  border-radius: 24rpx;
  background: #F2EDE8;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #2C2824;
  line-height: 1.55;
  box-shadow: inset 6rpx 6rpx 12rpx #DDD6CE, inset -6rpx -6rpx 12rpx #FFF8F2;
}

.char-count {
  text-align: right;
  font-size: 23rpx;
  color: #B5ADA5;
  margin-top: 12rpx;
  padding-right: 4rpx;
  font-weight: 500;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 12rpx;
  border-top: 1rpx solid rgba(44, 40, 36, 0.06);
  border-radius: 12rpx;
  margin: 0 -12rpx;
}

.info-icon {
  font-size: 40rpx;
  color: #0D9488;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
  font-size: 29rpx;
  font-weight: 500;
  color: #2C2824;
  letter-spacing: -0.01em;
}

.info-chevron {
  font-size: 32rpx;
  color: #B5ADA5;
  flex-shrink: 0;
  font-weight: 300;
}

.tag-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(44, 40, 36, 0.06);
}

.tag-chip {
  background: rgba(13, 148, 136, 0.10);
  color: #0D9488;
  border: 1rpx solid rgba(13, 148, 136, 0.16);
  border-radius: 9999rpx;
  padding: 14rpx 32rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.tag-chip-active {
  background: rgba(13, 148, 136, 0.20);
  box-shadow: inset 2rpx 2rpx 4rpx #DDD6CE, inset -2rpx -2rpx 4rpx #FFF8F2;
}

.mode-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.mode-card {
  padding: 32rpx 16rpx;
  text-align: center;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}

.mode-card-selected {
  border: 3rpx solid #0D9488;
  background: rgba(13, 148, 136, 0.06);
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, 0 8rpx 28rpx rgba(13, 148, 136, 0.12);
}

.mode-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #F2EDE8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  color: #8B8178;
  font-size: 36rpx;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.45);
}

.mode-card-selected .mode-icon {
  background: linear-gradient(135deg, #0D9488 0%, #14B8A6 100%);
  color: #ffffff;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, 0 8rpx 28rpx rgba(13, 148, 136, 0.20);
}

.mode-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C2824;
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}

.mode-card-selected .mode-title {
  color: #0D9488;
}

.mode-desc {
  font-size: 22rpx;
  color: #8B8178;
  line-height: 1.4;
}

.summary-bar {
  position: fixed;
  bottom: calc(144rpx + max(28rpx, env(safe-area-inset-bottom)));
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 64rpx);
  max-width: 720rpx;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.50);
  border-radius: 56rpx;
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.60),
    inset 0 -2rpx 4rpx rgba(255, 255, 255, 0.20),
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 4rpx 20rpx rgba(0, 0, 0, 0.06),
    0 48rpx 144rpx rgba(0, 0, 0, 0.08);
  z-index: 99;
}

.summary-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.summary-label {
  font-size: 25rpx;
  color: #8B8178;
  font-weight: 500;
}

.summary-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.summary-price .currency {
  font-size: 30rpx;
  color: #0D9488;
  font-weight: 600;
}

.summary-price .amount {
  font-size: 52rpx;
  font-weight: 700;
  color: #0D9488;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.btn-neu-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.40);
  border-radius: 9999rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, 0 8rpx 28rpx rgba(13, 148, 136, 0.24), inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.30);
}

.btn-neu-primary:active {
  box-shadow: inset 6rpx 6rpx 12rpx #DDD6CE, inset -6rpx -6rpx 12rpx #FFF8F2;
  transform: scale(0.97);
}

.tab-bar {
  position: fixed;
  bottom: max(28rpx, env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 64rpx);
  max-width: 720rpx;
  height: 128rpx;
  z-index: 100;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.50);
  border-radius: 56rpx;
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.60),
    inset 0 -2rpx 4rpx rgba(255, 255, 255, 0.20),
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 4rpx 20rpx rgba(0, 0, 0, 0.06),
    0 48rpx 144rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 40rpx;
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 136rpx;
  height: 88rpx;
  border-radius: 28rpx;
  color: #B5ADA5;
  font-size: 22rpx;
  font-weight: 500;
  position: relative;
  text-align: center;
}

.tab-item-active {
  color: #0D9488;
  font-weight: 600;
}

.tab-item-active-bg {
  position: absolute;
  width: 108rpx;
  height: 84rpx;
  border-radius: 32rpx;
  background: rgba(13, 148, 136, 0.16);
  border: 1rpx solid rgba(13, 148, 136, 0.30);
  box-shadow:
    inset 0 4rpx 12rpx rgba(255, 255, 255, 0.55),
    inset 0 -2rpx 4rpx rgba(255, 255, 255, 0.15),
    0 8rpx 40rpx rgba(13, 148, 136, 0.20);
  z-index: 0;
}

.tab-icon {
  font-size: 36rpx;
  position: relative;
  z-index: 1;
}

.tab-icon-active {
  transform: scale(1.08);
}

.tab-label {
  position: relative;
  z-index: 1;
}

.tab-label-active {
  position: relative;
  z-index: 1;
}
