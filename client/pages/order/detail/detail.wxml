<view class="container" wx:if="{{order}}">
  <!-- 订单状态 -->
  <view class="status-bar status-{{order.status}}">
    <text class="status-text">{{order.status_text}}</text>
    <text class="status-desc">{{order.status_desc}}</text>
  </view>

  <!-- 实时追踪入口（师傅出发后显示） -->
  <view class="card tracking-entry" wx:if="{{order.status === 'departing' || order.status === 'arrived' || order.status === 'serving'}}" bindtap="goTracking">
    <view class="tracking-icon">📍</view>
    <view class="tracking-info">
      <text class="tracking-title">查看师傅实时位置</text>
      <text class="tracking-desc" wx:if="{{order.status === 'departing'}}">师傅正在赶来，点击查看预计到达时间</text>
      <text class="tracking-desc" wx:if="{{order.status === 'arrived'}}">师傅已到达服务地点</text>
      <text class="tracking-desc" wx:if="{{order.status === 'serving'}}">师傅正在服务中</text>
    </view>
    <text class="tracking-arrow">›</text>
  </view>

  <!-- 服务信息 -->
  <view class="card service-card" bindtap="serviceDetail">
    <view class="svc-header">
      <text class="svc-name">{{order.service_name || order.service_type}}</text>
      <text class="svc-price">¥{{order.final_price || order.total_amount}}</text>
    </view>
    <view class="svc-info">
      <text class="info-row">📅 {{order.appoint_time || '待预约'}}</text>
      <text class="info-row">📍 {{order.address || '待填写'}}</text>
      <text class="info-row" wx:if="{{order.remark}}">📝 {{order.remark}}</text>
    </view>
    <view class="order-images" wx:if="{{order.images.length}}">
      <image wx:for="{{order.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
    </view>
  </view>

  <!-- 师傅信息 -->
  <view class="card worker-card" wx:if="{{order.worker_id}}" bindtap="workerDetail">
    <view class="wk-left">
      <image class="wk-avatar" src="{{order.worker_avatar || '/assets/default-avatar.png'}}"></image>
      <view class="wk-info">
        <text class="wk-name">{{order.worker_name || '师傅 #' + order.worker_id}}</text>
        <text class="wk-rating">★ {{order.worker_rating || '5.0'}}</text>
      </view>
    </view>
    <text class="wk-arrow">></text>
  </view>

  <!-- 报价列表（待接单） -->
  <view class="card bidding-card" wx:if="{{order.status === 'pending' && biddings.length}}">
    <view class="section-title">师傅报价</view>
    <view class="bidding-item" wx:for="{{biddings}}" wx:key="id">
      <view class="bidding-left">
        <text class="bidding-worker">师傅 #{{item.worker_id}}</text>
        <text class="bidding-time" wx:if="{{item.created_at}}">{{item.created_at}}</text>
      </view>
      <view class="bidding-right">
        <text class="bidding-price">¥{{item.price}}</text>
        <view class="select-btn" bindtap="selectWorker" data-id="{{item.id}}">选择</view>
      </view>
    </view>
  </view>

  <!-- 订单金额 -->
  <view class="card price-card">
    <view class="price-line"><text>服务费</text><text>¥{{order.service_price || 0}}</text></view>
    <view class="price-line" wx:if="{{order.material_fee}}"><text>材料费</text><text>¥{{order.material_fee}}</text></view>
    <view class="price-line" wx:if="{{order.discount_amount}}"><text>优惠</text><text class="discount">-¥{{order.discount_amount}}</text></view>
    <view class="price-line total"><text>合计</text><text class="total-price">¥{{order.final_price || order.total_amount}}</text></view>
  </view>

  <!-- LBS 轨迹 -->
  <view class="card track-card" wx:if="{{trackList.length}}">
    <view class="section-title">服务轨迹</view>
    <map id="trackMap" class="track-map"
         longitude="{{mapCenter.longitude}}"
         latitude="{{mapCenter.latitude}}"
         markers="{{trackMarkers}}"
         polyline="{{trackPolyline}}"
         scale="15"
         show-location></map>
    <view class="track-list">
      <view class="track-item" wx:for="{{trackList}}" wx:key="index" wx:for-index="index" wx:for-item="item">
        <view class="track-dot {{index === 0 ? 'active' : ''}}"></view>
        <view class="track-content">
          <text class="track-action">{{item.action || '位置更新'}}</text>
          <text class="track-location" wx:if="{{item.location}}">{{item.location}}</text>
          <text class="track-time">{{item.created_at || item.time}}</text>
        </view>
        <view class="track-nav-btn" wx:if="{{item.latitude && item.longitude}}"
              catchtap="openTrackNavigation"
              data-latitude="{{item.latitude}}"
              data-longitude="{{item.longitude}}"
              data-name="{{item.action || '位置更新'}}"
              data-address="{{item.location || ''}}">导航到这里</view>
      </view>
    </view>
  </view>

  <!-- 订单操作 -->
  <view class="card action-card">
    <block wx:if="{{order.status === 'pending'}}">
      <view class="action-btn secondary" bindtap="cancelOrder">取消订单</view>
    </block>
    <block wx:elif="{{order.status === 'accepted'}}">
      <view class="action-btn" bindtap="completeOrder">完成服务</view>
      <view class="action-btn secondary">联系师傅</view>
    </block>
    <block wx:elif="{{order.status === 'completed'}}">
      <view class="action-btn pay-btn" bindtap="openPayMethodSelector">去支付</view>
    </block>
    <block wx:elif="{{order.status === 'paid'}}">
      <view class="action-btn" bindtap="confirmComplete">确认完成</view>
      <view class="action-btn review-btn" bindtap="toggleReview">发表评价</view>
    </block>
    <block wx:elif="{{order.status === 'reviewed'}}">
      <view class="action-btn secondary">再次预约</view>
    </block>
  </view>

  <!-- 支付方式选择弹窗 -->
  <view class="pay-modal" wx:if="{{showPayMethodSelector}}">
    <view class="pm-mask" bindtap="closePayMethodSelector"></view>
    <view class="pm-content">
      <view class="pm-header">
        <text class="pm-title">选择支付方式</text>
        <text class="pm-close" bindtap="closePayMethodSelector">×</text>
      </view>
      <view class="pm-body">
        <view class="pay-method-item" wx:for="{{payMethods}}" wx:key="value" bindtap="onSelectPayMethod" data-method="{{item.value}}">
          <text class="pm-label">{{item.label}}</text>
          <text class="pm-arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 组合支付金额输入弹窗 -->
  <view class="pay-modal" wx:if="{{showPaymentModal}}">
    <view class="pm-mask" bindtap="closePaymentModal"></view>
    <view class="pm-content">
      <view class="pm-header">
        <text class="pm-title">组合支付</text>
        <text class="pm-close" bindtap="closePaymentModal">×</text>
      </view>
      <view class="pm-body">
        <view class="pay-total">应付总额：¥{{order.final_price || order.total_amount}}</view>
        <view class="pay-input-row">
          <text>钱包支付</text>
          <input type="digit" value="{{payForm.wallet_amount}}" data-field="wallet_amount" bindinput="onPayInput" placeholder="请输入金额" />
        </view>
        <view class="pay-input-row">
          <text>微信支付</text>
          <input type="digit" value="{{payForm.wechat_amount}}" data-field="wechat_amount" bindinput="onPayInput" placeholder="请输入金额" />
        </view>
      </view>
      <view class="pm-footer">
        <view class="pm-btn submit-btn" bindtap="payOrder" data-method="combined">确认支付</view>
      </view>
    </view>
  </view>

  <!-- 评价弹窗 -->
  <view class="review-modal" wx:if="{{showReview}}">
    <view class="rm-mask" bindtap="toggleReview"></view>
    <view class="rm-content">
      <view class="rm-header">
        <text class="rm-title">发表评价</text>
        <text class="rm-close" bindtap="toggleReview">×</text>
      </view>
      <view class="rm-body">
        <view class="rating-row">
          <text class="rating-label">整体评分</text>
          <view class="stars">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="s"
                  class="star {{s <= review.rating ? 'on' : ''}}"
                  bindtap="setRating" data-rating="{{s}}">★</text>
          </view>
        </view>
        <view class="tags-row">
          <text class="tags-label">评价标签（可多选）</text>
          <view class="tag-list">
            <text class="tag-item {{review.tags.indexOf(item) >= 0 ? 'active' : ''}}"
                  wx:for="{{presetTags}}" wx:key="*this"
                  bindtap="toggleTag" data-tag="{{item}}">{{item}}</text>
          </view>
        </view>
        <view class="content-row">
          <textarea class="content-input" placeholder="分享您的服务体验..."
                    value="{{review.content}}" bindinput="onContentInput" maxlength="500"></textarea>
        </view>
        <view class="images-row">
          <view class="image-list">
            <view class="img-item" wx:for="{{review.images}}" wx:key="*this">
              <image src="{{item}}" mode="aspectFill"></image>
              <view class="img-del" bindtap="removeImage" data-index="{{index}}">×</view>
            </view>
            <view class="img-add" bindtap="chooseImage" wx:if="{{review.images.length < 5}}">+</view>
          </view>
        </view>
        <view class="anonymous-row">
          <text>匿名评价</text>
          <switch checked="{{review.anonymous}}" bindchange="toggleAnonymous"></switch>
        </view>
      </view>
      <view class="rm-footer">
        <view class="rm-btn submit-btn" bindtap="submitReview">提交评价</view>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
