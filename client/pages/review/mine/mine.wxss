.container { background: #f5f6fa; min-height: 100vh; }
.status-tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 10; }
.stab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; }
.stab.active { color: #07c160; font-weight: 600; }
.stab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 4rpx; background: #07c160; border-radius: 2rpx; }

.review-list { padding: 20rpx; }
.review-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.rc-status { display: inline-block; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 6rpx; margin-bottom: 16rpx; }
.status-pending { background: #fff7e6; color: #fa8c16; }
.status-approved { background: #e6f7ed; color: #07c160; }
.status-rejected { background: #fff1f0; color: #ff4d4f; }

.rc-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.rc-rating { font-size: 26rpx; }
.star-on { color: #ff9900; }
.rc-service { font-size: 24rpx; color: #666; background: #f5f5f5; padding: 4rpx 12rpx; border-radius: 6rpx; }

.rc-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 10rpx; }
.rc-tag { font-size: 22rpx; color: #07c160; background: #e6f7ed; padding: 4rpx 12rpx; border-radius: 6rpx; }

.rc-content { font-size: 28rpx; color: #333; line-height: 1.6; display: block; }

.rc-images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 12rpx; }
.rc-images image { width: 100%; height: 180rpx; border-radius: 10rpx; }

.rc-reject { margin-top: 12rpx; padding: 12rpx; background: #fff7e6; border-radius: 8rpx; font-size: 26rpx; }
.reject-label { color: #fa8c16; font-weight: 500; }
.reject-reason { color: #333; }

.rc-reply { margin-top: 12rpx; padding: 12rpx; background: #f8f8f8; border-radius: 8rpx; font-size: 26rpx; }
.reply-label { color: #07c160; font-weight: 500; }

.rc-footer { display: flex; justify-content: space-between; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; }
.rc-time { font-size: 22rpx; color: #bbb; }
.view-order { font-size: 24rpx; color: #1989fa; }

.empty { padding: 100rpx 0; text-align: center; color: #999; }
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 26rpx; margin-top: 16rpx; }
.loading, .no-more { text-align: center; padding: 30rpx; font-size: 26rpx; color: #999; }
