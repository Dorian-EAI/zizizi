.container { background: #f5f6fa; min-height: 100vh; padding-bottom: 40rpx; }

.stats-card { margin: 20rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; }
.score-row { display: flex; align-items: center; gap: 24rpx; margin-bottom: 16rpx; }
.score-main { text-align: center; }
.score-num { font-size: 56rpx; font-weight: 700; color: #ff9900; display: block; }
.score-total { font-size: 24rpx; color: #999; }
.score-bars { flex: 1; }
.bar-item { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.star-label { font-size: 22rpx; color: #666; width: 48rpx; }
.bar-wrap { flex: 1; height: 16rpx; background: #f0f0f0; border-radius: 8rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #ff9900; border-radius: 8rpx; }
.bar-count { font-size: 22rpx; color: #999; width: 48rpx; text-align: right; }

.highlight { font-size: 26rpx; color: #07c160; background: #e6f7ed; padding: 12rpx 16rpx; border-radius: 10rpx; margin-bottom: 16rpx; }

.tag-cloud { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { font-size: 24rpx; color: #666; background: #f5f5f5; padding: 8rpx 18rpx; border-radius: 8rpx; }
.tag.active { background: #07c160; color: #fff; }

.review-list { margin: 0 20rpx; }
.review-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.review-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.user-info { display: flex; align-items: center; gap: 12rpx; }
.avatar { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; background: #e5e5e5; border-radius: 50%; font-size: 22rpx; color: #666; }
.nickname { font-size: 26rpx; color: #333; }
.star { color: #ddd; font-size: 24rpx; }
.star.on { color: #ff9900; }

.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 10rpx; }
.rtag { font-size: 22rpx; color: #07c160; background: #e6f7ed; padding: 4rpx 12rpx; border-radius: 6rpx; }
.content { font-size: 28rpx; color: #333; line-height: 1.6; margin-bottom: 12rpx; }
.images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 12rpx; }
.images image { width: 100%; height: 200rpx; border-radius: 10rpx; }

.review-footer { display: flex; justify-content: space-between; align-items: center; }
.time { font-size: 22rpx; color: #bbb; }
.like { font-size: 24rpx; color: #999; }
.like.liked { color: #e64340; }

.worker-reply { margin-top: 16rpx; padding: 16rpx; background: #f8f8f8; border-radius: 10rpx; }
.reply-label { font-size: 24rpx; color: #07c160; font-weight: 500; }
.reply-text { font-size: 26rpx; color: #555; }

.loading-more, .no-more, .empty { text-align: center; padding: 30rpx; color: #999; font-size: 26rpx; }
