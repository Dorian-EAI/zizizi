/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#0D9488;--brand-dark:#0A7A70;--brand-mid:#14B8A6;--brand-light:#CCFBF1;
  --brand-glow:rgba(13,148,136,0.18);--brand-subtle:rgba(13,148,136,0.08);
  --brand-gradient:linear-gradient(135deg,#0D9488 0%,#14B8A6 48%,#D4944C 100%);
  --accent:#D4944C;--accent-dark:#A0723C;--accent-light:#F5E6D0;--accent-glow:rgba(212,148,76,0.16);
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);--fill:rgba(44,40,36,0.04);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;
  --font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-out-lg:20rpx 20rpx 48rpx var(--neu-dark),-20rpx -20rpx 48rpx var(--neu-light),0 16rpx 64rpx rgba(0,0,0,0.06);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep:inset 10rpx 10rpx 20rpx var(--neu-dark),inset -10rpx -10rpx 20rpx var(--neu-light);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}

.design-canvas-page{position:relative;width:min(750rpx,100vw);height:1800rpx;min-height:1800rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:200rpx}
.mono{font-variant-numeric:tabular-nums;letter-spacing:-0.01em}

/* ===== Top Nav Bar ===== */
.nav-bar{background:radial-gradient(ellipse 440rpx 320rpx at 78% 45%,rgba(212,148,76,.10) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 18% 75%,rgba(13,148,136,.10) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.08) 0%,rgba(212,148,76,.06) 50%,rgba(13,148,136,.05) 100%);position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:36rpx 40rpx;padding-top:max(36rpx,env(safe-area-inset-top));border-radius:0 0 56rpx 56rpx;overflow:hidden}
.nav-icon-btn{width:88rpx;height:88rpx;border-radius:50%;border:none;background:var(--bg-elevated);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.nav-icon-btn:active{box-shadow:var(--neu-in);transform:scale(0.94)}
.nav-title{font-size:34rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em}

/* ===== Section ===== */
.section{padding:32rpx 40rpx 0}
.section-title{font-size:30rpx;font-weight:700;color:var(--text-1);margin-bottom:24rpx;display:flex;align-items:center;gap:12rpx}

/* ===== Glass Neumorphic Card ===== */
.glass-neu-card{background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(140%);-webkit-backdrop-filter:blur(40rpx) saturate(140%);border-radius:var(--r-lg);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-md),0 12rpx 56rpx rgba(0,0,0,0.06),0 4rpx 16rpx var(--brand-subtle),0 0 0 2rpx rgba(44,40,36,0.03);padding:40rpx;position:relative;overflow:hidden}
.glass-neu-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2rpx;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.80),transparent);pointer-events:none}

/* ===== Amount Display ===== */
.amount-section{padding:48rpx 40rpx 16rpx}
.amount-card{text-align:center;padding:56rpx 40rpx}
.amount-label{font-size:26rpx;color:var(--text-2);margin-bottom:16rpx}
.amount-value{font-size:88rpx;font-weight:700;font-family:var(--font-display);color:var(--text-1);letter-spacing:-0.03em;line-height:1.1}
.amount-value .currency{font-size:48rpx;margin-right:4rpx;vertical-align:top;font-weight:600}
.order-no{font-size:24rpx;color:var(--text-3);margin-top:20rpx}

/* ===== Payment Methods ===== */
.pay-method-list{display:flex;flex-direction:column;gap:24rpx}
.pay-method-item{display:flex;align-items:center;padding:32rpx;background:rgba(255,255,255,0.52);border-radius:var(--r-md);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm);cursor:pointer;transition:all var(--dur) var(--ease);position:relative}
.pay-method-item:active{box-shadow:var(--neu-in);transform:scale(0.98)}
.pay-method-item.selected{border:2rpx solid var(--brand);box-shadow:var(--neu-out-sm),0 0 0 6rpx var(--brand-subtle)}
.pay-method-icon{width:88rpx;height:88rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;margin-right:28rpx;flex-shrink:0}
.pay-method-icon.wechat{background:linear-gradient(135deg,#07C160,#06AE56);color:#fff}
.pay-method-icon.combo{background:linear-gradient(135deg,var(--accent),var(--brand));color:#fff}
.pay-method-icon.balance{background:linear-gradient(135deg,var(--brand),var(--brand-mid));color:#fff}
.pay-method-info{flex:1}
.pay-method-name{font-size:30rpx;font-weight:600;color:var(--text-1);margin-bottom:4rpx}
.pay-method-desc{font-size:24rpx;color:var(--text-2)}
.pay-method-radio{width:44rpx;height:44rpx;border-radius:50%;border:4rpx solid var(--neu-dark);margin-left:24rpx;flex-shrink:0;position:relative}
.pay-method-item.selected .pay-method-radio{border-color:var(--brand);background:var(--brand)}
.pay-method-item.selected .pay-method-radio::after{content:"";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:16rpx;height:16rpx;border-radius:50%;background:#fff}

/* ===== Coupon Selector ===== */
.coupon-selector{display:flex;align-items:center;justify-content:space-between;padding:32rpx;background:rgba(255,255,255,0.52);border-radius:var(--r-md);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm);cursor:pointer}
.coupon-selector:active{box-shadow:var(--neu-in)}
.coupon-left{display:flex;align-items:center;gap:20rpx}
.coupon-icon{width:72rpx;height:72rpx;border-radius:20rpx;background:linear-gradient(135deg,var(--accent),var(--accent-dark));color:#fff;display:flex;align-items:center;justify-content:center}
.coupon-text{font-size:28rpx;color:var(--text-1);font-weight:500}
.coupon-discount{font-size:28rpx;color:var(--red);font-weight:600}
.coupon-arrow{color:var(--text-3)}

/* ===== Order Detail ===== */
.detail-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:2rpx solid var(--sep)}
.detail-row:last-child{border-bottom:none}
.detail-label{font-size:27rpx;color:var(--text-2)}
.detail-value{font-size:27rpx;color:var(--text-1);font-weight:500}
.detail-value.highlight{color:var(--brand);font-weight:600}

/* ===== Bottom Payment Bar ===== */
.pay-bottom-bar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(750rpx,100vw);z-index:100;padding:24rpx 40rpx;padding-bottom:max(24rpx,env(safe-area-inset-bottom));background:rgba(255,255,255,0.72);backdrop-filter:blur(48rpx) saturate(160%);-webkit-backdrop-filter:blur(48rpx) saturate(160%);border-top:1rpx solid rgba(255,255,255,0.60);box-shadow:0 -8rpx 40rpx rgba(0,0,0,0.06)}
.pay-bottom-inner{display:flex;align-items:center;justify-content:space-between}
.pay-total-label{font-size:26rpx;color:var(--text-2)}
.pay-total-amount{font-size:48rpx;font-weight:700;font-family:var(--font-display);color:var(--text-1);letter-spacing:-0.02em}
.pay-total-amount .currency{font-size:28rpx;vertical-align:top;margin-right:4rpx}
.pay-now-btn{padding:28rpx 72rpx;background:var(--brand-gradient);color:#fff;font-size:32rpx;font-weight:700;border:none;border-radius:19998rpx;cursor:pointer;box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow);transition:all var(--dur) var(--spring)}
.pay-now-btn:active{transform:scale(0.94);box-shadow:var(--neu-in)}

/* ===== Security Tip ===== */
.security-tip{display:flex;align-items:center;justify-content:center;gap:12rpx;padding:32rpx 40rpx;font-size:24rpx;color:var(--text-3)}
.security-icon{color:var(--green)}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
