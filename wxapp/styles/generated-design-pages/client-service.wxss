/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}

page {
  --phone-bg:#F2EDE8;
  --border-glass:1rpx solid rgba(255,255,255,0.60);
  --border-glass-soft:1rpx solid rgba(255,255,255,0.45);
  --icon-raise:10rpx 10rpx 20rpx var(--neu-dark),-10rpx -10rpx 20rpx var(--neu-light);
  --icon-inset:inset 6rpx 6rpx 12rpx var(--neu-dark),inset -6rpx -6rpx 12rpx var(--neu-light);
}

page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:var(--body-bg);letter-spacing:-0.01em}

/* ===== Phone Frame ===== */
.design-canvas-page{position:relative;width:828rpx;min-height:1792rpx;background:var(--phone-bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:164rpx}
.design-canvas-page::-webkit-scrollbar{display:none}
.design-canvas-page{scrollbar-width:none}
.design-canvas-page::after{content:'';position:absolute;bottom:0;left:0;right:0;height:520rpx;background:radial-gradient(ellipse 360rpx 240rpx at 20% 90%,rgba(13,148,136,.05) 0%,transparent 70%),radial-gradient(ellipse 320rpx 200rpx at 80% 85%,rgba(212,148,76,.05) 0%,transparent 70%);pointer-events:none;z-index:0}
.design-canvas-page>*{position:relative;z-index:1}

/* ===== btn-neu-primary base (head only defines :active) ===== */
.btn-neu-primary{
  display:inline-flex;align-items:center;justify-content:center;gap:12rpx;
  background:var(--brand-gradient);
  color:var(--text-inverse);
  border:1rpx solid rgba(255,255,255,0.40);
  border-radius:19998rpx;
  padding:20rpx 40rpx;font-size:28rpx;font-weight:600;font-family:var(--font);
  cursor:pointer;
  box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow),inset 0 2rpx 2rpx rgba(255,255,255,0.30);
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease);
}

/* ===== Sub Header (status + back) ===== */
.sub-header{position:sticky;top:0;z-index:50;background:radial-gradient(ellipse 440rpx 320rpx at 78% 45%,rgba(212,148,76,.10) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 18% 75%,rgba(13,148,136,.10) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.08) 0%,rgba(212,148,76,.06) 50%,rgba(13,148,136,.05) 100%); border-radius:0 0 56rpx 56rpx; overflow:hidden;}
.status-bar{display:flex;align-items:center;justify-content:space-between;padding:28rpx 48rpx 8rpx;font-size:26rpx;font-weight:600;color:var(--text-1)}
.status-icons{display:flex;align-items:center;gap:12rpx}
.status-icons .design-svg-icon{width:32rpx;height:32rpx;stroke:var(--text-1);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.back-row{display:flex;align-items:center;gap:16rpx;padding:8rpx 40rpx 24rpx}
.back-btn{width:72rpx;height:72rpx;border-radius:50%;background:rgba(255,255,255,0.50);border:1rpx solid rgba(255,255,255,0.60);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;box-shadow:var(--neu-out-sm);transition:transform var(--dur) var(--ease),box-shadow var(--dur) var(--ease)}
.back-btn:active{box-shadow:var(--neu-in);transform:scale(0.9)}
.back-btn .design-svg-icon{width:36rpx;height:36rpx;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.back-title{flex:1;font-size:36rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.4rpx;text-align:center}
.back-spacer{width:72rpx;flex-shrink:0}

/* ===== Section Title ===== */
.section-title{font-size:36rpx;font-weight:700;color:var(--text-1);padding:40rpx 48rpx 28rpx;letter-spacing:-0.4rpx}
.section-header{display:flex;align-items:center;justify-content:space-between;padding:40rpx 48rpx 24rpx}
.section-header .section-title{padding:0}
.section-link{display:inline-flex;align-items:center;gap:8rpx;font-size:26rpx;font-weight:600;color:var(--brand);cursor:pointer;background:rgba(255,255,255,0.55);border:1rpx solid rgba(255,255,255,0.70);border-radius:19998rpx;font-family:var(--font);padding:12rpx 24rpx;box-shadow:var(--neu-out-sm);transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease),background var(--dur) var(--ease)}
.section-link:active{box-shadow:var(--neu-in);transform:scale(0.94);background:rgba(255,255,255,0.40)}
.section-link .design-svg-icon{width:28rpx;height:28rpx;stroke:var(--brand);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* ===== Online Service Cards ===== */
.online-card{display:flex;align-items:center;gap:28rpx;margin:32rpx 48rpx 24rpx;padding:32rpx;background:var(--surface-1);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:1rpx solid rgba(255,255,255,0.60);border-radius:44rpx;box-shadow:var(--neu-out-sm);transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.online-card:active{transform:scale(0.98);box-shadow:var(--neu-in)}
.online-icon{width:96rpx;height:96rpx;border-radius:28rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--text-inverse);box-shadow:var(--neu-out-sm)}
.online-icon .design-svg-icon{width:48rpx;height:48rpx;stroke:var(--text-inverse);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.online-icon-teal{background:linear-gradient(135deg,var(--brand) 0%,var(--brand-mid) 100%);box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow)}
.online-icon-amber{background:linear-gradient(135deg,var(--accent) 0%,var(--accent-mid) 100%);box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--accent-glow)}
.online-info{flex:1;min-width:0}
.online-name{font-size:32rpx;font-weight:700;color:var(--text-1);letter-spacing:-.01em;margin-bottom:8rpx}
.online-sub{font-size:24rpx;color:var(--text-2);line-height:1.5}
.hotline-num{font-size:38rpx;font-weight:700;color:var(--brand);letter-spacing:-.02em;margin-bottom:4rpx;font-variant-numeric:tabular-nums}
.btn-consult{flex-shrink:0}
.btn-call{flex-shrink:0;gap:12rpx}
.btn-call .design-svg-icon{width:28rpx;height:28rpx;stroke:var(--brand);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* ===== Filter Pills ===== */
.pills{display:flex;gap:16rpx;padding:0 48rpx 28rpx}
.pill{flex-shrink:0;padding:16rpx 36rpx;border-radius:19998rpx;font-size:26rpx;font-weight:600;cursor:pointer;white-space:nowrap;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease),background var(--dur) var(--ease),color var(--dur) var(--ease);border:none;font-family:var(--font);background:var(--bg-elevated);color:var(--text-2);box-shadow:var(--neu-out-sm)}
.pill:active{transform:scale(0.94);box-shadow:var(--neu-in)}
.pill-active{background:var(--brand-subtle);color:var(--brand);box-shadow:var(--neu-in),0 0 0 1rpx var(--brand-subtle)}

/* ===== Ticket Cards ===== */
.ticket-card{position:relative;margin:0 48rpx 24rpx;padding:32rpx;background:var(--surface-1);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:1rpx solid rgba(255,255,255,0.60);border-radius:40rpx;box-shadow:var(--neu-out-sm);cursor:pointer;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.ticket-card:active{transform:scale(0.97);box-shadow:var(--neu-in)}
.ticket-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.type-badge{display:inline-flex;align-items:center;font-size:22rpx;font-weight:700;padding:6rpx 20rpx;border-radius:19998rpx;letter-spacing:.02em}
.type-complaint{color:var(--orange);background:rgba(212,148,76,.07);border:1rpx solid rgba(212,148,76,.14)}
.type-refund{color:var(--blue);background:rgba(90,143,173,0.12);border:1rpx solid rgba(90,143,173,0.22)}
.type-claim{color:var(--red);background:rgba(196,83,58,0.12);border:1rpx solid rgba(196,83,58,0.22)}
.status-badge{display:inline-flex;align-items:center;gap:10rpx;font-size:22rpx;font-weight:600;padding:6rpx 20rpx;border-radius:19998rpx}
.status-badge::before{content:"";width:10rpx;height:10rpx;border-radius:50%;background:currentColor}
.status-processing{color:var(--orange);background:rgba(212,148,76,0.10)}
.status-reply{color:var(--blue);background:rgba(90,143,173,0.10)}
.status-resolved{color:var(--green);background:rgba(91,140,90,0.10)}
.ticket-title{font-size:30rpx;font-weight:600;color:var(--text-1);letter-spacing:-.01em;margin-bottom:24rpx}
.ticket-foot{display:flex;align-items:center;gap:12rpx;font-size:24rpx;color:var(--text-2)}
.ticket-no{font-variant-numeric:tabular-nums;color:var(--text-2)}
.ticket-dot{color:var(--text-3)}
.ticket-time{color:var(--text-3)}
.ticket-view{margin-left:auto;display:inline-flex;align-items:center;gap:4rpx;color:var(--brand);font-weight:600}
.ticket-view .design-svg-icon{width:24rpx;height:24rpx;stroke:var(--brand);fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

/* ===== FAQ Card ===== */
.faq-card{margin:0 48rpx;background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:2rpx solid rgba(255,255,255,0.70);border-radius:var(--radius-md);box-shadow:var(--neu-out-md);overflow:hidden;position:relative}
.faq-card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}
.faq-item{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:32rpx 36rpx;position:relative;cursor:pointer;transition:transform var(--dur) var(--ease),background 0.15s ease}
.faq-item:active{transform:scale(0.98);background:var(--fill)}
.faq-item:not(:last-child)::after{content:"";position:absolute;left:36rpx;right:36rpx;bottom:0;height:1rpx;background:var(--sep)}
.faq-q{flex:1;font-size:30rpx;color:var(--text-1);font-weight:500;letter-spacing:-.01em}
.faq-arrow{width:32rpx;height:32rpx;fill:none;stroke:var(--text-3);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;transition:transform var(--dur) var(--ease)}

/* ===== Bottom Bar ===== */
.bottom-bar{position:sticky;bottom:0;left:0;right:0;z-index:50;padding:28rpx 48rpx 48rpx;background:linear-gradient(180deg,rgba(242,237,232,0) 0%,rgba(242,237,232,0.88) 35%,rgba(242,237,232,0.96) 100%);backdrop-filter:blur(24rpx);-webkit-backdrop-filter:blur(24rpx)}
.btn-submit{width:100%;height:100rpx;font-size:32rpx;border-radius:36rpx}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
