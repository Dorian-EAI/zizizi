/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --phone-bg:#F2EDE8;
  --surface-1:rgba(255,255,255,0.50);
  --surface-2:rgba(255,255,255,0.45);
  --border-glass:1rpx solid rgba(255,255,255,0.60);
  --border-glass-soft:1rpx solid rgba(255,255,255,0.45);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-out-lg:20rpx 20rpx 48rpx var(--neu-dark),-20rpx -20rpx 48rpx var(--neu-light),0 16rpx 64rpx rgba(0,0,0,0.06);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep:inset 10rpx 10rpx 20rpx var(--neu-dark),inset -10rpx -10rpx 20rpx var(--neu-light);
  --icon-raise:10rpx 10rpx 20rpx var(--neu-dark),-10rpx -10rpx 20rpx var(--neu-light);
  --icon-inset:inset 6rpx 6rpx 12rpx var(--neu-dark),inset -6rpx -6rpx 12rpx var(--neu-light);
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:var(--body-bg);letter-spacing:-0.01em}

/* ===== Phone Frame ===== */
.design-canvas-page{position:relative;width:828rpx;min-height:1792rpx;background:var(--phone-bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:164rpx}
.design-canvas-page::-webkit-scrollbar{display:none}
.design-canvas-page{scrollbar-width:none}
.design-canvas-page::after{content:'';position:absolute;bottom:0;left:0;right:0;height:520rpx;background:radial-gradient(ellipse 360rpx 240rpx at 20% 90%,rgba(13,148,136,.05) 0%,transparent 70%),radial-gradient(ellipse 320rpx 200rpx at 80% 85%,rgba(212,148,76,.05) 0%,transparent 70%);pointer-events:none;z-index:0}
.design-canvas-page>*:not(.tab-bar){position:relative;z-index:1}

/* ===== Top Nav Bar (子页返回栏) ===== */
.nav-bar{display:flex;align-items:center;justify-content:space-between; padding:max(36rpx, env(safe-area-inset-top)) 40rpx 28rpx;position:relative;z-index:5; background:radial-gradient(ellipse 440rpx 320rpx at 78% 45%,rgba(212,148,76,.10) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 18% 75%,rgba(13,148,136,.10) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.08) 0%,rgba(212,148,76,.06) 50%,rgba(13,148,136,.05) 100%); border-radius:0 0 56rpx 56rpx; overflow:hidden;}
.back-btn{
  width:80rpx;height:80rpx;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,0.50);color:var(--text-1);
  border:1rpx solid rgba(255,255,255,0.60);
  box-shadow:var(--neu-out-sm),inset 0 2rpx 3rpx rgba(255,255,255,0.50);
  cursor:pointer;
  transition:transform var(--dur) var(--ease),box-shadow var(--dur) var(--ease);
}
.back-btn:active{box-shadow:var(--neu-in);transform:scale(0.90)}
.back-btn .design-svg-icon{width:40rpx;height:40rpx}
.nav-title{font-size:36rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.4rpx}
.nav-placeholder{width:80rpx;flex-shrink:0}

/* ===== Section ===== */
.section{padding:0 48rpx;margin-top:36rpx;position:relative;z-index:2}
.section-title{font-size:32rpx;font-weight:700;color:var(--text-1);padding:0 0 24rpx;letter-spacing:-0.4rpx}

/* ===== Chips (反馈类型) ===== */
.chips-row{display:flex;gap:20rpx;flex-wrap:wrap}
.chip{
  padding:18rpx 36rpx;border-radius:19998rpx;font-size:26rpx;font-weight:600;
  cursor:pointer;white-space:nowrap;border:none;font-family:var(--font);
  background:var(--bg-elevated);color:var(--text-2);box-shadow:var(--neu-out-sm);
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease),background var(--dur) var(--ease),color var(--dur) var(--ease);
}
.chip:active{transform:scale(0.94);box-shadow:var(--neu-in)}
.chip-active{
  background:var(--brand-subtle);color:var(--brand);
  border:2rpx solid var(--brand);
  box-shadow:var(--neu-in),0 0 24rpx var(--brand-glow);
}

/* ===== Glass Card (玻璃新拟态容器) ===== */
.glass-card{
  background:rgba(255,255,255,0.52);
  backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);
  border:2rpx solid rgba(255,255,255,0.70);
  border-radius:var(--radius-md);
  box-shadow:var(--neu-out-md),0 12rpx 56rpx rgba(0,0,0,0.06),0 0 0 2rpx rgba(44,40,36,0.05);
  padding:28rpx 32rpx;position:relative;overflow:hidden;
}
.glass-card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}

/* ===== Textarea (玻璃内陷) ===== */
.textarea{
  width:100%;min-height:240rpx;border:none;outline:none;resize:none;
  background:var(--phone-bg);
  border-radius:var(--radius-sm);
  box-shadow:var(--neu-in);
  padding:28rpx;font-family:var(--font);font-size:28rpx;line-height:1.6;
  color:var(--text-1);
  transition:box-shadow var(--dur) var(--ease);
}
.textarea::placeholder{color:var(--text-3)}
.textarea:focus{box-shadow:var(--neu-in-deep),0 0 0 3rpx var(--brand-subtle)}
.textarea-foot{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:0 8rpx}
.textarea-tip{font-size:22rpx;color:var(--text-3)}
.textarea-count{font-size:22rpx;color:var(--text-3);font-variant-numeric:tabular-nums}

/* ===== Upload Row ===== */
.upload-row{display:flex;gap:24rpx}
.upload-thumb,.upload-add{
  width:192rpx;height:192rpx;border-radius:var(--radius-sm);flex-shrink:0;
  display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12rpx;
  position:relative;overflow:hidden;cursor:pointer;
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease);
}
.upload-thumb{
  background:var(--phone-bg);
  box-shadow:var(--neu-out-sm);
  border:1rpx solid rgba(255,255,255,0.60);
}
.upload-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.upload-del{
  position:absolute;top:12rpx;right:12rpx;width:44rpx;height:44rpx;border-radius:50%;
  background:rgba(44,40,36,0.55);backdrop-filter:blur(16rpx);-webkit-backdrop-filter:blur(16rpx);
  border:1rpx solid rgba(255,255,255,0.30);
  display:flex;align-items:center;justify-content:center;color:#fff;cursor:pointer;
  transition:transform var(--dur) var(--ease);
}
.upload-del:active{transform:scale(0.85)}
.upload-del .design-svg-icon{width:24rpx;height:24rpx}
.upload-add{
  background:rgba(255,255,255,0.40);
  border:3rpx dashed var(--text-3);color:var(--text-3);
}
.upload-add:active{transform:scale(0.95);box-shadow:var(--neu-in)}
.upload-add .design-svg-icon{width:44rpx;height:44rpx}
.upload-add span{font-size:22rpx;font-weight:500}
.upload-tip{font-size:22rpx;color:var(--text-3);margin-top:20rpx;padding-left:8rpx}

/* ===== Input Card (联系方式) ===== */
.input-card{display:flex;align-items:center;gap:24rpx;padding:8rpx 32rpx}
.input-icon{width:40rpx;height:40rpx;color:var(--brand);fill:none;flex-shrink:0}
.text-input{
  flex:1;border:none;outline:none;background:transparent;
  font-family:var(--font);font-size:30rpx;color:var(--text-1);
  padding:28rpx 0;letter-spacing:-0.01em;
}
.text-input::placeholder{color:var(--text-3)}

/* ===== History Card ===== */
.history-card{
  background:rgba(255,255,255,0.52);
  backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);
  border:2rpx solid rgba(255,255,255,0.70);
  border-radius:var(--radius-md);
  box-shadow:var(--neu-out-sm),0 8rpx 36rpx rgba(0,0,0,0.04);
  padding:28rpx 32rpx;margin-bottom:24rpx;position:relative;overflow:hidden;
  cursor:pointer;
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease);
}
.history-card:active{transform:scale(0.98);box-shadow:var(--neu-in)}
.history-card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}
.history-card:last-child{margin-bottom:0}
.history-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.type-badge{
  display:inline-flex;align-items:center;font-size:22rpx;font-weight:600;
  padding:6rpx 20rpx;border-radius:19998rpx;letter-spacing:.02em;
}
.type-badge-teal{color:var(--brand);background:var(--brand-subtle);border:1rpx solid rgba(13,148,136,.11)}
.type-badge-amber{color:var(--accent-dark);background:var(--accent-light);border:1rpx solid rgba(212,148,76,0.16)}
.status-badge{
  display:inline-flex;align-items:center;gap:8rpx;font-size:22rpx;font-weight:600;
  padding:6rpx 20rpx;border-radius:19998rpx;
}
.status-badge::before{content:"";width:10rpx;height:10rpx;border-radius:50%;background:currentColor}
.status-replied{color:var(--green);background:rgba(91,140,90,0.10);border:1rpx solid rgba(91,140,90,0.20)}
.status-pending{color:var(--orange);background:rgba(212,148,76,.07);border:1rpx solid rgba(212,148,76,0.16)}
.history-summary{
  font-size:28rpx;line-height:1.6;color:var(--text-1);letter-spacing:-0.01em;
  margin-bottom:24rpx;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.history-foot{display:flex;align-items:center;justify-content:space-between}
.history-time{font-size:22rpx;color:var(--text-3);font-variant-numeric:tabular-nums}
.history-arrow{
  display:inline-flex;align-items:center;gap:4rpx;font-size:24rpx;font-weight:600;color:var(--brand);
}
.history-arrow .design-svg-icon{width:26rpx;height:26rpx}

/* ===== Submit Bar (底部固定) ===== */
.submit-bar{
  position:absolute;left:0;right:0;bottom:0;z-index:50;
  padding:28rpx 48rpx 56rpx;
  background:linear-gradient(180deg,rgba(242,237,232,0) 0%,rgba(242,237,232,0.92) 30%,rgba(242,237,232,0.98) 100%);
  backdrop-filter:blur(32rpx) saturate(150%);-webkit-backdrop-filter:blur(32rpx) saturate(150%);
}
.btn-submit{
  width:100%;height:104rpx;border:none;border-radius:19998rpx;
  background:var(--brand-gradient);
  color:var(--text-inverse);font-family:var(--font);font-size:32rpx;font-weight:700;
  letter-spacing:.04em;cursor:pointer;
  box-shadow:0 16rpx 40rpx var(--brand-glow),0 4rpx 16rpx rgba(0,0,0,0.08),inset 0 2rpx 2rpx rgba(255,255,255,0.30);
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease);
}
.btn-submit:active{transform:scale(0.97);box-shadow:var(--neu-in),0 8rpx 24rpx var(--brand-glow)}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
