/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#0D9488;--brand-dark:#0A7A70;--brand-mid:#14B8A6;--brand-light:#CCFBF1;
  --brand-glow:rgba(13,148,136,0.18);--brand-subtle:rgba(13,148,136,0.08);
  --brand-gradient:linear-gradient(135deg,#0D9488 0%,#14B8A6 48%,#D4944C 100%);
  --accent:#D4944C;--accent-dark:#A0723C;--accent-light:#F5E6D0;--accent-glow:rgba(212,148,76,0.16);
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);--fill:rgba(44,40,36,0.04);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;
  --font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-out-lg:20rpx 20rpx 48rpx var(--neu-dark),-20rpx -20rpx 48rpx var(--neu-light),0 16rpx 64rpx rgba(0,0,0,0.06);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}

.design-canvas-page{position:relative;width:min(750rpx,100vw);height:1800rpx;min-height:1800rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06)}

/* ===== Hero Section ===== */
.login-hero{position:relative;padding:160rpx 64rpx 80rpx;background:
  radial-gradient(ellipse 600rpx 400rpx at 80% 20%,rgba(212,148,76,.12) 0%,transparent 60%),
  radial-gradient(ellipse 500rpx 360rpx at 15% 60%,rgba(13,148,136,.11) 0%,transparent 60%),
  linear-gradient(160deg,rgba(13,148,136,.08) 0%,rgba(212,148,76,.05) 50%,rgba(13,148,136,.06) 100%);
  border-radius:0 0 80rpx 80rpx;
  text-align:center;
}
.logo-circle{width:192rpx;height:192rpx;border-radius:56rpx;margin:0 auto 48rpx;background:var(--brand-gradient);display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:var(--neu-out-lg),0 16rpx 64rpx var(--brand-glow)}
.app-name{font-size:56rpx;font-weight:700;font-family:var(--font-display);letter-spacing:-0.02em;margin-bottom:16rpx}
.app-slogan{font-size:28rpx;color:var(--text-2);letter-spacing:0.02em}

/* ===== Content ===== */
.login-content{padding:64rpx 48rpx}
.welcome-title{font-size:40rpx;font-weight:700;margin-bottom:16rpx}
.welcome-desc{font-size:27rpx;color:var(--text-2);line-height:1.6;margin-bottom:64rpx}

/* ===== Login Options ===== */
.login-option{display:flex;align-items:center;padding:36rpx 40rpx;margin-bottom:28rpx;background:rgba(255,255,255,0.52);border-radius:var(--r-lg);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-md);cursor:pointer;transition:all var(--dur) var(--spring)}
.login-option:active{box-shadow:var(--neu-in);transform:scale(0.98)}
.login-option-icon{width:80rpx;height:80rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;margin-right:32rpx;flex-shrink:0}
.login-option-icon.wechat{background:linear-gradient(135deg,#07C160,#06AE56);color:#fff}
.login-option-icon.mobile{background:linear-gradient(135deg,var(--brand),var(--brand-mid));color:#fff}
.login-option-text{flex:1}
.login-option-title{font-size:30rpx;font-weight:600;margin-bottom:6rpx}
.login-option-desc{font-size:24rpx;color:var(--text-2)}
.login-option-arrow{color:var(--text-3)}

/* ===== Agreement ===== */
.agreement-section{display:flex;align-items:flex-start;gap:20rpx;padding:40rpx 48rpx 0}
.agreement-checkbox{width:36rpx;height:36rpx;border-radius:12rpx;border:4rpx solid var(--neu-dark);flex-shrink:0;margin-top:2rpx;cursor:pointer;display:flex;align-items:center;justify-content:center}
.agreement-checkbox.checked{background:var(--brand);border-color:var(--brand)}
.agreement-text{font-size:24rpx;color:var(--text-2);line-height:1.6}
.agreement-text a{color:var(--brand);text-decoration:none}

/* ===== Other Login ===== */
.other-login{padding:64rpx 48rpx 32rpx;text-align:center}
.other-login-title{font-size:24rpx;color:var(--text-3);margin-bottom:40rpx;position:relative}
.other-login-title::before,.other-login-title::after{content:"";position:absolute;top:50%;width:120rpx;height:2rpx;background:var(--sep)}
.other-login-title::before{left:80rpx}
.other-login-title::after{right:80rpx}
.other-login-icons{display:flex;justify-content:center;gap:64rpx}
.other-icon{width:80rpx;height:80rpx;border-radius:50%;background:rgba(255,255,255,0.52);box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:var(--text-2);cursor:pointer;transition:all var(--dur) var(--spring)}
.other-icon:active{box-shadow:var(--neu-in);transform:scale(0.92)}

/* ===== Footer ===== */
.login-footer{position:absolute;bottom:48rpx;left:0;right:0;text-align:center;font-size:22rpx;color:var(--text-3)}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
