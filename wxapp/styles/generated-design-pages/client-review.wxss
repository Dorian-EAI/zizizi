/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#0D9488;--brand-dark:#0A7A70;--brand-mid:#14B8A6;--brand-light:#CCFBF1;
  --brand-glow:rgba(13,148,136,0.18);--brand-subtle:rgba(13,148,136,0.08);
  --brand-gradient:linear-gradient(135deg,#0D9488 0%,#14B8A6 48%,#D4944C 100%);
  --accent:#D4944C;--accent-dark:#A0723C;--accent-light:#F5E6D0;--accent-glow:rgba(212,148,76,0.16);
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);--fill:rgba(44,40,36,0.04);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;
  --font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}

.design-canvas-page{position:relative;width:min(750rpx,100vw);height:1800rpx;min-height:1800rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:200rpx}
.mono{font-variant-numeric:tabular-nums;letter-spacing:-0.01em}

/* ===== Top Nav Bar ===== */
.nav-bar{background:radial-gradient(ellipse 440rpx 320rpx at 78% 45%,rgba(212,148,76,.10) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 18% 75%,rgba(13,148,136,.10) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.08) 0%,rgba(212,148,76,.06) 50%,rgba(13,148,136,.05) 100%);position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:36rpx 40rpx;padding-top:max(36rpx,env(safe-area-inset-top));border-radius:0 0 56rpx 56rpx;overflow:hidden}
.nav-icon-btn{width:88rpx;height:88rpx;border-radius:50%;border:none;background:var(--bg-elevated);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.nav-icon-btn:active{box-shadow:var(--neu-in);transform:scale(0.94)}
.nav-title{font-size:34rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em}

/* ===== Section ===== */
.section{padding:32rpx 40rpx 0}
.section-title{font-size:30rpx;font-weight:700;color:var(--text-1);margin-bottom:24rpx}

/* ===== Glass Card ===== */
.glass-neu-card{background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(140%);-webkit-backdrop-filter:blur(40rpx) saturate(140%);border-radius:var(--r-lg);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-md);padding:40rpx;position:relative}
.glass-neu-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2rpx;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.80),transparent);pointer-events:none}

/* ===== Worker Card ===== */
.worker-card{display:flex;align-items:center;gap:28rpx}
.worker-avatar{width:128rpx;height:128rpx;border-radius:40rpx;background:linear-gradient(135deg,var(--brand),var(--brand-mid));box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:#fff;font-size:48rpx;font-weight:600;flex-shrink:0}
.worker-info{flex:1}
.worker-name{font-size:34rpx;font-weight:700;margin-bottom:8rpx}
.worker-service{font-size:26rpx;color:var(--text-2);margin-bottom:8rpx}
.worker-rating{display:flex;align-items:center;gap:8rpx;font-size:24rpx;color:var(--accent)}
.worker-rating .score{font-weight:600}

/* ===== Star Rating ===== */
.star-section{text-align:center;padding:48rpx 0}
.star-label{font-size:28rpx;color:var(--text-2);margin-bottom:32rpx}
.stars{display:flex;justify-content:center;gap:24rpx}
.star{width:96rpx;height:96rpx;cursor:pointer;transition:transform var(--dur) var(--spring)}
.star:active{transform:scale(0.9)}
.star .design-svg-icon{width:100%;height:100%}
.star.active .design-svg-icon{fill:var(--accent);stroke:var(--accent)}
.star-text{margin-top:24rpx;font-size:28rpx;color:var(--accent);font-weight:600}

/* ===== Tag Selector ===== */
.tag-list{display:flex;flex-wrap:wrap;gap:20rpx}
.tag-item{padding:16rpx 32rpx;border-radius:19998rpx;font-size:26rpx;background:rgba(255,255,255,0.52);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm);color:var(--text-2);cursor:pointer;transition:all var(--dur) var(--ease)}
.tag-item:active{box-shadow:var(--neu-in);transform:scale(0.95)}
.tag-item.selected{background:var(--brand);color:#fff;box-shadow:var(--neu-out-sm),0 4rpx 16rpx var(--brand-glow);border-color:transparent}

/* ===== Textarea ===== */
.review-textarea{width:100%;min-height:240rpx;padding:32rpx;border-radius:var(--r-md);background:var(--bg-elevated);border:none;box-shadow:var(--neu-in);font-family:var(--font);font-size:28rpx;color:var(--text-1);resize:none;outline:none;line-height:1.6}
.review-textarea::placeholder{color:var(--text-3)}
.textarea-counter{text-align:right;font-size:24rpx;color:var(--text-3);margin-top:16rpx}

/* ===== Image Upload ===== */
.upload-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20rpx}
.upload-item{aspect-ratio:1;border-radius:24rpx;overflow:hidden;position:relative;background:var(--bg-elevated);box-shadow:var(--neu-out-sm)}
.upload-item img{width:100%;height:100%;object-fit:cover}
.upload-delete{position:absolute;top:8rpx;right:8rpx;width:40rpx;height:40rpx;border-radius:50%;background:rgba(0,0,0,0.5);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx;cursor:pointer}
.upload-add{aspect-ratio:1;border-radius:24rpx;background:var(--bg-elevated);box-shadow:var(--neu-out-sm);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;color:var(--text-3);cursor:pointer;transition:all var(--dur) var(--ease)}
.upload-add:active{box-shadow:var(--neu-in);transform:scale(0.95)}
.upload-add-icon{font-size:48rpx}
.upload-add-text{font-size:22rpx}

/* ===== Anonymous Toggle ===== */
.anon-row{display:flex;align-items:center;justify-content:space-between;padding:32rpx 40rpx;background:rgba(255,255,255,0.52);border-radius:var(--r-md);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm)}
.anon-left{display:flex;align-items:center;gap:20rpx}
.anon-icon{width:72rpx;height:72rpx;border-radius:20rpx;background:var(--bg-elevated);box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:var(--brand)}
.anon-text{font-size:28rpx;font-weight:500}
.anon-desc{font-size:22rpx;color:var(--text-2)}
.toggle{width:88rpx;height:52rpx;border-radius:26rpx;background:var(--neu-dark);box-shadow:var(--neu-in);position:relative;cursor:pointer;transition:background var(--dur) var(--ease)}
.toggle::after{content:"";position:absolute;top:6rpx;left:6rpx;width:40rpx;height:40rpx;border-radius:50%;background:var(--bg-elevated);box-shadow:var(--neu-out-sm);transition:transform var(--dur) var(--spring)}
.toggle.active{background:var(--brand)}
.toggle.active::after{transform:translateX(36rpx)}

/* ===== Submit Bar ===== */
.submit-bar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(750rpx,100vw);z-index:100;padding:24rpx 40rpx;padding-bottom:max(24rpx,env(safe-area-inset-bottom));background:rgba(255,255,255,0.72);backdrop-filter:blur(48rpx) saturate(160%);border-top:1rpx solid rgba(255,255,255,0.60);box-shadow:0 -8rpx 40rpx rgba(0,0,0,0.06)}
.submit-btn{width:100%;padding:32rpx;background:var(--brand-gradient);color:#fff;font-size:32rpx;font-weight:700;border:none;border-radius:19998rpx;cursor:pointer;box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow);transition:all var(--dur) var(--spring)}
.submit-btn:active{transform:scale(0.98);box-shadow:var(--neu-in)}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
