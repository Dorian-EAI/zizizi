/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --phone-bg:#F2EDE8;
  --surface-1:rgba(255,255,255,0.50);
  --surface-2:rgba(255,255,255,0.45);
  --border-glass:1rpx solid rgba(255,255,255,0.60);
  --border-glass-soft:1rpx solid rgba(255,255,255,0.45);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-out-lg:20rpx 20rpx 48rpx var(--neu-dark),-20rpx -20rpx 48rpx var(--neu-light),0 16rpx 64rpx rgba(0,0,0,0.06);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep:inset 10rpx 10rpx 20rpx var(--neu-dark),inset -10rpx -10rpx 20rpx var(--neu-light);
  --icon-raise:10rpx 10rpx 20rpx var(--neu-dark),-10rpx -10rpx 20rpx var(--neu-light);
  --icon-inset:inset 6rpx 6rpx 12rpx var(--neu-dark),inset -6rpx -6rpx 12rpx var(--neu-light);
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:var(--body-bg);letter-spacing:-0.01em}

/* ===== Phone Frame ===== */
.design-canvas-page{position:relative;width:828rpx;min-height:1792rpx;background:var(--phone-bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:164rpx}
.design-canvas-page::-webkit-scrollbar{display:none}
.design-canvas-page{scrollbar-width:none}
.design-canvas-page::after{content:'';position:absolute;bottom:0;left:0;right:0;height:520rpx;background:radial-gradient(ellipse 360rpx 240rpx at 20% 90%,rgba(13,148,136,.05) 0%,transparent 70%),radial-gradient(ellipse 320rpx 200rpx at 80% 85%,rgba(212,148,76,.05) 0%,transparent 70%);pointer-events:none;z-index:0}
.design-canvas-page>*:not(.tab-bar){position:relative;z-index:1}

/* ===== Style Label ===== */
.style-label{position:absolute;top:32rpx;left:32rpx;z-index:100;background:var(--surface-2);backdrop-filter:blur(24rpx) saturate(130%);-webkit-backdrop-filter:blur(24rpx) saturate(130%);border:var(--border-glass-soft);border-radius:20rpx;padding:12rpx 24rpx;font-size:22rpx;font-weight:600;color:var(--brand);letter-spacing:0.6rpx}

/* ===== HERO ===== */
.hero{padding:28rpx 48rpx 48rpx;position:relative;z-index:1;background:radial-gradient(ellipse 440rpx 360rpx at 75% 45%,rgba(212,148,76,.10) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 20% 80%,rgba(13,148,136,.08) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.10) 0%,rgba(212,148,76,.08) 50%,rgba(13,148,136,.05) 100%);border-radius:0 0 64rpx 64rpx;overflow:hidden}

/* Status bar */
.status-bar{display:flex;align-items:center;justify-content:space-between;margin-bottom:32rpx;font-size:26rpx;font-weight:600;color:var(--text-1)}
.status-icons{display:flex;align-items:center;gap:12rpx}
.status-icons .design-svg-icon{width:32rpx;height:32rpx;stroke:var(--text-1);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

/* Glass Search Bar */
.search-bar{display:flex;align-items:center;gap:20rpx;background:var(--surface-2);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:var(--border-glass);border-radius:56rpx;padding:24rpx 36rpx;margin-bottom:32rpx;color:var(--text-3);font-size:28rpx;cursor:pointer;transition:transform var(--dur) var(--spring)}
.search-bar:active{transform:scale(0.97)}
.search-bar .design-svg-icon{width:36rpx;height:36rpx;stroke:var(--text-3);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.search-bar span{font-size:28rpx;color:var(--text-3)}

/* ===== Section Title ===== */
.section-title{font-size:36rpx;font-weight:700;color:var(--text-1);padding:20rpx 48rpx 14rpx;letter-spacing:-0.4rpx}

/* ===== Service Grid ===== */
.service-grid{display:grid;grid-template-columns:repeat(3,202rpx);gap:22rpx;justify-content:center;padding:22rpx 48rpx}
.service-card{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;width:202rpx;height:180rpx;background:var(--surface-1);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:1rpx solid rgba(255,255,255,0.75);border-radius:44rpx;box-shadow:var(--neu-out-md),inset 0 3rpx 4rpx rgba(255,255,255,0.65);padding:16rpx 12rpx;cursor:pointer;text-decoration:none;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.service-card:active{transform:scale(0.95);box-shadow:var(--neu-in)}
.icon-circle{width:80rpx;height:80rpx;border-radius:50%;flex-shrink:0;background:var(--phone-bg);box-shadow:var(--icon-raise),inset 0 3rpx 4rpx rgba(255,255,255,0.65);display:flex;align-items:center;justify-content:center;transition:box-shadow var(--dur) var(--ease),transform var(--dur) var(--spring)}
.service-card:active .icon-circle{box-shadow:var(--neu-in);transform:scale(0.94)}
.icon-circle .design-svg-icon{width:44rpx;height:44rpx;stroke:var(--brand);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.service-name{font-size:24rpx;color:var(--text-1);font-weight:600;white-space:nowrap}

/* ===== Category Chips ===== */
.chips-row{display:flex;gap:16rpx;overflow-x:auto;padding:20rpx 48rpx 22rpx;scrollbar-width:none}
.chips-row::-webkit-scrollbar{display:none}
.chip{flex-shrink:0;padding:16rpx 36rpx;border-radius:19998rpx;font-size:26rpx;font-weight:600;text-align:center;cursor:pointer;white-space:nowrap;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease),background var(--dur) var(--ease),color var(--dur) var(--ease);border:none;font-family:var(--font);background:var(--bg-elevated);color:var(--text-2);box-shadow:var(--neu-out-sm)}
.chip:active{transform:scale(0.94);box-shadow:var(--neu-in)}
.chip-active{background:var(--brand-subtle);color:var(--brand);box-shadow:var(--neu-in),0 0 0 1rpx var(--brand-subtle)}

/* ===== AI Assistant Card ===== */
.ai-card{margin:28rpx 48rpx 0;padding:32rpx;display:flex;align-items:center;gap:28rpx;border-radius:48rpx;background:radial-gradient(ellipse 480rpx 400rpx at 75% 40%,rgba(212,148,76,.16) 0%,transparent 70%),radial-gradient(ellipse 400rpx 320rpx at 20% 80%,rgba(13,148,136,.12) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.12) 0%,rgba(212,148,76,.14) 50%,rgba(20,184,166,.12) 100%);box-shadow:var(--neu-out-md),0 16rpx 56rpx rgba(13,148,136,.07);cursor:pointer;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.ai-card:active{transform:scale(0.97);box-shadow:var(--neu-in)}
.ai-icon{width:84rpx;height:84rpx;flex-shrink:0;border-radius:28rpx;background:linear-gradient(135deg,var(--brand) 0%,var(--brand-mid) 50%,var(--accent) 100%);box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:var(--text-inverse)}
.ai-icon .design-svg-icon{width:48rpx;height:48rpx}
.ai-text{flex:1;min-width:0}
.ai-title{font-size:32rpx;font-weight:700;color:var(--text-1);margin-bottom:6rpx;letter-spacing:-0.01em}
.ai-desc{font-size:24rpx;color:var(--text-2)}


/* ===== Recommend Masters (horizontal cards like reference) ===== */
.recommend-card{display:flex;align-items:center;gap:28rpx;margin:0 48rpx 22rpx;background:var(--surface-1);backdrop-filter:blur(32rpx) saturate(140%);-webkit-backdrop-filter:blur(32rpx) saturate(140%);border:var(--border-glass-soft);border-radius:40rpx;box-shadow:var(--neu-out-sm);padding:28rpx;cursor:pointer;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.recommend-card:active{transform:scale(0.97);box-shadow:var(--neu-in)}
.avatar{width:88rpx;height:88rpx;border-radius:50%;flex-shrink:0;position:relative;overflow:hidden;background:linear-gradient(145deg,rgba(255,255,255,0.68) 0%,rgba(255,255,255,0.28) 40%,var(--brand-subtle) 78%,rgba(255,255,255,0.18) 100%);backdrop-filter:blur(20rpx) saturate(160%);-webkit-backdrop-filter:blur(20rpx) saturate(160%);border:1rpx solid rgba(255,255,255,0.75);box-shadow:inset 0 4rpx 6rpx rgba(255,255,255,0.88),inset 0 -2rpx 4rpx rgba(0,0,0,0.04),var(--icon-raise);display:flex;align-items:center;justify-content:center}
.avatar::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(160deg,rgba(255,255,255,0.48) 0%,rgba(255,255,255,0.12) 35%,transparent 60%);pointer-events:none}
.avatar .design-svg-icon{width:52rpx;height:52rpx;stroke:var(--green);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.recommend-info{flex:1;min-width:0}
.recommend-name{font-size:30rpx;font-weight:700;color:var(--text-1);margin-bottom:4rpx}
.recommend-sub{font-size:24rpx;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.recommend-price{font-size:36rpx;font-weight:700;color:var(--accent);white-space:nowrap}

/* ===== Recommended Services Scroll ===== */
.rec-scroll{display:flex;gap:24rpx;overflow-x:auto;padding:0 48rpx 16rpx;scrollbar-width:none}
.rec-scroll::-webkit-scrollbar{display:none}
.rec-card{flex-shrink:0;width:360rpx;background:var(--surface-1);backdrop-filter:blur(32rpx) saturate(140%);-webkit-backdrop-filter:blur(32rpx) saturate(140%);border:var(--border-glass-soft);border-radius:40rpx;box-shadow:var(--neu-out-sm);overflow:hidden;padding:20rpx;cursor:pointer;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.rec-card:active{transform:scale(0.96);box-shadow:var(--neu-in)}
.rec-img{width:100%;height:200rpx;border-radius:28rpx;overflow:hidden;margin-bottom:20rpx;display:flex;align-items:center;justify-content:center;position:relative;box-shadow:inset 4rpx 4rpx 12rpx rgba(0,0,0,0.12)}
.rec-img-label{font-size:28rpx;font-weight:700;color:var(--text-inverse);text-shadow:0 2rpx 8rpx rgba(0,0,0,0.18);position:relative;z-index:2;letter-spacing:0.02em}
.rec-title{font-size:28rpx;font-weight:600;color:var(--text-1);margin-bottom:8rpx;letter-spacing:-0.01em}
.rec-meta{display:flex;align-items:center;gap:12rpx;font-size:22rpx;color:var(--text-2);margin-bottom:20rpx}
.rec-star{display:inline-flex;align-items:center;gap:6rpx;color:var(--orange);font-weight:600}
.rec-star .design-svg-icon{width:24rpx;height:24rpx;color:var(--orange)}
.rec-bottom{display:flex;align-items:center;justify-content:space-between}
.rec-price{display:flex;align-items:baseline;gap:2rpx}
.rec-price .currency{font-size:24rpx;color:var(--red);font-weight:600}
.rec-price .amount{font-size:38rpx;color:var(--red);font-weight:700;letter-spacing:-0.02em}
/* ===== Custom Title Bar (search only) ===== */
.title-bar{
  position:fixed;top:0;left:0;right:0;height:176rpx;padding-top:88rpx;
  display:flex;align-items:center;justify-content:center;
  padding-left:32rpx;padding-right:32rpx;
  background:rgba(242,237,232,0);backdrop-filter:blur(0rpx);-webkit-backdrop-filter:blur(0rpx);
  opacity:0;z-index:100;pointer-events:none;
  transition:background .3s ease,backdrop-filter .3s ease,opacity .25s ease;
}
.title-bar.visible{
  background:rgba(242,237,232,0.95);backdrop-filter:blur(48rpx) saturate(180%);-webkit-backdrop-filter:blur(48rpx) saturate(180%);
  opacity:1;pointer-events:auto;
}
.title-bar__search{
  width:100%;height:72rpx;display:flex;align-items:center;gap:16rpx;padding:0 28rpx;
  background:rgba(255,255,255,0.72);border:1rpx solid rgba(255,255,255,0.60);
  border-radius:36rpx;box-shadow:var(--neu-out-sm);
  backdrop-filter:blur(40rpx) saturate(160%);-webkit-backdrop-filter:blur(40rpx) saturate(160%);
  color:var(--text-3);font-size:26rpx;cursor:pointer;
}
.title-bar__search .design-svg-icon{width:30rpx;height:30rpx;stroke:var(--text-3);fill:none;flex-shrink:0}
.title-bar__search span{font-size:26rpx;color:var(--text-3)}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
