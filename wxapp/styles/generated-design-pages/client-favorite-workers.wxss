/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --phone-bg:#F2EDE8;
  --border-glass:1rpx solid rgba(255,255,255,0.60);
  --border-glass-soft:1rpx solid rgba(255,255,255,0.45);
  --icon-raise:10rpx 10rpx 20rpx var(--neu-dark),-10rpx -10rpx 20rpx var(--neu-light);
  --icon-inset:inset 6rpx 6rpx 12rpx var(--neu-dark),inset -6rpx -6rpx 12rpx var(--neu-light);
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:var(--body-bg);letter-spacing:-0.01em}

/* ===== Phone Frame ===== */
.design-canvas-page{position:relative;width:828rpx;min-height:1792rpx;background:var(--phone-bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:164rpx}
.design-canvas-page::-webkit-scrollbar{display:none}
.design-canvas-page{scrollbar-width:none}
.design-canvas-page::after{content:'';position:absolute;bottom:0;left:0;right:0;height:520rpx;background:radial-gradient(ellipse 360rpx 240rpx at 20% 90%,rgba(13,148,136,.05) 0%,transparent 70%),radial-gradient(ellipse 320rpx 200rpx at 80% 85%,rgba(212,148,76,.05) 0%,transparent 70%);pointer-events:none;z-index:0}
.design-canvas-page>*:not(.tab-bar):not(.top-header){position:relative;z-index:1}

/* Top Header */
.top-header{position:sticky;top:0;z-index:50}

/* Hero */
.hero{padding: max(76rpx, env(safe-area-inset-top)) 48rpx 48rpx;position:relative;z-index:1;background:radial-gradient(ellipse 480rpx 400rpx at 75% 40%,rgba(212,148,76,.16) 0%,transparent 70%),radial-gradient(ellipse 400rpx 320rpx at 20% 80%,rgba(13,148,136,.12) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.12) 0%,rgba(212,148,76,.14) 50%,rgba(20,184,166,.12) 100%);border-radius:0 0 64rpx 64rpx}
.hero::before{content:"";position:absolute;top:-40%;right:-20%;width:600rpx;height:600rpx;background:radial-gradient(circle,rgba(255,255,255,0.15) 0%,transparent 70%);border-radius:50%;pointer-events:none}
.hero::after{content:"";position:absolute;bottom:-30%;left:-10%;width:440rpx;height:440rpx;background:radial-gradient(circle,rgba(200,255,250,0.10) 0%,transparent 70%);border-radius:50%;pointer-events:none}
.nav-content{display:grid;grid-template-columns:80rpx 1fr auto;align-items:center;gap:16rpx;position:relative;z-index:2}
.nav-back{width:80rpx;height:80rpx;border-radius:50%;background:rgba(255,255,255,0.18);backdrop-filter:blur(32rpx);-webkit-backdrop-filter:blur(32rpx);border:1rpx solid rgba(255,255,255,0.30);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;box-shadow:inset 0 2rpx 4rpx rgba(255,255,255,0.3);flex-shrink:0;transition:transform var(--dur) var(--spring),background 0.2s var(--ease)}
.nav-back:active{transform:scale(0.85);background:rgba(255,255,255,0.32)}
.nav-back .design-svg-icon{width:40rpx;height:40rpx;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.nav-title{font-size:32rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em;text-align:center;justify-self:center}
.nav-edit{width:84rpx;height:84rpx;border-radius:50%;background:rgba(255,255,255,0.18);backdrop-filter:blur(32rpx);-webkit-backdrop-filter:blur(32rpx);border:1rpx solid rgba(255,255,255,0.30);box-shadow:inset 0 2rpx 4rpx rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;transition:transform var(--dur) var(--spring),background 0.2s var(--ease)}
.nav-edit:active{transform:scale(0.85);background:rgba(255,255,255,0.32)}
.nav-edit .design-svg-icon{width:44rpx;height:44rpx;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* Filter Pills (overlaps hero) */
.filter-tabs{margin:-36rpx 40rpx 0;background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:2rpx solid rgba(255,255,255,0.70);border-radius:var(--radius-md);box-shadow:var(--neu-out-md),0 12rpx 56rpx rgba(0,0,0,0.06),0 0 0 2rpx rgba(44,40,36,0.05);padding:16rpx;display:flex;gap:12rpx;position:relative;z-index:10}
.filter-tabs::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}

.filter-pill{flex:1;text-align:center;padding:20rpx 0;border-radius:var(--radius-sm);font-size:27rpx;font-weight:600;color:var(--text-2);cursor:pointer;white-space:nowrap;transition:transform var(--dur) var(--spring),all 0.2s var(--ease);border:none;background:transparent;font-family:var(--font)}
.filter-pill:active{transform:scale(0.94)}
.filter-pill:not(.active){background:var(--bg-elevated);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45)}
.filter-pill.active{background:rgba(13,148,136,.08);box-shadow:inset 4rpx 4rpx 10rpx var(--neu-dark),inset -4rpx -4rpx 10rpx var(--neu-light);color:var(--brand)}

/* ===== Section Title ===== */
.section-title{font-size:32rpx;font-weight:700;color:var(--text-1);padding:28rpx 40rpx 20rpx;letter-spacing:-0.4rpx}

/* ===== Worker List ===== */
.worker-list{padding:12rpx 40rpx 8rpx}

/* ===== Worker Card (玻璃新拟态) ===== */
.worker-card{margin-bottom:28rpx;padding:32rpx;background:var(--surface-1);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:var(--border-glass-soft);border-radius:44rpx;box-shadow:var(--neu-out-md);position:relative;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.worker-card:active{transform:scale(0.985);box-shadow:var(--neu-out-sm)}
.worker-card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}

.worker-head{display:flex;align-items:flex-start;gap:28rpx}

/* Avatar + Level Badge */
.avatar-wrap{display:flex;flex-direction:column;align-items:center;gap:10rpx;flex-shrink:0;width:104rpx}
.avatar{width:88rpx;height:88rpx;border-radius:50%;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:44rpx;font-weight:700;color:var(--brand-dark);letter-spacing:0;background:linear-gradient(145deg,rgba(255,255,255,0.68) 0%,rgba(255,255,255,0.28) 40%,var(--brand-subtle) 78%,rgba(255,255,255,0.18) 100%);backdrop-filter:blur(20rpx) saturate(160%);-webkit-backdrop-filter:blur(20rpx) saturate(160%);border:1rpx solid rgba(255,255,255,0.75);box-shadow:inset 0 4rpx 6rpx rgba(255,255,255,0.88),inset 0 -2rpx 4rpx rgba(0,0,0,0.04),var(--icon-raise)}
.avatar::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(160deg,rgba(255,255,255,0.48) 0%,rgba(255,255,255,0.12) 35%,transparent 60%);pointer-events:none}
.level-badge{font-size:18rpx;font-weight:700;color:#fff;padding:4rpx 16rpx;border-radius:19998rpx;white-space:nowrap;border:1rpx solid rgba(255,255,255,0.55);box-shadow:0 4rpx 12rpx rgba(0,0,0,0.12);letter-spacing:0.4rpx}
.level-badge.gold{background:linear-gradient(135deg,var(--accent) 0%,var(--accent-dark) 100%);box-shadow:0 4rpx 12rpx rgba(212,148,76,.16)}
.level-badge.normal{background:linear-gradient(135deg,var(--brand) 0%,var(--brand-dark) 100%);box-shadow:0 4rpx 12rpx rgba(13,148,136,.12)}

/* Worker Info */
.worker-info{flex:1;min-width:0;padding-top:4rpx}
.name-row{display:flex;align-items:center;gap:16rpx;margin-bottom:12rpx}
.worker-name{font-size:32rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.01em}
.rating{display:inline-flex;align-items:center;gap:6rpx;font-size:26rpx;font-weight:700;color:var(--orange)}
.rating .design-svg-icon{width:26rpx;height:26rpx;color:var(--orange)}
.meta-row{display:flex;align-items:center;gap:16rpx;font-size:24rpx;color:var(--text-2);margin-bottom:18rpx;font-weight:500}
.meta-item{display:inline-flex;align-items:center;gap:6rpx}
.meta-ico{width:24rpx;height:24rpx;stroke:var(--text-2);fill:none;flex-shrink:0}
.dot-sep{width:6rpx;height:6rpx;border-radius:50%;background:var(--text-3);flex-shrink:0}

/* Tag Chips */
.tag-chips{display:flex;gap:12rpx;flex-wrap:wrap}
.tag-chip{font-size:22rpx;font-weight:600;color:var(--brand);background:var(--brand-subtle);padding:6rpx 18rpx;border-radius:19998rpx;border:1rpx solid rgba(13,148,136,.10)}

/* Worker Foot */
.worker-foot{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:28rpx;padding-top:28rpx;border-top:1rpx solid var(--sep)}
.auth-badges{display:flex;gap:12rpx;flex-wrap:wrap;min-width:0}
.auth-badge{display:inline-flex;align-items:center;gap:6rpx;font-size:22rpx;font-weight:600;color:var(--green);background:rgba(91,140,90,0.10);padding:6rpx 16rpx;border-radius:14rpx;border:1rpx solid rgba(91,140,90,0.16);white-space:nowrap}
.auth-badge .design-svg-icon{width:22rpx;height:22rpx;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.actions{display:flex;gap:20rpx;flex-shrink:0}

/* ===== btn-neu-primary base (head 仅有 :active) ===== */
.btn-neu-primary{
  display:inline-flex;align-items:center;justify-content:center;
  background:var(--brand-gradient);
  color:var(--text-inverse);
  border:1rpx solid rgba(13,148,136,.12);border-radius:19998rpx;
  padding:16rpx 36rpx;font-size:26rpx;font-weight:600;font-family:var(--font);
  cursor:pointer;
  box-shadow:var(--neu-out-sm),0 8rpx 24rpx rgba(13,148,136,.12);
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease);
}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
