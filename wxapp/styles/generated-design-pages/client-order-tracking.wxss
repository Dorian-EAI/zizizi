/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
/* === 实时追踪页滚动变形（client-order-tracking → client-order-tracking-2）=== */
      /* 在微信小程序中：这些变量通过 setData 注入 WXML 的 style；HTML 原型用 scroll 事件直接更新。 */
      .design-canvas-page {
        --morph-p: 0;
        --reveal-p: 0;
        --nav-pt: 36rpx;
        --nav-pb: 36rpx;
        --nav-ph: 40rpx;
        --nav-radius: 56rpx;
        --btn-size: 88rpx;
        --map-h: 840rpx;
        --status-translate: 0rpx;
        --status-mt: -64rpx;
      }

      .nav-bar.morphing {
        display: grid;
        grid-template-columns: var(--btn-size) 1fr var(--btn-size);
        gap: 16rpx;
        align-items: center;
        padding: var(--nav-pt) var(--nav-ph) var(--nav-pb);
        border-radius: 0 0 var(--nav-radius) var(--nav-radius);
        will-change: padding, border-radius;
      }
      /* Hero 渐变在滚动中渐入覆盖原导航栏渐变 */
      .nav-bar.morphing::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        pointer-events: none;
        opacity: var(--morph-p);
        background:
          radial-gradient(ellipse 480rpx 400rpx at 75% 40%, rgba(212,148,76,.16) 0%, transparent 70%),
          radial-gradient(ellipse 400rpx 320rpx at 20% 80%, rgba(13,148,136,.12) 0%, transparent 70%),
          linear-gradient(135deg, rgba(13,148,136,.12) 0%, rgba(212,148,76,.14) 50%, rgba(20,184,166,.12) 100%);
        transition: opacity 0.05s linear;
      }
      .nav-bar.morphing .nav-title {
        font-size: calc(34rpx + 10rpx * var(--morph-p));
        text-align: center;
        justify-self: center;
        transition: font-size 0.05s linear;
      }
      .nav-bar.morphing .nav-icon-btn {
        width: var(--btn-size);
        height: var(--btn-size);
        transition: width 0.05s linear, height 0.05s linear;
      }

      /* 地图区域收缩 */
      .tracking-map-section .tracking-map {
        height: var(--map-h);
        transform: scale(calc(1 - 0.08 * var(--morph-p)));
        opacity: calc(1 - 0.7 * var(--morph-p));
        transform-origin: center center;
        transition: height 0.05s linear, transform 0.05s linear, opacity 0.05s linear;
      }
      .tracking-map-section::before {
        opacity: calc(1 - var(--morph-p));
        transition: opacity 0.05s linear;
      }

      /* 状态横幅从地图底部漂浮到 Hero 下方（filter-tabs 位置） */
      .design-canvas-page .tracking-status-bar {
        position: relative;
        z-index: 40;
        transform: translateY(var(--status-translate));
        margin-top: var(--status-mt);
        padding: calc(32rpx - 4rpx * var(--morph-p)) 36rpx;
        transition: transform 0.05s linear, margin-top 0.05s linear, padding 0.05s linear;
      }

      /* 内容区域滚动揭示 */
      .morph-reveal,
      .morph-reveal-item {
        opacity: var(--item-reveal-p, var(--reveal-p, 0));
        transform: translateY(calc(32rpx * (1 - var(--item-reveal-p, var(--reveal-p, 0)))));
        transition: opacity 0.05s linear, transform 0.05s linear;
      }

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
