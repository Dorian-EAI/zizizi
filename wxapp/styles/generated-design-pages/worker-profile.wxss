/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
page {
  --brand:#2D6CDF;--brand-dark:#2456B8;--brand-light:#DCE8FB;
  --brand-glow:rgba(45,108,223,0.18);--brand-subtle:rgba(45,108,223,0.08);
  --brand-gradient:linear-gradient(135deg,#2D6CDF 0%,#5A8EE8 48%,#D4944C 100%);
  --accent:#D4944C;--accent-light:#F5E6D0;--accent-glow:rgba(212,148,76,0.16);
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);--fill:rgba(44,40,36,0.04);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;--yellow:#D4944C;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;--r-tab:48rpx;
  /* Font */--font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:10rpx 10rpx 24rpx var(--neu-dark),-10rpx -10rpx 24rpx var(--neu-light);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light);
  --neu-out-lg:20rpx 20rpx 48rpx var(--neu-dark),-20rpx -20rpx 48rpx var(--neu-light);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep:inset 10rpx 10rpx 20rpx var(--neu-dark),inset -10rpx -10rpx 20rpx var(--neu-light);
  --glass-tab-bg:rgba(255,255,255,0.18);--glass-tab-blur:blur(96rpx) saturate(210%);--glass-tab-border:rgba(255,255,255,0.45);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}
.design-canvas-page{position:relative;width:828rpx;min-height:1792rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:164rpx}
.design-canvas-page::after{content:'';position:absolute;bottom:0;left:0;right:0;height:520rpx;background:radial-gradient(ellipse 400rpx 280rpx at 20% 90%,rgba(45,108,223,.04) 0%,transparent 70%),radial-gradient(ellipse 360rpx 240rpx at 80% 85%,rgba(212,148,76,.04) 0%,transparent 70%),radial-gradient(ellipse 320rpx 200rpx at 50% 95%,rgba(45,108,223,.04) 0%,transparent 70%);pointer-events:none;z-index:0}
.design-canvas-page>*:not(.tab-bar){position:relative;z-index:1}

/* Hero */
.hero{padding: max(76rpx, env(safe-area-inset-top)) 48rpx 112rpx;position:relative;z-index:1;background:radial-gradient(ellipse 480rpx 400rpx at 25% 40%,rgba(212,148,76,.12) 0%,transparent 70%),radial-gradient(ellipse 400rpx 320rpx at 80% 80%,rgba(45,108,223,.12) 0%,transparent 70%),linear-gradient(135deg,rgba(45,108,223,0.18) 0%,rgba(212,148,76,.08) 50%,rgba(45,108,223,.06) 100%);border-radius:0 0 64rpx 64rpx;overflow:hidden}

/* Profile Row */
.profile-row{display:flex;align-items:center;gap:28rpx;position:relative;z-index:2}
.avatar-col{display:flex;flex-direction:column;align-items:center;gap:10rpx;flex-shrink:0}
.avatar{width:96rpx;height:96rpx;border-radius:50%;flex-shrink:0;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;z-index:1;transition:transform var(--dur) var(--ease);background:var(--bg);box-shadow:inset 6rpx 6rpx 12rpx var(--neu-dark),inset -6rpx -6rpx 12rpx var(--neu-light)}
.avatar.avatar-glass{background:linear-gradient(145deg,rgba(255,255,255,0.68) 0%,rgba(255,255,255,0.28) 40%,var(--brand-subtle) 78%,rgba(255,255,255,0.18) 100%);backdrop-filter:blur(20rpx) saturate(160%);-webkit-backdrop-filter:blur(20rpx) saturate(160%);border:1rpx solid rgba(255,255,255,0.75);box-shadow:inset 0 4rpx 6rpx rgba(255,255,255,0.88),inset 0 -2rpx 4rpx rgba(0,0,0,0.04),var(--neu-out-sm)}
.avatar.avatar-glass::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(160deg,rgba(255,255,255,0.48) 0%,rgba(255,255,255,0.12) 35%,transparent 60%);pointer-events:none}
.avatar:active{transform:scale(0.97)}
.avatar .design-svg-icon{width:52rpx;height:52rpx;stroke:var(--brand);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.profile-info{flex:1;min-width:0}
.name-row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}
.profile-name{font-size:40rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em;line-height:1.2}
.verify-badge{display:inline-flex;align-items:center;gap:6rpx;background:rgba(255,255,255,0.45);backdrop-filter:blur(24rpx);-webkit-backdrop-filter:blur(24rpx);border:2rpx solid rgba(255,255,255,0.70);color:var(--brand);font-size:22rpx;font-weight:600;padding:6rpx 18rpx;border-radius:var(--r-pill);line-height:1.4;letter-spacing:0.01em}
.verify-badge .design-svg-icon{width:22rpx;height:22rpx;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

/* Edit Button */
.edit-btn{width:72rpx;height:72rpx;background:rgba(255,255,255,0.50);backdrop-filter:blur(24rpx);-webkit-backdrop-filter:blur(24rpx);border:2rpx solid rgba(255,255,255,0.75);color:var(--brand);border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform var(--dur) var(--ease),box-shadow 0.15s var(--ease);flex-shrink:0;box-shadow:var(--neu-out-sm),inset 0 2rpx 3rpx rgba(255,255,255,0.50)}
.edit-btn:active{box-shadow:var(--neu-in);transform:scale(0.96)}
.edit-btn .design-svg-icon{width:30rpx;height:30rpx;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* Rating Row */
.rating-row{display:flex;align-items:center;gap:16rpx;margin-top:28rpx;position:relative;z-index:2}
.rating-chip{display:inline-flex;align-items:center;gap:8rpx;font-size:26rpx;color:var(--text-1);font-weight:600}
.rating-chip .design-svg-icon{width:28rpx;height:28rpx;color:var(--orange);fill:var(--orange);flex-shrink:0}
.rating-divider{width:6rpx;height:6rpx;border-radius:50%;background:var(--text-3);flex-shrink:0}
.service-count{font-size:26rpx;color:var(--text-2);font-weight:500}

/* Stats Card */
.stats-card{position:relative;z-index:10;margin:-48rpx 48rpx 0;padding:40rpx 24rpx;background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(160%);-webkit-backdrop-filter:blur(40rpx) saturate(160%);border:2rpx solid rgba(255,255,255,0.70);border-radius:var(--r-lg);box-shadow:var(--neu-out-lg),0 20rpx 72rpx rgba(0,0,0,0.08),0 0 0 2rpx rgba(44,40,36,0.05),0 4rpx 16rpx rgba(20,184,166,0.04);display:flex;align-items:center}
.stats-card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}
.stat-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:12rpx;position:relative;padding:0 16rpx;cursor:pointer;transition:transform var(--dur) var(--ease)}
.stat-col:active{transform:scale(0.97)}
.stat-col:not(:last-child)::after{content:"";position:absolute;right:0;top:16rpx;bottom:16rpx;width:1rpx;background:var(--sep)}
.stat-num{font-size:48rpx;font-weight:700;color:var(--text-1);letter-spacing:-1rpx;line-height:1;font-variant-numeric:tabular-nums;position:relative;z-index:1}
.stat-num.brand{color:var(--brand)}
.stat-label{font-size:24rpx;color:var(--text-2);line-height:1;font-weight:500;position:relative;z-index:1}

/* Section + Menu Card */
.section{padding:0 48rpx;margin-top:36rpx;position:relative;z-index:5}
.section-title{font-size:34rpx;font-weight:700;color:var(--text-1);margin:0 8rpx 20rpx;letter-spacing:-0.02em}
.card{background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:2rpx solid rgba(255,255,255,0.70);border-radius:var(--r-lg);box-shadow:var(--neu-out-md),0 12rpx 48rpx rgba(0,0,0,0.06),0 0 0 2rpx rgba(44,40,36,0.05),0 4rpx 16rpx rgba(20,184,166,0.04);overflow:hidden;position:relative}
.card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}
.menu-card{overflow:hidden;padding:8rpx 0}
.menu-row{display:flex;align-items:center;gap:28rpx;padding:28rpx 36rpx;position:relative;cursor:pointer;transition:transform var(--dur) var(--ease);z-index:1}
.menu-row:active{transform:scale(0.97)}
.menu-row:not(:last-child)::after{content:"";position:absolute;left:128rpx;right:36rpx;bottom:0;height:1rpx;background:var(--sep)}

/* Menu Icons */
.menu-icon{width:68rpx;height:68rpx;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--bg);box-shadow:8rpx 8rpx 16rpx var(--neu-dark),-8rpx -8rpx 16rpx var(--neu-light),inset 0 2rpx 2rpx rgba(255,255,255,0.45)}
.menu-icon .design-svg-icon{width:36rpx;height:36rpx;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.menu-icon-coral{color:var(--red)}
.menu-icon-teal{color:var(--brand)}
.menu-icon-blue{color:var(--blue)}
.menu-icon-amber{color:var(--orange)}
.menu-icon-purple{color:var(--brand)}
.menu-icon-gray{color:var(--text-2)}
.menu-icon-green{color:var(--green)}
.menu-label{flex:1;font-size:30rpx;color:var(--text-1);font-weight:500;letter-spacing:-0.01em}
.menu-value{font-size:28rpx;color:var(--text-2);font-weight:500;margin-right:4rpx;text-align:right;max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.menu-value.green{color:var(--green);font-weight:600}
.menu-chevron{width:28rpx;height:28rpx;fill:none;stroke:var(--text-3);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}




/* Reduced Motion */

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
