/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#2D6CDF;--brand-dark:#2456B8;--brand-light:#DCE8FB;
  --brand-glow:rgba(45,108,223,0.18);--brand-subtle:rgba(45,108,223,0.08);
  --brand-gradient:linear-gradient(135deg,#2D6CDF 0%,#5A8EE8 48%,#D4944C 100%);
  --accent:#D4944C;--accent-light:#F5E6D0;--accent-glow:rgba(212,148,76,0.16);
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);--fill:rgba(44,40,36,0.04);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;--r-tab:48rpx;
  /* Font */--font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:10rpx 10rpx 24rpx var(--neu-dark),-10rpx -10rpx 24rpx var(--neu-light);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light);
  --neu-out-lg:20rpx 20rpx 48rpx var(--neu-dark),-20rpx -20rpx 48rpx var(--neu-light);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep:inset 10rpx 10rpx 20rpx var(--neu-dark),inset -10rpx -10rpx 20rpx var(--neu-light);
  --glass-tab-bg:rgba(255,255,255,0.18);--glass-tab-blur:blur(96rpx) saturate(210%);--glass-tab-border:rgba(255,255,255,0.45);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}
.design-canvas-page{position:relative;width:828rpx;min-height:1792rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:192rpx}
.design-canvas-page::after{content:'';position:absolute;bottom:0;left:0;right:0;height:520rpx;background:radial-gradient(ellipse 400rpx 280rpx at 20% 90%,rgba(45,108,223,.04) 0%,transparent 70%),radial-gradient(ellipse 360rpx 240rpx at 80% 85%,rgba(212,148,76,.04) 0%,transparent 70%),radial-gradient(ellipse 320rpx 200rpx at 50% 95%,rgba(45,108,223,.04) 0%,transparent 70%);pointer-events:none;z-index:0}
.design-canvas-page>*:not(.tab-bar){position:relative;z-index:1}

/* ===== Section + card (同参考页) ===== */
.section{padding:0 48rpx;margin-top:40rpx;position:relative;z-index:5}
.section-title{font-size:34rpx;font-weight:700;color:var(--text-1);margin-bottom:24rpx;letter-spacing:-0.02em;display:flex;align-items:center;justify-content:space-between}
.section-title .more{font-size:26rpx;font-weight:500;color:var(--text-3)}

.card{background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:2rpx solid rgba(255,255,255,0.70);border-radius:var(--r);box-shadow:var(--neu-out-md),0 12rpx 48rpx rgba(0,0,0,0.06),0 0 0 2rpx rgba(44,40,36,0.05),0 4rpx 16rpx rgba(20,184,166,0.04);overflow:hidden;position:relative}
.card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}

/* ===== btn-neu-primary 基础态补全（head 仅有 :active） ===== */
.btn-neu-primary{
  display:inline-flex;align-items:center;justify-content:center;gap:12rpx;
  background:var(--brand-gradient);color:#fff;
  border:none;border-radius:19998rpx;
  padding:28rpx 48rpx;font-size:30rpx;font-weight:600;font-family:var(--font);
  cursor:pointer;
  box-shadow:var(--neu-out-sm),0 12rpx 36rpx var(--brand-glow);
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease);
}
.btn-neu-primary:active{box-shadow:var(--neu-in);transform:scale(0.94)}

/* ===== Exam Hero / 返回栏 ===== */
.exam-hero{padding: max(48rpx, env(safe-area-inset-top)) 48rpx 32rpx;
  position:relative;z-index:1;
  background:radial-gradient(ellipse 480rpx 400rpx at 25% 40%,rgba(212,148,76,.12) 0%,transparent 70%),radial-gradient(ellipse 400rpx 320rpx at 80% 80%,rgba(45,108,223,.12) 0%,transparent 70%),linear-gradient(135deg,rgba(45,108,223,0.18) 0%,rgba(212,148,76,.08) 50%,rgba(45,108,223,.06) 100%);
  border-radius:0 0 64rpx 64rpx;overflow:hidden;}
.exam-hero::before{content:"";position:absolute;top:-30%;right:-15%;width:440rpx;height:440rpx;background:radial-gradient(circle,rgba(255,255,255,0.15) 0%,transparent 70%);border-radius:50%;pointer-events:none}
.exam-hero::after{content:"";position:absolute;bottom:-25%;left:-8%;width:360rpx;height:360rpx;background:radial-gradient(circle,rgba(255,255,255,0.08) 0%,transparent 70%);border-radius:50%;pointer-events:none}

.exam-nav{display:flex;align-items:center;justify-content:space-between;gap:24rpx;position:relative;z-index:2}
.back-btn{
  width:88rpx;height:88rpx;border-radius:50%;
  background:rgba(255,255,255,0.50);backdrop-filter:blur(32rpx);-webkit-backdrop-filter:blur(32rpx);
  border:1rpx solid rgba(255,255,255,0.55);
  box-shadow:var(--neu-out-sm),inset 0 2rpx 4rpx rgba(255,255,255,0.50);
  display:flex;align-items:center;justify-content:center;color:var(--brand);
  cursor:pointer;flex-shrink:0;
  transition:transform var(--dur) var(--spring),background 0.15s ease;
}
.back-btn:active{transform:scale(0.85);background:rgba(255,255,255,0.70)}
.back-btn .design-svg-icon{width:44rpx;height:44rpx}

.exam-nav-title-block{flex:1;min-width:0;text-align:center}
.exam-nav-title{font-size:34rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em;line-height:1.2}
.exam-nav-sub{font-size:24rpx;color:var(--text-2);margin-top:4rpx;font-weight:500;letter-spacing:0.01em}

.withdraw-circle{width:88rpx;height:88rpx;border-radius:50%;background:rgba(255,255,255,0.50);backdrop-filter:blur(32rpx);-webkit-backdrop-filter:blur(32rpx);border:1rpx solid rgba(255,255,255,0.55);box-shadow:var(--neu-out-sm),inset 0 2rpx 4rpx rgba(255,255,255,0.50);display:flex;align-items:center;justify-content:center;color:var(--brand);cursor:pointer;flex-shrink:0;transition:transform var(--dur) var(--spring),background 0.15s ease}
.withdraw-circle:active{transform:scale(0.85);background:rgba(255,255,255,0.70)}
.withdraw-circle .design-svg-icon{width:44rpx;height:44rpx}

.exit-hint{display:flex;align-items:center;justify-content:center;gap:10rpx;margin-top:28rpx;position:relative;z-index:2;font-size:23rpx;color:var(--text-2);font-weight:500;letter-spacing:0.01em}
.exit-hint .design-svg-icon{width:26rpx;height:26rpx;color:var(--orange);flex-shrink:0}

/* ===== 考试进度条卡 ===== */
.exam-progress-section{margin-top:-20rpx;position:relative;z-index:10}
.exam-progress-card{padding:32rpx 36rpx}
.progress-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;position:relative;z-index:1}
.progress-label{font-size:28rpx;color:var(--text-1);font-weight:600;letter-spacing:-0.01em;font-variant-numeric:tabular-nums}
.progress-label em{font-style:normal;color:var(--brand);font-weight:700}
.progress-timer{display:inline-flex;align-items:center;gap:10rpx;font-size:30rpx;font-weight:700;color:var(--orange);font-variant-numeric:tabular-nums;letter-spacing:0.02em}
.progress-timer .design-svg-icon{width:32rpx;height:32rpx;color:var(--orange)}

.progress-bar-wrap{height:16rpx;border-radius:var(--r-pill);background:var(--fill);box-shadow:inset 4rpx 4rpx 8rpx var(--neu-dark),inset -4rpx -4rpx 8rpx var(--neu-light);overflow:hidden;position:relative;z-index:1}
.progress-bar{height:100%;border-radius:var(--r-pill);background:linear-gradient(90deg,var(--brand-mid) 0%,var(--brand) 100%);box-shadow:0 0 20rpx var(--brand-glow);transition:width 0.4s var(--ease)}

/* ===== 题目卡 ===== */
.question-card{padding:40rpx 40rpx 32rpx}
.question-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx;position:relative;z-index:1}
.question-type-badge{
  display:inline-flex;align-items:center;padding:8rpx 22rpx;border-radius:var(--r-pill);
  background:var(--brand-subtle);border:1rpx solid rgba(45,108,223,.11);
  color:var(--brand);font-size:23rpx;font-weight:600;letter-spacing:0.02em;
}
.question-no{font-size:25rpx;color:var(--text-2);font-weight:500;font-variant-numeric:tabular-nums}

.question-stem{font-size:34rpx;font-weight:600;color:var(--text-1);line-height:1.55;letter-spacing:-0.01em;margin-bottom:36rpx;position:relative;z-index:1}

.option-list{display:flex;flex-direction:column;gap:20rpx;position:relative;z-index:1}
.option-item{
  display:flex;align-items:center;gap:24rpx;padding:28rpx 32rpx;border-radius:var(--r);
  background:rgba(255,255,255,0.42);border:3rpx solid transparent;
  box-shadow:var(--neu-out-sm);cursor:pointer;font-family:var(--font);text-align:left;
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease),border-color var(--dur) var(--ease),background var(--dur) var(--ease);
  position:relative;
}
.option-item:active{transform:scale(0.98);box-shadow:var(--neu-in)}
.option-letter{
  width:60rpx;height:60rpx;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:var(--bg);box-shadow:inset 4rpx 4rpx 8rpx var(--neu-dark),inset -4rpx -4rpx 8rpx var(--neu-light);
  color:var(--text-2);font-size:28rpx;font-weight:700;
  transition:background var(--dur) var(--ease),color var(--dur) var(--ease),box-shadow var(--dur) var(--ease);
}
.option-text{flex:1;font-size:30rpx;color:var(--text-1);font-weight:500;letter-spacing:-0.01em;transition:color var(--dur) var(--ease),font-weight var(--dur) var(--ease)}

.option-item.selected{background:rgba(45,108,223,.05);border-color:var(--brand);box-shadow:var(--neu-out-sm),0 0 0 6rpx var(--brand-glow)}
.option-item.selected .option-letter{background:var(--brand);color:#fff;box-shadow:0 8rpx 20rpx var(--brand-glow),inset 0 2rpx 4rpx rgba(255,255,255,0.30)}
.option-item.selected .option-text{color:var(--brand);font-weight:600}
.option-check{width:40rpx;height:40rpx;color:var(--brand);flex-shrink:0}

.question-foot{margin-top:28rpx;font-size:24rpx;color:var(--text-2);text-align:center;position:relative;z-index:1;letter-spacing:0.01em}

/* ===== 答题卡 ===== */
.answer-sheet-card{padding:36rpx}
.answer-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20rpx;position:relative;z-index:1}
.ans-cell{
  aspect-ratio:1/1;border-radius:var(--r-sm);
  display:flex;align-items:center;justify-content:center;
  font-size:28rpx;font-weight:600;color:var(--text-2);
  background:var(--bg);border:3rpx solid transparent;
  box-shadow:var(--neu-out-sm);cursor:pointer;font-family:var(--font);font-variant-numeric:tabular-nums;
  transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease);
}
.ans-cell:active{transform:scale(0.92);box-shadow:var(--neu-in)}
.ans-cell.answered{background:var(--brand);color:#fff;box-shadow:var(--neu-out-sm),0 8rpx 24rpx var(--brand-glow)}
.ans-cell.current{background:rgba(45,108,223,0.08);color:var(--brand);border-color:var(--brand);box-shadow:var(--neu-out-sm),0 0 0 6rpx var(--brand-glow)}

.answer-legend{display:flex;align-items:center;justify-content:center;gap:36rpx;margin-top:32rpx;padding-top:28rpx;border-top:1rpx solid var(--sep);position:relative;z-index:1}
.legend-item{display:inline-flex;align-items:center;gap:10rpx;font-size:24rpx;color:var(--text-2);font-weight:500}
.legend-item .dot{width:24rpx;height:24rpx;border-radius:8rpx;background:var(--bg);box-shadow:inset 2rpx 2rpx 4rpx var(--neu-dark),inset -2rpx -2rpx 4rpx var(--neu-light);border:3rpx solid transparent}
.legend-item .dot.answered{background:var(--brand);box-shadow:none}
.legend-item .dot.current{background:rgba(45,108,223,0.08);border-color:var(--brand);box-shadow:none}

/* ===== 底部固定双按钮 ===== */
.exam-footer{
  position:absolute;left:0;right:0;bottom:0;z-index:50;
  padding:28rpx 48rpx 36rpx;
  background:linear-gradient(180deg,rgba(242,237,232,0) 0%,rgba(242,237,232,0.92) 32%,var(--bg) 60%);
  display:flex;gap:24rpx;align-items:center;
  backdrop-filter:blur(16rpx);-webkit-backdrop-filter:blur(16rpx);
}
.exam-btn-prev{flex:1;padding:28rpx 40rpx;font-size:30rpx;gap:12rpx}
.exam-btn-next{flex:1.5;padding:28rpx 40rpx;font-size:30rpx}
.exam-btn-prev .design-svg-icon,.exam-btn-next .design-svg-icon{width:36rpx;height:36rpx}

/* Reduced Motion */

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
