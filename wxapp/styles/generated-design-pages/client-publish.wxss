/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#0D9488;--brand-dark:#0A7A70;--brand-light:#CCFBF1;
  --brand-glow:rgba(13,148,136,0.18);--brand-subtle:rgba(13,148,136,0.08);
  --brand-gradient:linear-gradient(135deg,#0D9488 0%,#14B8A6 48%,#D4944C 100%);
  --accent:#D4944C;--accent-light:#F5E6D0;--accent-glow:rgba(212,148,76,0.16);
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;
  --sep:rgba(44,40,36,0.06);--fill:rgba(44,40,36,0.04);
  --green:#5B8C5A;--red:#C4533A;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;--r-tab:48rpx;
  /* Font */--font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:10rpx 10rpx 24rpx var(--neu-dark),-10rpx -10rpx 24rpx var(--neu-light);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep:inset 10rpx 10rpx 20rpx var(--neu-dark),inset -10rpx -10rpx 20rpx var(--neu-light);
  --glass-tab-bg:rgba(255,255,255,0.18);--glass-tab-blur:blur(96rpx) saturate(210%);--glass-tab-border:rgba(255,255,255,0.45);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}

/* ===== Phone Frame ===== */
.design-canvas-page{position:relative;width:828rpx;min-height:1792rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:164rpx}
.design-canvas-page::after{content:'';position:absolute;bottom:0;left:0;right:0;height:520rpx;background:radial-gradient(ellipse 400rpx 280rpx at 20% 90%,rgba(13,148,136,.06) 0%,transparent 70%),radial-gradient(ellipse 360rpx 240rpx at 80% 85%,rgba(212,148,76,.05) 0%,transparent 70%),radial-gradient(ellipse 320rpx 200rpx at 50% 95%,rgba(20,184,166,.04) 0%,transparent 70%);pointer-events:none;z-index:0}
.design-canvas-page>*:not(.tab-bar){position:relative;z-index:1}

/* ===== Hero ===== */
.hero{padding: max(76rpx, env(safe-area-inset-top)) 48rpx 72rpx;position:relative;z-index:1;background:radial-gradient(ellipse 480rpx 400rpx at 75% 40%,rgba(212,148,76,.16) 0%,transparent 70%),radial-gradient(ellipse 400rpx 320rpx at 20% 80%,rgba(13,148,136,.12) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.12) 0%,rgba(212,148,76,.14) 50%,rgba(20,184,166,.12) 100%);border-radius:0 0 64rpx 64rpx;overflow:hidden;color:var(--text-1)}
.hero-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:40rpx;position:relative;z-index:2}
.hero-title .tag-h1{font-size:44rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em;line-height:1.2}
.hero-title .tag-p{font-size:26rpx;color:var(--text-2);margin-top:4rpx;font-weight:500}

/* Close .design-button (Glass circle on gradient Hero) */
.close-btn{width:84rpx;height:84rpx;border-radius:50%;background:rgba(255,255,255,.50);backdrop-filter:blur(24rpx);-webkit-backdrop-filter:blur(24rpx);border:2rpx solid rgba(255,255,255,0.75);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;box-shadow:inset 0 2rpx 3rpx rgba(255,255,255,0.50),0 8rpx 24rpx rgba(0,0,0,0.05);transition:transform var(--dur) var(--ease),background 0.15s var(--ease)}
.close-btn:active{transform:scale(0.88);background:rgba(255,255,255,.70)}

/* ===== Step Indicators (Glass on gradient Hero) ===== */
.steps{display:flex;align-items:center;gap:0;position:relative;z-index:2;padding:0 8rpx;margin-top:40rpx}
.step-circle{width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:700;font-family:var(--font-nums);flex-shrink:0;transition:transform var(--dur) var(--spring)}
.step-done{background:rgba(255,255,255,0.85);color:var(--brand);box-shadow:0 4rpx 16rpx rgba(0,0,0,0.08)}
.step-current{background:transparent;border:3rpx solid rgba(255,255,255,0.8);color:var(--text-1)}
.step-pending{background:rgba(255,255,255,0.15);border:3rpx solid rgba(255,255,255,0.25);color:rgba(44,40,36,0.6)}
.step-line{flex:1;height:4rpx;background:rgba(255,255,255,0.25);margin:0 16rpx;border-radius:2rpx}
.step-line.active{background:rgba(255,255,255,0.7)}

/* ===== Section ===== */
.section{padding:0 48rpx;margin-top:40rpx;position:relative;z-index:2}
.section+.section{margin-top:32rpx}
.section-label{font-size:26rpx;font-weight:600;color:var(--text-2);margin-bottom:20rpx;padding-left:4rpx;letter-spacing:0.4rpx;display:flex;align-items:center;gap:12rpx}
.section-label .req{color:var(--brand);font-weight:700}

/* ===== Glass Card ===== */
.card{background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(150%);-webkit-backdrop-filter:blur(40rpx) saturate(150%);border:2rpx solid rgba(255,255,255,0.70);border-radius:var(--r);box-shadow:var(--neu-out-md),0 12rpx 56rpx rgba(0,0,0,0.06),0 0 0 2rpx rgba(44,40,36,0.05),0 4rpx 16rpx rgba(13,148,136,.04);position:relative;overflow:hidden}
.card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(165deg,rgba(255,255,255,0.22) 0%,rgba(255,255,255,0.05) 30%,transparent 55%);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;padding:1rpx;pointer-events:none}

/* ===== Service Grid (4-column, neumorphic icon circles) ===== */
.service-card{padding:32rpx 24rpx;position:relative;z-index:1}
.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32rpx 8rpx}
.service-item{display:flex;flex-direction:column;align-items:center;gap:16rpx;cursor:pointer;text-decoration:none;transition:transform var(--dur) var(--spring)}
.service-item:active{transform:scale(0.88)}
.service-icon-chip{width:80rpx;height:80rpx;border-radius:50%;background:var(--bg);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;color:var(--brand);transition:all 0.2s var(--ease)}
.service-item:active .service-icon-chip,.service-item.selected .service-icon-chip{box-shadow:var(--neu-in)}
.service-item.selected .service-icon-chip{background:rgba(13,148,136,.07);color:var(--brand)}
.service-label{font-size:24rpx;font-weight:500;color:var(--text-1);text-align:center;line-height:1.25}
.service-item.selected .service-label{color:var(--brand);font-weight:600}

/* ===== Problem Description Card ===== */
.desc-card{padding:32rpx;position:relative;z-index:1}
.desc-textarea{width:100%;min-height:192rpx;border:none;border-radius:var(--r-sm);background:var(--bg);padding:24rpx 28rpx;font-family:var(--font);font-size:28rpx;color:var(--text-1);resize:none;outline:none;line-height:1.55;box-shadow:var(--neu-in);-webkit-appearance:none}
.desc-textarea::placeholder{color:var(--text-3)}
.desc-textarea:focus{box-shadow:var(--neu-in),0 0 0 4rpx var(--brand-subtle),0 0 0 8rpx var(--brand-glow)}
.char-count{text-align:right;font-size:23rpx;color:var(--text-3);margin-top:12rpx;padding-right:4rpx;font-weight:500;font-variant-numeric:tabular-nums;position:relative;z-index:1}

.info-row{display:flex;align-items:center;gap:24rpx;padding:26rpx 12rpx;border-top:1rpx solid var(--sep);cursor:pointer;border-radius:var(--r-sm);margin:0 -12rpx;transition:background 0.2s ease,transform var(--dur) var(--spring)}
.info-row:active{background:var(--fill);transform:scale(0.98)}
.info-icon{width:44rpx;height:44rpx;color:var(--brand);flex-shrink:0;display:flex;align-items:center;justify-content:center}
.info-text{flex:1;font-size:29rpx;font-weight:500;color:var(--text-1);letter-spacing:-0.01em}
.info-chevron{color:var(--text-3);flex-shrink:0;display:flex;align-items:center}

.tag-row{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:28rpx;padding-top:28rpx;border-top:1rpx solid var(--sep)}
.tag-chip{background:rgba(13,148,136,.06);color:var(--brand);border:1rpx solid rgba(13,148,136,.09);border-radius:var(--r-pill);padding:14rpx 32rpx;font-size:25rpx;font-weight:600;font-family:var(--font);cursor:pointer;transition:transform var(--dur) var(--spring),background 0.2s ease}
.tag-chip:active{transform:scale(0.9);background:rgba(13,148,136,.10)}

/* ===== Order Mode Selection (3 mode cards, neumorphic glass) ===== */
.mode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20rpx}
.mode-card{padding:32rpx 16rpx;text-align:center;cursor:pointer;transition:transform var(--dur) var(--spring),all 0.2s ease}
.mode-card:active{transform:scale(0.94)}
.mode-card.selected{border:3rpx solid var(--brand);background:rgba(13,148,136,.04);box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow),0 0 0 1rpx rgba(13,148,136,.04)}
.mode-icon{width:88rpx;height:88rpx;border-radius:50%;background:var(--bg);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;margin:0 auto 20rpx;color:var(--text-2);transition:all 0.2s ease}
.mode-card.selected .mode-icon{background:rgba(13,148,136,.07);color:var(--brand)}
.mode-title{font-size:28rpx;font-weight:700;color:var(--text-1);margin-bottom:8rpx;letter-spacing:-0.01em}
.mode-card.selected .mode-title{color:var(--brand)}
.mode-desc{font-size:22rpx;color:var(--text-2);line-height:1.4}

/* ===== Bottom Summary Bar (Fixed) ===== */
.summary-bar{
  position:fixed;
  bottom:calc(128rpx + max(28rpx, env(safe-area-inset-bottom)));
  left:50%;
  transform:translateX(-50%);
  width:calc(100% - 64rpx);
  max-width:720rpx;
  padding:28rpx 36rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:rgba(255,255,255,0.22);
  backdrop-filter:blur(96rpx) saturate(210%);
  -webkit-backdrop-filter:blur(96rpx) saturate(210%);
  border:1rpx solid rgba(255,255,255,0.50);
  border-radius:56rpx;
  box-shadow:
    inset 0 3rpx 6rpx rgba(255,255,255,0.60),
    inset 0 -1rpx 2rpx rgba(255,255,255,0.20),
    0 0 0 1rpx rgba(0,0,0,0.04),
    0 4rpx 20rpx rgba(0,0,0,0.06),
    0 24rpx 72rpx rgba(0,0,0,0.08);
  z-index:99;
}
.summary-bar::before{
  content:"";
  position:absolute;
  inset:0;
  border-radius:inherit;
  background:linear-gradient(160deg,
    rgba(255,255,255,0.42) 0%,
    rgba(255,255,255,0.16) 20%,
    rgba(255,255,255,0.03) 40%,
    transparent 60%);
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;
  mask-composite:exclude;
  padding:1rpx;
  pointer-events:none;
  z-index:1;
}
.summary-bar::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:inherit;
  background:linear-gradient(320deg,
    transparent 60%,
    rgba(13,148,136,.04) 80%,
    rgba(255,255,255,0.04) 100%);
  pointer-events:none;
  z-index:1;
}
.summary-left{display:flex;flex-direction:column;gap:6rpx;position:relative;z-index:2}
.summary-bar .btn-neu-primary{position:relative;z-index:2}
.summary-label{font-size:25rpx;color:var(--text-2);font-weight:500}
.summary-price{font-size:52rpx;font-weight:700;font-family:var(--font-nums);color:var(--brand);line-height:1.1;letter-spacing:-0.02em}
.summary-price .currency{font-size:30rpx;font-weight:600;margin-right:2rpx}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
