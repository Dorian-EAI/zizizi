/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#0D9488;--brand-dark:#0A7A70;--brand-mid:#14B8A6;--brand-light:#CCFBF1;
  --brand-glow:rgba(13,148,136,0.18);--brand-subtle:rgba(13,148,136,0.08);
  --brand-gradient:linear-gradient(135deg,#0D9488 0%,#14B8A6 48%,#D4944C 100%);
  --accent:#D4944C;--accent-dark:#A0723C;--accent-light:#F5E6D0;
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;
  --font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}

.design-canvas-page{position:relative;width:min(750rpx,100vw);height:1800rpx;min-height:1800rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06)}

/* ===== Top Nav ===== */
.nav-bar{background:radial-gradient(ellipse 440rpx 320rpx at 78% 45%,rgba(212,148,76,.10) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 18% 75%,rgba(13,148,136,.10) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.08) 0%,rgba(212,148,76,.06) 50%,rgba(13,148,136,.05) 100%);position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:28rpx 40rpx;padding-top:max(28rpx,env(safe-area-inset-top));border-radius:0 0 48rpx 48rpx;overflow:hidden;flex-shrink:0}
.nav-icon-btn{width:80rpx;height:80rpx;border-radius:50%;border:none;background:var(--bg-elevated);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.nav-icon-btn:active{box-shadow:var(--neu-in);transform:scale(0.94)}
.nav-title-area{text-align:center}
.nav-title{font-size:32rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em;margin-bottom:4rpx}
.nav-status{font-size:22rpx;color:var(--green);display:flex;align-items:center;justify-content:center;gap:8rpx}
.status-dot{width:12rpx;height:12rpx;border-radius:50%;background:var(--green);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

/* ===== Chat Area ===== */
.chat-area{flex:1;overflow-y:auto;padding:32rpx 40rpx}
.chat-date{text-align:center;font-size:22rpx;color:var(--text-3);margin:24rpx 0}

/* ===== Message Bubbles ===== */
.msg-row{display:flex;margin-bottom:32rpx;align-items:flex-end;gap:16rpx}
.msg-row.user{flex-direction:row-reverse}
.msg-avatar{width:72rpx;height:72rpx;border-radius:24rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:28rpx;font-weight:600;box-shadow:var(--neu-out-sm)}
.msg-avatar.service{background:linear-gradient(135deg,var(--brand),var(--brand-mid))}
.msg-avatar.user{background:linear-gradient(135deg,var(--accent),var(--accent-dark))}
.msg-content{max-width:70%}
.msg-bubble{padding:24rpx 32rpx;border-radius:36rpx;font-size:28rpx;line-height:1.6;word-wrap:break-word}
.msg-row.service .msg-bubble{background:rgba(255,255,255,0.60);border-bottom-left-radius:12rpx;box-shadow:var(--neu-out-sm);border:1rpx solid rgba(255,255,255,0.60)}
.msg-row.user .msg-bubble{background:var(--brand-gradient);color:#fff;border-bottom-right-radius:12rpx;box-shadow:0 8rpx 28rpx var(--brand-glow)}
.msg-time{font-size:20rpx;color:var(--text-3);margin-top:8rpx}
.msg-row.user .msg-time{text-align:right}

/* ===== Quick Reply ===== */
.quick-replies{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:16rpx}
.quick-reply{padding:16rpx 28rpx;background:rgba(255,255,255,0.52);border:1rpx solid rgba(255,255,255,0.60);border-radius:19998rpx;font-size:24rpx;color:var(--brand);cursor:pointer;box-shadow:var(--neu-out-sm);transition:all var(--dur) var(--ease)}
.quick-reply:active{box-shadow:var(--neu-in);transform:scale(0.95)}

/* ===== Order Card in Chat ===== */
.order-card{margin-top:16rpx;padding:24rpx;background:rgba(255,255,255,0.52);border-radius:24rpx;border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm);max-width:520rpx}
.order-card-title{font-size:24rpx;font-weight:600;color:var(--text-1);margin-bottom:8rpx}
.order-card-desc{font-size:22rpx;color:var(--text-2);margin-bottom:12rpx}
.order-card-price{font-size:28rpx;font-weight:700;color:var(--brand);font-family:var(--font-display)}

/* ===== Input Bar ===== */
.input-bar{position:sticky;bottom:0;z-index:100;padding:24rpx 32rpx;padding-bottom:max(24rpx,env(safe-area-inset-bottom));background:rgba(255,255,255,0.72);backdrop-filter:blur(48rpx) saturate(160%);-webkit-backdrop-filter:blur(48rpx) saturate(160%);border-top:1rpx solid rgba(255,255,255,0.60);flex-shrink:0}
.input-row{display:flex;align-items:center;gap:20rpx}
.input-actions{display:flex;gap:16rpx}
.input-action-btn{width:72rpx;height:72rpx;border-radius:50%;background:var(--bg-elevated);box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:var(--text-2);cursor:pointer;transition:all var(--dur) var(--ease);flex-shrink:0}
.input-action-btn:active{box-shadow:var(--neu-in);transform:scale(0.92)}
.input-wrapper{flex:1;position:relative}
.chat-input{width:100%;padding:20rpx 32rpx;padding-right:88rpx;border:none;border-radius:19998rpx;background:var(--bg-elevated);box-shadow:var(--neu-in);font-family:var(--font);font-size:28rpx;color:var(--text-1);outline:none}
.chat-input::placeholder{color:var(--text-3)}
.send-btn{position:absolute;right:12rpx;top:50%;transform:translateY(-50%);width:60rpx;height:60rpx;border-radius:50%;background:var(--brand-gradient);color:#fff;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4rpx 16rpx var(--brand-glow);transition:all var(--dur) var(--spring)}
.send-btn:active{transform:translateY(-50%) scale(0.9)}
.send-btn:disabled{background:var(--neu-dark);box-shadow:none;cursor:not-allowed}

/* ===== Service Menu ===== */
.service-menu{padding:24rpx 40rpx;background:rgba(255,255,255,0.52);border-bottom:2rpx solid var(--sep)}
.service-menu-title{font-size:24rpx;color:var(--text-2);margin-bottom:20rpx}
.service-menu-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20rpx}
.service-menu-item{text-align:center;cursor:pointer}
.service-menu-icon{width:88rpx;height:88rpx;border-radius:28rpx;background:var(--bg-elevated);box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:var(--brand);margin:0 auto 8rpx;transition:all var(--dur) var(--ease)}
.service-menu-item:active .service-menu-icon{box-shadow:var(--neu-in);transform:scale(0.92)}
.service-menu-name{font-size:22rpx;color:var(--text-2)}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
