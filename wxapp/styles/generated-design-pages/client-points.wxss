/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#0D9488;--brand-dark:#0A7A70;--brand-mid:#14B8A6;--brand-light:#CCFBF1;
  --brand-glow:rgba(13,148,136,0.24);--brand-subtle:rgba(13,148,136,0.10);
  --brand-gradient:linear-gradient(135deg,#0D9488 0%,#14B8A6 50%,#D4944C 100%);
  --accent:#D4944C;--accent-dark:#A0723C;--accent-light:#F5E6D0;--accent-soft:rgba(212,148,76,0.12);--accent-glow:rgba(212,148,76,0.18);
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;
  --font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}

.design-canvas-page{position:relative;width:min(750rpx,100vw);height:1800rpx;min-height:1800rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:80rpx}
.mono{font-variant-numeric:tabular-nums;letter-spacing:-0.01em}

/* ===== Top Nav ===== */
.nav-bar{background:radial-gradient(ellipse 440rpx 320rpx at 78% 45%,rgba(212,148,76,.14) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 18% 75%,rgba(13,148,136,.16) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.14) 0%,rgba(212,148,76,.08) 50%,rgba(13,148,136,.06) 100%);position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:36rpx 40rpx;padding-top:max(36rpx,env(safe-area-inset-top));border-radius:0 0 56rpx 56rpx;overflow:hidden}
.nav-icon-btn{width:88rpx;height:88rpx;border-radius:50%;border:none;background:var(--bg-elevated);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.nav-icon-btn:active{box-shadow:var(--neu-in);transform:scale(0.94)}
.nav-title{font-size:34rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em}

/* ===== Points Hero ===== */
.points-hero{padding:48rpx 40rpx 64rpx;background:
  radial-gradient(ellipse 560rpx 360rpx at 85% 30%,rgba(212,148,76,.16) 0%,transparent 66%),
  radial-gradient(ellipse 440rpx 320rpx at 10% 70%,rgba(13,148,136,.13) 0%,transparent 66%),
  linear-gradient(150deg,rgba(13,148,136,.10) 0%,rgba(212,148,76,.10) 100%);
  border-radius:0 0 64rpx 64rpx;
  text-align:center;
  position:relative;
  box-shadow:inset 0 2rpx 0 rgba(255,255,255,0.35);
}
.points-label{font-size:26rpx;color:var(--text-2);margin-bottom:16rpx}
.points-value{font-size:112rpx;font-weight:700;font-family:var(--font-display);letter-spacing:-0.04em;line-height:1;background:linear-gradient(135deg,var(--brand-dark) 0%,var(--accent-dark) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.points-unit{font-size:32rpx;color:var(--text-2);margin-top:8rpx}
.points-actions{display:flex;justify-content:center;gap:32rpx;margin-top:48rpx}
.points-action-btn{padding:20rpx 48rpx;border-radius:19998rpx;font-size:26rpx;font-weight:600;border:none;cursor:pointer;transition:all var(--dur) var(--spring)}
.points-action-btn.primary{background:var(--brand-gradient);color:#fff;box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow)}
.points-action-btn.secondary{background:rgba(255,255,255,0.52);color:var(--brand);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm)}
.points-action-btn:active{transform:scale(0.94)}

/* ===== Section ===== */
.section{padding:40rpx 40rpx 0}
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx}
.section-title{font-size:30rpx;font-weight:700;color:var(--text-1)}
.section-more{font-size:24rpx;color:var(--text-2);cursor:pointer}

/* ===== Glass Card ===== */
.glass-card{background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(140%);-webkit-backdrop-filter:blur(40rpx) saturate(140%);border-radius:var(--r-lg);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-md);padding:32rpx;position:relative}
.glass-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2rpx;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.80),transparent);pointer-events:none}

/* ===== Ways to earn ===== */
.earn-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24rpx}
.earn-item{text-align:center;cursor:pointer}
.earn-icon{width:80rpx;height:80rpx;border-radius:32rpx;margin:0 auto 16rpx;background:rgba(255,255,255,0.52);box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:var(--brand)}
.earn-item:active .earn-icon{box-shadow:var(--neu-in);transform:scale(0.94)}
.earn-name{font-size:24rpx;color:var(--text-1);margin-bottom:4rpx}
.earn-points{font-size:22rpx;color:var(--accent);font-weight:600}

/* ===== Points Mall ===== */
.mall-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24rpx}
.mall-item{background:rgba(255,255,255,0.52);border-radius:var(--r-md);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm);overflow:hidden;cursor:pointer;transition:all var(--dur) var(--ease)}
.mall-item:active{transform:scale(0.97);box-shadow:var(--neu-in)}
.mall-img{height:200rpx;background:radial-gradient(circle at 78% 22%,rgba(212,148,76,.20) 0%,transparent 56%),radial-gradient(circle at 18% 84%,rgba(13,148,136,.14) 0%,transparent 58%),rgba(255,255,255,.34);display:flex;align-items:center;justify-content:center;font-size:64rpx;line-height:1;color:var(--brand);box-shadow:inset 6rpx 6rpx 16rpx var(--neu-dark),inset -6rpx -6rpx 16rpx var(--neu-light);filter:saturate(.92)}
.mall-info{padding:24rpx}
.mall-name{font-size:26rpx;font-weight:600;margin-bottom:8rpx}
.mall-points{font-size:28rpx;font-weight:700;color:var(--accent);font-family:var(--font-display)}
.mall-points .tag-small{font-size:20rpx;font-weight:500;color:var(--text-3);margin-left:8rpx}

/* ===== Records ===== */
.record-item{display:flex;align-items:center;padding:28rpx 0;border-bottom:2rpx solid var(--sep)}
.record-item:last-child{border-bottom:none}
.record-icon{width:80rpx;height:80rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;margin-right:24rpx;flex-shrink:0}
.record-icon.plus{background:rgba(91,140,90,0.12);color:var(--green)}
.record-icon.minus{background:var(--accent-soft);color:var(--accent-dark)}
.record-info{flex:1}
.record-title{font-size:28rpx;font-weight:500;margin-bottom:4rpx}
.record-time{font-size:24rpx;color:var(--text-2)}
.record-points{font-size:32rpx;font-weight:700;font-family:var(--font-display)}
.record-points.plus{color:var(--green)}
.record-points.minus{color:var(--accent-dark)}

/* ===== Segmented Tabs ===== */
.segmented-tabs{display:flex;background:var(--bg-elevated);border-radius:19998rpx;padding:8rpx;box-shadow:var(--neu-in);margin-bottom:32rpx}
.seg-tab{flex:1;padding:16rpx 0;font-size:26rpx;font-weight:500;text-align:center;border-radius:19998rpx;color:var(--text-2);cursor:pointer;transition:all var(--dur) var(--ease)}
.seg-tab.active{background:rgba(255,255,255,0.80);color:var(--brand);box-shadow:var(--neu-out-sm);font-weight:600}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
