/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#0D9488;--brand-dark:#0A7A70;--brand-mid:#14B8A6;--brand-light:#CCFBF1;
  --brand-glow:rgba(13,148,136,0.24);--brand-subtle:rgba(13,148,136,0.10);
  --brand-gradient:linear-gradient(135deg,#0D9488 0%,#14B8A6 50%,#D4944C 100%);
  --accent:#D4944C;--accent-dark:#A0723C;--accent-light:#F5E6D0;--accent-soft:rgba(212,148,76,0.12);
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;
  --font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}

.design-canvas-page{position:relative;width:min(750rpx,100vw);height:1800rpx;min-height:1800rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:80rpx}
.mono{font-variant-numeric:tabular-nums;letter-spacing:-0.01em}

/* ===== Top Nav ===== */
.nav-bar{background:radial-gradient(ellipse 440rpx 320rpx at 78% 45%,rgba(212,148,76,.14) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 18% 75%,rgba(13,148,136,.16) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.14) 0%,rgba(212,148,76,.08) 50%,rgba(13,148,136,.06) 100%);position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:36rpx 40rpx;padding-top:max(36rpx,env(safe-area-inset-top));border-radius:0 0 56rpx 56rpx;overflow:hidden}
.nav-icon-btn{width:88rpx;height:88rpx;border-radius:50%;border:none;background:var(--bg-elevated);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.nav-icon-btn:active{box-shadow:var(--neu-in);transform:scale(0.94)}
.nav-title{font-size:34rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em}

/* ===== Invite Hero ===== */
.invite-hero{padding:64rpx 40rpx 80rpx;background:
  radial-gradient(ellipse 600rpx 400rpx at 80% 20%,rgba(212,148,76,.16) 0%,transparent 66%),
  radial-gradient(ellipse 500rpx 360rpx at 15% 65%,rgba(13,148,136,.13) 0%,transparent 66%),
  linear-gradient(150deg,rgba(13,148,136,.10) 0%,rgba(212,148,76,.10) 100%);
  border-radius:0 0 72rpx 72rpx;
  text-align:center;
  position:relative;
  box-shadow:inset 0 2rpx 0 rgba(255,255,255,0.35);
}
.invite-title{font-size:48rpx;font-weight:700;font-family:var(--font-display);letter-spacing:-0.02em;margin-bottom:16rpx}
.invite-subtitle{font-size:26rpx;color:var(--text-2);margin-bottom:56rpx}
.reward-cards{display:flex;gap:24rpx;justify-content:center;margin-bottom:56rpx}
.reward-card{flex:1;max-width:280rpx;padding:32rpx 24rpx;background:rgba(255,255,255,0.52);backdrop-filter:blur(24rpx);border-radius:var(--r-md);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-md)}
.reward-icon{width:80rpx;height:80rpx;border-radius:24rpx;background:var(--brand-gradient);color:#fff;display:flex;align-items:center;justify-content:center;margin:0 auto 16rpx}
.reward-amount{font-size:44rpx;font-weight:700;font-family:var(--font-display);color:var(--brand);margin-bottom:4rpx}
.reward-label{font-size:22rpx;color:var(--text-2)}
.invite-code-box{display:inline-flex;align-items:center;gap:24rpx;padding:24rpx 40rpx;background:rgba(255,255,255,0.60);border-radius:19998rpx;box-shadow:var(--neu-out-md)}
.invite-code-label{font-size:26rpx;color:var(--text-2)}
.invite-code-value{font-size:36rpx;font-weight:700;font-family:var(--font-display);letter-spacing:0.1em;color:var(--text-1)}
.copy-btn{padding:12rpx 28rpx;background:var(--brand-gradient);color:#fff;font-size:24rpx;font-weight:600;border:none;border-radius:19998rpx;cursor:pointer;box-shadow:0 4rpx 16rpx var(--brand-glow);transition:all var(--dur) var(--spring)}
.copy-btn:active{transform:scale(0.92)}

/* ===== Section ===== */
.section{padding:40rpx 40rpx 0}
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx}
.section-title{font-size:30rpx;font-weight:700;color:var(--text-1)}

/* ===== Glass Card ===== */
.glass-card{background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(140%);-webkit-backdrop-filter:blur(40rpx) saturate(140%);border-radius:var(--r-lg);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-md);padding:40rpx;position:relative}
.glass-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2rpx;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.80),transparent);pointer-events:none}

/* ===== Share Buttons ===== */
.share-methods{display:flex;justify-content:space-around;padding:16rpx 0}
.share-item{text-align:center;cursor:pointer}
.share-icon{width:88rpx;height:88rpx;border-radius:40rpx;display:flex;align-items:center;justify-content:center;margin:0 auto 16rpx;box-shadow:var(--neu-out-md);transition:all var(--dur) var(--spring)}
.share-item:active .share-icon{box-shadow:var(--neu-in);transform:scale(0.92)}
.share-icon.wechat,.share-icon.link{background:radial-gradient(circle at 72% 18%,rgba(13,148,136,.16) 0%,transparent 58%),rgba(255,255,255,.44);color:var(--brand);border:1rpx solid rgba(255,255,255,0.62)}
.share-icon.moments,.share-icon.qq{background:radial-gradient(circle at 76% 20%,rgba(212,148,76,.18) 0%,transparent 58%),rgba(255,255,255,.44);color:var(--accent-dark);border:1rpx solid rgba(255,255,255,0.62)}
.share-name{font-size:24rpx;color:var(--text-2)}

/* ===== Rules ===== */
.rule-item{display:flex;gap:24rpx;padding:24rpx 0;border-bottom:2rpx solid var(--sep)}
.rule-item:last-child{border-bottom:none}
.rule-num{width:48rpx;height:48rpx;border-radius:50%;background:var(--brand-light);color:var(--brand);display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;flex-shrink:0}
.rule-text{font-size:26rpx;color:var(--text-2);line-height:1.6;flex:1}
.rule-text .tag-strong{color:var(--text-1);font-weight:600}

/* ===== Invite List ===== */
.invite-item{display:flex;align-items:center;padding:24rpx 0;border-bottom:2rpx solid var(--sep)}
.invite-item:last-child{border-bottom:none}
.invite-avatar{width:88rpx;height:88rpx;border-radius:28rpx;background:var(--brand-gradient);color:#fff;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:600;margin-right:24rpx;flex-shrink:0;box-shadow:var(--neu-out-sm)}
.invite-info{flex:1}
.invite-name{font-size:28rpx;font-weight:500;margin-bottom:4rpx}
.invite-time{font-size:24rpx;color:var(--text-2)}
.invite-reward{font-size:28rpx;font-weight:700;color:var(--brand);font-family:var(--font-display)}
.invite-reward.pending{color:var(--text-3)}

/* ===== Stats ===== */
.stats-row{display:flex;gap:24rpx;margin-bottom:32rpx}
.stat-item{flex:1;text-align:center;padding:32rpx;background:rgba(255,255,255,0.40);border-radius:var(--r-md);box-shadow:var(--neu-out-sm)}
.stat-value{font-size:48rpx;font-weight:700;font-family:var(--font-display);color:var(--brand);margin-bottom:8rpx}
.stat-label{font-size:24rpx;color:var(--text-2)}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
