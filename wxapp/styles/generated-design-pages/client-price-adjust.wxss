/* AUTO-GENERATED from zjrnew page-local CSS; do not hand edit. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
page {
  --brand:#0D9488;--brand-dark:#0A7A70;--brand-mid:#14B8A6;--brand-light:#CCFBF1;
  --brand-glow:rgba(13,148,136,0.18);--brand-subtle:rgba(13,148,136,0.08);
  --brand-gradient:linear-gradient(135deg,#0D9488 0%,#14B8A6 48%,#D4944C 100%);
  --accent:#D4944C;--accent-dark:#A0723C;--accent-light:#F5E6D0;
  --bg:#F2EDE8;--bg-elevated:#F7F3EF;
  --neu-light:#FFF8F2;--neu-dark:#DDD6CE;
  --text-1:#2C2824;--text-2:#8B8178;--text-3:#B5ADA5;--text-inverse:#FFFFFF;
  --sep:rgba(44,40,36,0.06);
  --green:#5B8C5A;--red:#C4533A;--orange:#D4944C;--blue:#5A8FAD;
  --r:1.2rem;--r-lg:1.6rem;--r-sm:0.75rem;--r-pill:19998rpx;
  --font-display:'Cormorant Garamond', 'Noto Serif SC', 'STSong', Georgia, serif;
  --font-body:'Noto Serif SC', 'Cormorant Garamond', 'STSong', Georgia, serif;
  --font-nums:'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
  --font:var(--font-body);
  --neu-out-sm:12rpx 12rpx 28rpx var(--neu-dark),-12rpx -12rpx 28rpx var(--neu-light),0 8rpx 32rpx rgba(0,0,0,0.04);
  --neu-out-md:16rpx 16rpx 36rpx var(--neu-dark),-16rpx -16rpx 36rpx var(--neu-light),0 12rpx 48rpx rgba(0,0,0,0.05);
  --neu-in:inset 8rpx 8rpx 16rpx var(--neu-dark),inset -8rpx -8rpx 16rpx var(--neu-light);
  --spring:cubic-bezier(0.175,0.885,0.32,1.275);--ease:cubic-bezier(0.25,0.46,0.45,0.94);--dur:0.2s;
}
page {font-family:var(--font);color:var(--text-1);-webkit-font-smoothing:antialiased}
page {display:flex;align-items:flex-start;justify-content:center;min-height:100vh;background:#E8E4DF;letter-spacing:-0.01em}

.design-canvas-page{position:relative;width:min(750rpx,100vw);height:1800rpx;min-height:1800rpx;background:var(--bg);border-radius:96rpx;overflow:hidden;overflow-y:auto;box-shadow:0 40rpx 120rpx rgba(0,0,0,.12),0 8rpx 32rpx rgba(0,0,0,.06);padding-bottom:200rpx}
.mono{font-variant-numeric:tabular-nums;letter-spacing:-0.01em}

/* ===== Top Nav ===== */
.nav-bar{background:radial-gradient(ellipse 440rpx 320rpx at 78% 45%,rgba(212,148,76,.10) 0%,transparent 70%),radial-gradient(ellipse 360rpx 280rpx at 18% 75%,rgba(13,148,136,.10) 0%,transparent 70%),linear-gradient(135deg,rgba(13,148,136,.08) 0%,rgba(212,148,76,.06) 50%,rgba(13,148,136,.05) 100%);position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:36rpx 40rpx;padding-top:max(36rpx,env(safe-area-inset-top));border-radius:0 0 56rpx 56rpx;overflow:hidden}
.nav-icon-btn{width:88rpx;height:88rpx;border-radius:50%;border:none;background:var(--bg-elevated);box-shadow:var(--neu-out-sm),inset 0 2rpx 2rpx rgba(255,255,255,0.45);display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex-shrink:0;transition:transform var(--dur) var(--spring),box-shadow var(--dur) var(--ease)}
.nav-icon-btn:active{box-shadow:var(--neu-in);transform:scale(0.94)}
.nav-title{font-size:34rpx;font-weight:700;color:var(--text-1);letter-spacing:-0.02em}

/* ===== Section ===== */
.section{padding:32rpx 40rpx 0}
.section-title{font-size:30rpx;font-weight:700;color:var(--text-1);margin-bottom:24rpx;display:flex;align-items:center;gap:12rpx}

/* ===== Glass Card ===== */
.glass-card{background:rgba(255,255,255,0.52);backdrop-filter:blur(40rpx) saturate(140%);-webkit-backdrop-filter:blur(40rpx) saturate(140%);border-radius:var(--r-lg);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-md);padding:40rpx;position:relative}
.glass-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2rpx;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.80),transparent);pointer-events:none}

/* ===== Status Banner ===== */
.status-banner{display:flex;align-items:center;gap:24rpx;padding:32rpx 40rpx;margin:32rpx 40rpx 0;background:linear-gradient(135deg,rgba(212,148,76,.09),rgba(212,148,76,.05));border-radius:var(--r-md);border:1rpx solid rgba(212,148,76,.16)}
.status-icon{width:80rpx;height:80rpx;border-radius:24rpx;background:rgba(212,148,76,.12);display:flex;align-items:center;justify-content:center;color:var(--accent);flex-shrink:0}
.status-text{flex:1}
.status-title{font-size:28rpx;font-weight:600;color:var(--accent-dark);margin-bottom:4rpx}
.status-desc{font-size:24rpx;color:var(--text-2)}

/* ===== Worker Info ===== */
.worker-row{display:flex;align-items:center;gap:24rpx}
.worker-avatar{width:80rpx;height:80rpx;border-radius:28rpx;background:linear-gradient(135deg,var(--brand),var(--brand-mid));color:#fff;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:600;flex-shrink:0;box-shadow:var(--neu-out-sm)}
.worker-info{flex:1}
.worker-name{font-size:30rpx;font-weight:600;margin-bottom:4rpx}
.worker-service{font-size:24rpx;color:var(--text-2)}

/* ===== Amount Display ===== */
.amount-section{text-align:center;padding:48rpx 0}
.amount-label{font-size:26rpx;color:var(--text-2);margin-bottom:16rpx}
.amount-value{font-size:96rpx;font-weight:700;font-family:var(--font-display);color:var(--accent);letter-spacing:-0.03em;line-height:1.1}
.amount-value .currency{font-size:48rpx;vertical-align:top;margin-right:8rpx;font-weight:600}
.amount-reason{font-size:24rpx;color:var(--text-2);margin-top:16rpx}

/* ===== Fee Breakdown ===== */
.fee-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:2rpx solid var(--sep)}
.fee-row:last-child{border-bottom:none}
.fee-label{font-size:27rpx;color:var(--text-2)}
.fee-value{font-size:27rpx;color:var(--text-1);font-weight:500}
.fee-total{padding-top:24rpx;border-top:2rpx dashed var(--sep);margin-top:8rpx}
.fee-total .fee-label{font-weight:600;color:var(--text-1);font-size:28rpx}
.fee-total .fee-value{font-size:40rpx;font-weight:700;color:var(--brand);font-family:var(--font-display)}

/* ===== Reason Section ===== */
.reason-box{padding:28rpx 32rpx;background:var(--bg-elevated);border-radius:var(--r-md);box-shadow:var(--neu-in);font-size:27rpx;color:var(--text-1);line-height:1.6}

/* ===== Photo Evidence ===== */
.photo-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20rpx}
.photo-item{aspect-ratio:1;border-radius:24rpx;overflow:hidden;box-shadow:var(--neu-out-sm)}
.photo-item div{width:100%;height:100%}

/* ===== Action Buttons ===== */
.action-buttons{display:flex;gap:24rpx;padding:32rpx 40rpx}
.action-btn{flex:1;padding:28rpx;border-radius:19998rpx;font-size:30rpx;font-weight:600;border:none;cursor:pointer;transition:all var(--dur) var(--spring)}
.action-btn.reject{background:rgba(255,255,255,0.52);color:var(--text-2);border:1rpx solid rgba(255,255,255,0.60);box-shadow:var(--neu-out-sm)}
.action-btn.confirm{background:var(--brand-gradient);color:#fff;box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow)}
.action-btn:active{transform:scale(0.96);box-shadow:var(--neu-in)}

/* ===== Bottom Bar ===== */
.bottom-bar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(750rpx,100vw);z-index:100;padding:24rpx 40rpx;padding-bottom:max(24rpx,env(safe-area-inset-bottom));background:rgba(255,255,255,0.72);backdrop-filter:blur(48rpx) saturate(160%);border-top:1rpx solid rgba(255,255,255,0.60);box-shadow:0 -8rpx 40rpx rgba(0,0,0,0.06)}
.bottom-btn{width:100%;padding:32rpx;background:var(--brand-gradient);color:#fff;font-size:32rpx;font-weight:700;border:none;border-radius:19998rpx;cursor:pointer;box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow);transition:all var(--dur) var(--spring)}
.bottom-btn:active{transform:scale(0.98);box-shadow:var(--neu-in)}
.bottom-btn.disabled{background:var(--neu-dark);box-shadow:none;color:var(--text-3);cursor:not-allowed}

/* ===== Timeline ===== */
.timeline-item{display:flex;gap:24rpx;padding-bottom:40rpx;position:relative}
.timeline-item:last-child{padding-bottom:0}
.timeline-item::before{content:"";position:absolute;left:22rpx;top:52rpx;bottom:0;width:4rpx;background:var(--sep)}
.timeline-item:last-child::before{display:none}
.timeline-dot{width:48rpx;height:48rpx;border-radius:50%;background:var(--brand);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;box-shadow:0 4rpx 16rpx var(--brand-glow)}
.timeline-dot.done{background:var(--green);box-shadow:0 4rpx 16rpx rgba(91,140,90,0.30)}
.timeline-dot.pending{background:var(--bg-elevated);box-shadow:var(--neu-out-sm);color:var(--text-3)}
.timeline-content{flex:1;padding-top:4rpx}
.timeline-title{font-size:28rpx;font-weight:500;margin-bottom:4rpx}
.timeline-time{font-size:24rpx;color:var(--text-2)}

.design-canvas-page { width: 750rpx; min-height: 100vh; border-radius: 0; box-shadow: none; }
.design-svg-icon { display: block; width: 44rpx; height: 44rpx; }
