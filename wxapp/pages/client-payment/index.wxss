.payment-page{height:100vh;display:flex;flex-direction:column;overflow:hidden}.payment-scroll{flex:1;min-height:0}.amount-section{padding:48rpx 40rpx 16rpx}.amount-card{text-align:center;padding:56rpx 40rpx}.amount-label{display:block;font-size:26rpx;color:var(--text-2);margin-bottom:16rpx}.amount-value{display:flex;justify-content:center;align-items:flex-start;font-size:88rpx;font-weight:700;color:var(--text-1);letter-spacing:-.03em;line-height:1.1}.amount-value .currency{font-size:48rpx;margin-right:4rpx;font-weight:600}.order-no{display:block;font-size:24rpx;color:var(--text-3);margin-top:20rpx}.section{padding:32rpx 40rpx 0}.section-title{font-size:30rpx;margin-bottom:24rpx;display:block}.pay-method-list{display:flex;flex-direction:column;gap:24rpx}.pay-method-item{display:flex;align-items:center;padding:32rpx;background:rgba(255,255,255,.52);border-radius:var(--r-md);border:1rpx solid rgba(255,255,255,.60);box-shadow:var(--neu-out-sm);position:relative}.pay-method-item.selected{border:2rpx solid var(--brand);box-shadow:var(--neu-out-sm),0 0 0 6rpx var(--brand-subtle)}.pay-method-item.disabled{opacity:.58}.pay-method-icon{width:88rpx;height:88rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;margin-right:28rpx;flex-shrink:0}.pay-method-icon image{width:44rpx;height:44rpx}.pay-method-icon.wechat{background:linear-gradient(135deg,#07C160,#06AE56)}.pay-method-icon.combo{background:linear-gradient(135deg,var(--accent),var(--brand))}.pay-method-icon.balance{background:linear-gradient(135deg,var(--brand),var(--brand-mid))}.pay-method-icon.offline{background:linear-gradient(135deg,var(--blue),var(--brand))}.pay-method-info{flex:1;display:flex;flex-direction:column}.pay-method-name{font-size:30rpx;font-weight:600;margin-bottom:4rpx}.pay-method-desc{font-size:24rpx;color:var(--text-2)}.pay-method-radio{width:44rpx;height:44rpx;border-radius:50%;border:4rpx solid var(--neu-dark);margin-left:24rpx;position:relative}.pay-method-item.selected .pay-method-radio{border-color:var(--brand);background:var(--brand)}.pay-method-item.selected .pay-method-radio::after{content:"";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:16rpx;height:16rpx;border-radius:50%;background:#fff}
.coupon-selector{display:flex;align-items:center;justify-content:space-between;padding:32rpx;background:rgba(255,255,255,.52);border-radius:var(--r-md);border:1rpx solid rgba(255,255,255,.60);box-shadow:var(--neu-out-sm)}.coupon-left,.coupon-right{display:flex;align-items:center;gap:20rpx}.coupon-icon{width:72rpx;height:72rpx;border-radius:20rpx;background:linear-gradient(135deg,var(--accent),var(--accent-dark));display:flex;align-items:center;justify-content:center}.coupon-icon image{width:36rpx;height:36rpx}.coupon-text{font-size:28rpx;font-weight:500}.coupon-discount{font-size:28rpx;color:var(--red);font-weight:600}.coupon-arrow{width:32rpx;height:32rpx}.detail-card{padding:40rpx}.detail-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:2rpx solid var(--sep)}.detail-row:last-child{border-bottom:none}.detail-label,.detail-value{font-size:27rpx}.detail-label{color:var(--text-2)}.detail-value{font-weight:500}.detail-value.highlight{color:var(--brand);font-weight:600}.detail-row.total{padding-top:24rpx;border-top:2rpx dashed var(--sep)}.detail-label.strong{font-weight:600;color:var(--text-1)}.detail-total{font-size:36rpx;font-weight:700;color:var(--brand)}
.pay-bottom-bar{flex-shrink:0;z-index:100;padding:24rpx 40rpx;background:rgba(255,255,255,.72);backdrop-filter:blur(48rpx) saturate(160%);border-top:1rpx solid rgba(255,255,255,.60);box-shadow:0 -8rpx 40rpx rgba(0,0,0,.06);display:flex;align-items:center;justify-content:space-between}.pay-total-label{display:block;font-size:26rpx;color:var(--text-2)}.pay-total-amount{font-size:48rpx;font-weight:700}.pay-total-amount .currency{font-size:28rpx;margin-right:4rpx}.pay-now-btn{width:auto;margin:0;padding:28rpx 52rpx;background:var(--brand-gradient);color:#fff;font-size:30rpx;font-weight:700;border-radius:var(--r-pill);line-height:1.4;box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow)}.pay-now-btn[disabled]{background:var(--neu-dark);color:var(--text-3);box-shadow:none}.security-tip{display:flex;align-items:center;justify-content:center;gap:12rpx;padding:32rpx 40rpx;font-size:24rpx;color:var(--text-3)}.security-tip image{width:28rpx;height:28rpx}.contract-warning{margin:24rpx 40rpx 0;padding:28rpx 32rpx;background:rgba(196,83,58,.08);border:1rpx solid rgba(196,83,58,.24);border-radius:var(--r-md);display:flex;flex-direction:column}.contract-warning.checking{background:rgba(212,148,76,.10);border-color:rgba(212,148,76,.28)}.warning-title{font-size:28rpx;font-weight:700;color:var(--red);margin-bottom:8rpx}.checking .warning-title{color:var(--accent-dark)}.warning-desc{font-size:24rpx;color:var(--text-2);line-height:1.5}.method-empty{padding:48rpx;text-align:center;border-radius:var(--r-md);background:rgba(255,255,255,.35);color:var(--text-3);font-size:26rpx}.state-panel{padding:280rpx 64rpx;display:flex;flex-direction:column;align-items:center;text-align:center;color:var(--text-2)}.state-title{font-size:32rpx;font-weight:700;color:var(--text-1);margin-bottom:12rpx}.state-desc{font-size:26rpx;line-height:1.5}.scroll-spacer{height:40rpx}
