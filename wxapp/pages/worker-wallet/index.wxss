/* pages/worker-wallet/index.wxss — 师傅钱包页 像素级复刻 worker-wallet.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 师傅端品牌色：--brand-worker #2D6CDF
 */
.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== Hero ===== */
/* HTML: .hero{padding:max(38px,env(safe-area-inset-top)) 24px 40px;background:radial-gradient(...);border-radius:0 0 32px 32px;overflow:hidden} */
.hero {
  padding: 0 48rpx 80rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 25% 40%, rgba(212,148,76,.12) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 80% 80%, rgba(45, 108, 223, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.28) 0%, rgba(212,148,76,.10) 50%, rgba(45, 108, 223, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
  transition: padding var(--dur-base) var(--ease);
}
/* HTML: .hero::before / ::after 光斑装饰 */
.hero::before {
  content: "";
  position: absolute;
  top: -30%;
  right: -15%;
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.hero::after {
  content: "";
  position: absolute;
  bottom: -25%;
  left: -8%;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
/* 滚动驱动 hero 收缩 */
.hero.hero-collapsed {
  padding-bottom: 48rpx;
}

/* HTML: .hero-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px} */
.hero-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 52rpx;
  position: relative;
  z-index: 2;
}
/* HTML: .hero-title-block h1{font-size:18px;font-weight:600;color:var(--text-1)} */
.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
}
/* HTML: .hero-title-block p{font-size:13px;color:var(--text-2);margin-top:3px} */
.hero-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 6rpx;
  font-weight: 400;
}

/* HTML: .balance-label{font-size:13px;color:var(--text-2);font-weight:500;margin-bottom:8px} */
.balance-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  margin-bottom: 16rpx;
  letter-spacing: 0.02em;
  position: relative;
  z-index: 2;
}
/* HTML: .balance-amount{font-size:38px;font-weight:800;color:var(--brand);letter-spacing:-1.2px;line-height:1.1;font-variant-numeric:tabular-nums} */
.balance-amount {
  display: block;
  font-size: 76rpx;
  font-weight: 800;
  color: var(--brand-worker);
  letter-spacing: -2.4rpx;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  position: relative;
  z-index: 2;
}
/* HTML: .balance-chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px} */
.balance-chips {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}
/* HTML: .chip{padding:6px 12px;border-radius:var(--r-pill);background:rgba(255,255,255,0.50);backdrop-filter:blur(12px);border:0.5px solid rgba(255,255,255,0.55);box-shadow:var(--neu-out-sm),inset 0 1px 1.5px rgba(255,255,255,0.50);font-size:12.5px;color:var(--text-1);font-weight:600} */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  font-size: 25rpx;
  color: var(--text-1);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
/* HTML: .chip .chip-label{color:var(--text-2);font-weight:500} */
.chip .chip-label {
  color: var(--text-2);
  font-weight: 500;
}

/* ===== Quick Actions Card (overlaps hero -18px) ===== */
/* HTML: .quick-card{margin:-18px 24px 0;background:rgba(255,255,255,0.52);backdrop-filter:blur(20px) saturate(160%);border:1px solid rgba(255,255,255,0.70);border-radius:var(--r);box-shadow:var(--neu-out-md),0 10px 36px rgba(0,0,0,0.08),...;padding:18px 8px;display:flex;justify-content:space-around;align-items:center} */
.quick-card {
  position: relative;
  z-index: 10;
  margin: -36rpx 48rpx 0;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised), 0 20rpx 72rpx rgba(0, 0, 0, 0.08), 0 0 0 2rpx rgba(44, 40, 36, 0.05), var(--shadow-card-worker);
  padding: 36rpx 16rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  overflow: hidden;
}
.quick-card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}
/* HTML: .qa-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;padding:10px 4px;background:rgba(255,255,255,0.40);border:0.5px solid rgba(255,255,255,0.60);border-radius:var(--r-sm);box-shadow:var(--neu-out-sm)} */
.qa-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  background: rgba(255, 255, 255, 0.40);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: var(--r-sm);
  box-shadow: var(--neu-raised-sm);
  position: relative;
  z-index: 1;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
}
.qa-item:active {
  box-shadow: var(--neu-inset-sm);
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.25);
}
/* HTML: .qa-icon{width:46px;height:46px;border-radius:50%;background:var(--bg);box-shadow:var(--neu-out-sm),inset 0 1px 1.5px rgba(255,255,255,0.55);color:var(--brand)} */
.qa-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-worker);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}
.qa-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: inline-block;
}
/* HTML: .qa-label{font-size:13px;font-weight:600;color:var(--text-1)} */
.qa-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

/* ===== Section + Card ===== */
/* HTML: .section{padding:0 24px;margin-top:20px} */
.section {
  padding: 0 48rpx;
  margin-top: 40rpx;
  position: relative;
  z-index: 5;
}
/* HTML: .section-title{font-size:17px;font-weight:700;margin-bottom:12px;letter-spacing:-0.02em} */
.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;
  letter-spacing: -0.02em;
}
/* HTML: .card{background:rgba(255,255,255,0.52);backdrop-filter:blur(20px) saturate(150%);border:1px solid rgba(255,255,255,0.70);border-radius:var(--r);box-shadow:var(--neu-out-md),...} */
.card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised), 0 12rpx 48rpx rgba(0, 0, 0, 0.06), 0 0 0 2rpx rgba(44, 40, 36, 0.05), var(--shadow-card-worker);
  overflow: hidden;
  position: relative;
}
.card::before {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

/* ===== Income Stats Card ===== */
/* HTML: .income-card{padding:18px 18px 16px} */
.income-card {
  padding: 36rpx 36rpx 32rpx;
}
/* HTML: .income-card-title{font-size:16px;font-weight:700;margin-bottom:16px} */
.income-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 32rpx;
  letter-spacing: -0.01em;
  position: relative;
  z-index: 1;
}

/* HTML: .chart-wrap{display:flex;gap:10px;align-items:stretch;height:160px;margin-bottom:14px} */
.chart-wrap {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
  height: 320rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}
/* HTML: .y-axis{flex-direction:column;justify-content:space-between;align-items:flex-end;padding-right:4px;padding-top:2px;padding-bottom:18px} */
.y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  padding-right: 8rpx;
  padding-top: 4rpx;
  padding-bottom: 36rpx;
  flex-shrink: 0;
}
/* HTML: .y-label{font-size:10px;color:var(--text-3);font-weight:500} */
.y-label {
  font-size: 20rpx;
  color: var(--text-3);
  font-weight: 500;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* HTML: .bars-area{flex:1;display:flex;align-items:flex-end;justify-content:space-between;gap:8px;padding-bottom:18px} */
.bars-area {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  position: relative;
  padding-bottom: 36rpx;
}
/* HTML: .bars-area::before/::after grid lines */
.bars-area::before,
.bars-area::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: var(--sep);
  pointer-events: none;
}
.bars-area::before { top: 0; }
.bars-area::after { top: 50%; }

/* HTML: .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;height:100%;justify-content:flex-end} */
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
  position: relative;
}
/* HTML: .bar-track{width:100%;height:100%;display:flex;align-items:flex-end;justify-content:center} */
.bar-track {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
/* HTML: .bar{width:70%;max-width:18px;border-radius:6px 6px 3px 3px;background:var(--brand-subtle);opacity:0.85;min-height:8px} */
.bar {
  width: 70%;
  max-width: 36rpx;
  border-radius: 12rpx 12rpx 6rpx 6rpx;
  background: var(--brand-worker-subtle);
  opacity: 0.85;
  transition: opacity 0.2s ease, transform var(--dur-base) var(--spring);
  min-height: 16rpx;
}
.bar-col:active .bar {
  opacity: 1;
  transform: scaleY(0.96);
  transform-origin: bottom;
}
/* HTML: .bar.today{background:var(--brand);opacity:1;box-shadow:0 0 12px var(--brand-glow);max-width:20px;width:80%} */
.bar.today {
  background: var(--brand-worker);
  opacity: 1;
  box-shadow: 0 0 24rpx var(--brand-worker-glow);
  max-width: 40rpx;
  width: 80%;
}
/* HTML: .bar-label{position:absolute;bottom:0;font-size:10.5px;color:var(--text-2)} */
.bar-label {
  position: absolute;
  bottom: 0;
  font-size: 21rpx;
  color: var(--text-2);
  font-weight: 500;
  line-height: 1;
}
.bar-col.today-col .bar-label {
  color: var(--brand-worker);
  font-weight: 700;
}

/* HTML: .chart-summary{display:flex;align-items:center;justify-content:space-between;padding-top:12px;border-top:0.5px solid var(--sep)} */
.chart-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--sep);
  position: relative;
  z-index: 1;
}
/* HTML: .cs-label{font-size:13px;color:var(--text-2);font-weight:500} */
.cs-label {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}
/* HTML: .cs-value{font-size:17px;font-weight:700;color:var(--brand)} */
.cs-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand-worker);
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

/* ===== Transaction Rows ===== */
/* HTML: .tx-card{padding:2px 0} */
.tx-card {
  padding: 4rpx 0;
}
/* HTML: .tx-row{display:flex;align-items:center;gap:12px;padding:14px 18px;position:relative} */
.tx-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 36rpx;
  position: relative;
  z-index: 1;
  transition: transform var(--dur-base) var(--ease);
}
.tx-row:active { transform: scale(0.98); }
/* HTML: .tx-row+.tx-row::before{content:"";position:absolute;top:0;left:60px;right:18px;height:0.5px;background:var(--sep)} */
.tx-row + .tx-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 120rpx;
  right: 36rpx;
  height: 1rpx;
  background: var(--sep);
}
/* HTML: .tx-icon{width:40px;height:40px;border-radius:var(--r-sm);background:var(--bg);box-shadow:4px 4px 8px var(--neu-dark),-4px -4px 8px var(--neu-light),inset 0 1px 1px rgba(255,255,255,0.45)} */
.tx-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg-elevated);
  box-shadow: 8rpx 8rpx 16rpx var(--neu-dark), -8rpx -8rpx 16rpx var(--neu-light), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}
.tx-icon-img {
  width: 40rpx;
  height: 40rpx;
  display: inline-block;
}
/* HTML: .tx-icon.income{color:var(--green)} / .tx-icon.outcome{color:var(--red)} */
.tx-icon.income { color: var(--green); }
.tx-icon.outcome { color: var(--red); }
/* HTML: .tx-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px} */
.tx-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
/* HTML: .tx-title{font-size:15px;font-weight:600;color:var(--text-1)} */
.tx-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* HTML: .tx-time{font-size:12px;color:var(--text-2)} */
.tx-time {
  font-size: 24rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
/* HTML: .tx-amount{font-size:16px;font-weight:700;letter-spacing:-0.02em;flex-shrink:0;font-variant-numeric:tabular-nums} */
.tx-amount {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.tx-amount.income { color: var(--green); }
.tx-amount.outcome { color: var(--red); }
