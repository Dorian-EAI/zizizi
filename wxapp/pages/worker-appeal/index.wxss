/* pages/worker-appeal/index.wxss — 师傅申诉页 玻璃新拟态
 * 像素级复刻 worker-appeal.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

/* ===== 师傅端 brand token 覆盖（蓝色 #2D6CDF） ===== */
page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
  --brand-worker-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== Back Bar ===== */
/* HTML: 渐变背景 + border-radius:0 0 28px 28px */
.back-bar {
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212,148,76,.10) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(212,148,76,.04) 50%, rgba(45, 108, 223, 0.06) 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;          /* 12px */
  padding: 0 40rpx 28rpx; /* top 由内联 style 动态提供；20px 14px → 40rpx 28rpx */
  position: relative;
  z-index: 20;
  border-radius: 0 0 56rpx 56rpx; /* 28px */
  overflow: hidden;
}

/* HTML: 38px×38px; border-radius:50%; background:rgba(255,255,255,0.50); backdrop-filter:blur(12px) */
.back-btn {
  width: 76rpx;        /* 38px */
  height: 76rpx;       /* 38px */
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.60); /* 0.5px */
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.back-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.92);
}

/* HTML: svg 18px×18px */
.back-btn-icon {
  width: 36rpx;        /* 18px */
  height: 36rpx;       /* 18px */
}

/* HTML: font-size:17px; font-weight:700; letter-spacing:-0.02em */
.back-title {
  font-size: 34rpx;    /* 17px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  text-align: center;
}

/* HTML: 38px */
.back-spacer {
  width: 76rpx;        /* 38px */
  flex-shrink: 0;
}

/* ===== Section ===== */
/* HTML: padding:0 24px; margin-top:20px */
.section {
  position: relative;
  z-index: 1;
  padding: 0 48rpx;     /* 24px */
  margin-top: 40rpx;    /* 20px */
}

/* HTML: margin-bottom:12px */
.section-title-row {
  margin-bottom: 24rpx; /* 12px */
}

/* HTML: font-size:17px; font-weight:700; letter-spacing:-0.02em */
.section-title-text {
  font-size: 34rpx;     /* 17px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

/* ===== Appeal Hero (说明卡 · 玻璃渐变) ===== */
/* HTML: margin:4px 24px 0; padding:22px; gap:16px; border-radius:var(--r-lg) */
.appeal-hero {
  margin: 8rpx 48rpx 0;  /* 4px 24px */
  padding: 44rpx;         /* 22px */
  display: flex;
  gap: 32rpx;             /* 16px */
  align-items: flex-start;
  background:
    radial-gradient(ellipse 400rpx 320rpx at 20% 30%, rgba(212,148,76,.12) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 85% 80%, rgba(45, 108, 223, 0.22) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.24) 0%, rgba(212,148,76,.10) 50%, rgba(45, 108, 223, 0.10) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow: var(--neu-raised), 0 12rpx 48rpx rgba(0, 0, 0, 0.06), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
  position: relative;
  overflow: hidden;
  z-index: 5;
}

/* HTML: ::before top:-25%; right:-12%; 170px×170px */
.appeal-hero::before {
  content: "";
  position: absolute;
  top: -25%;
  right: -12%;
  width: 340rpx;       /* 170px */
  height: 340rpx;      /* 170px */
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* HTML: ::after bottom:-30%; left:-8%; 150px×150px */
.appeal-hero::after {
  content: "";
  position: absolute;
  bottom: -30%;
  left: -8%;
  width: 300rpx;       /* 150px */
  height: 300rpx;      /* 150px */
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* HTML: 52px×52px; border-radius:var(--r-sm); background:rgba(255,255,255,0.55) */
.appeal-hero-icon {
  width: 104rpx;       /* 52px */
  height: 104rpx;      /* 52px */
  border-radius: var(--r-sm);
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.50);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

/* HTML: svg 26px×26px */
.appeal-hero-icon-img {
  width: 52rpx;        /* 26px */
  height: 52rpx;       /* 26px */
}

.appeal-hero-text {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

/* HTML: h2 font-size:17px; margin-bottom:6px */
.appeal-hero-title {
  font-size: 34rpx;     /* 17px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  margin-bottom: 12rpx; /* 6px */
  display: block;
}

/* HTML: p font-size:13px; line-height:1.55 */
.appeal-hero-desc {
  font-size: 26rpx;     /* 13px */
  color: var(--text-2);
  line-height: 1.55;
  display: block;
}

/* ===== Appeal List ===== */
/* HTML: .appeal-card padding:4px 0; inherits .card styles */
.appeal-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised), 0 12rpx 48rpx rgba(0, 0, 0, 0.06), 0 0 0 2rpx rgba(44, 40, 36, 0.05), 0 4rpx 16rpx rgba(20, 184, 166, 0.04);
  overflow: hidden;
  position: relative;
  padding: 8rpx 0;      /* 4px */
}

/* HTML: padding:16px 18px */
.appeal-item {
  padding: 32rpx 36rpx; /* 16px 18px */
  position: relative;
  z-index: 1;
}

/* HTML: +.appeal-item::before top:0; left:18px; right:18px; height:0.5px */
.appeal-item + .appeal-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 36rpx;         /* 18px */
  right: 36rpx;        /* 18px */
  height: 1rpx;        /* 0.5px */
  background: var(--sep);
}

/* HTML: margin-bottom:9px; gap:8px */
.appeal-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;          /* 8px */
  margin-bottom: 18rpx; /* 9px */
}

/* HTML: padding:3px 10px; font-size:11px; border:0.5px */
.penalty-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;  /* 3px 10px */
  border-radius: var(--r-pill);
  background: var(--brand-subtle);
  color: var(--brand);
  font-size: 22rpx;     /* 11px */
  font-weight: 600;
  border: 1rpx solid rgba(45, 108, 223, 0.22); /* 0.5px */
}

/* HTML: padding:3px 10px; font-size:11px; border:0.5px solid transparent */
.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;  /* 3px 10px */
  border-radius: var(--r-pill);
  font-size: 22rpx;     /* 11px */
  font-weight: 600;
  border: 1rpx solid transparent;
  letter-spacing: 0.01em;
}

/* HTML: rgba(212,148,76,0.14); color:var(--orange) */
.status-pending {
  background: rgba(212, 148, 76, 0.14);
  color: var(--orange);
  border-color: rgba(212, 148, 76, 0.32);
}

.status-passed {
  background: rgba(91, 140, 90, 0.14);
  color: var(--green);
  border-color: rgba(91, 140, 90, 0.32);
}

/* HTML: rgba(196,83,58,0.14); color:var(--red) */
.status-rejected {
  background: rgba(196, 83, 58, 0.14);
  color: var(--red);
  border-color: rgba(196, 83, 58, 0.32);
}

/* HTML: font-size:15px; margin-bottom:4px */
.appeal-item-title {
  font-size: 30rpx;     /* 15px */
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 8rpx;  /* 4px */
  display: block;
}

/* HTML: font-size:13px; margin-bottom:11px */
.appeal-item-reason {
  font-size: 26rpx;     /* 13px */
  color: var(--text-2);
  margin-bottom: 22rpx; /* 11px */
  display: block;
}

/* HTML: gap:8px */
.appeal-item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;          /* 8px */
}

/* HTML: font-size:12px; font-variant-numeric:tabular-nums */
.appeal-item-time {
  font-size: 24rpx;     /* 12px */
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

/* HTML: gap:2px; padding:6px 12px; font-size:13px; border:0.5px */
.appeal-view-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;           /* 2px */
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-pill);
  padding: 12rpx 24rpx; /* 6px 12px */
  box-shadow: var(--neu-raised-sm);
}

.appeal-view-text {
  color: var(--brand);
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
}

/* HTML: svg 13px×13px */
.appeal-view-icon {
  width: 26rpx;        /* 13px */
  height: 26rpx;       /* 13px */
}

/* ===== Form Card ===== */
/* HTML: padding:6px 18px; inherits .card styles */
.form-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: var(--neu-raised), 0 12rpx 48rpx rgba(0, 0, 0, 0.06), 0 0 0 2rpx rgba(44, 40, 36, 0.05), 0 4rpx 16rpx rgba(20, 184, 166, 0.04);
  overflow: hidden;
  position: relative;
  padding: 12rpx 36rpx; /* 6px 18px */
}

/* HTML: padding:14px 0 */
.form-field {
  padding: 28rpx 0;     /* 14px */
  position: relative;
  z-index: 1;
}

/* HTML: +.form-field border-top:0.5px */
.form-field + .form-field {
  border-top: 1rpx solid var(--sep);
}

/* HTML: font-size:13px; margin-bottom:10px */
.form-label {
  display: block;
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 20rpx; /* 10px */
  letter-spacing: -0.01em;
}

/* HTML: border:0.5px; border-radius:var(--r-sm); padding:12px 14px; font-size:14px; inset shadow */
.form-input,
.form-textarea {
  width: 100%;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: var(--r-sm);
  padding: 24rpx 28rpx; /* 12px 14px */
  font-size: 28rpx;     /* 14px */
  color: var(--text-1);
  font-family: var(--font-body);
  box-shadow: inset 4rpx 4rpx 10rpx var(--neu-dark), inset -4rpx -4rpx 10rpx var(--neu-light);
  outline: none;
  box-sizing: border-box;
  transition: box-shadow var(--dur-base) var(--ease);
}

.form-ph {
  color: var(--text-3);
}

.form-textarea {
  resize: none;
  line-height: 1.55;
  min-height: 192rpx;   /* 96px */
  display: block;
}

/* HTML: chip-group gap:8px */
.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;           /* 8px */
}

/* HTML: padding:8px 14px; font-size:13px; border:0.5px */
.chip-radio {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx; /* 8px 14px */
  border-radius: var(--r-pill);
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;     /* 13px */
  font-weight: 600;
  border: 1rpx solid var(--border);
  box-shadow: var(--neu-raised-sm);
  transition: all var(--dur-base) var(--ease);
}

/* HTML: input:checked+span background:var(--brand); color:#fff */
.chip-radio.active {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
  box-shadow: var(--neu-raised-sm), 0 0 24rpx var(--brand-glow);
}

/* HTML: upload-grid gap:10px */
.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;           /* 10px */
}

/* HTML: 74px×74px; border:1.5px dashed; border-radius:var(--r-sm) */
.upload-cell {
  position: relative;
  width: 148rpx;        /* 74px */
  height: 148rpx;       /* 74px */
  border-radius: var(--r-sm);
  background: var(--bg);
  overflow: hidden;
}

.upload-cell.upload-add {
  border: 3rpx dashed var(--text-3); /* 1.5px */
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  background: var(--bg);
  box-shadow: none;
  transition: all var(--dur-base) var(--ease);
}

.upload-cell.upload-add:active {
  transform: scale(0.94);
  border-color: var(--brand);
  color: var(--brand);
}

.upload-preview {
  width: 100%;
  height: 100%;
}

/* HTML: svg 22px×22px */
.upload-add-icon {
  width: 44rpx;        /* 22px */
  height: 44rpx;       /* 22px */
}

.upload-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* HTML: font-size:11.5px; margin-top:8px */
.upload-hint {
  font-size: 23rpx;     /* 11.5px */
  color: var(--text-3);
  margin-top: 16rpx;    /* 8px */
  line-height: 1.4;
  display: block;
}

/* ===== Fixed Submit Bar ===== */
/* HTML: left/right:24px; bottom:18px */
.submit-bar {
  position: fixed;
  left: 48rpx;         /* 24px */
  right: 48rpx;        /* 24px */
  bottom: 36rpx;       /* 18px */
  z-index: 100;
}

/* HTML: gap:8px; border:0.5px; border-radius:var(--r-pill); padding:16px; font-size:16px */
.btn-submit {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;          /* 8px */
  background: var(--brand-gradient);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.40); /* 1px */
  border-radius: var(--r-pill);
  padding: 32rpx;       /* 16px */
  font-size: 32rpx;     /* 16px */
  font-weight: 700;
  letter-spacing: 0.04em;
  box-shadow: var(--neu-raised), 0 16rpx 48rpx var(--brand-glow), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.30);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}

.btn-submit:active {
  transform: scale(0.97);
  box-shadow: var(--neu-inset);
}

/* HTML: svg 18px×18px */
.btn-submit-icon {
  width: 36rpx;        /* 18px */
  height: 36rpx;       /* 18px */
}

.btn-submit-text {
  color: #fff;
  font-size: 32rpx;     /* 16px */
  font-weight: 700;
  letter-spacing: 0.04em;
}
