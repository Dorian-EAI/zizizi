.review-page{height:100vh;display:flex;flex-direction:column;overflow:hidden}.review-scroll{flex:1;min-height:0}.section{padding:32rpx 40rpx 0}.section-title{display:block;font-size:30rpx;margin-bottom:24rpx}.worker-card{display:flex;align-items:center;gap:28rpx;padding:40rpx}.worker-avatar{width:128rpx;height:128rpx;border-radius:40rpx;background:linear-gradient(135deg,var(--brand),var(--brand-mid));box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:#fff;font-size:48rpx;font-weight:600;flex-shrink:0}.worker-info{flex:1;display:flex;flex-direction:column}.worker-name{font-size:34rpx;font-weight:700;margin-bottom:8rpx}.worker-service{font-size:26rpx;color:var(--text-2);margin-bottom:8rpx}.worker-rating{font-size:24rpx;color:var(--accent)}.star-section{text-align:center;padding:48rpx 0}.star-label{display:block;font-size:28rpx;color:var(--text-2);margin-bottom:32rpx}.stars{display:flex;justify-content:center;gap:24rpx}.star{width:96rpx;height:96rpx}.star image{width:100%;height:100%}.star-text{display:block;margin-top:24rpx;font-size:28rpx;color:var(--text-3);font-weight:600}.star-text.active{color:var(--accent)}
.tag-list{display:flex;flex-wrap:wrap;gap:20rpx}.tag-item{padding:16rpx 32rpx;border-radius:var(--r-pill);font-size:26rpx;background:rgba(255,255,255,.52);border:1rpx solid rgba(255,255,255,.60);box-shadow:var(--neu-out-sm);color:var(--text-2)}.tag-item.selected{background:var(--brand);color:#fff;box-shadow:var(--neu-out-sm),0 4rpx 16rpx var(--brand-glow);border-color:transparent}.review-textarea{width:100%;min-height:240rpx;padding:32rpx;border-radius:var(--r-md);background:var(--bg-elevated);box-shadow:var(--neu-in);font-size:28rpx;color:var(--text-1);line-height:1.6}.textarea-counter{display:block;text-align:right;font-size:24rpx;color:var(--text-3);margin-top:16rpx}.upload-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20rpx}.upload-item,.upload-add{aspect-ratio:1;border-radius:24rpx;overflow:hidden;position:relative;background:var(--bg-elevated);box-shadow:var(--neu-out-sm)}.upload-item>image{width:100%;height:100%}.upload-delete{position:absolute;top:8rpx;right:8rpx;width:40rpx;height:40rpx;border-radius:50%;background:rgba(0,0,0,.5);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx}.upload-add{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;color:var(--text-3)}.upload-add image{width:56rpx;height:56rpx}.upload-add-text{font-size:22rpx}
.anon-row{display:flex;align-items:center;justify-content:space-between;padding:32rpx 40rpx;background:rgba(255,255,255,.52);border-radius:var(--r-md);border:1rpx solid rgba(255,255,255,.60);box-shadow:var(--neu-out-sm)}.anon-left{display:flex;align-items:center;gap:20rpx}.anon-icon{width:72rpx;height:72rpx;border-radius:20rpx;background:var(--bg-elevated);box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center}.anon-icon image{width:36rpx;height:36rpx}.anon-text{display:block;font-size:28rpx;font-weight:500}.anon-desc{display:block;font-size:22rpx;color:var(--text-2)}.toggle{width:88rpx;height:52rpx;border-radius:26rpx;background:var(--neu-dark);box-shadow:var(--neu-in);position:relative}.toggle-dot{position:absolute;top:6rpx;left:6rpx;width:40rpx;height:40rpx;border-radius:50%;background:var(--bg-elevated);box-shadow:var(--neu-out-sm);transition:transform var(--dur-base) var(--spring)}.toggle.active{background:var(--brand)}.toggle.active .toggle-dot{transform:translateX(36rpx)}
.submit-bar{flex-shrink:0;z-index:100;padding:24rpx 40rpx;background:rgba(255,255,255,.72);backdrop-filter:blur(48rpx) saturate(160%);border-top:1rpx solid rgba(255,255,255,.60);box-shadow:0 -8rpx 40rpx rgba(0,0,0,.06)}.submit-btn{width:100%;padding:32rpx;background:var(--brand-gradient);color:#fff;font-size:32rpx;font-weight:700;border-radius:var(--r-pill);box-shadow:var(--neu-out-sm),0 8rpx 28rpx var(--brand-glow);line-height:1.4}.submit-btn[disabled]{background:var(--neu-dark);color:var(--text-3);box-shadow:none}.permission-warning{margin:24rpx 40rpx 0;padding:28rpx 32rpx;background:rgba(196,83,58,.08);border:1rpx solid rgba(196,83,58,.24);border-radius:var(--r-md);display:flex;flex-direction:column}.warning-title{font-size:28rpx;font-weight:700;color:var(--red);margin-bottom:8rpx}.warning-desc{font-size:24rpx;color:var(--text-2);line-height:1.5}.state-panel{padding:280rpx 64rpx;display:flex;flex-direction:column;align-items:center;text-align:center;color:var(--text-2)}.state-title{font-size:32rpx;font-weight:700;color:var(--text-1);margin-bottom:12rpx}.state-desc{font-size:26rpx;line-height:1.5}.scroll-spacer{height:48rpx}
.upload-item,.upload-add{min-height:152rpx}.submit-bar{-webkit-backdrop-filter:blur(48rpx) saturate(160%)}
