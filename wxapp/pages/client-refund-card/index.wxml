<view class="phone-page design-detail-page" data-page-id="page-client-refund-card">
  <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" data-route="/pages/client-annual-card/index" bindtap="onNavigate"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">退卡申请</view><text class="tag-span"></text></view>
  <view class="page-body">
    <view class="notice error" wx:if="{{loadError}}">{{loadError}}</view>
    <view class="hero" wx:if="{{card}}"><view class="hero-kicker tag-p">{{card.name}}</view><view class="tag-h2">剩余有效期 {{card.remainingDays}} 天</view><view class="tag-p">已使用 / 总次数：{{card.usageText}}</view><view class="hero-number">¥ {{card.paidText}} <text class="tag-small">原购卡价格</text></view></view>
    <view class="section"><view class="section-title"><text class="tag-strong">退卡原因</text><text class="tag-span">单选</text></view><view class="chips"><view class="chip design-button {{reason === '使用频率低' ? 'active' : ''}}" data-reason="使用频率低" bindtap="onReason">使用频率低</view><view class="chip design-button {{reason === '服务不满意' ? 'active' : ''}}" data-reason="服务不满意" bindtap="onReason">服务不满意</view><view class="chip design-button {{reason === '搬家' ? 'active' : ''}}" data-reason="搬家" bindtap="onReason">搬家了</view><view class="chip design-button {{reason === '其他' ? 'active' : ''}}" data-reason="其他" bindtap="onReason">其他</view></view></view>
    <view class="section"><view class="section-title"><text class="tag-strong">退款信息</text></view><view class="card list-card">
      <view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20aria-hidden%3D%22true%22%3E%3Cpath%20d%3D%22M3%2012a9%209%200%201%200%203-6.7L3%208%22%2F%3E%3Cpath%20d%3D%22M3%203v5h5M9%2012h6M12%209v6%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">退款方式</view></view><text class="row-value tag-span">尚未接入</text></view>
      <view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20aria-hidden%3D%22true%22%3E%3Cpath%20d%3D%22M20%207V5a2%202%200%200%200-2-2H5a3%203%200%200%200%200%206h15v12H5a3%203%200%200%201-3-3V6%22%2F%3E%3Cpath%20d%3D%22M16%2013h4%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">退款账户</view></view><text class="row-value tag-span">待原支付契约确认</text></view>
      <view class="list-row"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20aria-hidden%3D%22true%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22M12%207v5l3%202%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">预计退款</view></view><text class="row-value tag-span">待服务端核算</text></view>
    </view></view>
    <view class="notice error">年卡退款与原支付渠道尚未接入。点击提交不会冻结权益、创建退款或改变年卡状态。</view>
  </view>
  <view class="fixed-actions"><view class="btn danger design-button is-disabled" bindtap="onSubmit">退卡服务暂未开放</view></view>
</view>
