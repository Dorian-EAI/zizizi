/* pages/client-mine/index.wxss — 像素级复刻 zjrnew/pages/client-mine.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

/* ===== 页面容器（不设 overflow:hidden，避免 scroll-view 内容裁剪） ===== */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--canvas);
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* ===== HERO — 活力渐变光晕（严格对齐 HTML：rgba 值 ×1） ===== */
/* HTML: padding: max(38px, env(safe-area-inset-top)) 24px 28px; border-radius: 0 0 32px 32px; */
.hero {
  padding: 0 48rpx 56rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 75% 40%, rgba(212, 148, 76, 0.16) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 20% 80%, rgba(13, 148, 136, 0.12) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.12) 0%, rgba(212, 148, 76, 0.14) 50%, rgba(20, 184, 166, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
  color: var(--text-1);
}

/* HTML: profile-row gap 14px; position relative z-index 2; */
.profile-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  z-index: 2;
}

/* HTML: avatar 52x52, base inset shadow */
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg);
  box-shadow: inset 6rpx 6rpx 12rpx var(--neu-dark), inset -6rpx -6rpx 12rpx var(--neu-light);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: transform var(--dur-base) var(--ease);
}

/* HTML: .avatar.avatar-glass — 玻璃质感 + 新拟态凸起 */
.avatar.avatar-glass {
  background: linear-gradient(145deg,
    rgba(255, 255, 255, 0.68) 0%,
    rgba(255, 255, 255, 0.28) 40%,
    var(--brand-subtle) 78%,
    rgba(255, 255, 255, 0.18) 100%);
  backdrop-filter: blur(20rpx) saturate(160%);
  -webkit-backdrop-filter: blur(20rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow:
    inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04),
    var(--neu-raised-sm);
}

/* HTML: .avatar.avatar-glass::before — Rim Light 高光 */
.avatar.avatar-glass::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(160deg,
    rgba(255, 255, 255, 0.48) 0%,
    rgba(255, 255, 255, 0.12) 35%,
    transparent 60%);
  pointer-events: none;
}

.avatar:active { transform: scale(0.97); }

/* HTML: avatar svg 26x26 */
.avatar-img {
  width: 52rpx;
  height: 52rpx;
  position: relative;
  z-index: 1;
}

/* HTML: profile-info flex:1 min-width:0 */
.profile-info {
  flex: 1;
  min-width: 0;
}

/* HTML: profile-name 20px / 700 / text-1 / -0.02em / line-height 1.2 */
.profile-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

/* HTML: profile-phone 13px / text-2 / margin-top 4px / 500 */
.profile-phone {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 8rpx;
  font-weight: 500;
}

/* HTML: edit-btn 36x36 glass circle */
.edit-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow:
    var(--neu-raised-sm),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  transition: transform var(--dur-base) var(--ease), box-shadow 0.15s var(--ease);
}

.edit-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.85);
}

/* HTML: edit-btn svg 16x16 */
.edit-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ===== Stats Card — 独立玻璃卡片，与 hero 重叠 -24px ===== */
/* HTML: margin: -24px 24px 0; padding: 20px 12px; border-radius: var(--r) [1.2rem=38rpx]; */
.stats-card {
  position: relative;
  z-index: 10;
  margin: -48rpx 48rpx 0;
  padding: 40rpx 24rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow:
    var(--neu-raised),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.60),
    0 16rpx 64rpx rgba(0, 0, 0, 0.08),
    0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

/* HTML: .stats-card::before — Rim Light */
.stats-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

/* HTML: stat-col flex:1 / gap 6px / padding 0 8px / ::after divider */
.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  padding: 0 16rpx;
  transition: transform var(--dur-base) var(--ease);
  z-index: 1;
}

.stat-col:active { transform: scale(0.92); }

/* HTML: stat-col:not(:last-child)::after right:0 top:8px bottom:8px width:0.5px sep */
.stat-col:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: var(--sep);
}

/* HTML: stat-num 24px / 700 / text-1 / -0.5px / tabular-nums */
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.5px;
  line-height: 1;
}

/* HTML: stat-label 12px / text-2 / line-height 1 / 500 */
.stat-label {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1;
  font-weight: 500;
}

/* ===== Section ===== */
/* HTML: section padding 0 24px; margin-top 20px; +section margin-top 16px */
.section {
  padding: 0 48rpx;
  margin-top: 40rpx;
  position: relative;
  z-index: 2;
}

.section + .section { margin-top: 32rpx; }

/* ===== Menu Card — Glass + 新拟态 ===== */
/* HTML: glass bg / border 1px / border-radius var(--r) [38rpx] / neu-out-md + 多层投影 */
.menu-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow:
    var(--neu-raised),
    0 12rpx 56rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05),
    0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  overflow: hidden;
  position: relative;
}

/* HTML: .menu-card::before Rim Light */
.menu-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(255, 255, 255, 0.05) 30%,
    transparent 55%);
  pointer-events: none;
  z-index: 0;
}

/* 菜单行内容在 Rim Light 之上 */
.menu-row {
  position: relative;
  z-index: 1;
}

/* HTML: menu-row gap 14px / padding 14px 18px / hairline ::after */
.menu-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 36rpx;
  transition: transform var(--dur-base) var(--ease), background 0.15s ease;
}

.menu-row:active {
  transform: scale(0.98);
  background: var(--fill);
}

/* HTML: menu-row:not(:last-child)::after left:64px right:18px bottom:0 height:0.5px sep */
.menu-row:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 128rpx;
  right: 36rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--sep);
}

/* HTML: menu-icon-wrap 32x32 circle / neu-out + inset highlight */
.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow:
    8rpx 8rpx 16rpx var(--neu-dark),
    -8rpx -8rpx 16rpx var(--neu-light),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}

/* HTML: menu-icon-wrap svg 18x18 */
.menu-icon {
  width: 36rpx;
  height: 36rpx;
}

.menu-icon-blue {
  color: #5A8FAD;
  background: rgba(90, 143, 173, 0.08);
  border: 1rpx solid rgba(90, 143, 173, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(90, 143, 173, 0.06);
}

.menu-icon-purple {
  color: #5856D6;
  background: rgba(88, 86, 214, 0.08);
  border: 1rpx solid rgba(88, 86, 214, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(88, 86, 214, 0.06);
}

.menu-icon-green {
  color: var(--green);
  background: rgba(91, 140, 90, 0.08);
  border: 1rpx solid rgba(91, 140, 90, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(91, 140, 90, 0.06);
}

.menu-icon-gray,
.menu-icon-slate {
  color: var(--text-2);
  background: rgba(120, 120, 128, 0.08);
  border: 1rpx solid rgba(120, 120, 128, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(120, 120, 128, 0.06);
}

.menu-icon-amber {
  color: var(--orange);
  background: rgba(212, 148, 76, 0.05);
  border: 1rpx solid rgba(212, 148, 76, 0.07);
  box-shadow: 0 4rpx 12rpx rgba(212, 148, 76, 0.04);
}

.menu-icon-teal {
  color: var(--brand);
  background: rgba(13, 148, 136, 0.08);
  border: 1rpx solid rgba(13, 148, 136, 0.07);
  box-shadow: 0 4rpx 12rpx rgba(13, 148, 136, 0.04);
}

.menu-icon-red {
  color: var(--red);
  background: rgba(196, 83, 58, 0.08);
  border: 1rpx solid rgba(196, 83, 58, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(196, 83, 58, 0.06);
}

.menu-icon-cyan {
  color: #5A8FAD;
  background: rgba(90, 143, 173, 0.08);
  border: 1rpx solid rgba(90, 143, 173, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(90, 143, 173, 0.06);
}

/* HTML: menu-label flex:1 / 15px / text-1 / 500 / -0.01em */
.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: -0.01em;
}

/* HTML: menu-badge 12px / text-3 / 500 / margin-right 2px */
.menu-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 500;
  margin-right: 4rpx;
}

.menu-badge .dot,
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 0 4rpx rgba(196, 83, 58, 0.15);
  flex-shrink: 0;
}

/* HTML: menu-chevron 14x14 / stroke text-3 / stroke-width 2.2 */
.menu-chevron {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* ===== 切换师傅端按钮（页面自定义，沿用玻璃新拟态） ===== */
.switch-role-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  box-shadow: var(--neu-raised-sm);
  transition: transform var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
}

.switch-role-btn:active {
  box-shadow: var(--neu-inset);
  transform: scale(0.97);
}

.switch-icon {
  width: 36rpx;
  height: 36rpx;
}

.switch-text {
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 600;
}

/* ===== 背景装饰光斑颜色（配合全局 .blob 基类）===== */
.blob-brand {
  background: radial-gradient(circle, var(--brand) 0%, transparent 70%);
}

.blob-accent {
  background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
}
