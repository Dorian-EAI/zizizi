.service-page{height:100vh;display:flex;flex-direction:column;overflow:hidden}.compact-nav{padding:28rpx 40rpx;padding-top:calc(env(safe-area-inset-top) + 28rpx);border-radius:0 0 48rpx 48rpx;flex-shrink:0}.compact-nav .nav-icon-btn{width:80rpx;height:80rpx}.compact-nav .nav-icon{width:36rpx;height:36rpx}.nav-title-area{text-align:center;display:flex;flex-direction:column;align-items:center}.nav-title-area .nav-title{font-size:32rpx;margin-bottom:4rpx}.nav-status{font-size:22rpx;color:var(--green);display:flex;align-items:center;gap:8rpx}.status-dot{width:12rpx;height:12rpx;border-radius:50%;background:var(--green)}
.chat-area{flex:1;min-height:0;padding:32rpx 40rpx;box-sizing:border-box}.chat-date{text-align:center;font-size:22rpx;color:var(--text-3);margin:24rpx 0}.msg-row{display:flex;margin-bottom:32rpx;align-items:flex-end;gap:16rpx}.msg-row.user{flex-direction:row-reverse}.msg-avatar{width:72rpx;height:72rpx;border-radius:24rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:28rpx;font-weight:600;box-shadow:var(--neu-out-sm)}.msg-avatar.service{background:linear-gradient(135deg,var(--brand),var(--brand-mid))}.msg-avatar.user{background:linear-gradient(135deg,var(--accent),var(--accent-dark))}.msg-content{max-width:70%;display:flex;flex-direction:column}.msg-bubble{padding:24rpx 32rpx;border-radius:36rpx;font-size:28rpx;line-height:1.6;word-break:break-all;white-space:pre-wrap}.msg-row.service .msg-bubble{background:rgba(255,255,255,.60);border-bottom-left-radius:12rpx;box-shadow:var(--neu-out-sm);border:1rpx solid rgba(255,255,255,.60)}.msg-row.user .msg-bubble{background:var(--brand-gradient);color:#fff;border-bottom-right-radius:12rpx;box-shadow:0 8rpx 28rpx var(--brand-glow)}.msg-time{font-size:20rpx;color:var(--text-3);margin-top:8rpx}.msg-row.user .msg-time{text-align:right}
.quick-replies{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:16rpx}.quick-reply{padding:16rpx 28rpx;background:rgba(255,255,255,.52);border:1rpx solid rgba(255,255,255,.60);border-radius:var(--r-pill);font-size:24rpx;color:var(--brand);box-shadow:var(--neu-out-sm)}.quick-reply:active{box-shadow:var(--neu-in);transform:scale(.95)}
.order-card{margin:0 0 32rpx 88rpx;padding:24rpx;background:rgba(255,255,255,.52);border-radius:24rpx;border:1rpx solid rgba(255,255,255,.60);box-shadow:var(--neu-out-sm);display:flex;align-items:center}.order-main{flex:1;display:flex;flex-direction:column}.order-card-title{font-size:24rpx;font-weight:600;margin-bottom:8rpx}.order-card-desc{font-size:22rpx;color:var(--text-2)}.order-arrow{width:32rpx;height:32rpx}
.input-bar{z-index:100;padding:24rpx 32rpx;background:rgba(255,255,255,.72);backdrop-filter:blur(48rpx) saturate(160%);border-top:1rpx solid rgba(255,255,255,.60);flex-shrink:0}.input-row{display:flex;align-items:center;gap:20rpx}.input-action-btn{width:72rpx;height:72rpx;border-radius:50%;background:var(--bg-elevated);box-shadow:var(--neu-out-sm);display:flex;align-items:center;justify-content:center;color:var(--text-2);flex-shrink:0}.input-action-btn image{width:36rpx;height:36rpx}.input-wrapper{flex:1;position:relative}.chat-input{width:100%;height:80rpx;padding:20rpx 88rpx 20rpx 32rpx;border-radius:var(--r-pill);background:var(--bg-elevated);box-shadow:var(--neu-in);font-size:28rpx;color:var(--text-1)}.send-btn{position:absolute;right:12rpx;top:50%;transform:translateY(-50%);width:60rpx;height:60rpx;padding:0;border-radius:50%;background:var(--brand-gradient);display:flex;align-items:center;justify-content:center;box-shadow:0 4rpx 16rpx var(--brand-glow)}.send-btn image{width:32rpx;height:32rpx}.send-btn[disabled]{background:var(--neu-dark);box-shadow:none}.state-block{display:flex;flex-direction:column;align-items:center;gap:24rpx;padding:120rpx 32rpx;color:var(--text-2);font-size:26rpx;text-align:center}.state-block.compact{padding:40rpx}.retry-btn{font-size:26rpx;color:#fff;background:var(--brand);border-radius:var(--r-pill);padding:12rpx 36rpx}.chat-spacer{height:32rpx}
