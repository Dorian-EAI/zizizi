<view class="phone-page design-detail-page" data-page-id="page-client-recharge-record">
  <view class="status-bar"><text class="tag-span">9:41</text><text class="status-icons tag-span">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" data-route="/pages/client-wallet/index" bindtap="onNavigate"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">充值记录</view><text class="tag-span"></text></view>
  <view class="page-body">
    <view class="segmented"><view class="segment design-button {{activeFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilter">全部</view><view class="segment design-button {{activeFilter === 'success' ? 'active' : ''}}" data-filter="success" bindtap="onFilter">成功</view><view class="segment design-button {{activeFilter === 'processing' ? 'active' : ''}}" data-filter="processing" bindtap="onFilter">处理中</view></view>
    <view class="hero"><view class="hero-kicker tag-p">本月充值</view><view class="hero-number">¥{{summaryText}}</view><view class="tag-p">{{summaryCopy}}</view></view>
    <view class="notice error" wx:if="{{loadError}}">{{loadError}}</view>
    <view class="section"><view class="section-title"><text class="tag-strong">充值流水</text><text class="tag-span">{{loading ? '同步中' : total + ' 笔'}}</text></view><view class="card list-card" wx:if="{{transactions.length}}"><view class="list-row" wx:for="{{transactions}}" wx:key="id" data-id="{{item.id}}" bindtap="onTransaction"><view class="row-icon tag-span"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20aria-hidden%3D%22true%22%3E%3Cpath%20d%3D%22M9.5%205C5.9%205%203%207.4%203%2010.3c0%201.6.9%203%202.3%204L4.7%2017l3-1.5c.6.1%201.2.2%201.8.2%203.6%200%206.5-2.4%206.5-5.4S13.1%205%209.5%205Z%22%2F%3E%3Cpath%20d%3D%22M14.5%209c3.6%200%206.5%202.3%206.5%205.2%200%201.5-.8%202.9-2.1%203.9l.5%202.4-2.7-1.3c-.7.2-1.4.3-2.2.3-2.7%200-5-1.3-6-3.3M7.5%209h.01M11.5%209h.01M14%2013h.01M18%2013h.01%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="row-main"><view class="row-title">{{item.title}}</view><view class="row-copy">{{item.timeText}}</view></view><view class="row-value"><text class="amount-{{item.amountTone}} tag-strong">{{item.amountText}}</text><text class="badge {{item.statusTone}} tag-span">{{item.statusText}}</text></view><text class="chevron tag-span">›</text></view></view><view class="empty-state truthful-empty" wx:elif="{{!loading}}"><view class="tag-h3">暂无充值记录</view><view class="tag-p">完成并经服务端确认的充值会显示在这里</view></view></view>
    <view class="btn secondary block design-button" bindtap="onRefresh">刷新记录</view>
  </view>
</view>
