/* pages/worker-reviews/index.wxss — 师傅评价管理页 玻璃新拟态
 * 像素级复刻 worker-reviews.html
 * 换算基准：1px = 2rpx（750rpx 设计稿）
 * 严格忠于 HTML 参考的尺寸、间距、圆角、阴影、渐变透明度
 */

/* ===== 师傅端品牌色覆盖（蓝色 #2D6CDF） ===== */
page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
  --purple: #A0723C;
  --purple-light: rgba(212, 148, 76, 0.12);
  --neu-in: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== Top Nav Bar (sticky) ===== */
/* HTML: nav-bar sticky top:0 z-index:50 padding:18px 20px border-radius:0 0 28px 28px */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx 36rpx;       /* 0 20px 18px */
  /* padding-top 由内联 style 动态提供（statusBarHeight + 36rpx ≈ 18px） */
  border-radius: 0 0 56rpx 56rpx;  /* 0 0 28px 28px */
  overflow: hidden;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212,148,76,.10) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(212,148,76,.04) 50%, rgba(45, 108, 223, 0.06) 100%);
}
/* HTML: nav-icon-btn 44x44 圆 bg-elevated neu-out-sm + inset */
.nav-icon-btn {
  width: 88rpx;        /* 44px */
  height: 88rpx;       /* 44px */
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  flex-shrink: 0;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.nav-icon-btn:active {
  box-shadow: var(--neu-in);
  transform: scale(0.94);
}
/* HTML: nav-icon-btn svg 22x22 */
.nav-icon-btn-icon { width: 44rpx; height: 44rpx; display: inline-block; }

/* HTML: nav-title 17px/700 -0.02em */
.nav-title {
  font-size: 34rpx;    /* 17px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}
/* HTML: nav-placeholder 44x44 */
.nav-placeholder { width: 88rpx; height: 88rpx; flex-shrink: 0; }

/* ===== Sections ===== */
/* HTML: section padding:0 20px margin-top:16px */
.section {
  padding: 0 40rpx;    /* 0 20px */
  margin-top: 32rpx;   /* 16px */
  position: relative;
  z-index: 2;
}
.section:first-of-type { margin-top: 36rpx; }  /* 18px */

/* ===== Glass + Neumorphic Card ===== */
/* HTML: glass-neu-card glass + neu-out-md + ring */
.glass-neu-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);   /* 1.6rem */
  box-shadow: var(--neu-raised), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(45, 108, 223, 0.04), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
  position: relative;
  overflow: hidden;
}
/* HTML: glass-neu-card::before gradient border overlay */
.glass-neu-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 55%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  padding: 1rpx;       /* 0.5px */
  pointer-events: none;
}

/* ===== Card Title ===== */
/* HTML: card-title 16px/700 -0.01em margin-bottom:14px */
.card-title {
  display: block;
  font-size: 32rpx;    /* 16px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 28rpx;  /* 14px */
}

/* ===== Stars (shared) ===== */
/* HTML: star-on orange 14x14; summary 16x16 */
/* HTML: star-off text-3 14x14 */
.summary-stars, .review-stars {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;           /* 2px */
}
.summary-star-icon { width: 32rpx; height: 32rpx; display: inline-block; }  /* 16px */
.review-star-icon { width: 28rpx; height: 28rpx; display: inline-block; }   /* 14px */

/* ===== Score Summary Card ===== */
/* HTML: summary-card padding:0 */
.summary-card { padding: 0; }
/* HTML: summary-top-bar 5px brand-gradient */
.summary-top-bar {
  height: 10rpx;       /* 5px */
  width: 100%;
  background: var(--brand-gradient);
}
/* HTML: summary-body flex gap:20px padding:20px 18px 22px */
.summary-body {
  display: flex;
  gap: 40rpx;          /* 20px */
  padding: 40rpx 36rpx 44rpx;  /* 20px 18px 22px */
  align-items: flex-start;
}
/* HTML: summary-left flex column */
.summary-left {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
/* HTML: score-big 48px/800 brand line-height:1 -0.03em text-shadow glow */
.score-big {
  font-size: 96rpx;    /* 48px */
  font-weight: 800;
  color: var(--brand);
  line-height: 1;
  letter-spacing: -0.03em;
  text-shadow: 0 4rpx 24rpx var(--brand-glow);
  font-variant-numeric: tabular-nums;
}
/* HTML: score-label 12px text-2 500 margin-top:5px */
.score-label {
  font-size: 24rpx;    /* 12px */
  color: var(--text-2);
  font-weight: 500;
  margin-top: 10rpx;   /* 5px */
  letter-spacing: 0.01em;
}
/* HTML: summary-stars margin-top:10px */
.summary-stars { margin-top: 20rpx; }  /* 10px */

/* HTML: summary-right flex column */
.summary-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* HTML: summary-count 12.5px text-2 600 right margin-bottom:14px */
.summary-count {
  font-size: 25rpx;    /* 12.5px */
  color: var(--text-2);
  font-weight: 600;
  text-align: right;
  margin-bottom: 28rpx;  /* 14px */
  letter-spacing: 0.01em;
}
/* HTML: dist-list flex column gap:9px */
.dist-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;          /* 9px */
}
/* HTML: dist-row flex gap:8px */
.dist-row {
  display: flex;
  align-items: center;
  gap: 16rpx;          /* 8px */
}
/* HTML: dist-label 11px text-2 600 width:26px */
.dist-label {
  font-size: 22rpx;    /* 11px */
  color: var(--text-2);
  font-weight: 600;
  width: 52rpx;        /* 26px */
  flex-shrink: 0;
  letter-spacing: 0.01em;
}
/* HTML: dist-track flex:1 7px pill bg-elevated neu-in */
.dist-track {
  flex: 1;
  height: 14rpx;       /* 7px */
  background: var(--bg-elevated);
  border-radius: var(--r-pill);
  box-shadow: var(--neu-in);
  overflow: hidden;
}
/* HTML: dist-fill linear brand→brand-mid + glow */
.dist-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand) 0%, var(--brand-mid) 100%);
  border-radius: var(--r-pill);
  box-shadow: 0 0 12rpx var(--brand-glow);
  transition: width 0.6s var(--ease);
}
/* HTML: dist-pct 11px text-2 700 width:32px right */
.dist-pct {
  font-size: 22rpx;    /* 11px */
  color: var(--text-2);
  font-weight: 700;
  width: 64rpx;        /* 32px */
  text-align: right;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

/* ===== Tag Cloud Card ===== */
/* HTML: tag-cloud-card padding:18px */
.tag-cloud-card { padding: 36rpx; }  /* 18px */
/* HTML: tag-cloud flex wrap gap:10px */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;          /* 10px */
}
/* HTML: tag-chip inline-flex gap:5px 8px 14px pill 12.5px/600 0.5px border neu-out-sm + inset */
.tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;          /* 5px */
  padding: 16rpx 28rpx;  /* 8px 14px */
  border-radius: var(--r-pill);
  font-size: 25rpx;    /* 12.5px */
  font-weight: 600;
  letter-spacing: 0.01em;
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  box-shadow: var(--neu-raised-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.tag-chip:active {
  box-shadow: var(--neu-in);
  transform: scale(0.95);
}
/* HTML: tag-ic 13x13 */
.tag-ic { width: 26rpx; height: 26rpx; display: inline-block; flex-shrink: 0; }
/* HTML: tag-count 800 12px border-left padding-left:6px opacity:0.85 */
.tag-count {
  font-weight: 800;
  font-size: 24rpx;    /* 12px */
  padding-left: 12rpx; /* 6px */
  margin-left: 2rpx;
  border-left: 2rpx solid currentColor;
  opacity: 0.85;
  font-variant-numeric: tabular-nums;
}
/* HTML: tag-brand brand bg + color */
.tag-brand {
  background: rgba(45, 108, 223, 0.10);
  color: var(--brand);
}
/* HTML: tag-accent accent bg + color */
.tag-accent {
  background: rgba(212, 148, 76, 0.12);
  color: var(--accent-dark);
}
/* HTML: tag-green green bg + color */
.tag-green {
  background: rgba(91, 140, 90, 0.12);
  color: var(--green);
}
/* HTML: tag-blue blue bg + color */
.tag-blue {
  background: rgba(90, 143, 173, 0.12);
  color: var(--blue);
}
/* HTML: tag-purple purple-light bg + purple color */
.tag-purple {
  background: var(--purple-light);
  color: var(--purple);
}

/* ===== Review List ===== */
/* HTML: review-list flex column gap:16px */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;          /* 16px */
}

/* ===== Review Card ===== */
/* HTML: review-card padding:16px 18px */
.review-card { padding: 32rpx 36rpx; }  /* 16px 18px */
/* HTML: review-head flex gap:12px margin-bottom:10px */
.review-head {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;          /* 12px */
  margin-bottom: 20rpx;  /* 10px */
}
/* HTML: review-avatar 42x42 圆 bg-elevated neu-in-deep 16px/700 brand */
.review-avatar {
  width: 84rpx;        /* 42px */
  height: 84rpx;       /* 42px */
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-elevated);
  box-shadow: var(--neu-in-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;    /* 16px */
  font-weight: 700;
  color: var(--brand);
  letter-spacing: -0.01em;
}
.review-avatar-accent { color: var(--accent-dark); }
.review-avatar-blue { color: var(--blue); }
.review-avatar-purple { color: var(--purple); }

/* HTML: review-user flex:1 */
.review-user { flex: 1; min-width: 0; }
/* HTML: review-name-row flex gap:8px margin-bottom:5px wrap */
.review-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;          /* 8px */
  margin-bottom: 10rpx;  /* 5px */
  flex-wrap: wrap;
}
/* HTML: review-name 15px/700 -0.01em */
.review-name {
  font-size: 30rpx;    /* 15px */
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}
/* HTML: review-service 10.5px/600 brand-subtle brand 2px 8px pill border */
.review-service {
  display: inline-flex;
  align-items: center;
  font-size: 21rpx;    /* 10.5px */
  font-weight: 600;
  background: var(--brand-subtle);
  color: var(--brand);
  padding: 4rpx 16rpx; /* 2px 8px */
  border-radius: var(--r-pill);
  border: 1rpx solid rgba(45, 108, 223, 0.18);
  letter-spacing: 0.01em;
}
/* HTML: review-date 11.5px text-3 500 flex-shrink:0 */
.review-date {
  font-size: 23rpx;    /* 11.5px */
  color: var(--text-3);
  font-weight: 500;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 4rpx;    /* 2px */
  font-variant-numeric: tabular-nums;
}
/* HTML: review-text 13.5px/500 line-height:1.6 padding:2px 0 */
.review-text {
  display: block;
  font-size: 27rpx;    /* 13.5px */
  color: var(--text-1);
  line-height: 1.6;
  font-weight: 500;
  letter-spacing: 0.005em;
  padding: 4rpx 0;     /* 2px 0 */
}
/* HTML: review-foot flex end margin-top:12px padding-top:10px border-top */
.review-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 24rpx;   /* 12px */
  padding-top: 20rpx;  /* 10px */
  border-top: 1rpx solid var(--sep);  /* 0.5px */
}
/* HTML: review-replied inline-flex gap:4px 12px text-3 500 */
.review-replied {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;           /* 4px */
  font-size: 24rpx;    /* 12px */
  color: var(--text-3);
  font-weight: 500;
}
/* HTML: review-replied svg 13x13 */
.review-replied-icon { width: 26rpx; height: 26rpx; display: inline-block; }
/* HTML: review-reply-btn inline-flex gap:4px transparent 12.5px/600 brand 4px 8px pill */
.review-reply-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;           /* 4px */
  background: transparent;
  font-size: 25rpx;    /* 12.5px */
  font-weight: 600;
  color: var(--brand);
  padding: 8rpx 16rpx; /* 4px 8px */
  border-radius: var(--r-pill);
  transition: transform var(--dur-base) var(--spring), opacity var(--dur-base) var(--ease);
}
.review-reply-btn:active {
  transform: scale(0.94);
  opacity: 0.7;
}
/* HTML: review-reply-btn svg 14x14 */
.review-reply-icon { width: 28rpx; height: 28rpx; display: inline-block; }

/* ===== 空态 ===== */
.empty {
  padding: 240rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-text {
  font-size: 26rpx;
  color: var(--text-3);
}

/* ===== 回复 Modal ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(44, 40, 36, 0.45);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  display: flex;
  align-items: flex-end;
}
.modal-sheet {
  width: 100%;
  background: var(--paper);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg);
  box-shadow: var(--neu-raised-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-close-text {
  font-size: 36rpx;
  color: var(--text-2);
  line-height: 1;
}
.modal-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  border-radius: var(--r-md);
  background: var(--bg);
  box-shadow: var(--neu-in);
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
  box-sizing: border-box;
}
.modal-placeholder { color: var(--text-3); }
.modal-submit {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: var(--r-lg);
  background: var(--brand-gradient);
  box-shadow: var(--neu-raised-sm), 0 12rpx 36rpx var(--brand-glow);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--dur-base) var(--spring), box-shadow var(--dur-base) var(--ease);
}
.modal-submit:active {
  box-shadow: var(--neu-in);
  transform: scale(0.94);
}
.modal-submit-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
}
