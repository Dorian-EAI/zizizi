.login-page{height:100vh;overflow:hidden;background:var(--bg)}
.login-hero{position:relative;padding:160rpx 64rpx 80rpx;background:radial-gradient(ellipse 600rpx 400rpx at 80% 20%,rgba(212,148,76,.18) 0%,transparent 60%),radial-gradient(ellipse 500rpx 360rpx at 15% 60%,rgba(13,148,136,.20) 0%,transparent 60%),linear-gradient(160deg,rgba(13,148,136,.10) 0%,rgba(212,148,76,.06) 50%,rgba(13,148,136,.08) 100%);border-radius:0 0 80rpx 80rpx;text-align:center;display:flex;flex-direction:column;align-items:center}
.logo-circle{width:192rpx;height:192rpx;border-radius:56rpx;margin:0 auto 48rpx;background:var(--brand-gradient);display:flex;align-items:center;justify-content:center;box-shadow:var(--neu-out-lg),0 16rpx 64rpx var(--brand-glow)}
.logo-icon{width:88rpx;height:88rpx}.app-name{font-size:56rpx;font-weight:700;letter-spacing:-.02em;margin-bottom:16rpx}.app-slogan{font-size:28rpx;color:var(--text-2);letter-spacing:.02em}
.login-content{padding:64rpx 48rpx}.welcome-title{display:block;font-size:40rpx;font-weight:700;margin-bottom:16rpx}.welcome-desc{display:block;white-space:pre-line;font-size:27rpx;color:var(--text-2);line-height:1.6;margin-bottom:64rpx}
.login-option{width:100%;height:auto;display:flex;align-items:center;padding:36rpx 40rpx;margin-bottom:28rpx;background:rgba(255,255,255,.52);border-radius:var(--r-lg);border:1rpx solid rgba(255,255,255,.60);box-shadow:var(--neu-out-md);line-height:1;transition:all var(--dur-base) var(--spring);text-align:left}
.login-option:active{box-shadow:var(--neu-in);transform:scale(.98)}.login-option[disabled]{opacity:.72}
.login-option-icon{width:96rpx;height:96rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;margin-right:32rpx;flex-shrink:0;color:#fff}.login-option-icon image{width:48rpx;height:48rpx}.login-option-icon.wechat{background:linear-gradient(135deg,#07C160,#06AE56)}.login-option-icon.mobile{background:linear-gradient(135deg,var(--brand),var(--brand-mid))}.wechat-mark{font-size:38rpx;font-weight:700;color:#fff}
.login-option-text{flex:1;display:flex;flex-direction:column}.login-option-title{font-size:30rpx;font-weight:600;margin-bottom:10rpx;color:var(--text-1)}.login-option-desc{font-size:24rpx;color:var(--text-2)}.login-option-arrow{width:36rpx;height:36rpx}
.agreement-section{display:flex;align-items:flex-start;gap:20rpx;padding:8rpx 48rpx 0}.agreement-checkbox{width:36rpx;height:36rpx;border-radius:12rpx;border:4rpx solid var(--neu-dark);flex-shrink:0;margin-top:2rpx;display:flex;align-items:center;justify-content:center}.agreement-checkbox.checked{background:var(--brand);border-color:var(--brand)}.agreement-checkbox image{width:24rpx;height:24rpx}.agreement-text{font-size:24rpx;color:var(--text-2);line-height:1.6}.agreement-link{color:var(--brand)}
.login-footer{position:absolute;bottom:max(48rpx,env(safe-area-inset-bottom));left:0;right:0;text-align:center;font-size:22rpx;color:var(--text-3)}
