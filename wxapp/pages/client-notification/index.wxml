<view class="phone-page design-detail-page" data-page-id="page-client-notification">
  <view class="status-bar"><text>9:41</text><text class="status-icons">● WiFi 100%</text></view>
  <view class="topbar"><view class="icon-button design-button" data-route="/pages/client-mine/index" bindtap="onNavigate"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%232C2824%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m15%2018-6-6%206-6M9%2012h10%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h1">消息通知</view><view class="top-action design-button" bindtap="onMarkAllRead">全部已读</view></view>
  <view class="page-body">
    <view class="section-title"><text class="tag-strong">消息中心</text><text class="badge {{unreadCount ? 'danger' : 'success'}}">{{unreadCount ? unreadCount + ' 条未读' : '已全部阅读'}}</text></view>
    <view class="segmented"><view class="segment {{selectedType === '' ? 'active' : ''}} design-button" data-type="" bindtap="onFilter">全部</view><view class="segment {{selectedType === 'system' ? 'active' : ''}} design-button" data-type="system" bindtap="onFilter">系统</view><view class="segment {{selectedType === 'order' ? 'active' : ''}} design-button" data-type="order" bindtap="onFilter">订单</view><view class="segment {{selectedType === 'activity' ? 'active' : ''}} design-button" data-type="activity" bindtap="onFilter">活动</view></view>
    <view class="notice info" wx:if="{{loading}}">正在同步消息…</view>
    <view class="notice error" wx:elif="{{loadError}}">{{loadError}}</view>
    <view class="section" wx:elif="{{visibleMessages.length}}"><view class="card list-card"><view class="list-row" wx:for="{{visibleMessages}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen"><text class="row-icon">{{item.iconText}}</text><view class="row-main"><view class="row-title">{{item.title || item.typeText}}</view><view class="row-copy">{{item.content}}</view></view><text class="badge danger" wx:if="{{item.unread}}">未读</text><text class="row-value" wx:else>{{item.timeText}}</text><text class="chevron">›</text></view></view></view>
    <view class="empty-state" wx:else><view class="empty-icon"><image class="design-svg-icon" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20aria-hidden%3D%22true%22%20focusable%3D%22false%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22m8%2012%202.5%202.5L16%209%22%2F%3E%3C%2Fsvg%3E" mode="aspectFill" /></view><view class="tag-h3">暂无消息</view><view class="tag-p">订单和系统通知会以服务端记录为准显示在这里。</view></view>
  </view>
  <view class="fixed-actions"><view class="btn primary design-button" bindtap="onMarkAllRead">全部标为已读</view></view>
</view>
