@import '../../../styles/glass-neu.wxss';

.page {
  min-height: 100vh;
  background: #F2EDE8;
  padding-bottom: 80rpx;
}

.hero {
  padding: calc(76rpx + env(safe-area-inset-top)) 48rpx 56rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 75% 40%, rgba(212, 148, 76, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 20% 80%, rgba(13, 148, 136, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.28) 0%, rgba(212, 148, 76, 0.20) 50%, rgba(20, 184, 166, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.50);
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
}

.back-icon {
  font-size: 40rpx;
  color: #2C2824;
  font-weight: 300;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C2824;
  letter-spacing: -0.01em;
}

.hero-spacer {
  width: 72rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #8B8178;
  margin-top: 24rpx;
  text-align: center;
  font-weight: 500;
  position: relative;
  z-index: 2;
}

.section {
  padding: 0 48rpx;
  margin-top: 40rpx;
  position: relative;
  z-index: 2;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
  padding-right: 4rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C2824;
  letter-spacing: -0.01em;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-link {
  font-size: 24rpx;
  color: #0D9488;
  font-weight: 600;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.quick-card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  padding: 36rpx 28rpx;
  box-shadow: 16rpx 16rpx 36rpx #DDD6CE, -16rpx -16rpx 36rpx #FFF8F2, 0 12rpx 56rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 20rpx;
}

.quick-icon-teal {
  background: linear-gradient(135deg, #0D9488 0%, #14B8A6 100%);
  color: #ffffff;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, 0 8rpx 28rpx rgba(13, 148, 136, 0.24);
}

.quick-icon-gold {
  background: linear-gradient(135deg, #D4944C 0%, #E8A85C 100%);
  color: #ffffff;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, 0 8rpx 28rpx rgba(212, 148, 76, 0.24);
}

.quick-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C2824;
  margin-bottom: 6rpx;
  letter-spacing: -0.01em;
}

.quick-desc {
  font-size: 24rpx;
  color: #8B8178;
  font-weight: 500;
}

.quick-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #0D9488;
  font-weight: 500;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0D9488;
  box-shadow: 0 0 8rpx rgba(13, 148, 136, 0.6);
}

.status-dot-warm {
  background: #D4944C;
  box-shadow: 0 0 8rpx rgba(212, 148, 76, 0.6);
}

.card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  box-shadow: 16rpx 16rpx 36rpx #DDD6CE, -16rpx -16rpx 36rpx #FFF8F2, 0 12rpx 56rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  position: relative;
}

.ticket-card {
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.ticket-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ticket-type {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(13, 148, 136, 0.10);
  color: #0D9488;
}

.ticket-type-repair {
  background: rgba(212, 148, 76, 0.10);
  color: #D4944C;
}

.ticket-type-complaint {
  background: rgba(220, 38, 38, 0.10);
  color: #DC2626;
}

.ticket-status {
  font-size: 22rpx;
  font-weight: 600;
}

.ticket-status-pending {
  color: #D4944C;
}

.ticket-status-processing {
  color: #0D9488;
}

.ticket-status-resolved {
  color: #8B8178;
}

.ticket-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2824;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.ticket-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ticket-time {
  font-size: 22rpx;
  color: #B5ADA5;
}

.ticket-reply {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #0D9488;
  font-weight: 600;
}

.ticket-reply-arrow {
  font-size: 28rpx;
  font-weight: 300;
}

.empty-tip {
  text-align: center;
  padding: 64rpx 0;
  font-size: 26rpx;
  color: #B5ADA5;
}

.faq-card {
  padding: 8rpx 32rpx;
}

.faq-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(44, 40, 36, 0.06);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.faq-q-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(13, 148, 136, 0.12);
  color: #0D9488;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.faq-q-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2824;
  line-height: 1.4;
}

.faq-arrow {
  font-size: 32rpx;
  color: #B5ADA5;
  transition: transform 0.2s ease;
}

.faq-arrow-open {
  transform: rotate(90deg);
}

.faq-answer {
  margin-top: 20rpx;
  padding-left: 64rpx;
  font-size: 26rpx;
  color: #8B8178;
  line-height: 1.6;
}

.cta-section {
  padding: 48rpx 48rpx 0;
  position: relative;
  z-index: 2;
}

.cta-card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  text-align: center;
  box-shadow: 16rpx 16rpx 36rpx #DDD6CE, -16rpx -16rpx 36rpx #FFF8F2, 0 12rpx 56rpx rgba(0, 0, 0, 0.06);
}

.cta-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2824;
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}

.cta-desc {
  font-size: 26rpx;
  color: #8B8178;
  margin-bottom: 32rpx;
}

.btn-neu-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.40);
  border-radius: 9999rpx;
  padding: 24rpx 64rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 10rpx 10rpx 28rpx #DDD6CE, -10rpx -10rpx 28rpx #FFF8F2, 0 8rpx 28rpx rgba(13, 148, 136, 0.24), inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.30);
}

.btn-neu-primary:active {
  box-shadow: inset 6rpx 6rpx 12rpx #DDD6CE, inset -6rpx -6rpx 12rpx #FFF8F2;
  transform: scale(0.97);
}
