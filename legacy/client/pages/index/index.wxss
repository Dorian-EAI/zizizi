/* ============================================================
 * 首页 · 玻璃新拟态样式
 * 匹配 zjrnew/pages/client-home-glass-neu.html
 * 1px = 2rpx
 * ============================================================ */

.page {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ===== HERO ===== */
.hero {
  padding: calc(28rpx + env(safe-area-inset-top)) 48rpx 48rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 440rpx 360rpx at 75% 45%, rgba(212, 148, 76, 0.10) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 20% 80%, rgba(13, 148, 136, 0.08) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.10) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.05) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

/* Glass Search Bar */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface-2);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 56rpx;
  padding: 24rpx 36rpx;
  color: var(--text-3);
  font-size: 28rpx;
  transition: transform 0.2s var(--spring);
}

.search-bar:active {
  transform: scale(0.97);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-3);
  font-family: var(--font-serif);
}

/* ===== Section Title ===== */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  padding: 20rpx 48rpx 14rpx;
  letter-spacing: -0.4rpx;
  font-family: var(--font-serif);
}

/* ===== Service Grid ===== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 202rpx);
  gap: 22rpx;
  justify-content: center;
  padding: 22rpx 48rpx;
}

.service-card {
  width: 202rpx;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: var(--surface-1);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 44rpx;
  box-shadow: var(--neu-out-md), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65);
  padding: 16rpx 12rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.service-card:active {
  transform: scale(0.95);
  box-shadow: var(--neu-in);
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-elevated);
  box-shadow: var(--icon-raise), inset 0 3rpx 4rpx rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow 0.2s var(--ease), transform 0.2s var(--spring);
}

.service-card:active .icon-circle {
  box-shadow: var(--neu-in);
  transform: scale(0.94);
}

.icon-svg {
  width: 44rpx;
  height: 44rpx;
}

.service-name {
  font-size: 24rpx;
  color: var(--text-1);
  font-weight: 600;
  white-space: nowrap;
  font-family: var(--font-serif);
}

/* ===== AI Assistant Card ===== */
.ai-card {
  position: relative;
  margin: 28rpx 48rpx 0;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  border-radius: 48rpx;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 75% 40%, rgba(212, 148, 76, 0.16) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 20% 80%, rgba(13, 148, 136, 0.12) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.12) 0%, rgba(212, 148, 76, 0.14) 50%, rgba(20, 184, 166, 0.12) 100%);
  box-shadow: var(--neu-out-md), 0 16rpx 56rpx rgba(13, 148, 136, 0.12);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.ai-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(160deg,
    rgba(255, 255, 255, 0.35) 0%,
    rgba(255, 255, 255, 0.12) 30%,
    transparent 60%);
  pointer-events: none;
}

.ai-card:active {
  transform: scale(0.97);
  box-shadow: var(--neu-in);
}

.ai-icon {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);
  box-shadow: var(--neu-out-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.ai-svg {
  width: 48rpx;
  height: 48rpx;
}

.ai-text {
  flex: 1;
  min-width: 0;
}

.ai-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 6rpx;
  letter-spacing: -0.2rpx;
  font-family: var(--font-serif);
}

.ai-desc {
  font-size: 24rpx;
  color: var(--text-2);
}

/* ===== Category Chips ===== */
.chips-scroll {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 20rpx 48rpx 22rpx;
  white-space: nowrap;
  height: 88rpx;
  align-items: center;
}

.chips-scroll::-webkit-scrollbar {
  display: none;
}

.chip {
  flex-shrink: 0;
  padding: 10rpx 36rpx;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  background: var(--bg-elevated);
  color: var(--text-2);
  box-shadow: var(--neu-out-sm);
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
  font-family: var(--font-serif);
}

.chip:active {
  transform: scale(0.94);
  box-shadow: var(--neu-in);
}

.chip-active {
  background: var(--brand-subtle);
  color: var(--brand);
  box-shadow: var(--neu-in), 0 0 0 1rpx rgba(13, 148, 136, 0.15);
}

.chip-text {
  font-size: 26rpx;
  font-weight: 600;
  font-family: var(--font-serif);
}

/* ===== Masters ===== */
.master-list {
  padding: 0 48rpx;
}

.recommend-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 22rpx;
  background: var(--surface-1);
  backdrop-filter: blur(32rpx) saturate(140%);
  -webkit-backdrop-filter: blur(32rpx) saturate(140%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 40rpx;
  box-shadow: var(--neu-out-sm);
  padding: 28rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.recommend-card:last-child {
  margin-bottom: 0;
}

.recommend-card:active {
  transform: scale(0.97);
  box-shadow: var(--neu-in);
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.28) 40%, var(--brand-subtle) 78%, rgba(255, 255, 255, 0.18) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88), var(--icon-raise);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-svg {
  width: 52rpx;
  height: 52rpx;
}

.recommend-info {
  flex: 1;
  min-width: 0;
}

.recommend-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 4rpx;
  font-family: var(--font-serif);
}

.recommend-sub {
  font-size: 24rpx;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommend-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
  white-space: nowrap;
  font-family: var(--font-serif);
}

/* ===== Recommended Services Scroll ===== */
.rec-scroll {
  display: flex;
  white-space: nowrap;
  padding: 0 48rpx 32rpx;
  width: 100%;
}

.rec-card {
  flex-shrink: 0;
  width: 360rpx;
  background: var(--surface-1);
  backdrop-filter: blur(32rpx) saturate(140%);
  -webkit-backdrop-filter: blur(32rpx) saturate(140%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 40rpx;
  box-shadow: var(--neu-out-sm);
  overflow: hidden;
  padding: 20rpx;
  margin-right: 24rpx;
  transition: transform 0.2s var(--spring), box-shadow 0.2s var(--ease);
}

.rec-card:active {
  transform: scale(0.96);
  box-shadow: var(--neu-in);
}

.rec-img {
  width: 100%;
  height: 200rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: inset 4rpx 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.rec-scroll .rec-card:last-child {
  margin-right: 0;
}

.rec-img-label {
  font-size: 28rpx;
  font-weight: 700;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
  letter-spacing: 0.4rpx;
}

.rec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
  letter-spacing: -0.2rpx;
  font-family: var(--font-serif);
}

.rec-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
}

.rec-star {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: var(--orange);
  font-weight: 600;
}

.star-icon {
  font-size: 22rpx;
  color: var(--orange);
}

.rec-count {
  font-size: 22rpx;
  color: var(--text-2);
}

.rec-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.currency {
  font-size: 24rpx;
  color: var(--red);
  font-weight: 600;
}

.amount {
  font-size: 38rpx;
  color: var(--red);
  font-weight: 700;
  letter-spacing: -0.4rpx;
  font-family: var(--font-serif);
}

.rec-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

/* ===== Scroll Title Bar ===== */
.title-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 176rpx;
  padding-top: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
  background: rgba(242, 237, 232, 0);
  backdrop-filter: blur(0rpx);
  -webkit-backdrop-filter: blur(0rpx);
  opacity: 0;
  z-index: 100;
  pointer-events: none;
  transition: background 0.3s ease, backdrop-filter 0.3s ease, opacity 0.25s ease;
}

.title-bar.visible {
  background: rgba(242, 237, 232, 0.95);
  backdrop-filter: blur(48rpx) saturate(180%);
  -webkit-backdrop-filter: blur(48rpx) saturate(180%);
  opacity: 1;
  pointer-events: auto;
}

.title-bar__search {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 36rpx;
  box-shadow: var(--neu-out-sm);
  backdrop-filter: blur(40rpx) saturate(160%);
  -webkit-backdrop-filter: blur(40rpx) saturate(160%);
  color: var(--text-3);
  font-size: 26rpx;
}

.title-bar-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.title-bar-placeholder {
  font-size: 26rpx;
  color: var(--text-3);
  font-family: var(--font-serif);
}

/* ===== Tabbar placeholder ===== */
.tabbar-placeholder {
  height: 180rpx;
}