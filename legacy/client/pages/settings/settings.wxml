<view class="container">
  <view class="card">
    <view class="row" bindtap="editProfile">
      <view class="row-icon">👤</view>
      <view class="row-content">
        <text class="row-label">个人信息</text>
        <text class="row-value">{{userInfo.nickname || userInfo.phone || '点击完善'}}</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goAddress">
      <view class="row-icon">📍</view>
      <view class="row-content">
        <text class="row-label">地址管理</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="showAgreement" data-type="about" data-title="关于我们">
      <view class="row-icon">ℹ️</view>
      <view class="row-content">
        <text class="row-label">关于我们</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="showAgreement" data-type="user_agreement" data-title="用户协议">
      <view class="row-icon">📄</view>
      <view class="row-content">
        <text class="row-label">用户协议</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="showAgreement" data-type="privacy_policy" data-title="隐私政策">
      <view class="row-icon">🔒</view>
      <view class="row-content">
        <text class="row-label">隐私政策</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <view class="card faq-card">
    <view class="section-header">
      <text class="row-icon-inline">💡</text>
      <text class="row-label-inline">帮助中心</text>
    </view>
    <view class="faq-list" wx:if="{{faqList.length}}">
      <view class="faq-item {{expandedFaqIds[item.id] ? 'open' : ''}}" wx:for="{{faqList}}" wx:key="id" bindtap="toggleFaq" data-id="{{item.id}}">
        <view class="faq-q">
          <text class="faq-q-text">{{item.question || item.title}}</text>
          <text class="faq-arrow">{{expandedFaqIds[item.id] ? '∧' : '∨'}}</text>
        </view>
        <view class="faq-a" wx:if="{{expandedFaqIds[item.id]}}">
          <text>{{item.answer || item.content}}</text>
        </view>
      </view>
    </view>
    <view class="empty-faq" wx:else>
      <text>暂无常见问题</text>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="clearCache">
      <view class="row-icon">🗑️</view>
      <view class="row-content">
        <text class="row-label">清除缓存</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <view class="logout-card">
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>
</view>
