.container { background: #f5f6fa; min-height: 100vh; padding: 20rpx; padding-bottom: 60rpx; }

.card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; }

.row { display: flex; align-items: center; padding: 30rpx 28rpx; border-bottom: 1rpx solid #f5f5f5; }
.row:last-child { border-bottom: none; }
.row-icon { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; font-size: 32rpx; margin-right: 20rpx; }
.row-content { flex: 1; display: flex; align-items: center; justify-content: space-between; }
.row-label { font-size: 30rpx; color: #333; }
.row-value { font-size: 26rpx; color: #999; max-width: 300rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { font-size: 32rpx; color: #ccc; margin-left: 12rpx; }

.section-header { display: flex; align-items: center; padding: 30rpx 28rpx 20rpx; }
.row-icon-inline { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; font-size: 32rpx; margin-right: 20rpx; }
.row-label-inline { font-size: 30rpx; color: #333; font-weight: 600; }

.faq-card { padding-bottom: 10rpx; }
.faq-list { padding: 0 28rpx 20rpx; }
.faq-item { border: 1rpx solid #f0f0f0; border-radius: 12rpx; margin-bottom: 16rpx; overflow: hidden; }
.faq-item.open { border-color: #d6e4ff; }
.faq-q { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 20rpx; background: #fafafa; }
.faq-item.open .faq-q { background: #f5f9ff; }
.faq-q-text { flex: 1; font-size: 28rpx; color: #333; font-weight: 500; padding-right: 16rpx; }
.faq-arrow { font-size: 24rpx; color: #999; }
.faq-a { padding: 20rpx; font-size: 26rpx; color: #666; line-height: 1.7; background: #fff; border-top: 1rpx solid #f0f0f0; }

.empty-faq { padding: 40rpx 28rpx; text-align: center; color: #bbb; font-size: 26rpx; }

.logout-card { margin-top: 40rpx; padding: 0 20rpx; }
.logout-btn { text-align: center; padding: 30rpx 0; background: #fff; border-radius: 16rpx; font-size: 30rpx; color: #e64340; font-weight: 600; }
