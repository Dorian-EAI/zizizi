/* ===== Worker Wallet - Glass Neumorphic ===== */
page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --accent: #D4944C;
  --bg: #F2EDE8;
  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;
  --text-1: #2C2824;
  --text-2: #8B8178;
  --text-3: #B5ADA5;
  --green: #5B8C5A;
  --red: #C4533A;
  --sep: rgba(44, 40, 36, 0.06);
  --r: 24rpx;
  --r-sm: 16rpx;
  --r-pill: 9999rpx;
  background: var(--bg);
  min-height: 100vh;
}

.page {
  padding-bottom: 200rpx;
}

/* ===== HERO ===== */
.hero {
  padding: 76rpx 48rpx 80rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 25% 40%, rgba(143, 169, 152, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 80% 80%, rgba(45, 108, 223, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.28) 0%, rgba(143, 169, 152, 0.20) 50%, rgba(45, 108, 223, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  top: -60rpx;
  right: -30rpx;
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 52rpx;
  position: relative;
  z-index: 2;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 6rpx;
  font-weight: 400;
}

/* Balance block */
.balance-block {
  position: relative;
  z-index: 2;
}

.balance-label {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  margin-bottom: 16rpx;
  letter-spacing: 0.02em;
}

.balance-amount {
  font-size: 76rpx;
  font-weight: 800;
  color: var(--brand);
  letter-spacing: -1.2rpx;
  line-height: 1.1;
}

/* Balance chips */
.balance-chips {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-top: 32rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.50);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow:
    10rpx 10rpx 24rpx var(--neu-dark),
    -10rpx -10rpx 24rpx var(--neu-light),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
  font-size: 25rpx;
  color: var(--text-1);
  font-weight: 600;
}

.chip-label {
  color: var(--text-2);
  font-weight: 500;
}

.chip-value {
  color: var(--text-1);
  font-weight: 700;
}

/* ===== QUICK ACTIONS CARD (overlaps hero -36rpx) ===== */
.quick-card {
  margin: -36rpx 48rpx 0;
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r);
  box-shadow:
    16rpx 16rpx 36rpx var(--neu-dark),
    -16rpx -16rpx 36rpx var(--neu-light),
    0 20rpx 72rpx rgba(0, 0, 0, 0.08),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  padding: 36rpx 16rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  position: relative;
  z-index: 10;
}

.qa-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  background: rgba(255, 255, 255, 0.40);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: var(--r-sm);
  box-shadow:
    10rpx 10rpx 24rpx var(--neu-dark),
    -10rpx -10rpx 24rpx var(--neu-light);
}

.qa-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--bg);
  box-shadow:
    10rpx 10rpx 24rpx var(--neu-dark),
    -10rpx -10rpx 24rpx var(--neu-light),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.qa-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

/* ===== Section + Card ===== */
.section {
  padding: 0 48rpx;
  margin-top: 40rpx;
  position: relative;
  z-index: 5;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r);
  box-shadow:
    16rpx 16rpx 36rpx var(--neu-dark),
    -16rpx -16rpx 36rpx var(--neu-light),
    0 12rpx 48rpx rgba(0, 0, 0, 0.06),
    0 0 0 2rpx rgba(44, 40, 36, 0.05);
  overflow: hidden;
  position: relative;
}

.card-gloss {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, transparent 100%);
  pointer-events: none;
}

/* ===== Income Stats Card ===== */
.income-card {
  padding: 36rpx 36rpx 32rpx;
}

.income-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 32rpx;
  letter-spacing: -0.01em;
  position: relative;
  z-index: 1;
}

.chart-wrap {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
  height: 320rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  padding-right: 8rpx;
  padding-top: 4rpx;
  padding-bottom: 36rpx;
  flex-shrink: 0;
}

.y-label {
  font-size: 20rpx;
  color: var(--text-3);
  font-weight: 500;
  line-height: 1;
}

.bars-area {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  position: relative;
  padding-bottom: 36rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
  position: relative;
}

.bar-track {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 70%;
  max-width: 36rpx;
  border-radius: 12rpx 12rpx 6rpx 6rpx;
  background: var(--brand-subtle);
  opacity: 0.85;
  min-height: 16rpx;
}

.bar.today {
  background: var(--brand);
  opacity: 1;
  box-shadow: 0 0 24rpx var(--brand-glow);
  max-width: 40rpx;
  width: 80%;
}

.bar-label {
  position: absolute;
  bottom: 0;
  font-size: 21rpx;
  color: var(--text-2);
  font-weight: 500;
  line-height: 1;
}

.chart-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--sep);
  position: relative;
  z-index: 1;
}

.cs-label {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

.cs-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
  letter-spacing: -0.01em;
}

/* ===== Transaction rows ===== */
.tx-card {
  padding: 4rpx 0;
}

.tx-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 36rpx;
  position: relative;
  z-index: 1;
}

.tx-row + .tx-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 120rpx;
  right: 36rpx;
  height: 1rpx;
  background: var(--sep);
}

.tx-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg);
  box-shadow:
    8rpx 8rpx 16rpx var(--neu-dark),
    -8rpx -8rpx 16rpx var(--neu-light),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}

.tx-icon.income {
  color: var(--green);
}

.tx-icon.outcome {
  color: var(--red);
}

.tx-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tx-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tx-time {
  font-size: 24rpx;
  color: var(--text-2);
}

.tx-amount {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  flex-shrink: 0;
}

.tx-amount.income {
  color: var(--green);
}

.tx-amount.outcome {
  color: var(--red);
}

/* ===== Empty / Loading States ===== */
.empty-state {
  padding: 80rpx 36rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-2);
}

.loading-state {
  padding: 40rpx 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
}

.load-end {
  padding: 30rpx 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== Icon SVG Placeholders ===== */
.icon-svg {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qa-icon .icon-svg {
  width: 44rpx;
  height: 44rpx;
}

.tx-icon .icon-svg {
  width: 40rpx;
  height: 40rpx;
}

.tab-icon .icon-svg {
  width: 40rpx;
  height: 40rpx;
}

.svg-arrow-up {
  width: 24rpx;
  height: 24rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(-45deg);
  margin-bottom: 8rpx;
}

.svg-transfer {
  width: 28rpx;
  height: 20rpx;
  border-top: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  position: relative;
}

.svg-list {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.svg-list::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.svg-list::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.svg-bolt {
  width: 24rpx;
  height: 32rpx;
  background: currentColor;
  clip-path: polygon(60% 0%, 100% 50%, 60% 50%, 100% 100%, 0% 60%, 40% 50%, 0% 0%);
}

.svg-arrow-down {
  width: 20rpx;
  height: 20rpx;
  border-bottom: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
  margin-top: 8rpx;
}

.svg-home {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.svg-home::before {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 20rpx solid currentColor;
  top: 0;
  left: 0;
}

.svg-home::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  bottom: 0;
  left: 4rpx;
}

.svg-orders {
  width: 28rpx;
  height: 32rpx;
  position: relative;
  border: 3rpx solid currentColor;
  border-radius: 2rpx;
}

.svg-orders::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 4rpx;
  right: 4rpx;
  height: 3rpx;
  background: currentColor;
}

.svg-orders::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 4rpx;
  right: 4rpx;
  height: 3rpx;
  background: currentColor;
}

.svg-wallet {
  width: 32rpx;
  height: 26rpx;
  position: relative;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.svg-wallet::before {
  content: '';
  position: absolute;
  right: -2rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.svg-user {
  width: 28rpx;
  height: 32rpx;
  position: relative;
}

.svg-user::before {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  top: 0;
  left: 6rpx;
}

.svg-user::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 12rpx 12rpx 0 0;
  bottom: 0;
  left: 2rpx;
}

/* ===== FLOATING TAB BAR ===== */
.tab-bar {
  position: fixed;
  bottom: max(28rpx, env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 64rpx);
  max-width: 720rpx;
  height: 112rpx;
  z-index: 100;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(96rpx) saturate(210%);
  -webkit-backdrop-filter: blur(96rpx) saturate(210%);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 48rpx;
  box-shadow:
    inset 0 3rpx 6rpx rgba(255, 255, 255, 0.60),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.20),
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 4rpx 20rpx rgba(0, 0, 0, 0.06),
    0 24rpx 72rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 12rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  width: 124rpx;
  height: 76rpx;
  border-radius: 28rpx;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 500;
  position: relative;
  transition: all 0.2s;
}

.tab-item.active {
  color: var(--brand);
  font-weight: 600;
}

.tab-item.active::before {
  content: "";
  position: absolute;
  width: 108rpx;
  height: 84rpx;
  border-radius: 32rpx;
  background: rgba(45, 108, 223, 0.16);
  border: 1rpx solid rgba(45, 108, 223, 0.30);
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.55),
    0 4rpx 20rpx rgba(45, 108, 223, 0.20);
  z-index: -1;
}

.tab-label {
  font-size: 22rpx;
  font-weight: 500;
}

.tab-item.active .tab-label {
  font-weight: 600;
}
