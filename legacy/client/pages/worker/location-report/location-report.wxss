page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --accent: #D4944C;
  --accent-dark: #A0723C;
  --bg: #F2EDE8;
  --bg-elevated: #F7F3EF;
  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;
  --text-1: #2C2824;
  --text-2: #8B8178;
  --text-3: #B5ADA5;
  --text-inverse: #FFFFFF;
  --sep: rgba(44, 40, 36, 0.06);
  --green: #5B8C5A;
  --red: #C4533A;
  --orange: #D4944C;
  --blue: #5A8FAD;
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
  --neu-out-sm: 12rpx 12rpx 28rpx var(--neu-dark), -12rpx -12rpx 28rpx var(--neu-light), 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  --neu-out-md: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light), 0 12rpx 48rpx rgba(0, 0, 0, 0.05);
  --neu-in: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
  background: var(--bg);
  min-height: 100vh;
}

.page {
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 164rpx;
}

/* ===== Nav Bar ===== */
.nav-bar {
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(143, 169, 152, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(143, 169, 152, 0.08) 50%, rgba(45, 108, 223, 0.06) 100%);
  padding: calc(max(36rpx, env(safe-area-inset-top)) + 36rpx) 40rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}

.nav-icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-icon-hidden {
  width: 44rpx;
  height: 44rpx;
  opacity: 0;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-placeholder-btn {
  visibility: hidden;
}

/* ===== Section ===== */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  position: relative;
  z-index: 2;
}

.section:first-of-type {
  margin-top: 36rpx;
}

/* ===== Location Report Bar ===== */
.location-report-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: var(--bg-elevated);
  border-radius: 9999rpx;
  box-shadow: var(--neu-in), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.report-dot {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 0 4rpx var(--brand-subtle);
  flex-shrink: 0;
}

.report-pulse {
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  border: 4rpx solid var(--green);
  animation: reportPulse 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
  pointer-events: none;
}

@keyframes reportPulse {
  0% { transform: scale(1); opacity: 0.55; }
  70% { transform: scale(1.8); opacity: 0; }
  100% { transform: scale(1.8); opacity: 0; }
}

.report-text {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--green);
}

/* ===== Location Info Card ===== */
.location-info-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  box-shadow: var(--neu-out-md), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(45, 108, 223, 0.04), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
  padding: 36rpx;
  position: relative;
  overflow: hidden;
}

.location-info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.location-info-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

.location-coords {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
  background: var(--brand-subtle);
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  border: 1rpx solid rgba(45, 108, 223, 0.15);
}

.mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

.location-address-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.location-ic {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.location-address {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.45;
}

.location-update {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  color: var(--text-2);
  font-weight: 500;
}

.update-ic {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.location-map-placeholder {
  margin-top: 28rpx;
  height: 240rpx;
  background: linear-gradient(135deg, rgba(45, 108, 223, 0.08) 0%, rgba(143, 169, 152, 0.08) 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(45, 108, 223, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.map-bg {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
}

.map-pin {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 0 8rpx var(--brand-subtle), 0 8rpx 24rpx var(--brand-glow);
  animation: pinBounce 2s ease-in-out infinite;
}

@keyframes pinBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

/* ===== Glass Neu Card ===== */
.glass-neu-card {
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  box-shadow: var(--neu-out-md), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(45, 108, 223, 0.04), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
  position: relative;
  overflow: hidden;
}

.glass-neu-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, transparent 100%);
  pointer-events: none;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
  margin-bottom: 28rpx;
  display: block;
}

.order-info-card {
  padding: 36rpx;
}

.order-info-list {
  display: flex;
  flex-direction: column;
}

.order-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.order-info-row:last-child {
  border-bottom: none;
}

.order-info-label {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 27rpx;
  color: var(--text-2);
  font-weight: 500;
  flex-shrink: 0;
}

.label-ic {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.order-info-value {
  font-size: 27rpx;
  color: var(--text-1);
  font-weight: 600;
  text-align: right;
  max-width: 60%;
  line-height: 1.4;
}

/* ===== Location Actions ===== */
.location-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-row {
  display: flex;
  gap: 24rpx;
}

.action-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  flex: 1;
  background: var(--bg-elevated);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}

.action-ic {
  width: 36rpx;
  height: 36rpx;
}

.action-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 104rpx;
  width: 100%;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border: none;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  box-shadow: var(--neu-out-sm), 0 8rpx 28rpx var(--brand-glow);
}

.location-note {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
  line-height: 1.5;
  margin-top: 8rpx;
}
