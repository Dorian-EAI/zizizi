page {
  --brand: #2D6CDF;
  --brand-dark: #2456B8;
  --brand-mid: #5A8EE8;
  --brand-light: #DCE8FB;
  --brand-glow: rgba(45, 108, 223, 0.28);
  --brand-subtle: rgba(45, 108, 223, 0.08);
  --accent: #D4944C;
  --accent-dark: #A0723C;
  --accent-light: #F5E6D0;
  --sage: #8FA998;
  --bg: #F2EDE8;
  --bg-elevated: #F7F3EF;
  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;
  --text-1: #2C2824;
  --text-2: #8B8178;
  --text-3: #B5ADA5;
  --text-inverse: #FFFFFF;
  --sep: rgba(44, 40, 36, 0.06);
  --green: #5B8C5A;
  --red: #C4533A;
  --orange: #D4944C;
  --blue: #5A8FAD;
  --brand-gradient: linear-gradient(135deg, #2D6CDF 0%, #5A8EE8 50%, #D4944C 100%);
  --neu-out-sm: 10rpx 10rpx 24rpx var(--neu-dark), -10rpx -10rpx 24rpx var(--neu-light);
  --neu-out-md: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light);
  --neu-in: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
  --neu-in-deep: inset 10rpx 10rpx 20rpx var(--neu-dark), inset -10rpx -10rpx 20rpx var(--neu-light);
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.page { background: var(--bg); min-height: 100vh; }

.loading-wrap { text-align: center; padding: 160rpx; color: var(--text-2); font-size: 28rpx; }

/* ===== Nav Bar ===== */
.nav-bar {
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(143, 169, 152, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(45, 108, 223, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(45, 108, 223, 0.14) 0%, rgba(143, 169, 152, 0.08) 50%, rgba(45, 108, 223, 0.06) 100%);
  padding: calc(max(36rpx, env(safe-area-inset-top)) + 0rpx) 40rpx 36rpx;
  display: flex; align-items: center; justify-content: space-between;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}
.nav-icon-btn {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex; align-items: center; justify-content: center;
  color: var(--text-1); flex-shrink: 0;
}
.nav-icon { width: 44rpx; height: 44rpx; }
.more-dots { font-size: 44rpx; color: var(--text-1); line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 700; color: var(--text-1); letter-spacing: -0.02em; }

/* ===== Sections ===== */
.section { padding: 0 40rpx; margin-top: 32rpx; }
.section:first-of-type { margin-top: 36rpx; }

/* ===== Glass Neu Card ===== */
.glass-neu-card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 32rpx;
  box-shadow: var(--neu-out-md), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(45, 108, 223, 0.04), 0 0 0 2rpx rgba(44, 40, 36, 0.05);
  position: relative;
  overflow: hidden;
}

/* ===== Card Title ===== */
.card-title { font-size: 32rpx; font-weight: 700; color: var(--text-1); letter-spacing: -0.01em; margin-bottom: 28rpx; }

/* ===== Status Card ===== */
.status-card { padding: 0; }
.status-top-bar { height: 10rpx; width: 100%; background: var(--brand-gradient); }
.status-card-body { padding: 36rpx 36rpx 40rpx; }
.status-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.status-chip {
  display: inline-flex; align-items: center;
  background: var(--accent-light); color: var(--accent-dark);
  font-size: 24rpx; font-weight: 700; letter-spacing: 0.02em;
  padding: 8rpx 24rpx; border-radius: 9999rpx;
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.6), 0 4rpx 12rpx var(--accent-glow);
}
.status-eta { font-size: 24rpx; color: var(--text-2); font-weight: 500; }
.status-desc { font-size: 42rpx; font-weight: 700; color: var(--text-1); letter-spacing: -0.02em; line-height: 1.3; margin-bottom: 40rpx; }

/* Timeline */
.timeline { position: relative; padding-top: 8rpx; }
.timeline-line {
  position: absolute; top: 32rpx; left: 60rpx; right: 60rpx; height: 6rpx;
  background: var(--neu-dark); border-radius: 9999rpx; opacity: 0.5;
}
.timeline-line-fill {
  position: absolute; top: 0; left: 0; height: 100%;
  background: linear-gradient(90deg, var(--brand) 0%, var(--brand-mid) 60%, var(--accent) 100%);
  border-radius: 9999rpx;
}
.timeline-nodes { display: flex; justify-content: space-between; position: relative; }
.tl-node { display: flex; flex-direction: column; align-items: center; gap: 12rpx; flex: 1; min-width: 0; }
.tl-dot {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 2;
}
.tl-check { width: 32rpx; height: 32rpx; }
.tl-dot-done {
  background: var(--brand); color: var(--text-inverse);
  box-shadow: 0 6rpx 20rpx var(--brand-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
}
.tl-dot-active {
  background: var(--accent); color: var(--text-inverse);
  box-shadow: 0 6rpx 24rpx var(--accent-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
}
.tl-dot-inner-wrap { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.tl-dot-inner { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--text-inverse); box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.35); }
.tl-dot-pulse {
  position: absolute; inset: -6rpx; border-radius: 50%;
  border: 4rpx solid var(--accent);
  animation: tlPulse 1.8s ease infinite;
}
@keyframes tlPulse {
  0% { transform: scale(1); opacity: 0.6; }
  70% { transform: scale(1.5); opacity: 0; }
  100% { transform: scale(1.5); opacity: 0; }
}
.tl-dot-pending {
  background: var(--bg-elevated);
  box-shadow: var(--neu-in), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
  border: 3rpx solid var(--neu-dark);
}
.tl-label { font-size: 24rpx; font-weight: 600; line-height: 1.2; text-align: center; }
.tl-label-done { color: var(--brand); }
.tl-label-active { color: var(--accent-dark); }
.tl-label-pending { color: var(--text-3); }
.tl-time { font-size: 22rpx; color: var(--text-2); font-weight: 500; }

/* ===== Worker / Customer Card ===== */
.worker-card { display: flex; align-items: center; gap: 28rpx; padding: 32rpx 36rpx; }
.avatar-col { display: flex; flex-direction: column; align-items: center; gap: 10rpx; flex-shrink: 0; }
.worker-avatar {
  width: 104rpx; height: 104rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--bg-elevated);
  box-shadow: var(--neu-in-deep);
  display: flex; align-items: center; justify-content: center;
  color: var(--brand);
  overflow: hidden;
}
.worker-avatar.avatar-glass {
  position: relative;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 255, 255, 0.28) 40%, var(--brand-subtle) 78%, rgba(255, 255, 255, 0.18) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 4rpx 6rpx rgba(255, 255, 255, 0.88), inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.04), var(--neu-out-sm);
}
.avatar-img { width: 100%; height: 100%; }
.avatar-icon { width: 56rpx; height: 56rpx; }
.verify-badge {
  display: inline-flex; align-items: center; gap: 6rpx;
  background: var(--brand-subtle); color: var(--brand);
  font-size: 21rpx; font-weight: 600;
  padding: 4rpx 16rpx; border-radius: 9999rpx;
  border: 1rpx solid rgba(45, 108, 223, 0.18);
}
.verify-icon { width: 22rpx; height: 22rpx; }
.worker-info { flex: 1; min-width: 0; }
.worker-name-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 10rpx; }
.worker-name { font-size: 34rpx; font-weight: 700; color: var(--text-1); letter-spacing: -0.01em; }
.worker-meta { display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; color: var(--text-2); font-weight: 500; }
.worker-star { color: var(--orange); font-weight: 600; }
.meta-dot { color: var(--text-3); }
.worker-actions { display: flex; gap: 20rpx; flex-shrink: 0; }
.action-circle {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--bg-elevated);
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
  display: flex; align-items: center; justify-content: center;
  color: var(--brand);
}
.action-circle:last-child { color: var(--accent-dark); }
.action-icon { width: 40rpx; height: 40rpx; }

/* ===== Info Card ===== */
.info-card { padding: 36rpx; }
.info-list { display: flex; flex-direction: column; }
.info-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sep);
}
.info-row:last-of-type { border-bottom: none; }
.info-label {
  display: inline-flex; align-items: center; gap: 12rpx;
  font-size: 27rpx; color: var(--text-2); font-weight: 500; flex-shrink: 0;
}
.info-ic { width: 30rpx; height: 30rpx; }
.info-value { font-size: 27rpx; color: var(--text-1); font-weight: 600; text-align: right; max-width: 60%; }
.info-desc-block {
  margin-top: 24rpx; padding: 24rpx 28rpx;
  background: var(--fill); border-radius: 16rpx;
  border: 1rpx solid var(--sep);
}
.info-desc-label { font-size: 23rpx; color: var(--text-2); font-weight: 600; margin-bottom: 10rpx; }
.info-desc-text { font-size: 26rpx; color: var(--text-1); line-height: 1.5; font-weight: 500; }
.mono { font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }

/* ===== Fee Card ===== */
.fee-card { padding: 36rpx; }
.fee-list { display: flex; flex-direction: column; }
.fee-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0;
}
.fee-label { font-size: 27rpx; color: var(--text-2); font-weight: 500; }
.fee-value { font-size: 28rpx; color: var(--text-1); font-weight: 600; }
.fee-value-coupon { color: var(--red); }
.fee-divider { height: 1rpx; background: var(--sep); margin: 12rpx 0; }
.fee-total-row {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-top: 20rpx; padding-top: 24rpx;
  border-top: 3rpx solid var(--sep);
}
.fee-total-label { font-size: 28rpx; color: var(--text-1); font-weight: 700; }
.fee-total { font-size: 48rpx; font-weight: 800; color: var(--brand); letter-spacing: -0.02em; }

/* ===== Check-in Card ===== */
.checkin-card { padding: 36rpx; }
.checkin-list { display: flex; flex-direction: column; }
.checkin-step {
  display: flex; gap: 28rpx; position: relative;
  padding-bottom: 36rpx;
}
.checkin-step:last-child { padding-bottom: 0; }
.checkin-step:not(:last-child)::after {
  content: ''; position: absolute;
  left: 30rpx; top: 68rpx; bottom: 4rpx; width: 4rpx;
  background: var(--brand-light);
  border-radius: 9999rpx;
}
.checkin-step.done:not(:last-child)::after { background: var(--brand); opacity: 0.45; }
.checkin-node {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 2;
}
.checkin-step.done .checkin-node {
  background: var(--brand); color: var(--text-inverse);
  box-shadow: 0 6rpx 20rpx var(--brand-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
}
.checkin-step.current .checkin-node {
  background: var(--brand); color: var(--text-inverse);
  box-shadow: 0 6rpx 28rpx var(--brand-glow), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.3);
}
.checkin-check { width: 32rpx; height: 32rpx; }
.checkin-step-icon { width: 32rpx; height: 32rpx; }
.checkin-step-emoji { font-size: 32rpx; }
.checkin-pulse {
  position: absolute; inset: -6rpx; border-radius: 50%;
  border: 4rpx solid var(--brand);
  animation: checkinPulse 1.8s ease infinite;
  pointer-events: none;
}
@keyframes checkinPulse {
  0% { transform: scale(1); opacity: 0.55; }
  70% { transform: scale(1.45); opacity: 0; }
  100% { transform: scale(1.45); opacity: 0; }
}
.checkin-body { flex: 1; min-width: 0; padding-top: 6rpx; }
.checkin-title-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 8rpx; }
.checkin-title { font-size: 28rpx; font-weight: 700; color: var(--text-1); letter-spacing: -0.01em; }
.checkin-status {
  font-size: 21rpx; font-weight: 700; letter-spacing: 0.02em;
  padding: 4rpx 16rpx; border-radius: 9999rpx; white-space: nowrap;
}
.checkin-status-done { color: var(--green); background: rgba(91, 140, 90, 0.14); }
.checkin-status-current { color: var(--text-inverse); background: var(--brand); box-shadow: 0 4rpx 12rpx var(--brand-glow); }
.checkin-meta { font-size: 24rpx; color: var(--text-2); font-weight: 500; line-height: 1.45; }
.checkin-action { margin-top: 20rpx; }

/* ===== Extra Fee Card ===== */
.extra-fee-card { padding: 36rpx; }
.extra-fee-tip {
  display: flex; align-items: flex-start; gap: 16rpx;
  background: var(--accent-light);
  border-radius: 16rpx;
  padding: 20rpx 24rpx; margin-bottom: 28rpx;
  border: 1rpx solid rgba(212, 148, 76, 0.25);
}
.tip-icon { width: 30rpx; height: 30rpx; flex-shrink: 0; margin-top: 2rpx; }
.extra-fee-tip-text { font-size: 24rpx; color: var(--accent-dark); font-weight: 600; line-height: 1.45; }
.extra-fee-record {
  display: flex; align-items: center; justify-content: space-between; gap: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--fill);
  border-radius: 16rpx;
  border: 1rpx solid var(--sep);
  margin-bottom: 28rpx;
}
.extra-fee-record-info { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.extra-fee-record-title { font-size: 27rpx; color: var(--text-1); font-weight: 600; display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.extra-fee-record-time { font-size: 23rpx; color: var(--text-2); font-weight: 500; }
.extra-fee-badge {
  display: inline-flex; align-items: center; gap: 6rpx;
  background: rgba(91, 140, 90, 0.14); color: var(--green);
  font-size: 22rpx; font-weight: 600;
  padding: 4rpx 16rpx; border-radius: 9999rpx;
}
.badge-icon { width: 22rpx; height: 22rpx; }
.extra-fee-amount { font-size: 30rpx; color: var(--text-1); font-weight: 700; letter-spacing: -0.01em; }
.extra-fee-action { display: flex; justify-content: center; }

/* ===== Buttons ===== */
.btn-neu-primary {
  display: inline-flex; align-items: center; justify-content: center; gap: 12rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border: none;
  border-radius: 9999rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx; font-weight: 600;
  box-shadow: var(--neu-out-sm), 0 8rpx 28rpx var(--brand-glow);
}
.btn-neu-secondary {
  display: inline-flex; align-items: center; justify-content: center; gap: 12rpx;
  background: rgba(255, 255, 255, 0.50);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 9999rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx; font-weight: 600;
  box-shadow: var(--neu-out-sm);
}
.btn-icon { width: 28rpx; height: 28rpx; }

/* ===== Bottom Action Bar ===== */
.action-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; gap: 24rpx;
  padding: 28rpx 40rpx;
  background: rgba(242, 237, 232, 0.88);
  border-top: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.05);
  z-index: 60;
}
.safe-bottom-space { height: env(safe-area-inset-bottom); }
.action-btn-secondary {
  display: inline-flex; align-items: center; justify-content: center; gap: 12rpx;
  height: 96rpx; flex: 0 0 38%;
  background: var(--bg-elevated); color: var(--text-1);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: 9999rpx;
  font-size: 28rpx; font-weight: 600;
  box-shadow: var(--neu-out-sm), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45);
}
.action-btn-secondary .action-btn-icon { width: 32rpx; height: 32rpx; color: var(--text-2); }
.action-btn-primary {
  display: inline-flex; align-items: center; justify-content: center; gap: 12rpx;
  height: 96rpx; flex: 1;
  background: var(--brand-gradient); color: var(--text-inverse);
  border: none;
  border-radius: 9999rpx;
  font-size: 30rpx; font-weight: 700; letter-spacing: 0.02em;
  box-shadow: var(--neu-out-sm), 0 8rpx 28rpx var(--brand-glow);
}
.action-btn-primary .action-btn-icon { width: 36rpx; height: 36rpx; }
