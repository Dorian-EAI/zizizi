.container { background: #f5f6fa; min-height: 100vh; padding-bottom: 60rpx; }
.bottom-space { height: 40rpx; }

.status-bar { padding: 30rpx; color: #fff; }
.status-bar.status-pending { background: #ff9900; }
.status-bar.status-accepted { background: #1989fa; }
.status-bar.status-completed { background: #07c160; }
.status-bar.status-paid { background: #07c160; }
.status-bar.status-reviewed { background: #07c160; }
.status-bar.status-cancelled { background: #999; }
.status-bar.status-departing { background: #004080; }
.status-bar.status-arrived { background: #10B981; }
.status-bar.status-serving { background: #6C5CE7; }

.tracking-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-left: 8rpx solid #004080;
}
.tracking-entry .tracking-icon { font-size: 48rpx; margin-right: 20rpx; }
.tracking-entry .tracking-info { flex: 1; display: flex; flex-direction: column; }
.tracking-entry .tracking-title { font-size: 30rpx; color: #004080; font-weight: 600; }
.tracking-entry .tracking-desc { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.tracking-entry .tracking-arrow { font-size: 40rpx; color: #ccc; }
.status-text { font-size: 36rpx; font-weight: 600; display: block; }
.status-desc { font-size: 26rpx; opacity: 0.9; }

.card { margin: 20rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; }
.service-card { }
.svc-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.svc-name { font-size: 32rpx; font-weight: 600; color: #333; }
.svc-price { font-size: 32rpx; font-weight: 600; color: #e64340; }
.svc-info { display: flex; flex-direction: column; gap: 8rpx; }
.info-row { font-size: 26rpx; color: #666; }
.order-images { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.order-images image { width: 160rpx; height: 160rpx; border-radius: 12rpx; }

.worker-card { display: flex; justify-content: space-between; align-items: center; }
.wk-left { display: flex; align-items: center; gap: 16rpx; }
.wk-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; }
.wk-info { }
.wk-name { font-size: 30rpx; font-weight: 600; color: #333; display: block; }
.wk-rating { font-size: 24rpx; color: #ff9900; }
.wk-arrow { color: #ccc; }

.section-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }

.bidding-card { }
.bidding-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.bidding-item:last-child { border-bottom: none; }
.bidding-left { display: flex; flex-direction: column; gap: 8rpx; }
.bidding-worker { font-size: 28rpx; color: #333; }
.bidding-time { font-size: 24rpx; color: #999; }
.bidding-right { display: flex; align-items: center; gap: 20rpx; }
.bidding-price { font-size: 32rpx; font-weight: 600; color: #e64340; }
.select-btn { background: #07c160; color: #fff; font-size: 26rpx; padding: 10rpx 28rpx; border-radius: 28rpx; }

.price-card { }
.price-line { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: 28rpx; color: #666; }
.price-line.total { border-top: 1rpx solid #f0f0f0; padding-top: 16rpx; margin-top: 16rpx; margin-bottom: 0; }
.discount { color: #07c160; }
.total-price { font-size: 36rpx; font-weight: 700; color: #e64340; }

.track-card { }
.track-list { position: relative; padding-left: 24rpx; }
.track-list::before { content: ''; position: absolute; left: 10rpx; top: 12rpx; bottom: 12rpx; width: 2rpx; background: #e5e5e5; }
.track-item { display: flex; align-items: flex-start; margin-bottom: 24rpx; position: relative; }
.track-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: #ccc; margin-right: 20rpx; margin-top: 6rpx; flex-shrink: 0; position: relative; z-index: 1; }
.track-dot.active { background: #07c160; }
.track-content { display: flex; flex-direction: column; gap: 6rpx; }
.track-action { font-size: 28rpx; color: #333; }
.track-location { font-size: 26rpx; color: #666; }
.track-time { font-size: 24rpx; color: #999; }
.track-map { width: 100%; height: 400rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.track-nav-btn { margin-left: auto; flex-shrink: 0; font-size: 24rpx; color: #004080; border: 1rpx solid #004080; padding: 8rpx 18rpx; border-radius: 24rpx; background: #fff; }

.action-card { display: flex; gap: 20rpx; }
.action-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 44rpx; font-size: 30rpx; background: #07c160; color: #fff; }
.action-btn.secondary { background: #f5f5f5; color: #666; }
.action-btn.review-btn { background: linear-gradient(135deg, #ff9900, #ff6600); }
.action-btn.pay-btn { background: linear-gradient(135deg, #07c160, #05a854); }

.pay-modal { position: fixed; inset: 0; z-index: 100; }
.pm-mask { position: absolute; inset: 0; background: rgba(0,0,0,0.5); }
.pm-content { position: absolute; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 20rpx 20rpx 0 0; max-height: 80vh; overflow-y: auto; }
.pm-header { display: flex; justify-content: space-between; padding: 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.pm-title { font-size: 34rpx; font-weight: 600; }
.pm-close { font-size: 48rpx; color: #999; }
.pm-body { padding: 30rpx; }
.pm-footer { padding: 30rpx; border-top: 1rpx solid #f0f0f0; }
.pm-btn { background: #07c160; color: #fff; text-align: center; padding: 24rpx; border-radius: 44rpx; font-size: 32rpx; }

.pay-method-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.pay-method-item:last-child { border-bottom: none; }
.pm-label { font-size: 30rpx; color: #333; }
.pm-arrow { color: #ccc; font-size: 32rpx; }

.pay-total { font-size: 32rpx; font-weight: 600; color: #e64340; text-align: center; margin-bottom: 30rpx; }
.pay-input-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.pay-input-row text { font-size: 30rpx; color: #333; }
.pay-input-row input { text-align: right; font-size: 30rpx; color: #333; width: 300rpx; }

.review-modal { position: fixed; inset: 0; z-index: 100; }
.rm-mask { position: absolute; inset: 0; background: rgba(0,0,0,0.5); }
.rm-content { position: absolute; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 20rpx 20rpx 0 0; max-height: 80vh; overflow-y: auto; }
.rm-header { display: flex; justify-content: space-between; padding: 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.rm-title { font-size: 34rpx; font-weight: 600; }
.rm-close { font-size: 48rpx; color: #999; }
.rm-body { padding: 30rpx; }

.rating-row { margin-bottom: 30rpx; }
.rating-label { font-size: 28rpx; color: #333; display: block; margin-bottom: 16rpx; }
.stars { display: flex; gap: 16rpx; }
.star { font-size: 56rpx; color: #ddd; }
.star.on { color: #ff9900; }

.tags-row { margin-bottom: 30rpx; }
.tags-label { font-size: 28rpx; color: #333; display: block; margin-bottom: 16rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-item { font-size: 26rpx; color: #666; background: #f5f5f5; padding: 12rpx 24rpx; border-radius: 30rpx; }
.tag-item.active { background: #07c160; color: #fff; }

.content-row { margin-bottom: 30rpx; }
.content-input { width: 100%; min-height: 200rpx; font-size: 28rpx; padding: 20rpx; border: 1rpx solid #e5e5e5; border-radius: 12rpx; }

.images-row { margin-bottom: 30rpx; }
.image-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.img-item { position: relative; }
.img-item image { width: 100%; height: 160rpx; border-radius: 10rpx; }
.img-del { position: absolute; top: -10rpx; right: -10rpx; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; background: #ff4d4f; color: #fff; border-radius: 50%; font-size: 28rpx; }
.img-add { width: 100%; height: 160rpx; border: 2rpx dashed #ddd; border-radius: 10rpx; text-align: center; line-height: 160rpx; font-size: 60rpx; color: #ccc; }

.anonymous-row { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; color: #666; }

.rm-footer { padding: 30rpx; border-top: 1rpx solid #f0f0f0; }
.submit-btn { background: #07c160; color: #fff; text-align: center; padding: 24rpx; border-radius: 44rpx; font-size: 32rpx; }
