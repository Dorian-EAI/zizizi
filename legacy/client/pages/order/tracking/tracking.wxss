.container { background: #f5f6fa; min-height: 100vh; padding-bottom: 60rpx; }
.bottom-space { height: 40rpx; }

/* 地图 */
.map { width: 100%; height: 500rpx; }

/* 状态横幅 */
.status-banner {
  background: #004080;
  color: #fff;
  padding: 30rpx;
  text-align: center;
}
.status-main { font-size: 36rpx; font-weight: 600; }
.status-sub { font-size: 26rpx; margin-top: 12rpx; opacity: 0.9; }
.status-stale { font-size: 24rpx; margin-top: 12rpx; color: #ffd666; }

/* 通用卡片 */
.card { margin: 20rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }
.empty { font-size: 26rpx; color: #999; text-align: center; padding: 20rpx 0; }

/* 师傅信息卡片 */
.worker-card { display: flex; justify-content: space-between; align-items: center; }
.wk-left { display: flex; align-items: center; gap: 16rpx; }
.wk-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; }
.wk-info { display: flex; flex-direction: column; gap: 6rpx; }
.wk-name { font-size: 30rpx; font-weight: 600; color: #333; }
.wk-rating { font-size: 24rpx; color: #ff9900; }
.wk-actions { display: flex; gap: 16rpx; }
.wk-btn {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 14rpx 22rpx; border-radius: 12rpx; min-width: 96rpx;
}
.wk-btn .btn-icon { font-size: 36rpx; line-height: 1; }
.wk-btn .btn-text { font-size: 22rpx; margin-top: 6rpx; }
.phone-btn { background: #07c160; color: #fff; }
.nav-btn { background: #004080; color: #fff; }

/* 时间线 */
.timeline-card { }
.timeline { position: relative; padding-left: 4rpx; }
.tl-item { display: flex; align-items: stretch; }
.tl-marker {
  width: 32rpx;
  display: flex; flex-direction: column; align-items: center;
  flex-shrink: 0;
}
.tl-dot {
  width: 20rpx; height: 20rpx; border-radius: 50%;
  margin-top: 6rpx; flex-shrink: 0;
  z-index: 1; position: relative;
}
.tl-dot.done { background: #004080; }
.tl-dot.pending { background: #fff; border: 2rpx solid #ccc; box-sizing: border-box; }
.tl-line {
  flex: 1;
  width: 2rpx;
  background: #e5e5e5;
  margin-top: 4rpx;
  margin-bottom: 4rpx;
}
.tl-content {
  display: flex; flex-direction: column; gap: 6rpx;
  padding-bottom: 30rpx;
  padding-left: 16rpx;
  flex: 1;
}
.tl-text { font-size: 28rpx; color: #333; }
.tl-time { font-size: 24rpx; color: #999; }
