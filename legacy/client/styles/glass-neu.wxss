/* ============================================================
 * 玻璃新拟态 (Glass Neumorphism) 全局样式
 * 自家人居家维修 · 客户端 Teal 品牌
 * 1px = 2rpx 换算
 * ============================================================ */

page {
  --brand: #0D9488;
  --brand-dark: #0A7A70;
  --brand-mid: #14B8A6;
  --brand-light: #CCFBF1;
  --brand-glow: rgba(13, 148, 136, 0.24);
  --brand-subtle: rgba(13, 148, 136, 0.10);
  --brand-gradient: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #D4944C 100%);

  --accent: #D4944C;
  --accent-dark: #A0723C;
  --accent-mid: #E8C088;
  --accent-light: #F5E6D0;
  --accent-glow: rgba(212, 148, 76, 0.20);

  --bg: #F2EDE8;
  --bg-elevated: #F7F3EF;
  --body-bg: #E8E4DF;

  --neu-light: #FFF8F2;
  --neu-dark: #DDD6CE;

  --text-1: #2C2824;
  --text-2: #8B8178;
  --text-3: #B5ADA5;
  --text-inverse: #ffffff;

  --sep: rgba(44, 40, 36, 0.06);
  --fill: rgba(44, 40, 36, 0.04);

  --green: #5B8C5A;
  --red: #C4533A;
  --orange: #D4944C;
  --blue: #5A8FAD;
  --purple: #5856D6;

  --r-sm: 24rpx;
  --r-md: 32rpx;
  --r-lg: 48rpx;
  --r-pill: 9999rpx;

  --dur: 0.2s;

  background: #F2EDE8;
  color: #2C2824;
  font-family: 'Noto Serif SC', 'PingFang SC', -apple-system, Georgia, serif;
  font-size: 28rpx;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

view, text, input, button, textarea, scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

view {
  -webkit-tap-highlight-color: transparent;
}

/* ===== 新拟态阴影预设 ===== */
.neu-out-sm {
  box-shadow: 10rpx 10rpx 28rpx var(--neu-dark), -10rpx -10rpx 28rpx var(--neu-light), 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.neu-out-md {
  box-shadow: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light), 0 12rpx 48rpx rgba(0, 0, 0, 0.05);
}

.neu-in {
  box-shadow: inset 8rpx 8rpx 16rpx var(--neu-dark), inset -8rpx -8rpx 16rpx var(--neu-light);
}

/* ===== 玻璃新拟态卡片 ===== */
.glass-neu-card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-lg);
  box-shadow: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  position: relative;
  overflow: hidden;
}

/* ===== 页面容器 ===== */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 164rpx;
}

/* ===== Hero 区域 ===== */
.hero {
  padding: calc(76rpx + env(safe-area-inset-top)) 48rpx 56rpx;
  position: relative;
  z-index: 1;
  background:
    radial-gradient(ellipse 480rpx 400rpx at 75% 40%, rgba(212, 148, 76, 0.32) 0%, transparent 70%),
    radial-gradient(ellipse 400rpx 320rpx at 20% 80%, rgba(13, 148, 136, 0.24) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.28) 0%, rgba(212, 148, 76, 0.20) 50%, rgba(20, 184, 166, 0.12) 100%);
  border-radius: 0 0 64rpx 64rpx;
  overflow: hidden;
}

/* ===== 顶部导航栏 ===== */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(36rpx + env(safe-area-inset-top)) 32rpx 24rpx;
  background:
    radial-gradient(ellipse 440rpx 320rpx at 78% 45%, rgba(212, 148, 76, 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 280rpx at 18% 75%, rgba(13, 148, 136, 0.16) 0%, transparent 70%),
    linear-gradient(135deg, rgba(13, 148, 136, 0.14) 0%, rgba(212, 148, 76, 0.08) 50%, rgba(13, 148, 136, 0.06) 100%);
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}

.nav-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: none;
  box-shadow: 10rpx 10rpx 28rpx var(--neu-dark), -10rpx -10rpx 28rpx var(--neu-light), inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-1);
  flex-shrink: 0;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.02em;
}

.nav-spacer {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* ===== 分区 ===== */
.section {
  padding: 0 48rpx;
  margin-top: 40rpx;
  position: relative;
  z-index: 2;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;
  letter-spacing: -0.02em;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 20rpx;
  padding-left: 4rpx;
  letter-spacing: 0.2px;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ===== 玻璃卡片 ===== */
.card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(44, 40, 36, 0.05);
  position: relative;
  overflow: hidden;
}

/* ===== 按钮 ===== */
.btn-neu-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--brand-gradient);
  color: var(--text-inverse);
  border: 1rpx solid rgba(255, 255, 255, 0.40);
  border-radius: var(--r-pill);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 10rpx 10rpx 28rpx var(--neu-dark), -10rpx -10rpx 28rpx var(--neu-light), 0 8rpx 28rpx var(--brand-glow), inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.30);
  transition: transform var(--dur) cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.btn-neu-primary:active {
  box-shadow: var(--neu-in);
  transform: scale(0.94);
}

.btn-neu-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.50);
  color: var(--brand);
  border: 1rpx solid rgba(255, 255, 255, 0.60);
  border-radius: var(--r-pill);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 10rpx 10rpx 28rpx var(--neu-dark), -10rpx -10rpx 28rpx var(--neu-light);
}

.btn-neu-secondary:active {
  box-shadow: var(--neu-in);
  transform: scale(0.94);
}

/* ===== 菜单卡片 ===== */
.menu-card {
  background: rgba(255, 255, 255, 0.52);
  border: 2rpx solid rgba(255, 255, 255, 0.70);
  border-radius: var(--r-md);
  box-shadow: 16rpx 16rpx 36rpx var(--neu-dark), -16rpx -16rpx 36rpx var(--neu-light), 0 12rpx 56rpx rgba(0, 0, 0, 0.06), 0 4rpx 16rpx rgba(13, 148, 136, 0.04);
  overflow: hidden;
  position: relative;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 36rpx;
  position: relative;
}

.menu-row-sep {
  position: absolute;
  left: 128rpx;
  right: 36rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--sep);
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg);
  box-shadow: 8rpx 8rpx 16rpx var(--neu-dark), -8rpx -8rpx 16rpx var(--neu-light), inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.45);
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
  letter-spacing: -0.01em;
}

.menu-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 500;
  margin-right: 4rpx;
}

.menu-chevron {
  width: 28rpx;
  height: 28rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

/* 菜单图标颜色变体 */
.menu-icon-blue { color: var(--blue); background: rgba(90, 143, 173, 0.08); }
.menu-icon-purple { color: var(--purple); background: rgba(88, 86, 214, 0.08); }
.menu-icon-green { color: var(--green); background: rgba(91, 140, 90, 0.08); }
.menu-icon-gray { color: var(--text-2); background: rgba(120, 120, 128, 0.08); }
.menu-icon-amber { color: var(--orange); background: rgba(212, 148, 76, 0.08); }
.menu-icon-teal { color: var(--brand); background: rgba(13, 148, 136, 0.08); }
.menu-icon-red { color: var(--red); background: rgba(196, 83, 58, 0.08); }
.menu-icon-cyan { color: var(--blue); background: rgba(90, 143, 173, 0.08); }
.menu-icon-slate { color: var(--text-2); background: rgba(120, 120, 128, 0.08); }

/* ===== 底部 Tab Bar ===== */
.tab-bar {
  position: fixed;
  bottom: max(28rpx, env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 64rpx);
  max-width: 720rpx;
  height: 128rpx;
  z-index: 100;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.50);
  border-radius: 56rpx;
  box-shadow:
    inset 0 3rpx 6rpx rgba(255, 255, 255, 0.60),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.20),
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 4rpx 20rpx rgba(0, 0, 0, 0.06),
    0 24rpx 72rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 20rpx;
  backdrop-filter: blur(48px);
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 136rpx;
  height: 88rpx;
  border-radius: 28rpx;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 500;
  position: relative;
  text-align: center;
}

.tab-item-active {
  color: var(--brand);
  font-weight: 600;
}

.tab-item-active-bg {
  position: absolute;
  width: 108rpx;
  height: 84rpx;
  border-radius: 32rpx;
  background: rgba(13, 148, 136, 0.16);
  border: 1rpx solid rgba(13, 148, 136, 0.30);
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.55),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.15),
    0 4rpx 20rpx rgba(13, 148, 136, 0.20);
  z-index: 0;
}

.tab-label {
  position: relative;
  z-index: 1;
}

/* ===== 通用工具类 ===== */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }
.relative { position: relative; }
.overflow-hidden { overflow: hidden; }
.text-center { text-align: center; }
.w-full { width: 100%; }

.text-brand { color: var(--brand); }
.text-accent { color: var(--accent); }
.text-1 { color: var(--text-1); }
.text-2 { color: var(--text-2); }
.text-3 { color: var(--text-3); }

.mt-0 { margin-top: 0; }
.mt-4 { margin-top: 8rpx; }
.mt-8 { margin-top: 16rpx; }
.mt-16 { margin-top: 32rpx; }
.mt-20 { margin-top: 40rpx; }
.mt-24 { margin-top: 48rpx; }
.mb-4 { margin-bottom: 8rpx; }
.mb-8 { margin-bottom: 16rpx; }
.mb-16 { margin-bottom: 32rpx; }

.px-24 { padding-left: 48rpx; padding-right: 48rpx; }
.py-16 { padding-top: 32rpx; padding-bottom: 32rpx; }
