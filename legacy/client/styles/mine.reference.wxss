/* =========================================================
 * 我的页面样式 · 参考 lilu-value-investing-30.html
 * - 用户信息区使用 indigo 彩色边条（讲座卡片风格）
 * - 数据区使用 serif 大号数字
 * - 菜单区使用四色系统区分不同模块
 * ========================================================= */

.page-container.data-v-415e71d6 {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom, 0px));
}

/* ---------- 顶部导航 ---------- */
.custom-nav.data-v-415e71d6 {
  position: sticky;
  top: 0;
  z-index: 101;
  padding-top: max(env(safe-area-inset-top), 59px);
  background: var(--surface);
  border-bottom: 1rpx solid var(--divider);
}
.nav-title.data-v-415e71d6 {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 0.08em;
}

/* ---------- 用户信息卡 ---------- */
.user-header.data-v-415e71d6 {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  margin: 24rpx 30rpx 0;
  border-radius: var(--radius-lg);
  gap: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 8rpx solid var(--indigo);
  box-shadow: var(--shadow-card);
}
.user-avatar-wrap.data-v-415e71d6 {
  position: relative;
}
.user-avatar.data-v-415e71d6 {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--indigo-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-emoji.data-v-415e71d6 {
  font-size: 56rpx;
}
.avatar-edit-icon.data-v-415e71d6 {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.user-info.data-v-415e71d6 {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.user-name-row.data-v-415e71d6 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}
.user-name.data-v-415e71d6 {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.vip-badge.data-v-415e71d6 {
  padding: 4rpx 14rpx;
  background: var(--amber-soft);
  border-radius: 999rpx;
}
.vip-text.data-v-415e71d6 {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--amber);
  letter-spacing: 0.04em;
}
.user-phone.data-v-415e71d6 {
  font-size: 24rpx;
  color: var(--text-2);
}
.user-id.data-v-415e71d6 {
  font-size: 22rpx;
  color: var(--text-3);
}
.edit-btn.data-v-415e71d6 {
  padding: 12rpx 24rpx;
  background: var(--bg-soft);
  border-radius: 999rpx;
}
.edit-btn text.data-v-415e71d6 {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-2);
}

/* ---------- 数据统计（讲座风格的大数字） ---------- */
.stats-card.data-v-415e71d6 {
  display: flex;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx 0;
  margin: 24rpx 30rpx 0;
  box-shadow: var(--shadow-card);
}
.stat-item.data-v-415e71d6 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
}
.stat-item.data-v-415e71d6 + .stat-item.data-v-415e71d6::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background: var(--divider);
}
.stat-value.data-v-415e71d6 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--indigo);
  line-height: 1.1;
}
.stat-label.data-v-415e71d6 {
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 0.02em;
}

/* ---------- 通用 section 卡 ---------- */
.section-card.data-v-415e71d6 {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin: 24rpx 30rpx 0;
  box-shadow: var(--shadow-card);
}
.section-card.indigo  { border-left: 8rpx solid var(--indigo); }
.section-card.teal    { border-left: 8rpx solid var(--teal); }
.section-card.amber   { border-left: 8rpx solid var(--amber); }
.section-card.rose    { border-left: 8rpx solid var(--rose); }

.section-header.data-v-415e71d6 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title.data-v-415e71d6 {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 0.02em;
}

/* ---------- 服务菜单网格 ---------- */
.menu-grid.data-v-415e71d6 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx 0;
  padding-top: 8rpx;
}
.menu-grid-item.data-v-415e71d6 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: var(--radius-md);
  position: relative;
}
.grid-icon.data-v-415e71d6 {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 10rpx;
}
.grid-label.data-v-415e71d6 {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 500;
}
.grid-badge.data-v-415e71d6 {
  position: absolute;
  top: 8rpx;
  right: 20%;
  padding: 2rpx 12rpx;
  background: var(--rose);
  color: #fff;
  font-size: 18rpx;
  border-radius: 999rpx;
  min-width: 28rpx;
  text-align: center;
}

/* ---------- 列表菜单（工具行） ---------- */
.menu-list.data-v-415e71d6 {
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
}
.menu-item.data-v-415e71d6 {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  gap: 18rpx;
}
.menu-item.data-v-415e71d6 + .menu-item.data-v-415e71d6 {
  border-top: 1rpx solid var(--divider);
}
.menu-icon.data-v-415e71d6 {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.menu-label.data-v-415e71d6 {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
}
.menu-value.data-v-415e71d6 {
  font-size: 22rpx;
  color: var(--text-3);
}
.menu-arrow.data-v-415e71d6 {
  font-size: 28rpx;
  color: var(--text-4);
  font-weight: 300;
}

/* ---------- 退出按钮 ---------- */
.logout-btn.data-v-415e71d6 {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 30rpx 40rpx;
  padding: 26rpx 0;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
}
.logout-btn text.data-v-415e71d6 {
  font-size: 26rpx;
  color: var(--rose-text);
  font-weight: 600;
  letter-spacing: 0.04em;
}

/* 额外间距 */
.spacing-bottom.data-v-415e71d6 {
  height: 40rpx;
}
