/* TabBar 组件样式 · 参考 lilu-value-investing-30.html 风格 */
.tab-bar.data-v-8f6cabe5 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #ffffff;
  border-top: 1rpx solid #f4f4f5;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
  box-shadow: 0 -2rpx 16rpx rgba(24, 24, 27, 0.04);
}
.tab-item.data-v-8f6cabe5 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  transition: transform 0.2s;
}
.tab-emoji.data-v-8f6cabe5 {
  font-size: 40rpx;
  line-height: 44rpx;
  margin-bottom: 4rpx;
  opacity: 0.55;
}
.tab-item.active .tab-emoji.data-v-8f6cabe5 {
  opacity: 1;
}
.tab-text.data-v-8f6cabe5 {
  font-size: 22rpx;
  color: #a1a1aa;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.tab-item.active .tab-text.data-v-8f6cabe5 {
  color: #4f46e5;
  font-weight: 700;
}
